# ── audio.cpp backend (asr-live) ────────────────────────────
#
# audio.cpp (github.com/0xShug0/audio.cpp) runs speech models on ggml — here
# Nemotron 3.5 ASR, which transcribes while the audio is still coming in. Its
# server takes its models from a JSON file, not from its command line, so
# llmctl writes one per model and slot, named after both: the command line then
# still tells models apart (what preset compares), and status and preset-save
# read the model back from the file. Each entry is served twice: as <alias>
# for whole recordings (POST /v1/audio/transcriptions) and as <alias>-live for
# live audio (POST /v1/audio/transcriptions/live, raw PCM in a chunked body,
# text deltas as SSE on the same connection).
# models.conf fields for backend=audiocpp:
#   binary       audiocpp_server, built by `download` from a pinned commit
#   model        the model's GGUF
#   alias        the model id the server answers to
#   extra_args   family=<audio.cpp family> task=<asr|tts|…> (KEY=VAL)
AUDIOCPP_GIT="https://github.com/0xShug0/audio.cpp.git"
# audio.cpp follows its release tags, not main; outdated says when a new one is out.
# audio.cpp follows its newest release tag (download --master: main). This one,
# tried here, is what it falls back to when GitHub cannot be asked.
AUDIOCPP_TAG=v0.9.1
AUDIOCPP_COMMIT=cf124a67cc55d8f65a9a15eec69edbff0fb212c8
AUDIOCPP_DIR="$DATA_DIR/audio.cpp"
AUDIOCPP_CONF_DIR="$STATE_DIR/audiocpp"

_is_audiocpp_argv() { [[ " ${_ARGV[*]} " == *" --config $AUDIOCPP_CONF_DIR/"* ]]; }

# The model file an audio.cpp server runs, from its config file.
_audiocpp_model_of_argv() {
    local conf
    conf=$(_argv_flag --config) || return 1
    python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["models"][0]["path"])' "$conf" 2>/dev/null
}

# KEY=VAL out of an audiocpp entry's extra_args.
_audiocpp_arg() {
    local key="$1" a
    for a in "${_r_args[@]}"; do [[ "$a" == "$key="* ]] && { echo "${a#*=}"; return 0; }; done
    return 1
}

_start_audiocpp() {
    local -a refused=()
    [[ -n "$reasoning" ]] && refused+=("--reasoning")
    [[ -n "$ctx" ]] && refused+=("--ctx")
    [[ -n "$parallel" ]] && refused+=("--parallel")
    [[ -n "$cache_ram" ]] && refused+=("--cache-ram")
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$spec" ]] && refused+=("--spec")
    [[ "$use_mmproj" == true ]] && refused+=("--mmproj")
    [[ -n "$temp" ]] && refused+=("--temp")
    [[ -n "$top_p" ]] && refused+=("--top-p")
    [[ -n "$max_predict" ]] && refused+=("--max-predict")
    [[ "$start_proxy" == true ]] && refused+=("--proxy")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    [[ "$compact" == true ]] && refused+=("--compact")
    [[ "$verbose" == true ]] && refused+=("--verbose")
    [[ -n "$output_dir" ]] && refused+=("--output")
    [[ -n "$lang" ]] && refused+=("--lang")
    [[ -n "$seed" ]] && refused+=("--seed")
    if (( ${#refused[@]} )); then
        echo "Error: '$name' is an audio.cpp model — these options have no meaning for it: ${refused[*]}"
        exit 1
    fi
    local family task
    family=$(_audiocpp_arg family) || { echo "Error: models.conf entry '$_r_name' names no family=… in extra_args"; exit 1; }
    task=$(_audiocpp_arg task) || task=asr
    local model="${_r_model//\~/$HOME}" bin="${_r_binary//\~/$HOME}"
    local conf="$AUDIOCPP_CONF_DIR/${_r_name}-${slot}.json"
    local -a cmd=("$bin" --config "$conf" --host "${host:-127.0.0.1}" --port "$port_server")

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    [[ "$ignore_memory" == true ]] || _memory_check_start "$slot" "${cmd[*]}" false
    [[ -x "$bin" ]] || { echo "Error: audio.cpp is not built — run: $PROG download $_r_name"; exit 1; }
    [[ -f "$model" ]] || { echo "Error: $model is missing — run: $PROG download $_r_name"; exit 1; }
    mkdir -p "$AUDIOCPP_CONF_DIR"
    python3 - "$conf" "$model" "$_r_client" "$family" "$task" <<'PY' || exit 1
import json, sys
conf, model, alias, family, task = sys.argv[1:]
json.dump({"backend": "vulkan", "device": 0, "threads": 4, "lazy_load": False,
           "models": [{"id": alias, "family": family, "path": model, "task": task, "mode": "offline"},
                      {"id": alias + "-live", "family": family, "path": model, "task": task,
                       "mode": "streaming"}]},
          open(conf, "w"), indent=2)
PY
    local url="http://${host:-127.0.0.1}:$port_server"
    local config_text
    config_text="$(
        echo "Model:    $_r_label ($_r_client, $_r_client-live)"
        echo "Backend:  audio.cpp — $bin, Vulkan"
        echo "Weights:  $model"
        echo "Config:   $conf"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        echo "API:      POST $url/v1/audio/transcriptions        (file, model=$_r_client)"
        echo "          POST $url/v1/audio/transcriptions/live   (?model=$_r_client-live, chunked 16 kHz s16le PCM → SSE deltas)"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "----------------------------"
    )"
    echo "$config_text"
    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting audio.cpp [slot $slot] on port $port_server..."
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append "${cmd[@]}")
    [[ -n "$server_pid" ]] || { echo "Error: audio.cpp did not report a PID. See $server_log" >&2; exit 1; }
    echo "Server running (PID: $server_pid, detached)"
    _watch_start "$server_pid" "$server_log" "$port_server" || { _stop_slot "$slot" > /dev/null 2>&1; exit 1; }
    echo ""
    echo "  Try:   curl -s $url/v1/audio/transcriptions -F file=@aufnahme.wav -F model=$_r_client"
    echo "  Live:  ffmpeg -f pulse -i default -ar 16000 -ac 1 -f s16le - | curl -sN -X POST -T - -H 'Expect:' \\"
    echo "           '$url/v1/audio/transcriptions/live?model=$_r_client-live'"
    echo "  Logs:  tail -f $server_log"
    echo "  Stop:  $PROG stop $slot"
}

# status for an audio.cpp slot.
_describe_audiocpp() {
    local indent="$1" model host port label ids
    model=$(_audiocpp_model_of_argv) || model=""
