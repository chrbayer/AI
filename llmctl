# preset-save for an audio.cpp slot: the entry by its model file, plus --host.
_capture_audiocpp_slot() {
    local slot="$1" model host name
    model=$(_audiocpp_model_of_argv) || { echo "slot $slot: cannot read the audio.cpp config" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    (( ${#candidates[@]} )) || { echo "slot $slot: $(basename "$model") is not in models.conf" >&2; return 1; }
    host=$(_argv_flag --host) || host=""
    [[ "$host" == "127.0.0.1" ]] && host=""
    local -a flags=()
    [[ -n "$host" ]] && flags+=(--host "$host")
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot${flags[*]:+ ${flags[*]}}"
            _cap_label="$_r_label"
            return 0
        fi
    done
    echo "slot $slot: cannot express the running audio.cpp server as start options." >&2
    return 1
}

# download for an audiocpp entry: audio.cpp itself, from a pinned commit, built
# with Vulkan and only the model families models.conf names — the full set is
# 90-odd families and 7 GB of build.
_audiocpp_families() {
    local entry f fams=""
    local -a w
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a w <<< "$entry"
        [[ "${w[19]:-}" == audiocpp ]] || continue
        for f in ${w[6]}; do [[ "$f" == family=* ]] && fams+="${fams:+,}${f#family=}"; done
    done
    echo "$fams"
}
# The audio.cpp to build: AC_REF (a tag, or main under --master) and AC_SHA.
_audiocpp_wanted() {
    local refs
    AC_REF="" AC_SHA=""
    if [[ "${DL_MASTER:-false}" == true ]]; then
        AC_SHA=$(git ls-remote "$AUDIOCPP_GIT" refs/heads/main 2>/dev/null | cut -f1)
        [[ -n "$AC_SHA" ]] && AC_REF=main
    else
        refs=$(git ls-remote --tags "$AUDIOCPP_GIT" 'v*' 2>/dev/null)
        AC_REF=$(sed -n 's#.*refs/tags/\(v[0-9]*\.[0-9]*\.[0-9]*\)$#\1#p' <<< "$refs" | sort -V | tail -1)
        if [[ -n "$AC_REF" ]]; then
            # An annotated tag lists its commit on a ^{} line of its own.
            AC_SHA=$(awk -v t="refs/tags/$AC_REF^{}" '$2 == t { print $1 }' <<< "$refs")
            [[ -n "$AC_SHA" ]] || AC_SHA=$(awk -v t="refs/tags/$AC_REF" '$2 == t { print $1 }' <<< "$refs")
        fi
    fi
    if [[ -z "$AC_REF" || -z "$AC_SHA" ]]; then
        AC_REF="$AUDIOCPP_TAG" AC_SHA="$AUDIOCPP_COMMIT"
    fi
}

_audiocpp_setup() {
    local bin="${_r_binary//\~/$HOME}"
    _audiocpp_wanted
    if [[ "$DL_CHECK" == true ]]; then
        if [[ -x "$bin" && "$(git -C "$AUDIOCPP_DIR" rev-parse HEAD 2>/dev/null)" == "$AC_SHA" ]]; then
            echo "  audio.cpp: built ($AC_REF)"
        elif [[ -x "$bin" ]]; then echo "  audio.cpp: to rebuild at $AC_REF (~2 min)"; DL_PENDING=$(( DL_PENDING + 1 ))
        else echo "  audio.cpp: to clone and build at $AC_REF (Vulkan, ~2 min)"; DL_PENDING=$(( DL_PENDING + 1 )); fi
        return 0
    fi
    local head; head=$(git -C "$AUDIOCPP_DIR" rev-parse HEAD 2>/dev/null)
    if [[ -x "$bin" && "$head" == "$AC_SHA" ]]; then
        echo "  audio.cpp in $AUDIOCPP_DIR ($AC_REF)"
        return 0
    fi
    [[ -x "$bin" ]] && echo "  audio.cpp: built at ${head:0:9}, rebuilding at $AC_REF"
    _check_deps git cmake c++ glslc || return 1
    if [[ ! -d "$AUDIOCPP_DIR/.git" ]]; then
        echo "  git clone $AUDIOCPP_GIT"
        git clone -q "$AUDIOCPP_GIT" "$AUDIOCPP_DIR" || return 1
    fi
    git -C "$AUDIOCPP_DIR" cat-file -e "$AC_SHA^{commit}" 2>/dev/null ||
        git -C "$AUDIOCPP_DIR" fetch -q origin "$AC_SHA" || return 1
    git -C "$AUDIOCPP_DIR" -c advice.detachedHead=false checkout -q "$AC_SHA" || return 1
    git -C "$AUDIOCPP_DIR" submodule update -q --init --recursive --depth 1 || return 1
    local fams; fams=$(_audiocpp_families)
    echo "  building with Vulkan, model families: $fams"
    ( cd "$AUDIOCPP_DIR" && scripts/build_linux.sh --backend vulkan --model-set custom --models "$fams" \
        --target audiocpp_server ) > "$AUDIOCPP_DIR/build.log" 2>&1 ||
        { echo "  build failed — see $AUDIOCPP_DIR/build.log"; return 1; }
    [[ -x "$bin" ]] || { echo "  built, but $bin is not there — see $AUDIOCPP_DIR/build.log"; return 1; }
    echo "  built: $bin"
}

_start_tts() {
    local -a refused=()
    [[ -n "$reasoning" ]] && refused+=("--reasoning")
    [[ -n "$ctx" ]] && refused+=("--ctx")
    [[ -n "$parallel" ]] && refused+=("--parallel")
    [[ -n "$cache_ram" ]] && refused+=("--cache-ram")
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$spec" ]] && refused+=("--spec")
    [[ "$use_mmproj" == true ]] && refused+=("--mmproj")
    [[ -n "$temp" ]] && refused+=("--temp")
    [[ -n "$top_p" ]] && refused+=("--top-p")
    [[ -n "$max_predict" ]] && refused+=("--max-predict")
    [[ "$start_proxy" == true ]] && refused+=("--proxy")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    [[ "$compact" == true ]] && refused+=("--compact")
    [[ "$verbose" == true ]] && refused+=("--verbose")
    [[ -n "$output_dir" ]] && refused+=("--output")
    if (( ${#refused[@]} )); then
        echo "Error: '$name' is a speech model — these options have no meaning for it: ${refused[*]}"
        exit 1
    fi
    local l="${lang:-$TTS_DEFAULT_LANG}"
    if [[ ! " zh en de it pt es ja ko fr ru " == *" $l "* ]]; then
        echo "Error: --lang takes zh, en, de, it, pt, es, ja, ko, fr or ru (got '$l')"; exit 1
    fi

    local model="${_r_model//\~/$HOME}" mm="${_r_mmproj//\~/$HOME}"
    # The streaming llama-server is a separate build (patches/build-tts-server.sh);
    # without it, llama-tts does the same job slower.
    if [[ "$(basename "$_r_binary")" == llama-server* && ! -x "${_r_binary//\~/$HOME}" ]]; then
        [[ "$print_cmd" == true ]] || echo "Note: $_r_binary is not built — using llama-tts (no streaming). Build it: $SHARE_DIR/patches/build-tts-server.sh"
        _r_binary="llama-tts"
    fi
    # The interpreter's own path, as Python rewrites argv[0] to it — and preset
    # compares this command against the running process's argv. Asked of Python
    # itself, since `command -v` may name a pyenv shim instead.
    local py; py=$(python3 -c 'import sys; print(sys.executable)' 2>/dev/null) || py=python3
    local -a cmd=("$py" "$TTS_SERVER_SCRIPT" --host "${host:-127.0.0.1}" --port "$port_server"
        --model "$model" --mmproj "$mm" --voices "$TTS_VOICES" --binary "$_r_binary"
        --lang "$l" --alias "$_r_client")
    [[ -n "$seed" ]] && cmd+=(--seed "$seed")
    (( ${#_r_args[@]} )) && cmd+=(-- "${_r_args[@]}")

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    [[ "$ignore_memory" == true ]] || _memory_check_start "$slot" "${cmd[*]}" false
    _check_deps python3 "$_r_binary" || exit 1
    local f
    for f in "$model" "$mm"; do
        [[ -f "$f" ]] || { echo "Error: $f is missing — run: $PROG download $_r_name"; exit 1; }
    done
    local n_voices
    n_voices=$(find "$TTS_VOICES" -maxdepth 1 \( -name '*.wav' -o -name '*.mp3' -o -name '*.flac' \) 2>/dev/null | wc -l)
    (( n_voices > 0 )) || echo "Note: no voices in $TTS_VOICES yet — $PROG download $_r_name brings two, $PROG voice adds more."

    local url="http://${host:-127.0.0.1}:$port_server"
    local config_text
    config_text="$(
        echo "Model:    $_r_label ($_r_client)"
        if [[ "$(basename "$_r_binary")" == llama-server* ]]; then
            echo "Backend:  tts — $_r_binary (model resident, streaming) behind tts_server.py"
        else
            echo "Backend:  tts — $_r_binary behind tts_server.py, one run per request"
        fi
        echo "Weights:  $model"
        echo "          $mm"
        echo "Voices:   $TTS_VOICES ($n_voices)"
        echo "Language: $l (a request may name another)"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        echo "API:      POST $url/v1/audio/speech  {\"input\": \"…\", \"voice\": \"<name>\"}"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "----------------------------"
    )"
    echo "$config_text"
    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting speech server [slot $slot] on port $port_server..."
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: the speech server did not report a PID. See $server_log" >&2
        exit 1
    fi
    echo "Server running (PID: $server_pid, detached)"
    _watch_start "$server_pid" "$server_log" "$port_server" || { _stop_slot "$slot" > /dev/null 2>&1; exit 1; }
    echo ""
    echo "  Try:   curl -s $url/v1/audio/speech -H 'Content-Type: application/json' \\"
    echo "           -d '{\"input\": \"Hallo!\", \"voice\": \"frau\"}' -o hallo.wav"
    echo "  Logs:  tail -f $server_log"
    echo "  Stop:  $PROG stop $slot"
}

# status for a speech slot.
_describe_tts() {
    local indent="$1" model host port lang label names
    model=$(_argv_flag --model) || model=""
    host=$(_argv_flag --host) || host="127.0.0.1"
    port=$(_argv_flag --port) || port="?"
    lang=$(_argv_flag --lang) || lang="$TTS_DEFAULT_LANG"
    label=$(_label_for_model_path "$model") || label="$(basename "$model")"
    names=$(curl -sf -m 3 "http://127.0.0.1:$port/v1/audio/voices" | python3 -c 'import json,sys; print(", ".join(json.load(sys.stdin)["voices"]))' 2>/dev/null)
    echo "${indent}Model:     $label"
    echo "${indent}API:       http://$host:$port/v1/audio/speech  (language $lang)"
    echo "${indent}Voices:    ${names:-no answer (still starting?)}"
    local bin; bin=$(_argv_flag --binary) || bin=""
    if [[ "$(basename "$bin")" == llama-server* ]]; then
        awk -v g="$(_slot_gpu_mib "$slot" 2>/dev/null || echo 0)" -v i="$indent" 'BEGIN {
            printf "%sEngine:    llama-server, model resident (%.1f GiB), streaming\n", i, g / 1024 }'
    else
        echo "${indent}Engine:    llama-tts, loaded per request"
    fi
}

# preset-save for a speech slot: the entry by its model file, plus --host and --lang.
_capture_tts_slot() {
    local slot="$1" model host lang name
    model=$(_argv_flag --model) || { echo "slot $slot: the speech server carries no --model" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    (( ${#candidates[@]} )) || { echo "slot $slot: $(basename "$model") is not in models.conf" >&2; return 1; }
    host=$(_argv_flag --host) || host=""
    [[ "$host" == "127.0.0.1" ]] && host=""
    lang=$(_argv_flag --lang) || lang=""
    [[ "$lang" == "$TTS_DEFAULT_LANG" ]] && lang=""
    local seed; seed=$(_argv_flag --seed) || seed=""
    local -a flags=()
    [[ -n "$host" ]] && flags+=(--host "$host")
    [[ -n "$lang" ]] && flags+=(--lang "$lang")
    [[ -n "$seed" ]] && flags+=(--seed "$seed")
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot${flags[*]:+ ${flags[*]}}"
            _cap_label="$_r_label"
            return 0
        fi
        _cap_diff_name="$name"; _cap_diff_built="$built"
    done
    echo "slot $slot: cannot express the running speech server as start options." >&2
    [[ -n "${_cap_diff_built:-}" ]] && printf '  closest: %s\n  running: %s\n' "$_cap_diff_built" "${_ARGV[*]}" >&2
    return 1
}

# Links that make ComfyUI and llmctl share what they both use:
#   <base>/models        → the models directory. Custom node packs (Qwen3-TTS)
#                          look for and download their models there, not under
#                          --models-directory.
#   <base>/input/voice-* → the speech voices, one hard link per voice file:
#                          LoadAudio lists only the input directory's own files
#                          and refuses a symlink that resolves outside it.
_comfyui_links() {
    local base="$1" models="$2"
    [[ -e "$base/models" || -L "$base/models" ]] || ln -s "$models" "$base/models"
    # llmctl's own nodes (Artifact Check): linked, so an install reaches them at the next start.
    if [[ -d "$COMFYUI_SHARE/nodes/llmctl_nodes" ]]; then
        mkdir -p "$base/custom_nodes"
        ln -sfn "$COMFYUI_SHARE/nodes/llmctl_nodes" "$base/custom_nodes/llmctl_nodes"
    fi
    _comfyui_voice_links "$base"
}

_comfyui_voice_links() {
    local input="$1/input" f n
    [[ -d "$1" ]] || return 0
    mkdir -p "$input"
    # voice-<file> belongs to the voice <file>: replaced whenever that voice
    # exists — a voice rewritten in place gets a new inode, which leaves the old
    # link behind with the old sound. Symlinks are from an earlier layout.
    for f in "$input"/voice-*; do
        [[ -e "$f" || -L "$f" ]] || continue
        n="${f##*/voice-}"
        if [[ -L "$f" || -e "$TTS_VOICES/$n" ]]; then rm -f "$f"; fi
    done
    for f in "$TTS_VOICES"/*.wav "$TTS_VOICES"/*.mp3 "$TTS_VOICES"/*.flac; do
        [[ -f "$f" ]] || continue
        ln "$f" "$input/voice-${f##*/}" 2>/dev/null || cp "$f" "$input/voice-${f##*/}"
    done
}

# The same, for whichever comfyui entry is set up — after `voice` changed a voice.
_comfyui_voice_links_all() {
    local entry m_name
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name _ <<< "$entry"
        _resolve_model "$m_name" && [[ "$_r_backend" == comfyui ]] || continue
        _comfyui_voice_links "$(dirname "${_r_binary//\~/$HOME}")"
    done
}

_start_comfyui() {
    local -a refused=()
    [[ -n "$reasoning" ]] && refused+=("--reasoning")
    [[ -n "$ctx" ]] && refused+=("--ctx")
    [[ -n "$parallel" ]] && refused+=("--parallel")
    [[ -n "$cache_ram" ]] && refused+=("--cache-ram")
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$spec" ]] && refused+=("--spec")
    [[ "$use_mmproj" == true ]] && refused+=("--mmproj")
    [[ -n "$temp" ]] && refused+=("--temp")
    [[ -n "$top_p" ]] && refused+=("--top-p")
    [[ -n "$max_predict" ]] && refused+=("--max-predict")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    [[ "$compact" == true ]] && refused+=("--compact")
    if (( ${#refused[@]} )); then
        echo "Error: '$name' is ComfyUI, not an LLM — these options have no meaning for it: ${refused[*]}"
        exit 1
    fi

    local app="${_r_binary//\~/$HOME}"
    local models="${_r_model//\~/$HOME}"
    local base; base="$(dirname "$app")"
    local -a cmd=("$app/.venv/bin/python" "$app/main.py"
        --listen "${host:-127.0.0.1}" --port "$port_server"
        --base-directory "$base" --models-directory "$models"
        "${_r_args[@]}")
    # Absolute, since ComfyUI runs from its checkout; a preset entry's "~" is
    # not expanded by any shell on the way here.
    local out=""
    if [[ -n "$output_dir" ]]; then
        out="$(realpath -m "${output_dir/#\~/$HOME}")"
        cmd+=(--output-directory "$out")
    fi
    [[ "$verbose" == true ]] && cmd+=(--verbose DEBUG)

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    [[ "$ignore_memory" == true ]] || _memory_check_start "$slot" "${cmd[*]}" false
    if [[ ! -x "$app/.venv/bin/python" || ! -f "$app/main.py" ]]; then
        echo "Error: ComfyUI is not set up at $app — run: $PROG download $_r_name"
        exit 1
    fi
    # --models-directory insists on an existing directory, and ComfyUI lists
    # custom_nodes/ under --base-directory without creating it.
    mkdir -p "$models" "$base/custom_nodes" "$COMFYUI_TMP" ${out:+"$out"}
    _comfyui_links "$base" "$models"

    local url="http://${host:-127.0.0.1}:$port_server"
    [[ "$host" == "0.0.0.0" ]] && url="http://$(hostname):$port_server"
    local config_text
    config_text="$(
        echo "Model:    $_r_label"
        echo "Backend:  ComfyUI — $app"
        echo "Models:   $models"
        echo "Data:     $base/{user,input,temp}"
        echo "Output:   ${out:-$base/output (default; --output DIR elsewhere)}"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        [[ -n "$host" && "$host" != "127.0.0.1" && "$host" != "localhost" ]] && \
            echo "  WARNING: ComfyUI has no authentication — anyone who reaches $host:$port_server can run workflows."
        echo "UI:       $url"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${_r_rocm_env:+$_r_rocm_env }${cmd[*]}"
        echo "----------------------------"
    )"
    echo "$config_text"

    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting ComfyUI [slot $slot] on port $port_server..."
    # From the checkout, as its own launcher would; _r_rocm_env is unquoted on
    # purpose — it word-splits into KEY=VAL pairs for env, after (so over) ours.
    # ROCPROFILER_REGISTER_ENABLED=0 (#54): torch registers its profiler, which
    # takes 4096 interrupt signals at start and leaves KFD none for ROCr's own;
    # its AsyncEventsLoop then polls without an event and keeps a core at 100%
    # for as long as ComfyUI runs, idle or not (ROCm/TheRock#7051, ComfyUI#16339).
    # The soft limit of open files up to the hard one: ROCm holds a dmabuf file
    # descriptor for every block of GPU memory, and after a few models in one
    # session (Z-Image, klein, Qwen-Image, a detailer) ComfyUI ran into the
    # default 1024 — "HIP kernel launch failed: out of memory", then "Too many
    # open files" on every request, with 82 GiB free.
    local server_pid=""
    server_pid=$(cd "$app" && { ulimit -Sn "$(ulimit -Hn)" 2>/dev/null || true; } &&
        _spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append \
        env TMPDIR="$COMFYUI_TMP" PYTHONUNBUFFERED=1 ROCPROFILER_REGISTER_ENABLED=0 \
            LLMCTL_IMAGES_API="http://127.0.0.1:$(( PORT_BASE_PROXY + slot ))" $_r_rocm_env "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: ComfyUI did not report a PID. See $server_log" >&2
        exit 1
    fi
    echo "Server running (PID: $server_pid, detached) — up in ~10-20 s; models load per workflow."
    _watch_start "$server_pid" "$server_log" "$port_server" || { _stop_slot "$slot" > /dev/null 2>&1; exit 1; }
    if [[ "$start_proxy" == true ]]; then
        _start_images_server "$slot" "$host" || { _stop_slot "$slot" > /dev/null; exit 1; }
    fi
    if [[ "$tunnel" == true ]]; then
        _start_tunnel "$slot" || { _stop_slot "$slot" > /dev/null; exit 1; }
    fi
    echo ""
    echo "  UI:    $url"
    [[ "$start_proxy" == true ]] && \
        echo "  API:   http://${host:-127.0.0.1}:$port_proxy/v1/images/generations (and /edits, /v1/models)"
    echo "  Logs:  tail -f $server_log"
    echo "  Stop:  $PROG stop $slot"
}

# ── Commands ────────────────────────────────────────────────

cmd_list() {
    printf "\n\033[1mAvailable models:\033[0m\n\n"
    printf "  %-14s %-32s %-40s %s\n" "NAME" "LABEL" "BINARY" "ROCm ENV"
    printf "  %-14s %-32s %-40s %s\n" "----" "-----" "------" "---------"
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name m_binary m_model m_mmproj m_alias m_label m_args m_client m_rocm_env _ _ _ <<< "$entry"
        printf "  \033[36m%-14s\033[0m %-32s %-40s %s\n" "$m_name" "$m_label" "$m_binary" "${m_rocm_env:-—}"
    done
    # ComfyUI's models are whatever its workflows need, so they are listed per workflow.
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name _ <<< "$entry"
        _resolve_model "$m_name" && [[ "$_r_backend" == comfyui ]] || continue
        _comfyui_paths
        printf "\n  \033[36m%s\033[0m workflows (%s):\n" "$m_name" "$c_wf"
        if [[ ! -x "$c_app/.venv/bin/python" ]]; then
            echo "    not set up — $PROG download $m_name"
        else
            python3 "$COMFYUI_MODELS_SCRIPT" list "$c_wf" "$c_models"
        fi
    done
    echo ""
    echo "  $PROG start <name> [slot]     start server + proxy (slot N, default 1)"
    echo "  $PROG presets                 configurations that start several of them at once"
    echo "  eval \"\$($PROG env <name> [slot])\"  set Claude Code env vars in this shell"
    echo ""
}

# ── Reasoning ───────────────────────────────────────────────
#
# One switch for every model: --reasoning off|on|low|medium|high|max|N. What each
# model can actually do lives in models.conf (`reasoning`, `reasoning_levels`),
# because the mechanism is the chat template, not the server: --reasoning sets the
# template kwarg enable_thinking, --reasoning-effort sets the template variables
# reasoning_effort / reasoning_strength. A template that reads neither cannot be
# steered, and templates raise on level names they do not know — so a request the
# model cannot honour is refused here instead of failing per request later.
#
# Fills _reasoning_args (llama-server flags) and _reasoning_note (one line for the
# start output). Returns 1 with an explanation on stderr if the model cannot comply.
REASONING_LEVELS="low medium high max"

_translate_reasoning() {
    local spec="$1" mode="$2" level_map="$3"
    _reasoning_args=()
    _reasoning_note=""

    # A token budget is spelled as a number; 0 means off, -1 unrestricted.
    if [[ "$spec" =~ ^(-1|[0-9]+)$ ]]; then
        [[ "$spec" == "0" ]] && spec="off"
    elif [[ ! " off on $REASONING_LEVELS " == *" $spec "* ]]; then
        echo "Error: --reasoning takes off, on, a level ($REASONING_LEVELS), or a token budget (N, -1); got '$spec'" >&2
        return 1
    fi

    local is_level=false
    [[ " $REASONING_LEVELS " == *" $spec "* ]] && is_level=true

    case "$mode" in
        none)
            if [[ "$spec" == "off" ]]; then
                _reasoning_note="not applicable — this model has no thinking mode"
                return 0
            fi
            echo "Error: model '$_r_name' has no thinking mode (its chat template has no reasoning at all)" >&2
            return 1
            ;;
        locked-off)
            if [[ "$spec" == "off" ]]; then
                _reasoning_note="already off — the chat template locks thinking closed"
                return 0
            fi
            echo "Error: the chat template of '$_r_name' locks thinking closed, so '--reasoning $spec' cannot work." >&2
            echo "       Only a different template (--chat-template-file with the stock one) would restore it." >&2
            return 1
            ;;
        toggle)
            if [[ "$is_level" == true ]]; then
                echo "Error: model '$_r_name' supports on/off and a token budget, but no reasoning levels." >&2
                echo "       Use --reasoning on, off, or a token budget (e.g. --reasoning 2048)." >&2
                return 1
            fi
            ;;
        effort|unknown) ;;
        *)
            echo "Error: model '$_r_name' has an unknown reasoning mode '$mode' in models.conf" >&2
            return 1
            ;;
    esac

    if [[ "$spec" == "off" ]]; then
        # The model's own sampler tweaks for non-thinking mode come first, so an
        # explicit flag later in the command line still wins.
        [[ ${#_r_no_reasoning_args[@]} -gt 0 ]] && _reasoning_args+=("${_r_no_reasoning_args[@]}")
        _reasoning_args+=(--reasoning off --reasoning-budget 0)
        _reasoning_note="off (--reasoning off --reasoning-budget 0)"
        return 0
    fi

    if [[ "$spec" == "on" ]]; then
        _reasoning_args+=(--reasoning on)
        _reasoning_note="on, template default depth"
        return 0
    fi

    if [[ "$is_level" == true ]]; then
        local mapped=""
        if [[ "$mode" == "effort" ]]; then
            # "low=low medium=medium high=high max=xhigh" → the name this template takes
            local pair
            for pair in $level_map; do
                [[ "${pair%%=*}" == "$spec" ]] && mapped="${pair#*=}"
            done
            if [[ -z "$mapped" ]]; then
                echo "Error: model '$_r_name' does not map the level '$spec' (has: ${level_map:-none})" >&2
                return 1
            fi
        else
            mapped="$spec"   # unknown mode: pass the canonical name through
        fi
        _reasoning_args+=(--reasoning on --reasoning-effort "$mapped")
        _reasoning_note="level $spec (--reasoning-effort $mapped)"
        return 0
    fi

    # Remaining case: a token budget.
    _reasoning_args+=(--reasoning on --reasoning-budget "$spec")
    if [[ "$spec" == "-1" ]]; then
        _reasoning_note="on, unrestricted budget"
    else
        _reasoning_note="on, budget ${spec} tokens"
    fi
    return 0
}

# ── Token helpers (--tunnel) ────────────────────────────────

# Count real tokens in the token file (blank lines and # comments don't count).
_token_count() {
    # grep -c prints 0 *and* exits 1 when nothing matches, so capture first and
    # only then fall back — piping the failure into `echo 0` yields "0\n0".
    local n
    n=$(grep -cvE '^[[:space:]]*(#|$)' "$TOKEN_FILE" 2>/dev/null) || n=0
    echo "${n:-0}"
}

# The tokens a tunnelled LLM slot checks: there, private to the user, and at least one.
_check_token_file() {
    local ok=true
    if [[ ! -f "$TOKEN_FILE" ]]; then
        echo "Error: no token file at $TOKEN_FILE"
        echo "       Create one (0600, one token per line), e.g.:"
        echo "         mkdir -p $LLM_CONF_DIR && umask 077"
        echo "         openssl rand -hex 32 > $TOKEN_FILE"
        ok=false
    else
        local perms
        perms=$(stat -c %a "$TOKEN_FILE")
        if [[ ! "$perms" =~ ^[0-7]00$ ]]; then
            echo "Error: $TOKEN_FILE is mode $perms — must not be readable by group or others."
            echo "       chmod 600 $TOKEN_FILE"
            ok=false
        elif [[ "$(_token_count)" -eq 0 ]]; then
            echo "Error: $TOKEN_FILE contains no tokens (blank lines and # comments don't count)"
            ok=false
        fi
    fi
    [[ "$ok" == true ]]
}

# The image API in front of a ComfyUI slot, on the slot's proxy port. The pid
# and log files are the proxy's, so stop, status and preset treat it as one.
_start_images_server() {
    local slot="$1" host="$2"
    local port_server=$(( PORT_BASE_SERVER + slot ))
    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local log="$LOG_DIR/proxy-${slot}.log" pid="" i
    mkdir -p "$PID_DIR" "$LOG_DIR"
    echo "Starting the image API [slot $slot] on port $port_proxy..."
    pid=$(_spawn_detached "$PID_DIR/proxy-${slot}.pid" "$log" truncate \
        python3 -u "$IMAGES_SERVER_SCRIPT" --comfy "http://127.0.0.1:$port_server" \
            --public-comfy "http://${host:-127.0.0.1}:$port_server" \
            --api "$COMFYUI_SHARE/api" --host "${host:-127.0.0.1}" --port "$port_proxy" \
            ${vision:+--vision "$vision"} \
            ${vision_slot:+--vision-slot "$vision_slot" --vision-model "$VISION_MODEL" --llmctl "$(readlink -f "${BASH_SOURCE[0]}")"})
    [[ -n "$pid" ]] || { echo "Error: the image API did not report a PID. See $log"; return 1; }
    for (( i=0; i<10; i++ )); do
        sleep 1
        ps -p "$pid" > /dev/null 2>&1 || { echo "Error: the image API failed to start. See $log"; return 1; }
        if ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
            echo "Image API running (PID: $pid)"
            return 0
        fi
    done
    echo "Error: the image API did not listen on port $port_proxy within 10 s. See $log"
    return 1
}

# --vision VALUE for the image API of slot $2: sets vision (a URL) and, when it
# names a slot, vision_slot — in the caller's scope, for _start_images_server.
_resolve_vision() {
    local value="$1" own="$2"
    vision="$value"; vision_slot=""
    [[ -z "$value" ]] && return 0
    if [[ "$value" =~ ^[1-9][0-9]*$ ]]; then
        _check_slot "$value" || return 1
        [[ "$value" == "$own" ]] && { echo "Error: --vision names this very slot ($own)"; return 1; }
        vision_slot="$value"
        vision="http://127.0.0.1:$(( PORT_BASE_SERVER + value ))"
    elif [[ ! "$value" =~ ^https?:// ]]; then
        echo "Error: --vision takes a slot number or a URL; got '$value'"; return 1
    fi
}

# The --vision an image API runs with ("" for none), read from its argv.
_images_server_vision() {
    local pid
    pid=$(_slot_proxy_pid "$1") && _read_argv "$pid" || { echo ""; return; }
    local k
    for (( k=0; k < ${#_ARGV[@]}; k++ )); do
        [[ "${_ARGV[k]}" == --vision ]] && { echo "${_ARGV[k+1]}"; return; }
    done
    echo ""
}

_tunnel_up() {
    local pid=""
    [[ -f "$PID_DIR/tunnel-$1.pid" ]] && pid=$(cat "$PID_DIR/tunnel-$1.pid")
    [[ -n "$pid" ]] && ps -p "$pid" > /dev/null 2>&1
}

# The autossh pattern of one forwarded port: what pkill matches to find a tunnel
# left from an earlier start — autossh's ssh child carries it too, and that is
# what holds the port on the far side.
_tunnel_pattern() { echo "-R $(( $1 + TUNNEL_PORT_OFFSET )):127.0.0.1:$1"; }

# autossh for a slot. ComfyUI: its UI port, and the image API's when it runs.
# Any other slot: its proxy's port only, the proxy in token mode — the server's
# own port never leaves this machine.
# ExitOnForwardFailure makes a port still held on the far side (a session that
# died without the server noticing) an error rather than a tunnel without a
# forward; one more try after a pause, as that session times out.
_start_tunnel() {
    local slot="$1"
    local port_server=$(( PORT_BASE_SERVER + slot )) port_proxy=$(( PORT_BASE_PROXY + slot ))
    local log="$LOG_DIR/tunnel-${slot}.log" pid="" try p
    local -a fwd=()
    local ports=""
    if _slot_is_comfyui "$slot"; then
        fwd=(-R "$(( port_server + TUNNEL_PORT_OFFSET )):127.0.0.1:$port_server")
        ports=":$port_server → :$(( port_server + TUNNEL_PORT_OFFSET ))"
        if ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
            fwd+=(-R "$(( port_proxy + TUNNEL_PORT_OFFSET )):127.0.0.1:$port_proxy")
            ports+=", :$port_proxy → :$(( port_proxy + TUNNEL_PORT_OFFSET ))"
        fi
    else
        ss -tlnp 2>/dev/null | grep -q ":${port_proxy} " ||
            { echo "Error: slot $slot has no proxy on :$port_proxy to tunnel"; return 1; }
        fwd=(-R "$(( port_proxy + TUNNEL_PORT_OFFSET )):127.0.0.1:$port_proxy")
        ports=":$port_proxy → :$(( port_proxy + TUNNEL_PORT_OFFSET )) (proxy, token required)"
    fi
    _check_deps autossh || return 1
    # One login first, so a key the agent cannot sign with (locked after a
    # reboot, say) or a host that refuses is said here once — autossh would
    # retry it in a loop, and a server with fail2ban or sshguard then bans us.
    local why
    if ! why=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$TUNNEL_HOST" true 2>&1); then
        echo "Error: cannot log in to $TUNNEL_HOST — no tunnel started:"
        sed 's/^/  /' <<< "$why" | tail -n 3
        [[ "$why" == *agent* || "$why" == *"Permission denied"* ]] &&
            echo "  Is the SSH key unlocked? ssh-add, then start again."
        return 1
    fi
    for try in 1 2; do
        for p in $port_server $port_proxy; do pkill -f -- "$(_tunnel_pattern "$p")" 2>/dev/null; done
        sleep 1
        pid=$(_spawn_detached "$PID_DIR/tunnel-${slot}.pid" "$log" truncate \
            env AUTOSSH_GATETIME=0 autossh -N -M 0 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
                -o ExitOnForwardFailure=yes -o BatchMode=yes "${fwd[@]}" "$TUNNEL_HOST")
        sleep 3
        if [[ -n "$pid" ]] && ps -p "$pid" > /dev/null 2>&1; then
            echo "Tunnel running (PID: $pid) to $TUNNEL_HOST, forwarding $ports"
            return 0
        fi
        (( try == 1 )) && { echo "  tunnel did not hold — the far side may still have the port; again in 5 s"; sleep 5; }
    done
    echo "Error: the tunnel to $TUNNEL_HOST did not come up. See $log"
    return 1
}

_stop_tunnel() {
    local slot="$1" pid="" p
    [[ -f "$PID_DIR/tunnel-${slot}.pid" ]] && pid=$(cat "$PID_DIR/tunnel-${slot}.pid")
    rm -f "$PID_DIR/tunnel-${slot}.pid"
    [[ -n "$pid" ]] && ps -p "$pid" > /dev/null 2>&1 || return 1
    kill "$pid" 2>/dev/null
    for p in $(( PORT_BASE_SERVER + slot )) $(( PORT_BASE_PROXY + slot )); do
        pkill -f -- "$(_tunnel_pattern "$p")" 2>/dev/null
    done
    echo "Slot $slot: tunnel (PID: $pid) stopped."
}

# The proxy's extra environment for a halogen-server slot (one word per line):
# it has no Messages API, takes thinking off as reasoning_effort "none", and
# gets the request defaults its container carries. Nothing for halogen-flash.
_halogen_server_proxy_env() {
    local pid d
    pid=$(_slot_server_pid "$1") && _read_argv "$pid" && _is_halogen_argv || return 0
    [[ "$(_argv_halogen_flavor)" == server ]] || return 0
    echo "LLM_TRANSLATE_MESSAGES=1"
    echo "LLM_THINKING_OFF_EFFORT=none"
    d=$(_argv_label llmctl.defaults) && echo "LLM_REQUEST_DEFAULTS=$d"
    return 0
}

# Start proxy.py for one slot and wait until it listens. Its own function so
# `preset` can add a missing proxy to a slot whose model already matches —
# reloading 70B of weights for a process that starts in a second would be absurd.
_start_proxy() {
    local slot="$1" host="$2" token_mode="$3"   # token_mode: a tunnelled slot
    # A ComfyUI slot's proxy is the image API, not proxy.py.
    if _slot_is_comfyui "$slot"; then
        _start_images_server "$slot" "$host"
        return
    fi
    local port_server=$(( PORT_BASE_SERVER + slot ))
    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local proxy_log="$LOG_DIR/proxy-${slot}.log"
    mkdir -p "$PID_DIR" "$LOG_DIR"

    # A halogen slot passes its cap explicitly while its server is still being
    # created; otherwise it is read from the server that runs there.
    local halogen_cap="${4:-}"
    local -a backend_env=()
    if [[ -n "$halogen_cap" ]] || _slot_is_halogen "$slot"; then
        [[ -z "$halogen_cap" ]] && halogen_cap=$(_halogen_cap_of_slot "$slot")
        backend_env=(LLM_PROXY_TIMEOUT="$HALOGEN_PROXY_TIMEOUT"
                     LLM_MAX_TOKENS_CAP="$halogen_cap" LLM_INLINE_IMAGE_URLS=1)
        # halogen speaks the Messages API itself since 0.15.1; the proxy's own
        # translation stays for an older image, or to compare.
        [[ "${LLMCTL_HALOGEN_TRANSLATE:-0}" == 1 ]] && backend_env+=(LLM_TRANSLATE_MESSAGES=1)
        local -a server_env=()
        mapfile -t server_env < <(_halogen_server_proxy_env "$slot")
        backend_env+=("${server_env[@]}")
    elif [[ "${proxy_kind:-}" == gufo ]] || _slot_is_gufo "$slot"; then
        # gufo's own /v1/messages splits the thinking off and handles tools since
        # 0.10.0 (0.4.0 still handed it back inside the text, "</think>" and
        # all), but refuses images there and has no count_tokens: the proxy
        # translates just those to chat completions. LLMCTL_GUFO_TRANSLATE=1
        # translates everything, as before; LLMCTL_GUFO_NATIVE_MESSAGES=1 nothing.
        backend_env=(LLM_PROXY_TIMEOUT="$HALOGEN_PROXY_TIMEOUT" LLM_INLINE_IMAGE_URLS=1)
        if [[ "${LLMCTL_GUFO_TRANSLATE:-0}" == 1 ]]; then backend_env+=(LLM_TRANSLATE_MESSAGES=1)
        elif [[ "${LLMCTL_GUFO_NATIVE_MESSAGES:-0}" != 1 ]]; then backend_env+=(LLM_TRANSLATE_MESSAGES=images)
        fi
    else
        backend_env=(LLM_PROXY_TIMEOUT="$LLAMA_SERVER_TIMEOUT")
        # llama-server fetches image URLs itself, from any address — through a
        # tunnelled proxy that would let a token holder reach this machine and the
        # LAN. So the proxy fetches them first, public hosts only, and the
        # server only ever sees data: URLs. (The direct path is not covered.)
        [[ "$token_mode" == true ]] && backend_env+=(LLM_INLINE_IMAGE_URLS=1)
    fi

    echo "Starting proxy [slot $slot] on port $port_proxy..."
    # -u: unbuffered stdout/stderr so every log line lands in $proxy_log
    # immediately (and nothing is lost when the proxy is killed on stop).
    # LLM_TOKEN_FILE switches the proxy into hardened mode: token check,
    # path allowlist, concurrency and body-size caps. Unset = pass-through.
    # 127.0.0.1 rather than localhost: rootless podman publishes on IPv4 only,
    # and localhost may resolve to ::1 first.
    local proxy_pid=""
    proxy_pid=$(_spawn_detached "$PID_DIR/proxy-${slot}.pid" "$proxy_log" truncate \
        env LLM_BACKEND_URL="http://127.0.0.1:${port_server}" \
            LLM_PROXY_HOST="${host:-127.0.0.1}" \
            LLM_PROXY_PORT="${port_proxy}" \
            LLM_TOKEN_FILE="$([[ "$token_mode" == true ]] && echo "$TOKEN_FILE")" \
            "${backend_env[@]}" \
            python3 -u "$PROXY_SCRIPT")
    if [[ -z "$proxy_pid" ]]; then
        echo "Error: the proxy did not report a PID. See $proxy_log"
        return 1
    fi

    local max_wait=10 i
    for (( i=0; i<max_wait; i++ )); do
        sleep 1
        if ! ps -p "$proxy_pid" > /dev/null 2>&1; then
            echo "Error: Proxy failed to start. See $proxy_log"
            return 1
        fi
        if ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
            echo "Proxy running (PID: $proxy_pid)"
            return 0
        fi
    done
    echo "Error: Proxy did not listen on port $port_proxy within ${max_wait}s. See $proxy_log"
    return 1
}

# Stop only the proxy of a slot, leaving the loaded model alone.
_stop_proxy() {
    local slot="$1"
    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local proxy_pid=""
    [[ -f "$PID_DIR/proxy-${slot}.pid" ]] && proxy_pid=$(cat "$PID_DIR/proxy-${slot}.pid")
    if [[ -z "$proxy_pid" ]] || ! ps -p "$proxy_pid" > /dev/null 2>&1; then
        proxy_pid=$(_pid_on_port "$port_proxy")
    fi
    if [[ -n "$proxy_pid" ]] && ps -p "$proxy_pid" > /dev/null 2>&1; then
        kill "$proxy_pid" 2>/dev/null
        rm -f "$PID_DIR/proxy-${slot}.pid"
        echo "Slot $slot: proxy (PID: $proxy_pid) stopped."
        return 0
    fi
    return 1
}

# cmd_start for a halogen model. Runs inside cmd_start and reads its locals
# (bash scoping is dynamic): the options are parsed and checked there already.
_start_halogen() {
    local flavor; flavor=$(_halogen_flavor "$_r_binary")
    local -a refused=()
    if [[ "$flavor" == server ]]; then
        [[ -n "$cache_ram" && ! "$cache_ram" =~ ^[0-9]+$ ]] && refused+=("--cache-ram $cache_ram (MiB, 0 = prompt cache off)")
        [[ "$use_mmproj" == true ]] && refused+=("--mmproj (halogen-server is text only)")
        [[ "$reasoning" =~ ^[1-9][0-9]*$ ]] && refused+=("--reasoning $reasoning (no thinking budget; use a level or off)")
        [[ -n "$ctx" ]] && (( ctx > HALOGEN_NATIVE_CTX )) && refused+=("--ctx $ctx (at most $HALOGEN_NATIVE_CTX, no YaRN)")
    else
        [[ -n "$cache_ram" && "$cache_ram" != "0" ]] && refused+=("--cache-ram $cache_ram (only 0 = prompt cache off)")
    fi
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    [[ "$verbose" == true ]] && refused+=("--verbose")
    [[ "$spec" == "off" ]] && refused+=("--spec off (its MTP draft is byte-identical to plain decoding)")
    if (( ${#refused[@]} )); then
        echo "Error: not available with the halogen backend: ${refused[*]}"
        exit 1
    fi
    local lan=false
    [[ -n "$host" && "$host" != "127.0.0.1" && "$host" != "localhost" ]] && lan=true
    if [[ "$harden" == true && "$lan" == true ]]; then
        echo "Error: --tunnel with --host $host would publish halogen on the LAN without a token —"
        echo "       the server has no authentication of its own. Leave --host out: --tunnel"
        echo "       reaches it through the proxy, which checks the token."
        exit 1
    fi
    _check_deps podman python3 || exit 1

    local model_path="${_r_model//\~/$HOME}"
    local model_dir; model_dir="$(dirname "$model_path")"

    # The container's environment, in a fixed order so that the same options
    # always produce the same command — preset compares it word for word.
    local -a keys=()
    local -A val=()
    _henv() { [[ -v "val[$1]" ]] || keys+=("$1"); val[$1]="$2"; }

    _henv HALOGEN_CHECKPOINT "/models/$(basename "$model_path")"
    _henv HALOGEN_MODEL_ID "$_r_client"
    local kv
    for kv in "${_r_args[@]}"; do
        [[ "$kv" == HALOGEN_*=* ]] || { echo "Error: extra_args of '$_r_name' must be HALOGEN_*=VALUE pairs (got '$kv')"; exit 1; }
        _henv "${kv%%=*}" "${kv#*=}"
    done

    local ctx_n="${ctx:-${_r_ctx:-$HALOGEN_NATIVE_CTX}}"
    local yarn="" defaults=""
    if [[ "$flavor" == server ]]; then
        _henv HALOGEN_SLOT_CTX "$ctx_n"
        [[ -n "$parallel" ]] && _henv HALOGEN_KV_SLOTS "$parallel"
        [[ -n "$cache_ram" ]] && _henv HALOGEN_CACHE_MB "$cache_ram"
        # What the server has no setting for, the proxy puts into requests that
        # do not say otherwise — compact JSON, as it travels in a label.
        local -a d=()
        if [[ -n "$reasoning" ]]; then
            local r="$reasoning" pair mapped=""
            [[ "$r" == "0" ]] && r=off
            if [[ "$r" == off ]]; then
                d+=('"reasoning_effort":"none"')
            elif [[ " $REASONING_LEVELS " == *" $r "* ]]; then
                for pair in $_r_reasoning_levels; do [[ "${pair%%=*}" == "$r" ]] && mapped="${pair#*=}"; done
                d+=("\"reasoning_effort\":\"$mapped\"")
            fi
        fi
        [[ -n "$temp" ]]  && d+=("\"temperature\":$temp")
        [[ -n "$top_p" ]] && d+=("\"top_p\":$top_p")
        if (( ${#d[@]} )); then
            defaults=$(IFS=,; echo "{${d[*]}}")
        fi
    else
        _henv HALOGEN_CTX "$ctx_n"
        if (( ctx_n > HALOGEN_NATIVE_CTX )); then
            yarn=$(( (ctx_n + HALOGEN_NATIVE_CTX - 1) / HALOGEN_NATIVE_CTX ))
            _henv HALOGEN_ROPE_YARN "$yarn"
        fi
        # The pool holds every running conversation's KV; one request must fit.
        if [[ -z "${val[HALOGEN_KV_POOL_POSITIONS]:-}" ]] || (( val[HALOGEN_KV_POOL_POSITIONS] < ctx_n )); then
            _henv HALOGEN_KV_POOL_POSITIONS "$ctx_n"
        fi
        [[ -n "$parallel" ]] && _henv HALOGEN_KV_SLOTS "$parallel"

        if [[ -n "$reasoning" ]]; then
            local r="$reasoning"
            [[ "$r" == "0" ]] && r=off
            if [[ "$r" == off ]]; then
                _henv HALOGEN_ENABLE_THINKING 0
            elif [[ " $REASONING_LEVELS " == *" $r "* ]]; then
                local pair mapped=""
                for pair in $_r_reasoning_levels; do [[ "${pair%%=*}" == "$r" ]] && mapped="${pair#*=}"; done
                _henv HALOGEN_REASONING_EFFORT "$mapped"
            elif [[ "$r" =~ ^[1-9][0-9]*$ ]]; then
                _henv HALOGEN_MAX_THINKING_TOKENS "$r"
            fi
            # on and -1: the server's own default (thinking on, effort xhigh).
        fi
        [[ -n "$temp" ]]  && _henv HALOGEN_TEMPERATURE "$temp"
        [[ -n "$top_p" ]] && _henv HALOGEN_TOP_P "$top_p"
        [[ "$cache_ram" == "0" ]] && _henv HALOGEN_PROMPT_CACHE 0
    fi
    local cap="$HALOGEN_MAX_TOKENS_CAP"
    if [[ -n "$max_predict" && "$max_predict" != "-1" ]]; then
        cap="$max_predict"
        _henv HALOGEN_MAX_TOKENS_CAP "$cap"
    fi
    if [[ "$use_mmproj" == true ]]; then
        if [[ -z "$_r_mmproj" ]]; then
            echo "Error: --mmproj requested but model '$name' defines no mmproj"; exit 1
        fi
        # The engine looks for its vision tower beside the checkpoint.
        if [[ "$(dirname "${_r_mmproj//\~/$HOME}")" != "$model_dir" ]]; then
            echo "Error: halogen loads the vision file from beside the checkpoint; mmproj of '$name' is elsewhere"; exit 1
        fi
        _henv HALOGEN_VISION_TOWER 1
    fi

    local -a env_args=()
    local k
    for k in "${keys[@]}"; do env_args+=(-e "$k=${val[$k]}"); done

    local -a labels=(--label "llmctl.model=$model_path") mounts=(-v "$model_dir:/models:ro")
    [[ -n "$defaults" ]] && labels+=(--label "llmctl.defaults=$defaults")
    [[ "$flavor" == server ]] && mounts+=(-v "$model_dir/tokenizer:/tokenizer:ro")
    local -a cmd=(podman run --rm --name "$(_halogen_container "$slot")"
        "${labels[@]}"
        -p "${host:-127.0.0.1}:${port_server}:${HALOGEN_API_PORT}"
        --device /dev/kfd --device /dev/dri --group-add keep-groups
        --ipc=host --ulimit memlock=-1:-1
        "${env_args[@]}"
        "${mounts[@]}"
        "$_r_binary")

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    # ── It holds most of the machine: it has to fit beside what runs ──
    [[ "$ignore_memory" == true ]] || _memory_check_start "$slot" "${cmd[*]}" true
    local container; container=$(_halogen_container "$slot")
    if podman container exists "$container" 2>/dev/null; then
        # Left behind by a podman client that died without cleaning up; the port
        # check above already proved nothing is serving from it.
        podman rm -f "$container" > /dev/null 2>&1
    fi
    if [[ ! -f "$model_path" ]]; then
        echo "Error: checkpoint not found: $model_path — run: $PROG download $_r_name"; exit 1
    fi
    if [[ "$flavor" == server && ! -f "$model_dir/tokenizer/tokenizer.json" ]]; then
        echo "Error: no tokenizer beside the checkpoint ($model_dir/tokenizer) — run: $PROG download $_r_name"; exit 1
    fi

    [[ "$compact" == true ]] && { _compact_memory || exit 1; }
    local contig; contig=$(_contig_gib)
    if [[ "$flavor" == flash ]] && (( contig < HALOGEN_MIN_CONTIG_GIB )); then
        echo "Note: only $contig GiB of host memory are free in 2 MiB blocks (want >= $HALOGEN_MIN_CONTIG_GIB)."
        if [[ "$compact" == true ]]; then
            echo "      Stop other large programs (a VM, ComfyUI, …) or reboot, or prefill may stall for minutes."
        else
            echo "      Prefill may stall for minutes; consider: $PROG start $name $slot --compact"
        fi
    fi

    _render_halogen_config() {
        echo "Model:    $_r_label ($_r_client)"
        echo "Backend:  halogen — $_r_binary (podman, container $container)"
        echo "Checkpoint: $model_path"
        if [[ "$use_mmproj" == true ]]; then
            echo "Vision:   on (--mmproj)"
        elif [[ -n "$_r_mmproj" ]]; then
            echo "Vision:   available but not loaded (pass --mmproj)"
        fi
        echo "Host:     ${host:-127.0.0.1 (default)}"
        [[ "$lan" == true ]] && echo "  WARNING: published beyond localhost ($host) without authentication — trusted networks only."
        if [[ "$tunnel" == true ]]; then
            echo "Tunnel:   to $TUNNEL_HOST, the proxy's port :$port_proxy only (--tunnel)"
            echo "  Tokens:  $(_token_count) from $TOKEN_FILE; token budgets capped at $cap"
        fi
        echo "Proxy:    always on :$port_proxy — translates /v1/messages (Claude Code), normalizes time stamps,"
        echo "          clamps token budgets to $cap, fetches http(s) image URLs and passes them inline"
        if [[ "$flavor" == server ]]; then
            _render_halogen_server_config
        else
            echo "Context:  $ctx_n${yarn:+ (YaRN x$yarn over the native $HALOGEN_NATIVE_CTX)}"
            echo "Parallel: ${val[HALOGEN_KV_SLOTS]:-4 (server default)} over a pool of ${val[HALOGEN_KV_POOL_POSITIONS]} positions"
            case "${val[HALOGEN_PROMPT_CACHE]:-}" in
                0) echo "PromptCache: off (--cache-ram 0)" ;;
                *) echo "PromptCache: on (server default)" ;;
            esac
            if [[ -n "$reasoning" ]]; then
                echo "Reasoning: $reasoning — ${val[HALOGEN_ENABLE_THINKING]:+thinking off by default}${val[HALOGEN_REASONING_EFFORT]:+default effort ${val[HALOGEN_REASONING_EFFORT]}}${val[HALOGEN_MAX_THINKING_TOKENS]:+thinking budget ${val[HALOGEN_MAX_THINKING_TOKENS]} tokens}"
            else
                echo "Reasoning: server default (thinking on, effort xhigh; requests may override)"
            fi
            echo "Speculative: on (MTP head, byte-identical to plain decoding)"
            [[ -n "$temp$top_p" ]] && echo "Samplers: ${temp:+temp $temp}${temp:+${top_p:+, }}${top_p:+top-p $top_p} (server defaults; requests may override)"
        fi
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "----------------------------"
    }
    _render_halogen_server_config() {
        local slots="${val[HALOGEN_KV_SLOTS]:-1}" drafter="${val[HALOGEN_DRAFTER]:-2}"
        echo "Context:  $ctx_n per slot"
        if (( slots > 1 )); then
            echo "Parallel: $slots slots — speculation off, each stream at serial speed"
        else
            echo "Parallel: 1 slot (with speculative decoding)"
        fi
        case "${val[HALOGEN_CACHE_MB]:-}" in
            "") echo "PromptCache: on, sized by the server from free memory" ;;
            0)  echo "PromptCache: off (--cache-ram 0)" ;;
            *)  echo "PromptCache: ${val[HALOGEN_CACHE_MB]} MiB of host memory (~70 KB per cached token)" ;;
        esac
        if [[ -n "$defaults" ]]; then
            echo "Reasoning: request defaults $defaults (the proxy fills them in; requests may override)"
        else
            echo "Reasoning: template default (effort xhigh; requests may override)"
        fi
        local -a dn=(serial MTP DFlash2)
        echo "Speculative: ${dn[drafter]:-drafter $drafter} by default, byte-identical to plain decoding; requests may pick another"
    }
    local config_text; config_text="$(_render_halogen_config)"
    echo "$config_text"

    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting halogen [slot $slot] on port $port_server..."
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: podman did not report a PID. See $server_log" >&2
        exit 1
    fi
    echo "Server running (PID: $server_pid, detached) — loading takes ~15-30 s with the"
    echo "weights in the file cache, a few minutes from disk."
    _watch_start "$server_pid" "$server_log" "$port_server" || { _stop_slot "$slot" > /dev/null 2>&1; exit 1; }

    _start_proxy "$slot" "$host" "$harden" "$cap" || { _stop_slot "$slot" > /dev/null; exit 1; }

    echo ""
    echo "  Logs:  tail -f $server_log"
    echo "         tail -f $proxy_log"
    echo "  Env:   $PROG env $_r_name $slot"
    echo "  Stop:  $PROG stop $slot"
}

_start_gufo() {
    local -a refused=()
    [[ -n "$cache_ram" ]] && refused+=("--cache-ram")
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    if (( ${#refused[@]} )); then
        echo "Error: not available with the gufo backend: ${refused[*]}"
        exit 1
    fi
    local lan=false
    [[ -n "$host" && "$host" != "127.0.0.1" && "$host" != "localhost" ]] && lan=true
    _check_deps podman || exit 1

    local model_path="${_r_model//\~/$HOME}"
    local model_dir; model_dir="$(dirname "$model_path")"
    local ctx_n="${ctx:-${_r_ctx:-0}}" sessions="${parallel:-$GUFO_SESSIONS_DEFAULT}"

    # gufo serve llm's flags, in a fixed order: preset compares the command word
    # for word.
    local -a serve=(gufo serve --host 0.0.0.0 --port "$GUFO_API_PORT" llm
        --model "/models/$(basename "$model_path")" --served-model-name "$_r_client"
        --context "$ctx_n" --sessions "$sessions")
    # The entry's flags, less those a start option overrides: gufo refuses a flag
    # given twice.
    local -a own=("${_r_args[@]}") drop=()
    [[ -n "$temp" ]] && drop+=(--temperature)
    [[ -n "$top_p" ]] && drop+=(--top-p)
    [[ -n "$max_predict" ]] && drop+=(--max-tokens)
    local j
    for (( j=0; j < ${#own[@]}; j++ )); do
        if [[ " ${drop[*]} " == *" ${own[j]} "* ]]; then j=$(( j + 1 )); continue; fi
        serve+=("${own[j]}")
    done

    # Speculation: the entry's spec_args, the draft's host path mounted as /draft.
    local draft_mount="" spec_note="off"
    if [[ "$spec" != off && ${#_r_spec_args[@]} -gt 0 ]]; then
        local w prev_w=""
        for w in "${_r_spec_args[@]}"; do
            w="${w//\~/$HOME}"
            case "$prev_w" in
                --dflash-model|--mtp-model)
                    [[ -f "$w" ]] || { echo "Error: draft not found: $w — run: $PROG download $_r_name"; exit 1; }
                    draft_mount="$(dirname "$w")"; w="/draft/$(basename "$w")" ;;
            esac
            serve+=("$w")
            prev_w="$w"
        done
        spec_note="${_r_spec_args[*]}"
    fi

    if [[ -n "$reasoning" ]]; then
        local r="$reasoning"
        [[ "$r" == "0" ]] && r=off
        case "$r" in
            off) serve+=(--think off) ;;
            on|-1) serve+=(--think on) ;;
            *)  if [[ " $REASONING_LEVELS " == *" $r "* ]]; then
                    local pair mapped="$r"
                    for pair in $_r_reasoning_levels; do [[ "${pair%%=*}" == "$r" ]] && mapped="${pair#*=}"; done
                    serve+=(--think on --reasoning-effort "$mapped")
                else
                    echo "Error: gufo takes --reasoning off, on or a level ($REASONING_LEVELS), not a token budget"; exit 1
                fi ;;
        esac
    fi
    [[ -n "$temp" ]]  && serve+=(--temperature "$temp")
    [[ -n "$top_p" ]] && serve+=(--top-p "$top_p")
    [[ -n "$max_predict" && "$max_predict" != "-1" ]] && serve+=(--max-tokens "$max_predict")
    [[ "$verbose" == true ]] && serve+=(--log-level debug)
    if [[ "$use_mmproj" == true ]]; then
        [[ -n "$_r_mmproj" ]] || { echo "Error: --mmproj requested but model '$name' defines no mmproj"; exit 1; }
        [[ "$(dirname "${_r_mmproj//\~/$HOME}")" == "$model_dir" ]] ||
            { echo "Error: gufo finds the vision file beside the model; mmproj of '$name' is elsewhere"; exit 1; }
        serve+=(--mmproj "/models/$(basename "${_r_mmproj//\~/$HOME}")")
    fi

    local -a cmd=(podman run --rm --name "$(_gufo_container "$slot")"
        --label "llmctl.model=$model_path"
        -p "${host:-127.0.0.1}:${port_server}:${GUFO_API_PORT}"
        --security-opt label=disable
        --device /dev/kfd --device /dev/dri --group-add keep-groups
        --ulimit memlock=-1:-1
        -v "$model_dir:/models:ro")
    [[ -n "$draft_mount" ]] && cmd+=(-v "$draft_mount:/draft:ro")
    cmd+=("$_r_binary" "${serve[@]}")

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    [[ "$ignore_memory" == true ]] || _memory_check_start "$slot" "${cmd[*]}" true
    local container; container=$(_gufo_container "$slot")
    podman container exists "$container" 2>/dev/null && podman rm -f "$container" > /dev/null 2>&1
    [[ -f "$model_path" ]] || { echo "Error: model not found: $model_path — run: $PROG download $_r_name"; exit 1; }
    [[ "$compact" == true ]] && { _compact_memory || exit 1; }

    local config_text
    config_text="$(
        echo "Model:    $_r_label ($_r_client)"
        echo "Backend:  gufo — $_r_binary (podman, container $container)"
        echo "Weights:  $model_path"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        [[ "$lan" == true ]] && echo "  WARNING: published beyond localhost ($host) without authentication — trusted networks only."
        echo "Context:  ${ctx_n/#0/native} per session, $sessions session(s) — KV reserved at start"
        echo "Speculative: $spec_note"
        if [[ "$use_mmproj" == true ]]; then echo "Vision:   on (--mmproj; gufo uploads it at the first image)"
        elif [[ -n "$_r_mmproj" ]]; then echo "Vision:   available but not loaded (pass --mmproj)"; fi
        [[ -n "$reasoning" ]] && echo "Reasoning: $reasoning"
        echo "Proxy:    always on :$port_proxy — passes /v1/messages (Claude Code) to gufo, translates only"
        echo "          requests with images and count_tokens; normalizes time stamps, inlines image URLs"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "----------------------------"
    )"
    echo "$config_text"
    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting gufo [slot $slot] on port $port_server..."
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append "${cmd[@]}")
    [[ -n "$server_pid" ]] || { echo "Error: podman did not report a PID. See $server_log" >&2; exit 1; }
    echo "Server running (PID: $server_pid, detached) — gufo loads a 30 GB model in a few seconds"
    echo "from the file cache, longer from disk."
    _watch_start "$server_pid" "$server_log" "$port_server" || { _stop_slot "$slot" > /dev/null 2>&1; exit 1; }
    local proxy_kind=gufo
    _start_proxy "$slot" "$host" "$harden" || { _stop_slot "$slot" > /dev/null; exit 1; }
    echo ""
    echo "  Logs:  tail -f $server_log"
    echo "         tail -f $proxy_log"
    echo "  Env:   $PROG env $_r_name $slot"
    echo "  Stop:  $PROG stop $slot"
}

# _describe_server for a gufo server, from its command line in $_ARGV.
_describe_gufo() {
    local pid="$1" indent="$2" model label host="" i
    model=$(_argv_halogen_model) || model=""
    label=$(_label_for_model_path "$model") || label="$(basename "${model:-unknown}")"
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "-p" ]] && host="${_ARGV[i+1]%%:*}"
    done
    echo "${indent}Model:     $label ($(_argv_flag --served-model-name || echo "?"))"
    local -a params=("ctx $(_argv_flag --context || echo native) per session" "sessions $(_argv_flag --sessions || echo 1)")
    local v
    v=$(_argv_flag --max-tokens) && params+=("token cap $v")
    _argv_flag --mmproj > /dev/null && params+=("vision")
    [[ -n "$host" && "$host" != "127.0.0.1" ]] && params+=("host $host")
    local joined="" p
    for p in "${params[@]}"; do joined+="${joined:+, }$p"; done
    echo "${indent}Params:    $joined"
    if v=$(_argv_flag --think); then
        echo "${indent}Reasoning: $v$(_argv_flag --reasoning-effort > /dev/null && echo ", effort $(_argv_flag --reasoning-effort)")"
    else
        echo "${indent}Reasoning: model default"
    fi
    echo "${indent}Spec:      $(_argv_flag --speculative || echo off)"
    awk -v g="$(_slot_gtt_mib "$slot" 2>/dev/null || echo 0)" -v r="$(_gufo_rss_mib "$slot")" -v i="$indent" 'BEGIN {
        printf "%sMemory:    weights %.1f GiB in RAM, KV and working memory %.1f GiB GTT\n", i, r / 1024, g / 1024 }'
}

# _capture_slot for a gufo server: its flags read back into start options.
_capture_gufo_slot() {
    local slot="$1" model
    model=$(_argv_halogen_model) || { echo "slot $slot: the container carries no llmctl.model label" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    (( ${#candidates[@]} )) || { echo "slot $slot: $(basename "$model") is not in models.conf — add it there first" >&2; return 1; }
    local host="" i
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "-p" ]] && host="${_ARGV[i+1]%%:*}"
    done
    [[ "$host" == "127.0.0.1" ]] && host=""
    local ctx_v sess think effort temp top_p cap
    ctx_v=$(_argv_flag --context); sess=$(_argv_flag --sessions)
    think=$(_argv_flag --think); effort=$(_argv_flag --reasoning-effort)
    temp=$(_argv_flag --temperature); top_p=$(_argv_flag --top-p); cap=$(_argv_flag --max-tokens)
    local name
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local -a flags=()
        [[ -n "$ctx_v" && "$ctx_v" != "${_r_ctx:-0}" ]] && flags+=(--ctx "$ctx_v")
        [[ -n "$sess" && "$sess" != "$GUFO_SESSIONS_DEFAULT" ]] && flags+=(--parallel "$sess")
        if [[ "$think" == off ]]; then flags+=(--reasoning off)
        elif [[ -n "$effort" ]]; then
            local level=""; level=$(_level_for_effort "$effort" "$_r_reasoning_levels") || level="$effort"
            flags+=(--reasoning "$level")
        elif [[ "$think" == on ]]; then flags+=(--reasoning on); fi
        _argv_flag --speculative > /dev/null || { (( ${#_r_spec_args[@]} )) && flags+=(--spec off); }
        _argv_flag --mmproj > /dev/null && flags+=(--mmproj)
        [[ -n "$host" ]] && flags+=(--host "$host")
        # Values the entry's own flags give are no start options; only a change is.
        local own_t="" own_p="" own_c="" k
        for (( k=0; k < ${#_r_args[@]} - 1; k++ )); do
            case "${_r_args[k]}" in
                --temperature) own_t="${_r_args[k+1]}" ;;
                --top-p) own_p="${_r_args[k+1]}" ;;
                --max-tokens) own_c="${_r_args[k+1]}" ;;
            esac
        done
        [[ -n "$temp" && "$temp" != "$own_t" ]] && flags+=(--temp "$temp")
        [[ -n "$top_p" && "$top_p" != "$own_p" ]] && flags+=(--top-p "$top_p")
        if _tunnel_up "$slot"; then
            flags+=(--tunnel)
            [[ "$cap" == "$TUNNEL_MAX_PREDICT_DEFAULT" ]] && cap="$own_c"   # --tunnel's own cap
        fi
        [[ -n "$cap" && "$cap" != "$own_c" ]] && flags+=(--max-predict "$cap")
        _argv_flag --log-level > /dev/null && flags+=(--verbose)
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot ${flags[*]}"
            _cap_label="$_r_label"
            return 0
        fi
        _cap_diff_name="$name"; _cap_diff_built="$built"
    done
    echo "slot $slot: cannot express the running gufo server as start options." >&2
    [[ -n "${_cap_diff_built:-}" ]] && printf '  closest is %s:\n    %s\n  while the process runs:\n    %s\n' \
        "'$_cap_diff_name'" "$_cap_diff_built" "${_ARGV[*]}" >&2
    return 1
}

cmd_start() {
    local name=""
    local slot="1"
    local reasoning=""          # "" = model/template default; off|on|<level>|N (see _translate_reasoning)
    local parallel=""
    local ctx=""                # "" = model default; N>0 = override context size
    local cache_ram=""          # "" = server default (8192 MiB); 0 = disable prompt cache; -1 = no limit; N>0 = MiB cap
    local similarity=""         # "" = server default (0.1); 0 = pure LRU slot pick; F in 0..1 = prefix share a slot must already hold
    local verbose=false         # true = -lv 4 (TRACE): reveals ggml/backend + buffer-size startup logs
    local clear_logs=false      # true = truncate this slot's server/proxy logs before starting
    local host=""               # "" = llama-server default (127.0.0.1); e.g. 0.0.0.0 to expose on LAN
    local gpu_priority=""       # "" = driver default; low|medium|high|realtime (needs patched ggml-vulkan)
    local use_mmproj=false      # true = load the model's mmproj (multimodal projector), if defined
    local start_proxy=false     # true = also start proxy.py (timestamp normalization for prompt caching)
    local max_predict=""        # "" = model/server default; N = cap tokens per generation
    local spec=""               # "" = on when the model declares spec_args; on|off forces it
    # Samplers otherwise live in models.conf, per model. These two override them
    # for one run, which is what a task-specific preset needs: the same model at
    # temp 0.1 for code and at its own 0.6 for prose.
    local temp=""
    local top_p=""
    # --print-cmd builds and validates everything, prints the llama-server command
    # and starts nothing. `preset` uses it to compare a slot's target state against
    # the argv of what is actually running there.
    local print_cmd=false
    local compact=false         # true = defragment host memory first (sudo)
    local output_dir=""         # comfyui: where generated images go (default <base>/output)
    local lang=""               # tts: default language of the speech slot (ISO 639-1)
    local seed=""               # tts: sampling seed when a request names none (-1 = random)
    local ignore_memory=false   # skip the memory check beside halogen (preset checks the set itself)
    local vision=""             # comfyui: slot or URL of a vision model for the image API's /check
    local vision_slot=""        # … its slot, when given as one: /repair starts and stops it there
    local tunnel=false          # comfyui: reverse tunnel to $TUNNEL_HOST (see deploy/vps-comfy-vhost.conf)

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --proxy) start_proxy=true; shift ;;
            --compact) compact=true; shift ;;
            --public) echo "Error: --public is gone (llmctl 1.62): --tunnel is the way out"; exit 1 ;;
            --max-predict) _need_value "$@" || exit 1; max_predict="$2"; shift 2 ;;
            --reasoning) _need_value "$@" || exit 1; reasoning="$2"; shift 2 ;;
            --reasoning-budget) _need_value "$@" || exit 1; reasoning="$2"; shift 2 ;;   # alias: a budget is a valid --reasoning spec
            --no-reasoning) reasoning=off; shift ;;          # alias for --reasoning off
            --parallel) _need_value "$@" || exit 1; parallel="$2"; shift 2 ;;
            --ctx) _need_value "$@" || exit 1; ctx="$2"; shift 2 ;;
            --cache-ram) _need_value "$@" || exit 1; cache_ram="$2"; shift 2 ;;
            --similarity) _need_value "$@" || exit 1; similarity="$2"; shift 2 ;;
            --verbose) verbose=true; shift ;;
            --clear-logs) clear_logs=true; shift ;;
            --host) _need_value "$@" || exit 1; host="$2"; shift 2 ;;
            --gpu-priority) _need_value "$@" || exit 1; gpu_priority="$2"; shift 2 ;;
            --mmproj) use_mmproj=true; shift ;;
            --spec) _need_value "$@" || exit 1; spec="$2"; shift 2 ;;
            --temp) _need_value "$@" || exit 1; temp="$2"; shift 2 ;;
            --top-p) _need_value "$@" || exit 1; top_p="$2"; shift 2 ;;
            --no-spec) spec=off; shift ;;                     # alias for --spec off
            --print-cmd) print_cmd=true; shift ;;
            --output) _need_value "$@" || exit 1; output_dir="$2"; shift 2 ;;
            --lang) _need_value "$@" || exit 1; lang="$2"; shift 2 ;;
            --seed) _need_value "$@" || exit 1; seed="$2"; shift 2 ;;
            --ignore-memory) ignore_memory=true; shift ;;
            --vision) _need_value "$@" || exit 1; vision="$2"; shift 2 ;;
            --tunnel) tunnel=true; shift ;;
            -*) echo "Unknown option: $1"; exit 1 ;;
            *) if [[ -z "$name" ]]; then name="$1"; elif [[ "$slot" == "1" ]]; then slot="$1"; fi; shift ;;
        esac
    done

    [[ -z "$name" ]] && { echo "Usage: $PROG start <model-name> [slot] [--proxy] [--tunnel] [--max-predict N] [--reasoning off|on|low|medium|high|max|N] [--no-reasoning] [--reasoning-budget N] [--parallel N] [--ctx N] [--cache-ram N] [--similarity F] [--verbose] [--clear-logs] [--host ADDR] [--gpu-priority low|medium|high|realtime] [--mmproj] [--spec on|off] [--no-spec]"; exit 1; }
    _check_slot "$slot" || exit 1
    if [[ -n "$parallel" && ! "$parallel" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --parallel requires a positive integer (got '$parallel')"; exit 1
    fi
    if [[ -n "$ctx" && ! "$ctx" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --ctx requires a positive integer (got '$ctx')"; exit 1
    fi
    if [[ -n "$cache_ram" && ! "$cache_ram" =~ ^(-1|0|[1-9][0-9]*)$ ]]; then
        echo "Error: --cache-ram requires -1 (no limit), 0 (disable prompt cache), or N>0 (MiB cap); got '$cache_ram'"; exit 1
    fi
    if [[ -n "$similarity" && ! "$similarity" =~ ^(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)$ ]]; then
        echo "Error: --similarity requires a fraction from 0 to 1 (0 = pure LRU); got '$similarity'"; exit 1
    fi
    if [[ -n "$gpu_priority" && ! "$gpu_priority" =~ ^(low|medium|high|realtime)$ ]]; then
        echo "Error: --gpu-priority requires low, medium, high, or realtime; got '$gpu_priority'"; exit 1
    fi
    if [[ -n "$max_predict" && ! "$max_predict" =~ ^(-1|[1-9][0-9]*)$ ]]; then
        echo "Error: --max-predict requires -1 (no limit) or N>0 (token cap); got '$max_predict'"; exit 1
    fi
    if [[ -n "$temp" && ! "$temp" =~ ^([0-1](\.[0-9]+)?|2(\.0+)?|\.[0-9]+)$ ]]; then
        echo "Error: --temp requires a number from 0 to 2 (0 = greedy); got '$temp'"; exit 1
    fi
    if [[ -n "$top_p" && ! "$top_p" =~ ^(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)$ ]]; then
        echo "Error: --top-p requires a fraction from 0 to 1; got '$top_p'"; exit 1
    fi

    local port_server=$(( PORT_BASE_SERVER + slot ))
    local port_proxy=$(( PORT_BASE_PROXY + slot ))

    _resolve_model "$name" || { echo "Unknown model: $name"; cmd_list; exit 1; }
    # Hardened: the proxy checks tokens and the server shows no more than it must —
    # --tunnel for every slot but ComfyUI (whose server sits behind Basic Auth on
    # the far side). A cap, too: without one a request could generate until --timeout.
    local harden=false
    if [[ "$tunnel" == true && "$_r_backend" != comfyui ]]; then
        harden=true
        _check_token_file || exit 1
        case "$_r_backend" in
            llama|halogen|gufo) [[ -z "$max_predict" ]] && max_predict="$TUNNEL_MAX_PREDICT_DEFAULT" ;;
        esac
    fi
    if [[ "$tunnel" == true ]]; then
        if [[ -z "$TUNNEL_HOST" ]]; then
            echo "Error: --tunnel needs the server to tunnel to: LLMCTL_TUNNEL_HOST, or"
            echo "       echo user@host > $CONFIG_DIR/tunnel-host"
            exit 1
        fi
    fi
    if [[ -n "$vision" ]]; then
        [[ "$_r_backend" == comfyui && "$start_proxy" == true ]] || \
            { echo "Error: --vision is for the image API: a comfyui model started with --proxy"; exit 1; }
        _resolve_vision "$vision" "$slot" || exit 1
    fi
    case "$_r_backend" in
        llama) [[ "$tunnel" == true ]] && start_proxy=true ;;   # the tunnel reaches the proxy only
        # Their proxy is what speaks the Messages API, so it always runs.
        halogen|gufo) start_proxy=true ;;
        comfyui|tts|audiocpp) ;;
        *) echo "Error: model '$name' names an unknown backend '$_r_backend' in models.conf (llama, halogen, gufo, comfyui, tts or audiocpp)"; exit 1 ;;
    esac
    if [[ -n "$output_dir" && "$_r_backend" != comfyui ]]; then
        echo "Error: --output is for comfyui models — '$name' generates no images"; exit 1
    fi
    if [[ -n "$lang$seed" && "$_r_backend" != tts ]]; then
        echo "Error: --lang and --seed are for speech (tts) models; '$name' is not one"; exit 1
    fi
    if [[ -n "$seed" && ! "$seed" =~ ^(-1|[0-9]+)$ ]]; then
        echo "Error: --seed takes a number, or -1 for a random one each time (got '$seed')"; exit 1
    fi
    [[ "$start_proxy" == true ]] && { _check_deps python3 || exit 1; }
    if [[ "$print_cmd" != true && "$_r_backend" == llama ]]; then
        [[ "$compact" == true ]] && { _compact_memory || exit 1; }
    fi

    # Needs the resolved model, since what --reasoning can mean depends on it.
    _reasoning_args=(); _reasoning_note=""
    if [[ -n "$reasoning" && "$_r_backend" != comfyui && "$_r_backend" != tts ]]; then
        _translate_reasoning "$reasoning" "$_r_reasoning" "$_r_reasoning_levels" || exit 1
    fi

    # Guard: abort if ports are already in use. Skipped for --print-cmd, which
    # describes a slot rather than claiming it — usually one that is running.
    if [[ "$print_cmd" != true ]]; then
        if ss -tlnp 2>/dev/null | grep -q ":${port_server} "; then
            echo "Error: Port $port_server already in use. Is slot $slot already running?"
            exit 1
        fi
        if [[ "$start_proxy" == true ]] && ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
            echo "Error: Port $port_proxy already in use. Is a proxy for slot $slot already running?"
            exit 1
        fi

        mkdir -p "$PID_DIR" "$LOG_DIR" "$SLOT_STATE_DIR"
        # Whatever preset once owned this slot does not own what starts here now;
        # `preset` writes the marker back after this call returns.
        rm -f "$PID_DIR/preset-${slot}"

        # ComfyUI keeps its models until something inside it needs the room; it
        # cannot see this model coming. (halogen needs no such step: it refuses
        # to start beside ComfyUI at all.)
        [[ "$_r_backend" == llama ]] && _comfyui_unload
    fi

    local proxy_log="$LOG_DIR/proxy-${slot}.log"
    local server_log="$LOG_DIR/server-${slot}.log"

    # --clear-logs: start this slot's logs fresh (e.g. for a clean cache-stats run)
    if [[ "$clear_logs" == true && "$print_cmd" != true ]]; then
        : > "$server_log"
        : > "$proxy_log"
        echo "Cleared logs for slot $slot"
    fi

    # --tunnel for an LLM slot, once its server (and proxy) run: speech and audio.cpp
    # get a proxy in token mode first, as they run without one otherwise.
    _tunnel_llm_slot() {
        [[ "$tunnel" == true && "$print_cmd" != true ]] || return 0
        if [[ "$_r_backend" == tts || "$_r_backend" == audiocpp ]]; then
            _start_proxy "$slot" "$host" true || { _stop_slot "$slot" > /dev/null; exit 1; }
        fi
        _start_tunnel "$slot" || { _stop_slot "$slot" > /dev/null; exit 1; }
        echo "  From outside: the server's /s$slot/ path (deploy/vps-llm-tunnel-vhost.conf), with a token from $TOKEN_FILE"
    }

    if [[ "$_r_backend" == halogen ]]; then
        _start_halogen
        _tunnel_llm_slot
        return
    fi
    if [[ "$_r_backend" == gufo ]]; then
        _start_gufo
        _tunnel_llm_slot
        return
    fi
    if [[ "$_r_backend" == comfyui ]]; then
        _start_comfyui
        return
    fi
    if [[ "$_r_backend" == tts ]]; then
        _start_tts
        _tunnel_llm_slot
        return
    fi
    if [[ "$_r_backend" == audiocpp ]]; then
        _start_audiocpp
        _tunnel_llm_slot
        return
    fi

    # Expand tilde in model paths
    local model_path="${_r_model//\~/$HOME}"
    # mmproj (multimodal projector) is only loaded on explicit --mmproj request.
    local mmproj_path=""
    if [[ "$use_mmproj" == true ]]; then
        if [[ -n "$_r_mmproj" ]]; then
            mmproj_path="${_r_mmproj//\~/$HOME}"
        else
            echo "Error: --mmproj requested but model '$name' defines no mmproj"; exit 1
        fi
    fi

    if [[ -n "$spec" && "$spec" != "on" && "$spec" != "off" ]]; then
        echo "Error: --spec takes on or off; got '$spec'" >&2
        exit 1
    fi
    if [[ "$spec" == "on" && ${#_r_spec_args[@]} -eq 0 ]]; then
        echo "Error: model '$_r_name' declares no speculative decoding in models.conf." >&2
        echo "       It needs a draft head in its own GGUF to speculate without a second model." >&2
        exit 1
    fi

    # Build llama-server command
    local -a cmd=("${_r_binary}" \
        --model "$model_path" \
        --port "$port_server")

    # --host exposes the server beyond localhost (e.g. 0.0.0.0 for LAN access).
    [[ -n "$host" ]] && cmd+=(--host "$host")
    [[ -n "$mmproj_path" ]] && cmd+=(--mmproj "$mmproj_path")
    # --parallel and --timeout are managed centrally here, not in models.conf.
    cmd+=(--alias "$_r_client" "${_r_args[@]}" --parallel "${parallel:-1}" --timeout "$LLAMA_SERVER_TIMEOUT")
    # --ctx overrides the model's default context size when given.
    [[ -n "$ctx" ]] && _r_ctx="$ctx"
    [[ -n "$_r_ctx" ]] && cmd+=(--ctx-size "$_r_ctx")
    # --cache-ram overrides the server's default prompt-cache size (8192 MiB).
    # 0 disables the host-RAM prompt cache (keeps system RAM flat during use).
    [[ -n "$cache_ram" ]] && cmd+=(--cache-ram "$cache_ram")
    # --similarity is llama-server's --slot-prompt-similarity: how much of a prompt
    # a slot must already hold (longest common prefix) to be reused; 0 = pure LRU.
    [[ -n "$similarity" ]] && cmd+=(--slot-prompt-similarity "$similarity")
    # Unconditional, so `clear-kv` works on every slot. The trailing slash is
    # required: llama-server concatenates path + filename without a separator.
    cmd+=(--slot-save-path "$SLOT_STATE_DIR/")
    # --tunnel authenticates at llama-server itself. proxy.py forwards the
    # Authorization header untouched, so this one key file covers the direct and
    # the proxied endpoint alike. --no-slots matters most: /slots is enabled by
    # default and exposes other clients' prompts.
    if [[ "$harden" == true ]]; then
        cmd+=(--api-key-file "$TOKEN_FILE" --no-webui --no-slots)
    fi
    # A cap on generated tokens; without it a single request can hold the GPU
    # until --timeout expires.
    [[ -n "$max_predict" && "$max_predict" != "-1" ]] && cmd+=(--n-predict "$max_predict")
    # llama.cpp maps ggml/model-load INFO logs to TRACE (level 4); the default
    # verbosity (3=INFO) filters them, so backend detection and buffer-size
    # lines never reach the log. -lv 4 reveals them (also more runtime logging).
    [[ "$verbose" == true ]] && cmd+=(-lv 4)
    # Whatever --reasoning translated into for this model (may be empty).
    [[ ${#_reasoning_args[@]} -gt 0 ]] && cmd+=("${_reasoning_args[@]}")
    # Speculative decoding: on whenever the model declares it, unless --spec off.
    # The draft head ships inside the model's own GGUF, so this costs no extra file.
    [[ "$spec" != "off" && ${#_r_spec_args[@]} -gt 0 ]] && cmd+=("${_r_spec_args[@]}")
    # Last, on purpose: llama-server takes the last occurrence of a sampler flag,
    # so these override both models.conf and the sampler set that --reasoning off
    # brings with it.
    [[ -n "$temp" ]] && cmd+=(--temp "$temp")
    [[ -n "$top_p" ]] && cmd+=(--top-p "$top_p")

    # Everything above only assembled the command; nothing has been started yet,
    # which is what makes --print-cmd a safe way to ask "what would this slot run?".
    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi
    [[ "$ignore_memory" == true ]] || _memory_check_start "$slot" "${cmd[*]}" false

    # The proxy is opt-in (--proxy): it only rewrites time/date stamps to keep the
    # prompt cache warm, which a client that sends no such stamps does not need.
    # Without it, clients talk to llama-server directly (see cmd_env).
    if [[ "$start_proxy" == true ]]; then
        _start_proxy "$slot" "$host" "$harden" || exit 1
    fi

    # Start llama-server in background
    echo "Starting llama.cpp server [slot $slot] on port $port_server..."

    # Behaviour-relevant llama.cpp defaults we do NOT pass, so they stay hidden.
    _has_flag() { local f; for f in "${cmd[@]}"; do [[ "$f" == "$1" ]] && return 0; done; return 1; }

    # Render the effective start config once. It is printed to the terminal AND
    # written to the top of the server log (below), so a saved log is self-describing.
    # The Command line is the ground truth of every flag (samplers, cache-type-k/v,
    # flash-attn, threads, ngl come from models.conf); the Defaults section shows
    # behaviour-relevant llama.cpp defaults we never pass.
    _render_config() {
        echo "Model: $_r_label ($_r_alias)"
        if [[ -n "$mmproj_path" ]]; then
            echo "mmproj: $mmproj_path (--mmproj)"
        elif [[ -n "$_r_mmproj" ]]; then
            echo "mmproj: available but not loaded (pass --mmproj)"
        fi
        case "$_r_role" in
            embedding) echo "Serves:   embeddings — POST /v1/embeddings" ;;
            rerank)    echo "Serves:   reranking — POST /v1/rerank" ;;
        esac
        echo "ROCm env: ${_r_rocm_env:-—}"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        # The LAN listener carries no authentication unless --tunnel added a key file.
        if [[ -n "$host" && "$host" != "127.0.0.1" && "$host" != "localhost" && "$host" != "::1" ]]; then
            local where="beyond localhost ($host)"
            [[ "$host" == "0.0.0.0" || "$host" == "::" ]] && where="to ALL interfaces"
            if [[ "$harden" == true ]]; then
                echo "  NOTE: bound $where; token auth is active (--tunnel)."
            else
                echo "  WARNING: bound $where without authentication —"
                echo "           expose only inside a trusted network."
            fi
        fi
        if [[ "$tunnel" == true ]]; then
            echo "Tunnel:   to $TUNNEL_HOST, the proxy's port :$port_proxy only (--tunnel)"
            echo "  Tokens:  $(_token_count) from $TOKEN_FILE — checked by the proxy and by llama-server"
            echo "  Server:  --no-webui --no-slots, generation capped at ${max_predict} tokens"
            echo "  Proxy:   path allowlist, token check, concurrency cap; fetches image URLs itself (public hosts only)"
        fi
        if [[ "$start_proxy" == true ]]; then
            echo "Proxy:    enabled on :$port_proxy (--proxy) — normalizes time/date stamps for the prompt cache"
        else
            echo "Proxy:    disabled — clients talk to :$port_server directly (pass --proxy to enable)"
        fi
        echo "Context:  ${_r_ctx:-default}"
        echo "Parallel: ${parallel:-1}"
        echo "Timeout:  ${LLAMA_SERVER_TIMEOUT}s (server and proxy)"
        if [[ -n "$cache_ram" ]]; then
            case "$cache_ram" in
                0)  echo "PromptCache: disabled (--cache-ram 0)" ;;
                -1) echo "PromptCache: no limit (--cache-ram -1)" ;;
                *)  echo "PromptCache: ${cache_ram} MiB (--cache-ram ${cache_ram})" ;;
            esac
        else
            echo "PromptCache: 8192 MiB (server default)"
        fi
        if [[ -n "$similarity" ]]; then
            case "$similarity" in
                0|0.0*) echo "SlotSimilarity: 0 — pure LRU slot pick (--similarity $similarity)" ;;
                *)      echo "SlotSimilarity: $similarity (--similarity $similarity)" ;;
            esac
        fi
        if [[ -n "$reasoning" ]]; then
            echo "Reasoning: ${_reasoning_note}"
            [[ "$_r_reasoning" == "unknown" ]] && \
                echo "  NOTE: this model's template support is unverified in models.conf —"
            [[ "$_r_reasoning" == "unknown" ]] && \
                echo "        the flags are passed through, run '$PROG probe-reasoning' once it is downloaded."
        else
            echo "Reasoning: template default (model supports: $_r_reasoning)"
        fi
        if [[ ${#_r_spec_args[@]} -eq 0 ]]; then
            echo "Speculative: not available for this model"
        elif [[ "$spec" == "off" ]]; then
            echo "Speculative: off (--spec off)"
        else
            echo "Speculative: on (${_r_spec_args[*]})"
        fi
        if [[ -n "$temp$top_p" ]]; then
            local sam=""
            [[ -n "$temp" ]] && sam+="temp $temp"
            [[ -n "$top_p" ]] && sam+="${sam:+, }top-p $top_p"
            echo "Samplers: $sam — overriding what models.conf sets for this model"
        fi
        [[ -n "$gpu_priority" ]] && echo "GPU priority: $gpu_priority (GGML_VK_QUEUE_PRIORITY; needs patched ggml-vulkan)"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "Defaults in effect (not overridden):"
        _has_flag --slot-prompt-similarity || echo "  slot-prompt-similarity: 0.1  (LCP slot routing; 0 = pure LRU)"
        _has_flag --batch-size            || echo "  batch-size:             2048"
        _has_flag --ubatch-size           || echo "  ubatch-size:            512"
        _has_flag --keep                  || echo "  keep:                   0"
        _has_flag -lv                     || echo "  verbosity:              3 (INFO)  — use --verbose for TRACE"
        echo "----------------------------"
    }
    local config_text
    config_text="$(_render_config)"
    echo "$config_text"

    # Preload jemalloc for the server (better allocation behaviour under load).
    # stdbuf -oL -eL line-buffers stdio so raw ggml/ROCm prints (llama.cpp only
    # flushes its own LOG_* lines) also reach $server_log promptly; it appends
    # libstdbuf to LD_PRELOAD, coexisting with the jemalloc preload.
    # _r_rocm_env is intentionally unquoted — word-splits space-separated KEY=VAL pairs for env
    # --gpu-priority sets GGML_VK_QUEUE_PRIORITY for the patched ggml-vulkan backend
    # (VK_EXT_global_priority). Empty var = not set = driver default. See patches/.
    local gpu_prio_env=""
    [[ -n "$gpu_priority" ]] && gpu_prio_env="GGML_VK_QUEUE_PRIORITY=$gpu_priority"
    # Write the effective config to the top of a fresh server log, then let the
    # server append below it (>>), so the saved log is self-describing. Each start
    # truncates first, preserving the fresh-log-per-start behaviour.
    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    # Detached, so the model outlives the terminal it was started from.
    # _r_rocm_env is unquoted on purpose: it word-splits into KEY=VAL pairs for env.
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append \
        env LD_PRELOAD=/lib64/libjemalloc.so.2 $gpu_prio_env $_r_rocm_env stdbuf -oL -eL "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: the server did not report a PID. See $server_log" >&2
        return 1
    fi

    echo "Server running (PID: $server_pid, detached)"
    _watch_start "$server_pid" "$server_log" "$port_server" || { _stop_slot "$slot" > /dev/null 2>&1; return 1; }

    # The tunnel last, so the port only opens once there is a backend behind it.
    _tunnel_llm_slot

    echo ""
    echo "  Logs:  tail -f $server_log"
    [[ "$start_proxy" == true ]] && echo "         tail -f $proxy_log"
    echo "  Stop:  $PROG stop $slot"
}

# The server / proxy actually running on a slot: the PID file if it still names a
# live process, otherwise whoever holds the port. Prints the PID, or returns 1.
# After a start: watch the new server for a while (LLMCTL_START_WATCH seconds,
# default 20, 0 = not at all). One that dies in that time — a model or mmproj
# it cannot load, memory it cannot get — is reported with the end of its log,
# its PID file removed, and start fails, rather than "Server running" over a
# corpse that only status or the log would show. One that answers is reported
# up; one still loading is left to it.
# $1 PID, $2 log, $3 port.
_watch_start() {
    local pid="$1" log="$2" port="$3" limit="${LLMCTL_START_WATCH:-20}" t=0 code
    [[ "$limit" =~ ^[0-9]+$ ]] || limit=20
    (( limit > 0 )) || return 0
    while (( t < limit )); do
        if ! ps -p "$pid" > /dev/null 2>&1; then
            echo "Error: the server exited ${t} s after its start. The end of its log ($log):" >&2
            # Its last words, without what gdb adds when it catches the crash
            # (the backtrace, debuginfod's questions): what llama.cpp, a Python
            # traceback or podman said last.
            grep -vE '^(#[0-9]|\[(New|Thread|Inferior)|This GDB|  <|Enable debuginfod|Debuginfod|To make this|Using host libthread|0x[0-9a-f]+ in|$)' "$log" |
                tail -n 8 | sed 's/^/  /' >&2
            return 1
        fi
        code=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$port/health" 2>/dev/null)
        [[ "$code" == 200 ]] || code=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "http://127.0.0.1:$port/" 2>/dev/null)
        if [[ "$code" == 200 ]]; then
            echo "Server up after ${t} s."
            return 0
        fi
        sleep 2
        t=$(( t + 2 ))
    done
    echo "Still loading after ${limit} s — '$PROG status' shows when it is up."
}

_slot_server_pid() {
    local slot="$1" pid=""
    [[ -f "$PID_DIR/server-${slot}.pid" ]] && pid=$(cat "$PID_DIR/server-${slot}.pid")
    if [[ -z "$pid" ]] || ! ps -p "$pid" > /dev/null 2>&1; then
        pid=$(_pid_on_port $(( PORT_BASE_SERVER + slot )))
    fi
    [[ -n "$pid" ]] && ps -p "$pid" > /dev/null 2>&1 || return 1
    echo "$pid"
}

_slot_proxy_pid() {
    local slot="$1" pid=""
    [[ -f "$PID_DIR/proxy-${slot}.pid" ]] && pid=$(cat "$PID_DIR/proxy-${slot}.pid")
    if [[ -z "$pid" ]] || ! ps -p "$pid" > /dev/null 2>&1; then
        pid=$(_pid_on_port $(( PORT_BASE_PROXY + slot )))
    fi
    [[ -n "$pid" ]] && ps -p "$pid" > /dev/null 2>&1 || return 1
    echo "$pid"
}

# Is this PID one of ours? Asked of whoever holds a port in our ranges, before
# that port is taken as evidence of a slot: with dozens of slots possible, some
# unrelated service on :8010 would otherwise show up in `status` as a slot.
# Every server llmctl starts carries --slot-save-path, every proxy is proxy.py,
# every ComfyUI --base-directory.
_is_llmctl_process() {
    local pid="$1" cmdline=""
    cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
    [[ "$cmdline" == *"--slot-save-path $SLOT_STATE_DIR/"* || "$cmdline" == *"$PROXY_SCRIPT"* ||
       "$cmdline" == *"--name $HALOGEN_CONTAINER_PREFIX"* || "$cmdline" == *"--name $GUFO_CONTAINER_PREFIX"* ||
       "$cmdline" == *"/main.py --listen "*" --base-directory "* ||
       "$cmdline" == *"$TTS_SERVER_SCRIPT"* || "$cmdline" == *"$IMAGES_SERVER_SCRIPT"* ||
       "$cmdline" == *"--config $AUDIOCPP_CONF_DIR/"* ]]
}

# The slots this machine currently has something on, ascending. Nothing keeps a
# list of slots, so it is reconstructed: the PID and preset files name the slots
# llmctl knows about, and the listening ports catch the rest — a server whose PID
# file was lost still answers on its port, which is the same fallback
# _slot_server_pid uses for a single slot.
_active_slots() {
    local -a slots=()
    local f n port pid
    for f in "$PID_DIR"/server-*.pid "$PID_DIR"/proxy-*.pid "$PID_DIR"/tunnel-*.pid "$PID_DIR"/preset-*; do
        [[ -e "$f" ]] || continue
        n="${f##*/}"; n="${n#*-}"; n="${n%.pid}"
        [[ "$n" =~ ^[1-9][0-9]*$ ]] && slots+=("$n")
    done
    while read -r port pid; do
        [[ "$port" =~ ^[0-9]+$ && -n "$pid" ]] || continue
        if   (( port > PORT_BASE_SERVER && port <= PORT_BASE_SERVER + SLOT_MAX )); then
            n=$(( port - PORT_BASE_SERVER ))
        elif (( port > PORT_BASE_PROXY  && port <= PORT_BASE_PROXY  + SLOT_MAX )); then
            n=$(( port - PORT_BASE_PROXY ))
        else
            continue
        fi
        _is_llmctl_process "$pid" && slots+=("$n")
    done < <(ss -tlnp 2>/dev/null | awk 'NR > 1 { n = split($4, a, ":"); p = ""
                                                 if (match($0, /pid=[0-9]+/)) p = substr($0, RSTART + 4, RLENGTH - 4)
                                                 print a[n], p }')
    # A halogen port is held by podman's network helper, not by anything of ours;
    # its container name is what gives the slot away.
    for n in $(_container_slots); do slots+=("$n"); done
    (( ${#slots[@]} )) || return 0
    printf '%s\n' "${slots[@]}" | sort -un
}

# The slots that have a server log, ascending — which is what cache-stats reads,
# and the reason it has its own enumeration: a log outlives the server it came
# from, so the numbers here are the ones with statistics, not the running ones.
_log_slots() {
    local -a slots=()
    local f n
    for f in "$LOG_DIR"/server-*.log; do
        [[ -e "$f" ]] || continue
        n="${f##*/server-}"; n="${n%.log}"
        [[ "$n" =~ ^[1-9][0-9]*$ ]] && slots+=("$n")
    done
    (( ${#slots[@]} )) || return 0
    printf '%s\n' "${slots[@]}" | sort -un
}

# The label of whatever model a slot is running, read from the process itself.
# Falls back to the file name, and to "unknown" for anything unreadable.
_slot_model_label() {
    local slot="$1" pid="" i
    pid=$(_slot_server_pid "$slot") || { echo "unknown"; return 1; }
    _read_argv "$pid" || { echo "unknown"; return 1; }
    if _is_tts_argv; then
        local path label
        path=$(_argv_flag --model) || { echo "unknown"; return 1; }
        label=$(_label_for_model_path "$path") || label="$(basename "$path")"
        echo "$label"; return 0
    fi
    if _is_audiocpp_argv; then
        local path label
        path=$(_audiocpp_model_of_argv) || { echo "unknown"; return 1; }
        label=$(_label_for_model_path "$path") || label="$(basename "$path")"
        echo "$label"; return 0
    fi
    if _is_comfyui_argv; then
        local path label
        path=$(_argv_flag --models-directory) || { echo "unknown"; return 1; }
        label=$(_label_for_model_path "$path") || label="ComfyUI"
        echo "$label"; return 0
    fi
    if _is_container_argv; then
        local path label
        path=$(_argv_halogen_model) || { echo "unknown"; return 1; }
        label=$(_label_for_model_path "$path") || label="$(basename "$path")"
        echo "$label"; return 0
    fi
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        case "${_ARGV[i]}" in
            -m|--model)
                local label
                label=$(_label_for_model_path "${_ARGV[i+1]}") || label="$(basename "${_ARGV[i+1]}")"
                echo "$label"; return 0 ;;
        esac
    done
    echo "unknown"
}

# Find a PID listening on a given port (uses ss or lsof).
_pid_on_port() {
    local port="$1"
    if command -v ss > /dev/null; then
        ss -tlnp 2>/dev/null | grep ":${port} " | grep -oP 'pid=\K[0-9]+' | head -1
    elif command -v lsof > /dev/null; then
        lsof -ti ":$port" 2>/dev/null | head -1
    fi
}

_stop_slot() {
    local slot="$1"
    local stopped=0

    local server_pid=""
    local container="" ckind=""
    if container=$(_slot_container "$slot"); then
        ckind=$(_slot_container_kind "$slot")
        # podman stop, not a signal to the client: it waits for the container to
        # exit and removes it (--rm), so the name is free for the next start.
        _stop_proxy "$slot" && stopped=$(( stopped + 1 ))
        server_pid=$(_slot_server_pid "$slot") || server_pid=""
        podman stop -t 30 "$container" > /dev/null 2>&1
        podman rm -f "$container" > /dev/null 2>&1
        [[ -n "$server_pid" ]] && kill "$server_pid" 2>/dev/null
        echo "Slot $slot: $ckind (container $container) stopped."
        stopped=$(( stopped + 1 ))
    elif server_pid=$(_slot_server_pid "$slot"); then
        local kind="llama-server"
        _read_argv "$server_pid" && _is_comfyui_argv && kind="ComfyUI"
        _read_argv "$server_pid" && _is_tts_argv && kind="speech server"
        _read_argv "$server_pid" && _is_audiocpp_argv && kind="audio.cpp"
        kill "$server_pid" 2>/dev/null
        # Until it is gone: a restart on the same slot needs the port free, and
        # ComfyUI takes a moment to let go of it. SIGKILL after 15 s.
        local t
        for (( t=0; t < 75; t++ )); do
            ps -p "$server_pid" > /dev/null 2>&1 || break
            sleep 0.2
        done
        ps -p "$server_pid" > /dev/null 2>&1 && kill -9 "$server_pid" 2>/dev/null
        echo "Slot $slot: $kind (PID: $server_pid) stopped."
        stopped=$(( stopped + 1 ))
    fi

    _stop_proxy "$slot" && stopped=$(( stopped + 1 ))
    _stop_tunnel "$slot" && stopped=$(( stopped + 1 ))

    rm -f "$PID_DIR/server-${slot}.pid" "$PID_DIR/proxy-${slot}.pid"
    rm -f "$PID_DIR/preset-${slot}"
    # Only succeeds while nothing was saved there via ?action=save.
    rmdir "$SLOT_STATE_DIR" 2>/dev/null || true
    return $(( stopped == 0 ))
}

cmd_stop() {
    local slot="${1:-}"

    if [[ -n "$slot" ]]; then
        _check_slot "$slot" || return 1
        _stop_slot "$slot" || echo "Slot $slot: nothing was running."
    else
        local total=0
        for s in $(_active_slots); do
            _stop_slot "$s" && total=$(( total + 1 ))
        done
        [[ "$total" -eq 0 ]] && echo "Nothing was running."
    fi

    rmdir "$PID_DIR" 2>/dev/null || true
}

# ── Presets ─────────────────────────────────────────────────
#
# A preset is a whole configuration under one name: the models, their slots and
# their start flags (presets.conf). Every entry goes through cmd_start unchanged,
# so a preset can do exactly what `start` can do and nothing has to be mirrored.

cmd_presets() {
    printf "\n\033[1mAvailable presets:\033[0m\n\n"
    if (( ${#_PRESETS[@]} == 0 )); then
        echo "  none defined — add one to presets.conf"
        echo ""
        return 0
    fi
    local entry line
    local -a f w
    for entry in "${_PRESETS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        printf "  \033[36m%-14s\033[0m %s\n" "${f[0]}" "${f[1]}"
        for line in "${f[@]:2}"; do
            w=(); read -ra w <<< "$line"
            printf "  %-14s   slot %-3s %-14s %s\n" "" "${w[1]}" "${w[0]}" "${w[*]:2}"
        done
        echo ""
    done
    echo "  $PROG preset <name>            bring the machine to that configuration:"
    echo "                                    keep what already matches, stop the rest, start what is missing"
    echo "  $PROG preset <name> --dry-run  show the plan, change nothing"
    echo ""
}

# A model is ready when llama-server says so itself:
#
#   2.11.562.067 I srv  llama_server: listening on http://127.0.0.1:8001
#
# It prints that line after 'model loaded', so it marks the end of the load and
# not the moment the socket exists. Nothing else is as reliable: the port alone
# could be an older server that never went away, and the process being alive
# says nothing about how far it has got. Waiting for the line serializes GPU memory
# allocation across a preset's models — the next one may only start allocating
# once this one has all it needs — and it makes the last model in a preset
# finish loading before the shell prompt comes back.
#
# The wait ends early on an error: the server log marks those with severity E
# ('E srv  llama_server: exiting due to model loading error'), and a load that
# dies leaves no process behind. Either way there is nothing left to wait for.
#
# The log is appended to across starts, so the caller passes the size it had
# before this start; only what was written after that may decide anything.
_wait_for_slot() {
    local slot="$1" limit="$2" offset="${3:-0}"
    local port=$(( PORT_BASE_SERVER + slot ))
    local log="$LOG_DIR/server-${slot}.log"
    local pid=""
    [[ -f "$PID_DIR/server-${slot}.pid" ]] && pid=$(cat "$PID_DIR/server-${slot}.pid")
    local waited=0 size=0 fresh="" err=""
    while (( waited < limit )); do
        size=0
        [[ -f "$log" ]] && size=$(stat -c%s "$log" 2>/dev/null || echo 0)
        # --clear-logs truncated it under us; what is there now is all this run's.
        (( size < offset )) && offset=0
        fresh=$(tail -c "+$(( offset + 1 ))" "$log" 2>/dev/null)

        # halogen: uvicorn announces the API once the engine behind it answers.
        # ComfyUI: the address of its web UI, once the server is up.
        if grep -Eq "(llama_server:|server is) listening on http://[^[:space:]]*:${port}([^0-9]|\$)|Uvicorn running on http://|To see the GUI go to: https?://[^[:space:]]*:${port}([^0-9]|\$)|tts_server listening on http://[^[:space:]]*:${port}([^0-9]|\$)|audiocpp_server listening on http://[^[:space:]]*:${port}([^0-9]|\$)" <<< "$fresh"; then
            echo "  loaded after ${waited}s — listening on :$port"
            return 0
        fi
        err=$(grep -m1 -E "^[0-9][0-9.]* E " <<< "$fresh")
        if [[ -n "$err" ]]; then
            echo "  the server reported an error while loading:" >&2
            echo "    ${err}" >&2
            echo "  see $log" >&2
            return 1
        fi
        if [[ -n "$pid" ]] && ! ps -p "$pid" > /dev/null 2>&1; then
            echo "  the server exited while loading — see $log" >&2
            return 1
        fi
        sleep 1
        waited=$(( waited + 1 ))
        (( waited % 30 == 0 )) && echo "  loading… ${waited}s"
    done
    echo "  not loaded after ${limit}s — the log has no 'listening on :$port' yet." >&2
    echo "  Raise the limit with --wait N if this model is simply slow to load; see $log" >&2
    return 1
}

cmd_preset() {
    local name=""
    local dry_run=false
    local force=false           # true = reload every model, even one that already matches
    local repair=false          # true = only restart this preset's slots whose server died
    local wait_limit=300        # per model, until it reports itself loaded (--wait N)
    # start options that describe how a slot is run and reached rather than what
    # the model does. Those apply to a whole configuration equally, so they are
    # given here and appended to every entry; what shapes the model itself
    # (--ctx, --reasoning, --temp, --parallel, …) stays with its entry in
    # presets.conf, where it belongs to one model and not to the set.
    local -a extra=()
    local output_dir=""         # --output: where ComfyUI entries put their images

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --output) _need_value "$@" || exit 1; output_dir="$2"; shift 2 ;;
            --force) force=true; shift ;;
            --repair) repair=true; shift ;;
            --wait) _need_value "$@" || exit 1; wait_limit="$2"; shift 2 ;;
            --proxy|--clear-logs|--verbose) extra+=("$1"); shift ;;
            --host|--gpu-priority) _need_value "$@" || exit 1; extra+=("$1" "$2"); shift 2 ;;
            -*) echo "Unknown option for preset: $1"
                echo "  preset takes --dry-run, --force, --repair, --wait N, and the start options that"
                echo "  apply to the whole configuration:"
                echo "    --proxy  --host ADDR  --clear-logs  --verbose  --gpu-priority L"
                echo "    --output DIR  (ComfyUI entries only)"
                echo "  They are appended to every entry, so they win over what the entry itself"
                echo "  says. Per-model options such as --ctx or --reasoning belong in the entry."
                exit 1 ;;
            *) [[ -z "$name" ]] && name="$1"; shift ;;
        esac
    done

    [[ -z "$name" ]] && { cmd_presets; exit 1; }
    if [[ ! "$wait_limit" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --wait requires a positive number of seconds (got '$wait_limit')"; exit 1
    fi
    _resolve_preset "$name" || { echo "Unknown preset: $name"; cmd_presets; exit 1; }
    (( ${#_p_entries[@]} == 0 )) && { echo "Error: preset '$name' lists no models."; exit 1; }
    if [[ -n "$output_dir" ]]; then
        local has_comfy=false l
        for l in "${_p_entries[@]}"; do
            _resolve_model "${l%% *}" && [[ "$_r_backend" == comfyui ]] && has_comfy=true
        done
        [[ "$has_comfy" == true ]] || { echo "Error: --output is for ComfyUI, and preset '$name' has no ComfyUI entry."; exit 1; }
    fi

    # ── Read the preset, and ask start what each entry would run ────────────
    # Everything is checked before anything is touched: a name typo or an
    # impossible flag in the last entry must not disturb a running slot.
    local -a e_model=() e_slot=() e_flags=() e_label=() e_cmd=() e_proxy=() e_harden=() e_host=()
    local -a e_tunnel=() e_vision=()
    local word
    local line seen=""
    local -a w
    for line in "${_p_entries[@]}"; do
        w=(); read -ra w <<< "$line"
        if (( ${#w[@]} < 2 )); then
            echo "Error: preset '$name': entry '$line' needs a model and a slot."; exit 1
        fi
        local m="${w[0]}" s="${w[1]}"
        _resolve_model "$m" || { echo "Error: preset '$name': unknown model '$m'."; exit 1; }
        if ! _check_slot "$s" 2> /dev/null; then
            echo "Error: preset '$name': '$m' asks for slot '$s'; slots are 1-$SLOT_MAX."; exit 1
        fi
        if [[ " $seen " == *" $s "* ]]; then
            echo "Error: preset '$name': slot $s is claimed twice — one server per slot."; exit 1
        fi
        seen+=" $s"

        # The entry's own flags first, the command-level ones after, so a --host
        # given here overrides one written into the entry rather than the reverse.
        # Each backend gets the ones that mean something to it: ComfyUI has no
        # proxy and no Vulkan queue, and only it takes --output.
        local -a eff=("${w[@]:2}")
        if [[ "$_r_backend" == comfyui || "$_r_backend" == tts || "$_r_backend" == audiocpp ]]; then
            local k=0
            while (( k < ${#extra[@]} )); do
                case "${extra[k]}" in
                    --proxy) k=$(( k + 1 )) ;;
                    --verbose)        [[ "$_r_backend" == comfyui ]] && eff+=("${extra[k]}"); k=$(( k + 1 )) ;;
                    --gpu-priority)   k=$(( k + 2 )) ;;
                    --host)           eff+=("${extra[k]}" "${extra[k+1]}"); k=$(( k + 2 )) ;;
                    *)                eff+=("${extra[k]}"); k=$(( k + 1 )) ;;
                esac
            done
            [[ -n "$output_dir" && "$_r_backend" == comfyui ]] && eff+=(--output "$output_dir")
        else
            eff+=("${extra[@]}")
        fi

        # start itself is the authority on what this entry means — flags, samplers,
        # reasoning translation, speculation and all. Asking it beats re-deriving
        # any of that here, and it validates the entry on the way.
        local out rc
        out=$( cmd_start "$m" "$s" "${eff[@]}" --print-cmd 2>&1 ); rc=$?
        if (( rc != 0 )); then
            echo "Error: preset '$name': entry '$line' cannot be started:"
            printf '  %s\n' "$out"
            exit 1
        fi

        e_model+=("$m"); e_slot+=("$s"); e_flags+=("${eff[*]}"); e_label+=("$_r_label")
        e_cmd+=("$out")
        # A halogen or gufo slot always has its proxy, asked for or not; so does a
        # tunnelled LLM slot, in token mode.
        local tunnelled_llm=false
        [[ " ${eff[*]} " == *" --tunnel "* && "$_r_backend" != comfyui ]] && tunnelled_llm=true
        if [[ " ${eff[*]} " == *" --proxy "* || "$_r_backend" == halogen || "$_r_backend" == gufo || "$tunnelled_llm" == true ]]; then
            e_proxy+=(true); else e_proxy+=(false); fi
        e_harden+=("$tunnelled_llm")
        # A ComfyUI slot's tunnel and the vision model its image API asks.
        [[ " ${eff[*]} " == *" --tunnel "* ]] && e_tunnel+=(true) || e_tunnel+=(false)
        local ev="" pv=""
        for word in "${eff[@]}"; do [[ "$pv" == "--vision" ]] && ev="$word"; pv="$word"; done
        e_vision+=("$ev")
        # The host a reconciled proxy has to bind, read from the same effective flags.
        local eh="" prev=""
        for word in "${eff[@]}"; do
            [[ "$prev" == "--host" ]] && eh="$word"
            prev="$word"
        done
        e_host+=("$eh")
    done

    # ── --repair: bring back what died, and nothing else ────────────────────
    # For a watchdog (llmctl service). A slot counts only while `preset` still
    # claims it for this preset — `start` and `stop` drop that claim, and so
    # does another preset — so a machine switched to something else by hand is
    # left alone. Nothing is stopped, no other slot is touched.
    if [[ "$repair" == true ]]; then
        local total=${#e_model[@]} i n=0
        for (( i=0; i<total; i++ )); do
            local sl="${e_slot[i]}"
            [[ "$(cat "$PID_DIR/preset-${sl}" 2>/dev/null)" == "$_p_name" ]] || continue
            if _halogen_orphan "$sl"; then
                echo "Slot $sl: an orphaned halogen container holds it — left for '$PROG stop $sl'."
                continue
            fi
            if _slot_server_pid "$sl" > /dev/null; then
                local vision="" vision_slot="" proxy_new=false
                _resolve_vision "${e_vision[i]}" "$sl" > /dev/null
                if [[ "${e_proxy[i]}" == true ]] && ! _slot_proxy_pid "$sl" > /dev/null; then
                    echo "Slot $sl: its proxy died — starting it again."
                    _start_proxy "$sl" "${e_host[i]}" "${e_harden[i]}" && proxy_new=true
                    n=$(( n + 1 ))
                fi
                if [[ "${e_tunnel[i]}" == true ]] && { ! _tunnel_up "$sl" || [[ "$proxy_new" == true ]]; }; then
                    echo "Slot $sl: its tunnel is down — opening it again."
                    _start_tunnel "$sl" || true
                    n=$(( n + 1 ))
                fi
                continue
            fi
            echo "Slot $sl: ${e_model[i]} of preset '$_p_name' is gone — starting it again."
            local -a flags=(); read -ra flags <<< "${e_flags[i]}"
            local off=0
            [[ -f "$LOG_DIR/server-${sl}.log" ]] && off=$(stat -c%s "$LOG_DIR/server-${sl}.log" 2>/dev/null || echo 0)
            if [[ "$dry_run" == true ]]; then
                echo "  (dry run) $PROG start ${e_model[i]} $sl ${e_flags[i]}"
            elif ( cmd_start "${e_model[i]}" "$sl" "${flags[@]}" ) && _wait_for_slot "$sl" "$wait_limit" "$off"; then
                echo "$_p_name" > "$PID_DIR/preset-${sl}"
            else
                # Keep the claim, so the next round tries again.
                echo "$_p_name" > "$PID_DIR/preset-${sl}"
                echo "Slot $sl: did not come back. See $LOG_DIR/server-${sl}.log"
            fi
            n=$(( n + 1 ))
        done
        (( n )) || echo "Preset '$_p_name': nothing to repair."
        return 0
    fi

    # ── Compare against what is running ─────────────────────────────────────
    # Per slot, the target command against the running process's own argv. A full
    # comparison, so a slot counts as matching only when every flag agrees — model,
    # context, parallel, samplers, mmproj, speculation, reasoning.
    local total=${#e_model[@]} i
    local -a e_action=() e_proxy_action=() e_tunnel_action=()
    local keep_n=0 start_n=0 restart_n=0
    for (( i=0; i<total; i++ )); do
        local s="${e_slot[i]}" pid="" action="start" proxy_action="none" tunnel_action="none"
        if pid=$(_slot_server_pid "$s"); then
            if [[ "$force" == true ]]; then
                action="restart"
            elif _read_argv "$pid" && [[ "${_ARGV[*]}" == "${e_cmd[i]}" ]]; then
                action="keep"
            else
                action="restart"
            fi
        fi
        # A proxy is a second, cheap process; when the model itself is right, the
        # proxy is added or removed on its own rather than reloading the weights.
        if [[ "$action" == "keep" ]]; then
            local proxy_up=false
            _slot_proxy_pid "$s" > /dev/null && proxy_up=true
            if [[ "${e_proxy[i]}" == true && "$proxy_up" == false ]]; then
                proxy_action="start"
            elif [[ "${e_proxy[i]}" == false && "$proxy_up" == true ]]; then
                proxy_action="stop"
            elif [[ "${e_proxy[i]}" == true && "$proxy_up" == true ]] && _slot_is_comfyui "$s"; then
                # The image API asks the vision model the preset names, or none.
                local vision="" vision_slot=""
                _resolve_vision "${e_vision[i]}" "$s" > /dev/null
                [[ "$(_images_server_vision "$s")" == "$vision" ]] || proxy_action="restart"
            fi
            # The tunnel follows: started when asked for and down, or when the image
            # API it forwards comes anew; stopped when the preset has none.
            if [[ "${e_tunnel[i]}" == true ]]; then
                if ! _tunnel_up "$s"; then tunnel_action="start"
                elif [[ "$proxy_action" == start || "$proxy_action" == restart ]]; then tunnel_action="restart"; fi
            elif _tunnel_up "$s"; then
                tunnel_action="stop"
            fi
        fi
        e_action+=("$action"); e_proxy_action+=("$proxy_action"); e_tunnel_action+=("$tunnel_action")
        case "$action" in
            keep)    keep_n=$(( keep_n + 1 )) ;;
            start)   start_n=$(( start_n + 1 )) ;;
            restart) restart_n=$(( restart_n + 1 )) ;;
        esac
    done

    # Slots the preset does not name: a preset describes the whole machine, so
    # anything else running is stopped — including a model this preset itself put
    # on a slot it no longer uses.
    local -a foreign=()
    local s
    for s in $(_active_slots); do
        [[ " $seen " == *" $s "* ]] && continue
        if _slot_server_pid "$s" > /dev/null || _slot_proxy_pid "$s" > /dev/null || _halogen_orphan "$s"; then
            foreign+=("$s")
        fi
    done

    # ── The plan ────────────────────────────────────────────────────────────
    echo ""
    printf "\033[1mPreset '%s' — %s\033[0m\n" "$_p_name" "$_p_label"
    (( ${#extra[@]} > 0 )) && printf "applied to every entry: %s\n" "${extra[*]}"
    echo ""
    for s in "${foreign[@]}"; do
        local running=""
        running=$(_slot_model_label "$s")
        _halogen_orphan "$s" && running="halogen (container only)"
        [[ "$running" == "unknown" ]] && running="(proxy only)"
        printf "  slot %-3s %-14s %-24s %s\n" "$s" "-" "$running" "stop — not part of this preset"
    done
    for (( i=0; i<total; i++ )); do
        local note=""
        case "${e_action[i]}" in
            keep)    note="already running like this — keep" ;;
            start)   note="start" ;;
            restart) note=$([[ "$force" == true ]] && echo "restart (--force)" || echo "runs a different configuration — stop and start") ;;
        esac
        case "${e_proxy_action[i]}" in
            start)   note+=", add proxy" ;;
            stop)    note+=", stop proxy" ;;
            restart) note+=", restart the image API (another --vision)" ;;
        esac
        case "${e_tunnel_action[i]}" in
            start)   note+=", add tunnel" ;;
            stop)    note+=", stop tunnel" ;;
            restart) note+=", renew tunnel" ;;
        esac
        printf "  slot %-3s %-14s %-24s %s\n" "${e_slot[i]}" "${e_model[i]}" "${e_label[i]}" "$note"
    done

    if [[ " ${extra[*]} " == *" --clear-logs "* ]] && (( keep_n > 0 )); then
        echo ""
        echo "Note: --clear-logs only reaches slots that are started here."
        echo "      $keep_n slot(s) keep running, and keep their logs."
    fi

    local fits=true
    _preset_memory_check || fits=false

    if [[ "$dry_run" == true ]]; then
        if (( start_n + restart_n > 0 )); then
            echo ""
            echo "Would start:"
            for (( i=0; i<total; i++ )); do
                [[ "${e_action[i]}" == "keep" ]] && continue
                echo "  $PROG start ${e_model[i]} ${e_slot[i]} ${e_flags[i]}"
            done
        fi
        echo ""
        return 0
    fi
    [[ "$fits" == true ]] || exit 1

    if (( start_n + restart_n == 0 )) && (( ${#foreign[@]} == 0 )); then
        local pending=0 j
        for (( j=0; j<total; j++ )); do
            [[ "${e_proxy_action[j]}" == "none" && "${e_tunnel_action[j]}" == "none" ]] || pending=1
        done
        if (( pending == 0 )); then
            echo ""
            echo "Preset '$_p_name' is already running exactly like this — nothing to do."
            for (( j=0; j<total; j++ )); do echo "$_p_name" > "$PID_DIR/preset-${e_slot[j]}"; done
            echo ""
            return 0
        fi
    fi

    # ── Stop first, start second ────────────────────────────────────────────
    # Everything that has to go goes before the first model loads: the new weights
    # need the GPU memory the old ones are holding.
    echo ""
    for s in "${foreign[@]}"; do
        local running=""
        running=$(_slot_model_label "$s")
        _stop_slot "$s" > /dev/null && \
            echo "Slot $s: $running stopped (not part of preset '$_p_name')."
    done
    for (( i=0; i<total; i++ )); do
        [[ "${e_action[i]}" == "restart" ]] || continue
        _stop_slot "${e_slot[i]}" > /dev/null && echo "Slot ${e_slot[i]}: stopped (ran a different configuration)."
    done

    # Kept slots: reconcile the proxy and the tunnel alone, and claim the slot for
    # this preset.
    for (( i=0; i<total; i++ )); do
        [[ "${e_action[i]}" == "keep" ]] || continue
        local vision="" vision_slot=""
        _resolve_vision "${e_vision[i]}" "${e_slot[i]}" > /dev/null
        case "${e_proxy_action[i]}" in
            restart) _stop_proxy "${e_slot[i]}" > /dev/null ;&
            start) _start_proxy "${e_slot[i]}" "${e_host[i]}" "${e_harden[i]}" || {
                       echo "Error: could not add the proxy to slot ${e_slot[i]}."; exit 1; } ;;
            stop)  _stop_proxy "${e_slot[i]}" > /dev/null && \
                       echo "Slot ${e_slot[i]}: proxy stopped (this preset does not ask for one)." ;;
        esac
        case "${e_tunnel_action[i]}" in
            start|restart) _start_tunnel "${e_slot[i]}" || {
                       echo "Error: could not open the tunnel for slot ${e_slot[i]}."; exit 1; } ;;
            stop)  _stop_tunnel "${e_slot[i]}" > /dev/null && \
                       echo "Slot ${e_slot[i]}: tunnel stopped (this preset does not ask for one)." ;;
        esac
        echo "$_p_name" > "$PID_DIR/preset-${e_slot[i]}"
        printf "Slot %s: %s keeps running (%s).\n" "${e_slot[i]}" "${e_model[i]}" "${e_label[i]}"
    done

    local -a started=()
    local n=0
    for (( i=0; i<total; i++ )); do
        [[ "${e_action[i]}" == "keep" ]] && continue
        n=$(( n + 1 ))
        local m="${e_model[i]}" sl="${e_slot[i]}"
        local -a flags=(); read -ra flags <<< "${e_flags[i]}"
        echo ""
        printf "\033[1m[%d/%d] %s → slot %s\033[0m\n" "$n" "$(( start_n + restart_n ))" "$m" "$sl"
        # In a subshell: cmd_start ends a failed start with `exit`, which would
        # otherwise take the preset — and the rollback below — down with it.
        # Where this run's output starts in the appended server log — what was
        # there before belongs to an earlier start and must not answer for this one.
        local off=0
        [[ -f "$LOG_DIR/server-${sl}.log" ]] && off=$(stat -c%s "$LOG_DIR/server-${sl}.log" 2>/dev/null || echo 0)
        # --ignore-memory: the whole set was weighed above, before anything stopped.
        if ( cmd_start "$m" "$sl" "${flags[@]}" --ignore-memory ) && _wait_for_slot "$sl" "$wait_limit" "$off"; then
            _record_footprint "$sl"
            echo "$_p_name" > "$PID_DIR/preset-${sl}"
            started+=("$sl")
            continue
        fi

        # Rolling back what this run started: a half-loaded preset is a
        # configuration nobody asked for, and its slots hold GPU memory the next
        # attempt needs. Slots that were already running and matched are left
        # alone — stopping a good model to tidy up would help no one.
        echo ""
        echo "Preset '$_p_name' failed at $m (slot $sl) — rolling back this run."
        _stop_slot "$sl" > /dev/null 2>&1 || true
        local r
        for r in "${started[@]}"; do
            _stop_slot "$r" || true
        done
        if (( keep_n > 0 )); then
            echo "Still running from before: $(
                for (( r=0; r<total; r++ )); do
                    [[ "${e_action[r]}" == "keep" ]] && printf '%s (slot %s) ' "${e_model[r]}" "${e_slot[r]}"
                done)"
        else
            echo "Nothing of preset '$_p_name' is running."
        fi
        exit 1
    done

    echo ""
    printf "\033[1mPreset '%s' is up.\033[0m\n" "$_p_name"
    for (( i=0; i<total; i++ )); do
        printf "  slot %-3s %-32s :%s\n" "${e_slot[i]}" "${e_label[i]}" "$(( PORT_BASE_SERVER + e_slot[i] ))"
    done
    echo ""
    local -a env_lines=() ui_lines=()
    for (( i=0; i<total; i++ )); do
        if _resolve_model "${e_model[i]}" && [[ "$_r_backend" == comfyui ]]; then
            ui_lines+=("http://127.0.0.1:$(( PORT_BASE_SERVER + e_slot[i] ))  (${e_model[i]})")
        else
            env_lines+=("eval \"\$($PROG env ${e_model[i]} ${e_slot[i]})\"")
        fi
    done
    if (( ${#env_lines[@]} )); then
        echo "  Env:    each shell picks one of them:"
        printf '            %s\n' "${env_lines[@]}"
    fi
    (( ${#ui_lines[@]} )) && printf '  UI:     %s\n' "${ui_lines[@]}"
    echo "  Status: $PROG status"
    echo "  Stop:   $PROG stop"
    echo ""
}

# ── GPU memory a configuration needs ────────────────────────
#
# What a model takes on the GPU depends on far more than its file: KV cache per
# context and slot, hybrid and sliding-window layers that hold no KV, the cache
# type, the draft, the vision projector, compute buffers. Rather than model all
# of that, llmctl measures: once a slot has loaded, what its process holds on
# the GPU is written down under its exact start command, and `preset` adds those
# numbers up before it loads anything. A command never measured counts with the
# size of its weight files — a lower bound, and said as such.
FOOTPRINT_FILE="$STATE_DIR/footprints.tsv"   # sha1 of the command, MiB, date, label
GTT_RESERVE_MIB=2048                        # headroom kept free beside the models

_footprint_key() { printf '%s' "$1" | sha1sum | cut -c1-16; }

# GPU memory of whatever runs on a slot, in MiB. A halogen container runs its
# engine outside our process tree, but it runs alone, so the GPU total is its.
# A speech slot's model lives in the engine it started as a child.
# The GTT a slot's processes hold, from their DRM fdinfo. halogen's engine runs
# inside its container, reached through podman's host PIDs.
_slot_gtt_mib() {
    local pid c sum=0
    pid=$(_slot_server_pid "$1") || return 1
    local container
    if container=$(_slot_container "$1"); then
        for c in $(podman top "$container" hpid 2>/dev/null | tail -n +2); do
            sum=$(( sum + $(_proc_gpu_mib "$c") ))
        done
    else
        sum=$(_proc_gpu_mib "$pid")
        for c in $(pgrep -P "$pid"); do sum=$(( sum + $(_proc_gpu_mib "$c") )); done
    fi
    echo "$sum"
}

# The weights halogen pinned in host memory, outside the GTT pool, as its
# startup log reports them.
_halogen_pinned_mib() {
    local g
    g=$(sed -n 's/.*memory: \([0-9.]*\) GiB of weights locked.*/\1/p' "$LOG_DIR/server-$1.log" 2>/dev/null | tail -1)
    awk -v g="${g:-0}" 'BEGIN { printf "%d", g * 1024 }'
}

# What a slot takes from memory: its GTT, and for halogen the pinned weights
# too — they come out of the same RAM the GTT pool is carved from. halogen-server
# maps its checkpoint and keeps its prompt cache in host memory, gufo holds its
# weights there: their resident memory counts.
_slot_gpu_mib() {
    local gtt pid
    gtt=$(_slot_gtt_mib "$1") || return 1
    if _slot_is_halogen "$1"; then
        if pid=$(_slot_server_pid "$1") && _read_argv "$pid" && [[ "$(_argv_halogen_flavor)" == server ]]; then
            echo $(( gtt + $(_container_rss_mib "$(_halogen_container "$1")") ))
        else
            echo $(( gtt + $(_halogen_pinned_mib "$1") ))
        fi
    elif _slot_is_gufo "$1"; then
        echo $(( gtt + $(_gufo_rss_mib "$1") ))
    else
        echo "$gtt"
    fi
}

# Beside halogen, a start has to fit: what runs already, plus what this start
# will take (measured, or estimated), within the GTT pool minus what programs
# outside llmctl hold and a reserve. halogen's pinned weights count, though
# they lie outside the pool — the pool is carved from the same RAM, and what is
# left beyond it is the system's and the page cache's (the n-gram table is read
# through it). Only when halogen runs or starts; llama sets keep their own ways.
# $1 slot, $2 the command it will run, $3 true when it is a halogen start.
_memory_check_start() {
    local slot="$1" target="$2" starting_halogen="$3"
    local s hs=""
    # gufo, like halogen, holds memory outside the GTT pool (its weights as RSS):
    # beside either, a start has to be weighed.
    for s in $(_container_slots); do [[ "$s" != "$slot" ]] && hs="$s"; done
    [[ -n "$hs" || "$starting_halogen" == true ]] || return 0
    local total=$(( $(_gtt_total_bytes) / 1048576 ))
    (( total > 0 )) || return 0
    local need how="measured"
    need=$(_lookup_footprint "$target")
    [[ -n "$need" ]] || { need=$(_estimate_cmd_mib "$target"); how="estimated"; }
    local running=0 gtt_ours=0 m
    local -a held=()
    local pid known
    for s in $(_active_slots); do
        m=$(_slot_gtt_mib "$s" 2>/dev/null) && gtt_ours=$(( gtt_ours + m ))
        [[ "$s" == "$slot" ]] && continue
        m=$(_slot_gpu_mib "$s" 2>/dev/null) || continue
        # A slot still loading holds less than it will: what it is known to
        # take, where that is more.
        if pid=$(_slot_server_pid "$s") && _read_argv "$pid"; then
            known=$(_lookup_footprint "${_ARGV[*]}")
            [[ -n "$known" ]] || known=$(_estimate_cmd_mib "${_ARGV[*]}")
            (( known > m )) && m=$known
        fi
        running=$(( running + m )); held+=("slot $s $(_gib "$m")")
    done
    local outside=$(( $(_gtt_used_bytes) / 1048576 - gtt_ours ))
    (( outside < 0 )) && outside=0
    local budget=$(( total - outside - GTT_RESERVE_MIB ))
    (( running + need <= budget )) && return 0
    local beside
    beside="$(_slot_container_kind "$hs" 2>/dev/null || echo halogen) on slot $hs"
    [[ -n "$hs" ]] || beside="the slots that run"
    echo "Error: not enough memory beside $beside:"
    echo "       this start needs $(_gib "$need") ($how); running: ${held[*]:-nothing} ($(_gib "$running"));"
    echo "       budget $(_gib "$budget") (GTT pool $(_gib "$total") minus $(_gib "$outside") outside llmctl and $(_gib "$GTT_RESERVE_MIB") reserve)."
    echo "       Stop a slot first, or start anyway with --ignore-memory."
    exit 1
}

# The GPU with the largest GTT pool: its total and what is in use, in bytes.
_gtt_card() { ls -d /sys/class/drm/card*/device 2>/dev/null | while read -r d; do
    [[ -r "$d/mem_info_gtt_total" ]] && echo "$(cat "$d/mem_info_gtt_total") $d"; done | sort -n | tail -1 | cut -d' ' -f2; }
_gtt_total_bytes() { local d; d=$(_gtt_card); cat "$d/mem_info_gtt_total" 2>/dev/null || echo 0; }
_gtt_used_bytes()  { local d; d=$(_gtt_card); cat "$d/mem_info_gtt_used" 2>/dev/null || echo 0; }

# Write down what the slot's server holds now, under its command line. Below
# 256 MiB it has not loaded anything worth recording.
_record_footprint() {
    local slot="$1" pid mib key label
    pid=$(_slot_server_pid "$slot") || return 0
    _read_argv "$pid" || return 0
    mib=$(_slot_gpu_mib "$slot") || return 0
    (( mib >= 256 )) || return 0
    key=$(_footprint_key "${_ARGV[*]}")
    label=$(_slot_model_label "$slot")
    mkdir -p "$STATE_DIR"
    { grep -v "^$key	" "$FOOTPRINT_FILE" 2>/dev/null
      printf '%s\t%s\t%s\t%s\n' "$key" "$mib" "$(date +%F)" "$label"; } > "$FOOTPRINT_FILE.new" &&
        mv "$FOOTPRINT_FILE.new" "$FOOTPRINT_FILE"
}

_lookup_footprint() {
    local key
    key=$(_footprint_key "$1")
    awk -F'\t' -v k="$key" '$1 == k { print $2; exit }' "$FOOTPRINT_FILE" 2>/dev/null
}

# What of a GGUF (all its parts, when split) gufo keeps in memory, and what it
# leaves on the SSD — Flash-Next's n-gram table (per_layer_token_embd), read
# with O_DIRECT: "resident ngram" in bytes, from the tensor table in the
# headers. Without python3 or a readable header: the files' size, nothing out.
_gguf_resident_bytes() {
    local -a parts=("$1")
    [[ "$1" =~ -00001-of-[0-9]+\.gguf$ ]] && parts=("${1%-00001-of-*}"-*-of-*.gguf)
    python3 -I - "${parts[@]}" <<'PY' 2>/dev/null || { local f b=0; for f in "${parts[@]}"; do b=$(( b + $(stat -c%s "$f" 2>/dev/null || echo 0) )); done; echo "$b 0"; }
import os, struct, sys
SZ = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
total = ngram = 0
for path in sys.argv[1:]:
    with open(path, "rb") as f:
        def u(fmt):
            fmt = "<" + fmt
            return struct.unpack(fmt, f.read(struct.calcsize(fmt)))[0]
        def skip(t):
            if t == 8:
                f.seek(u("Q"), 1)
            elif t == 9:
                at, n = u("I"), u("Q")
                if at == 8:
                    for _ in range(n):
                        f.seek(u("Q"), 1)
                else:
                    f.seek(SZ[at] * n, 1)
            else:
                f.seek(SZ[t], 1)
        assert f.read(4) == b"GGUF"
        u("I")
        nt, nkv = u("Q"), u("Q")
        align = 32
        for _ in range(nkv):
            key = f.read(u("Q"))
            t = u("I")
            if key == b"general.alignment" and t == 4:
                align = u("I")
            else:
                skip(t)
        tensors = []
        for _ in range(nt):
            name = f.read(u("Q")).decode()
            f.seek(8 * u("I") + 4, 1)
            tensors.append((u("Q"), name))
        data = os.path.getsize(path) - (f.tell() + align - 1) // align * align
    tensors.sort()
    for i, (off, name) in enumerate(tensors):
        size = (tensors[i + 1][0] if i + 1 < len(tensors) else data) - off
        if name.startswith("per_layer_token_embd"):
            ngram += size
        else:
            total += size
print(total, ngram)
PY
}

# Lower bound for a command never measured: the size of the files it loads.
_estimate_cmd_mib() {
    local -a w; read -ra w <<< "$1"
    local i bytes=0 f
    if [[ "${w[1]:-}" == */main.py ]]; then
        echo 1024; return          # ComfyUI idle; its workflows load later
    fi
    for (( i=0; i < ${#w[@]} - 1; i++ )); do
        case "${w[i]}" in
            -m|--model|--mmproj|-md|--model-draft)
                f="${w[i+1]}"
                # A split GGUF loads all of its parts.
                if [[ "$f" =~ -00001-of-[0-9]+\.gguf$ ]]; then
                    for f in "${f%-00001-of-*}"-*-of-*.gguf; do bytes=$(( bytes + $(stat -c%s "$f" 2>/dev/null || echo 0) )); done
                else
                    bytes=$(( bytes + $(stat -c%s "$f" 2>/dev/null || echo 0) ))
                fi ;;
        esac
    done
    # halogen: its files are no guide — the n-gram table beside the weights is
    # read through the page cache, not loaded. 62 GiB pinned weights (v2) and
    # ~20 GiB of KV pool and working memory, as models.conf describes it.
    # halogen-server: the checkpoint (mapped), the prompt cache it was given, the
    # KV pool (64 KiB per position and slot) and ~4.5 GiB of working memory —
    # 20.5 GiB of GPU memory for one 256K slot, measured.
    if [[ " ${w[*]} " == *" --name $HALOGEN_CONTAINER_PREFIX"* && "$(_halogen_flavor "${w[${#w[@]}-1]}")" == server ]]; then
        local ckpt="" mdir="" cache_mb=0 kv_slots=1 sctx=$HALOGEN_NATIVE_CTX prev=""
        for (( i=0; i < ${#w[@]}; i++ )); do
            case "$prev" in
                -v) [[ "${w[i]}" == *:/models:ro ]] && mdir="${w[i]%:/models:ro}" ;;
                -e) case "${w[i]}" in
                        HALOGEN_CHECKPOINT=*) ckpt="${w[i]#*=/models/}" ;;
                        HALOGEN_CACHE_MB=*) cache_mb="${w[i]#*=}" ;;
                        HALOGEN_KV_SLOTS=*) kv_slots="${w[i]#*=}" ;;
                        HALOGEN_SLOT_CTX=*) sctx="${w[i]#*=}" ;;
                    esac ;;
            esac
            prev="${w[i]}"
        done
        # No cache size: the server takes most of what is free; say 50 GiB.
        [[ " ${w[*]} " == *" HALOGEN_CACHE_MB="* ]] || cache_mb=50000
        bytes=$(stat -c%s "$mdir/$ckpt" 2>/dev/null || echo 0)
        echo $(( bytes / 1048576 + cache_mb + kv_slots * sctx / 16 + 4608 ))
        return
    fi
    [[ " ${w[*]} " == *" --name $HALOGEN_CONTAINER_PREFIX"* ]] && { echo $(( 84 * 1024 )); return; }
    # gufo: the GGUF and its draft (host paths from the label and the mounts),
    # ~6 GiB of working memory, and the KV it reserves for every session —
    # ~2 GiB per 32K tokens of context. Measured with Qwen3.8-27B Q8 and
    # DFlash2, two sessions: 41 / 45 / 54 / 68 GiB at 32K / 64K / 128K / 256K.
    # Flash-Next is read differently: its n-gram table stays on the SSD (read
    # with O_DIRECT, outside the page cache), and its state per session is
    # smaller — ~8 GiB of working memory and snapshot cache, ~0.9 GiB per 32K
    # and session. Measured with the unsloth UD-Q4_K_XL and its MTP head, two
    # sessions: 94 / 101 GiB at 128K / 256K.
    if [[ " ${w[*]} " == *" --name $GUFO_CONTAINER_PREFIX"* ]]; then
        local model="" draft_dir="" draft="" ctx_n=0 sess=1 prev=""
        for (( i=0; i < ${#w[@]}; i++ )); do
            case "$prev" in
                --label) [[ "${w[i]}" == llmctl.model=* ]] && model="${w[i]#llmctl.model=}" ;;
                -v) [[ "${w[i]}" == *:/draft:ro ]] && draft_dir="${w[i]%:/draft:ro}" ;;
                --dflash-model|--mtp-model) draft="${w[i]##*/}" ;;
                --context) ctx_n="${w[i]}" ;;
                --sessions) sess="${w[i]}" ;;
            esac
            prev="${w[i]}"
        done
        local resident ngram
        read -r resident ngram < <(_gguf_resident_bytes "$model")
        bytes=$resident
        [[ -n "$draft_dir" && -n "$draft" ]] && bytes=$(( bytes + $(stat -c%s "$draft_dir/$draft" 2>/dev/null || echo 0) ))
        if (( ngram > 0 )); then
            echo $(( bytes / 1048576 + 8 * 1024 + 896 * sess * ctx_n / 32768 ))
        else
            echo $(( bytes / 1048576 + 6 * 1024 + 2048 * sess * ctx_n / 32768 ))
        fi
        return
    fi
    echo $(( bytes / 1048576 ))
}

# The memory balance of a preset's target set, printed under its plan.
# Expects e_cmd, e_slot, e_model, e_label from cmd_preset.
_preset_memory_check() {
    local total_mib=$(( $(_gtt_total_bytes) / 1048576 ))
    (( total_mib > 0 )) || return 0
    # Whatever else is on the GPU now (desktop, programs outside llmctl): the
    # pool minus what our running slots hold.
    local ours=0 s m
    for s in $(_active_slots); do
        m=$(_slot_gtt_mib "$s" 2>/dev/null) && ours=$(( ours + m ))
    done
    local outside_mib=$(( $(_gtt_used_bytes) / 1048576 - ours ))
    (( outside_mib < 0 )) && outside_mib=0
    local budget=$(( total_mib - outside_mib - GTT_RESERVE_MIB ))

    echo ""
    echo "GPU memory (GTT pool $(_gib "$total_mib"), $(_gib "$outside_mib") used outside llmctl, $(_gib "$GTT_RESERVE_MIB") kept free):"
    local i sum=0 estimated=0 comfy=""
    for (( i=0; i < ${#e_cmd[@]}; i++ )); do
        local mib how
        mib=$(_lookup_footprint "${e_cmd[i]}")
        if [[ -n "$mib" ]]; then
            how="measured"
        else
            mib=$(_estimate_cmd_mib "${e_cmd[i]}"); how="weights only — not measured yet"
            [[ " ${e_cmd[i]} " == *" --name $HALOGEN_CONTAINER_PREFIX"* || " ${e_cmd[i]} " == *" --name $GUFO_CONTAINER_PREFIX"* ]] && how="estimate — not measured yet"
            estimated=1
        fi
        _resolve_model "${e_model[i]}" && [[ "$_r_backend" == comfyui ]] && { comfy="${e_model[i]}"; how="idle; workflows load on top"; }
        _resolve_model "${e_model[i]}" && [[ "$_r_backend" == tts && "$(basename "$_r_binary")" != llama-server* ]] && how="only while it speaks"
        sum=$(( sum + mib ))
        printf "  slot %-3s %-14s %9s  (%s)\n" "${e_slot[i]}" "${e_model[i]}" "$(_gib "$mib")" "$how"
    done
    printf "  %-23s %9s  of %s available\n" "total" "$(_gib "$sum")" "$(_gib "$budget")"
    local with_halogen=false
    for (( i=0; i < ${#e_cmd[@]}; i++ )); do
        [[ " ${e_cmd[i]} " == *" --name $HALOGEN_CONTAINER_PREFIX"* ]] && with_halogen=true
    done
    [[ "$with_halogen" == true ]] && echo "  (halogen counts its pinned weights too: they come out of the same RAM)"
    if (( sum > budget )) && [[ "$with_halogen" == true ]]; then
        # Beside halogen an overcommit does not fail cleanly: its pinned weights
        # stay, and what gives way is the page cache and then swap.
        echo "  This set does not fit beside halogen — not starting it. Drop an entry,"
        echo "  or start the slots by hand with --ignore-memory."
        return 1
    elif (( sum > budget )); then
        echo "  WARNING: this set needs more than the GPU has free — a model will likely fail"
        echo "           to load. Loading anyway; what fails is rolled back."
    elif (( estimated )); then
        echo "  (estimates are lower bounds: KV cache and buffers come on top)"
    fi
    if [[ -n "$comfy" ]]; then
        local left=$(( budget - sum )) bytes wf n_fit=0 biggest="" 
        local -a too=()
        _resolve_model "$comfy"
        _comfyui_paths
        while IFS=$'\t' read -r bytes wf; do
            if (( bytes / 1048576 <= left )); then
                n_fit=$(( n_fit + 1 )); biggest="$wf, $(_gib $(( bytes / 1048576 )))"
            else
                too+=("$wf ($(_gib $(( bytes / 1048576 ))))")
            fi
        done < <(python3 "$COMFYUI_MODELS_SCRIPT" sizes "$c_wf" "$c_models" 2>/dev/null | sort -n)
        if (( ${#too[@]} == 0 )); then
            echo "  ComfyUI has $(_gib "$left") left: all $n_fit workflows fit (largest: $biggest of weights)"
        else
            echo "  ComfyUI has $(_gib "$left") left: $n_fit workflows fit, these do not (weights):"
            printf '    %s\n' "${too[@]}"
        fi
    fi
}

_gib() { awk -v m="$1" 'BEGIN { printf "%.1f GiB", m / 1024 }'; }

# ── Capturing a running configuration ───────────────────────
#
# The reverse of `preset`: read what is running and write it back as a preset.
# Nothing here is trusted on derivation alone — every entry it builds is fed
# back through `start --print-cmd` and has to reproduce the server's own argv
# flag for flag before it may be written (see _capture_slot).

# Every model name in models.conf that points at a given .gguf. Usually one, but
# two entries may share a file and differ only in flags, and then the
# verification below is what tells them apart.
_names_for_model_path() {
    local path="$1" entry
    local -a f
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        [[ "${f[2]//\~/$HOME}" == "$path" ]] && echo "${f[0]}"
    done
}

# The level name that produced a given --reasoning-effort for this model, i.e.
# _translate_reasoning read backwards through reasoning_levels.
_level_for_effort() {
    local effort="$1" map="$2" pair level
    for level in $REASONING_LEVELS; do
        for pair in $map; do
            [[ "${pair%%=*}" == "$level" && "${pair#*=}" == "$effort" ]] && { echo "$level"; return 0; }
        done
    done
    # No map (mode "unknown"): the canonical name was passed through unchanged.
    [[ -z "$map" ]] && { echo "$effort"; return 0; }
    return 1
}

# Turn the process running on a slot back into a preset entry.
# Sets _cap_entry ("<model> <slot> [flags...]") and _cap_label; returns 1 with an
# explanation on stderr when the running server cannot be expressed as one.
_capture_slot() {
    local slot="$1"
    _cap_diff_name=""; _cap_diff_built=""
    local pid=""
    pid=$(_slot_server_pid "$slot") || { echo "slot $slot: nothing is running there" >&2; return 1; }
    _read_argv "$pid" || { echo "slot $slot: cannot read /proc/$pid/cmdline" >&2; return 1; }
    if _is_halogen_argv; then
        _capture_halogen_slot "$slot"
        return
    fi
    if _is_gufo_argv; then
        _capture_gufo_slot "$slot"
        return
    fi
    if _is_comfyui_argv; then
        _capture_comfyui_slot "$slot"
        return
    fi
    if _is_tts_argv; then
        _capture_tts_slot "$slot"
        return
    fi
    if _is_audiocpp_argv; then
        _capture_audiocpp_slot "$slot"
        return
    fi

    local model="" mmproj="" ctx="" parallel="" predict="" cache_ram="" similarity="" host=""
    local spec_type="" reason="" reason_effort="" reason_budget=""
    local last_temp="" last_top_p=""
    local auth=false verbose=false
    local i=0
    while (( i < ${#_ARGV[@]} )); do
        case "${_ARGV[i]}" in
            -m|--model)               model="${_ARGV[i+1]}";        i=$(( i + 2 )) ;;
            --mmproj)                 mmproj="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            -c|--ctx-size)            ctx="${_ARGV[i+1]}";          i=$(( i + 2 )) ;;
            -np|--parallel)           parallel="${_ARGV[i+1]}";     i=$(( i + 2 )) ;;
            -n|--n-predict)           predict="${_ARGV[i+1]}";      i=$(( i + 2 )) ;;
            --cache-ram)              cache_ram="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --slot-prompt-similarity) similarity="${_ARGV[i+1]}";   i=$(( i + 2 )) ;;
            --host)                   host="${_ARGV[i+1]}";         i=$(( i + 2 )) ;;
            --spec-type)              spec_type="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --reasoning)              reason="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --reasoning-effort)       reason_effort="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --reasoning-budget)       reason_budget="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --api-key-file)           auth=true;                    i=$(( i + 2 )) ;;
            -lv)                      verbose=true;                 i=$(( i + 2 )) ;;
            # Samplers may legitimately repeat — models.conf sets them, --reasoning
            # off may reset them, --temp/--top-p override both. The last wins, so
            # keep overwriting and end up with what the server actually uses.
            --temp)                   last_temp="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --top-p)                  last_top_p="${_ARGV[i+1]}";   i=$(( i + 2 )) ;;
            *)                                                      i=$(( i + 1 )) ;;
        esac
    done

    if [[ -z "$model" ]]; then
        echo "slot $slot: the running process names no --model; it was not started from here" >&2
        return 1
    fi
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    if (( ${#candidates[@]} == 0 )); then
        echo "slot $slot: $(basename "$model") is not in models.conf — add it there first" >&2
        return 1
    fi

    # GGML_VK_QUEUE_PRIORITY lives in the environment, not in argv, so the
    # verification below cannot see it — read it from the process itself.
    local gpu_priority=""
    if [[ -r "/proc/$pid/environ" ]]; then
        gpu_priority=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null |
                       sed -n 's/^GGML_VK_QUEUE_PRIORITY=//p' | head -1)
    fi
    local proxy_up=false
    _slot_proxy_pid "$slot" > /dev/null && proxy_up=true

    local name
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local -a flags=()
        # A token file means --tunnel (it brings the proxy along).
        if [[ "$auth" == true ]]; then
            flags+=(--tunnel)
        else
            [[ "$proxy_up" == true ]] && flags+=(--proxy)
        fi
        # --tunnel brings a cap of its own; only a different one needs saying.
        [[ -n "$predict" ]] && ! [[ "$auth" == true && "$predict" == "$TUNNEL_MAX_PREDICT_DEFAULT" ]] &&
            flags+=(--max-predict "$predict")

        # Reasoning, read back through _translate_reasoning's own rules.
        if [[ "$reason" == "off" ]]; then
            flags+=(--reasoning off)
        elif [[ -n "$reason_effort" ]]; then
            local level=""
            level=$(_level_for_effort "$reason_effort" "$_r_reasoning_levels") || {
                echo "slot $slot: reasoning effort '$reason_effort' matches no level of '$name'" >&2
                continue; }
            flags+=(--reasoning "$level")
        elif [[ -n "$reason_budget" ]]; then
            flags+=(--reasoning "$reason_budget")
        elif [[ "$reason" == "on" ]]; then
            flags+=(--reasoning on)
        fi

        [[ -n "$parallel" && "$parallel" != "1" ]] && flags+=(--parallel "$parallel")
        [[ -n "$ctx" && "$ctx" != "$_r_ctx" ]] && flags+=(--ctx "$ctx")
        [[ -n "$cache_ram" ]] && flags+=(--cache-ram "$cache_ram")
        [[ -n "$similarity" ]] && flags+=(--similarity "$similarity")
        [[ -n "$mmproj" ]] && flags+=(--mmproj)
        [[ -n "$host" ]] && flags+=(--host "$host")
        [[ -n "$gpu_priority" ]] && flags+=(--gpu-priority "$gpu_priority")
        [[ "$verbose" == true ]] && flags+=(--verbose)
        # Speculation is on by default wherever the model declares it, so only
        # its absence needs saying.
        [[ ${#_r_spec_args[@]} -gt 0 && -z "$spec_type" ]] && flags+=(--spec off)

        # The proof: what these flags mean has to be what is actually running.
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot ${flags[*]}"
            _cap_label="$_r_label"
            return 0
        fi

        # Second try with the samplers the process ends on. Unlike every other flag
        # these cannot simply be read off: models.conf sets them for every model, so
        # only a comparison shows whether this server was given different ones. The
        # smallest set that reproduces the command wins, so a captured entry never
        # carries a --temp that merely repeats the model's own.
        local attempt
        for attempt in temp top-p both; do
            local -a flags2=("${flags[@]}")
            case "$attempt" in
                temp)  [[ -n "$last_temp" ]] || continue
                       flags2+=(--temp "$last_temp") ;;
                top-p) [[ -n "$last_top_p" ]] || continue
                       flags2+=(--top-p "$last_top_p") ;;
                both)  [[ -n "$last_temp" && -n "$last_top_p" ]] || continue
                       flags2+=(--temp "$last_temp" --top-p "$last_top_p") ;;
            esac
            local built2=""
            built2=$( cmd_start "$name" "$slot" "${flags2[@]}" --print-cmd 2>/dev/null ) || continue
            if [[ "$built2" == "${_ARGV[*]}" ]]; then
                _cap_entry="$name $slot ${flags2[*]}"
                _cap_label="$_r_label"
                return 0
            fi
        done
        _cap_diff_name="$name"
        _cap_diff_built="$built"
    done

    # Nothing verified: say where it parts ways rather than writing a guess.
    echo "slot $slot: cannot express the running server as start options." >&2
    if [[ -n "${_cap_diff_built:-}" ]]; then
        echo "  closest is '$_cap_diff_name', which would run:" >&2
        echo "    $_cap_diff_built" >&2
        echo "  while the process runs:" >&2
        echo "    ${_ARGV[*]}" >&2
    fi
    echo "  it was probably started by hand with flags llmctl does not offer." >&2
    return 1
}

# _capture_slot for a halogen server: its settings are the container's
# environment, read back into the start options that produce them.
_capture_halogen_slot() {
    local slot="$1" model
    model=$(_argv_halogen_model) || { echo "slot $slot: the container carries no llmctl.model label" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    if (( ${#candidates[@]} == 0 )); then
        echo "slot $slot: $(basename "$model") is not in models.conf — add it there first" >&2
        return 1
    fi
    local host="" i
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "-p" ]] && host="${_ARGV[i+1]%%:*}"
    done
    [[ "$host" == "127.0.0.1" ]] && host=""
    local ctx slots think effort budget temp top_p cap cache vision
    ctx=$(_argv_env HALOGEN_CTX); slots=$(_argv_env HALOGEN_KV_SLOTS)
    think=$(_argv_env HALOGEN_ENABLE_THINKING); effort=$(_argv_env HALOGEN_REASONING_EFFORT)
    budget=$(_argv_env HALOGEN_MAX_THINKING_TOKENS)
    temp=$(_argv_env HALOGEN_TEMPERATURE); top_p=$(_argv_env HALOGEN_TOP_P)
    cap=$(_argv_env HALOGEN_MAX_TOKENS_CAP); cache=$(_argv_env HALOGEN_PROMPT_CACHE)
    vision=$(_argv_env HALOGEN_VISION_TOWER)
    # halogen-server: its own context variable, a cache size, and request defaults
    # where halogen-flash has environment variables.
    local cache_mb=""
    if [[ "$(_argv_halogen_flavor)" == server ]]; then
        ctx=$(_argv_env HALOGEN_SLOT_CTX); cache_mb=$(_argv_env HALOGEN_CACHE_MB)
        effort=$(_argv_default reasoning_effort)
        [[ "$effort" == none ]] && { think=0; effort=""; }
        temp=$(_argv_default temperature); top_p=$(_argv_default top_p)
    fi
    local tunnelled=false
    _tunnel_up "$slot" && tunnelled=true

    local name
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local -a flags=()
        [[ "$tunnelled" == true ]] && flags+=(--tunnel)
        # --tunnel implies a cap of its own; only a different one needs saying.
        if [[ -n "$cap" ]] && ! [[ "$tunnelled" == true && "$cap" == "$TUNNEL_MAX_PREDICT_DEFAULT" ]]; then
            flags+=(--max-predict "$cap")
        fi
        if [[ "$think" == "0" ]]; then
            flags+=(--reasoning off)
        elif [[ -n "$effort" ]]; then
            local level=""
            level=$(_level_for_effort "$effort" "$_r_reasoning_levels") || continue
            flags+=(--reasoning "$level")
        elif [[ -n "$budget" ]]; then
            flags+=(--reasoning "$budget")
        fi
        # The entry's own extra_args may set the slots; only a change is a flag.
        local own_slots="" kv
        for kv in "${_r_args[@]}"; do [[ "$kv" == HALOGEN_KV_SLOTS=* ]] && own_slots="${kv#*=}"; done
        [[ -n "$slots" && "$slots" != "$own_slots" ]] && flags+=(--parallel "$slots")
        [[ -n "$ctx" && "$ctx" != "${_r_ctx:-$HALOGEN_NATIVE_CTX}" ]] && flags+=(--ctx "$ctx")
        [[ "$cache" == "0" ]] && flags+=(--cache-ram 0)
        local own_cache=""
        for kv in "${_r_args[@]}"; do [[ "$kv" == HALOGEN_CACHE_MB=* ]] && own_cache="${kv#*=}"; done
        [[ -n "$cache_mb" && "$cache_mb" != "$own_cache" ]] && flags+=(--cache-ram "$cache_mb")
        [[ -n "$vision" ]] && flags+=(--mmproj)
        [[ -n "$host" ]] && flags+=(--host "$host")
        [[ -n "$temp" ]] && flags+=(--temp "$temp")
        [[ -n "$top_p" ]] && flags+=(--top-p "$top_p")

        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot ${flags[*]}"
            _cap_label="$_r_label"
            return 0
        fi
        _cap_diff_name="$name"; _cap_diff_built="$built"
    done
    echo "slot $slot: cannot express the running halogen server as start options." >&2
    if [[ -n "${_cap_diff_built:-}" ]]; then
        echo "  closest is '$_cap_diff_name', which would run:" >&2
        echo "    $_cap_diff_built" >&2
        echo "  while the process runs:" >&2
        echo "    ${_ARGV[*]}" >&2
    fi
    return 1
}

# _capture_slot for ComfyUI: the entry is found by its models directory, and
# only --host and --verbose can differ between two starts of it.
_capture_comfyui_slot() {
    local slot="$1" models host name
    models=$(_argv_flag --models-directory) || { echo "slot $slot: ComfyUI runs without --models-directory" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$models")
    if (( ${#candidates[@]} == 0 )); then
        echo "slot $slot: no comfyui entry in models.conf has $models as its model directory" >&2
        return 1
    fi
    host=$(_argv_flag --listen) || host=""
    [[ "$host" == "127.0.0.1" ]] && host=""
    local -a flags=()
    [[ -n "$host" ]] && flags+=(--host "$host")
    local out
    out=$(_argv_flag --output-directory) && flags+=(--output "$out")
    [[ "$(_argv_flag --verbose)" == DEBUG ]] && flags+=(--verbose)
    _slot_proxy_pid "$slot" > /dev/null && flags+=(--proxy)
    _tunnel_up "$slot" && flags+=(--tunnel)
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot${flags[*]:+ ${flags[*]}}"
            _cap_label="$_r_label"
            return 0
        fi
        _cap_diff_name="$name"; _cap_diff_built="$built"
    done
    echo "slot $slot: cannot express the running ComfyUI as start options." >&2
    if [[ -n "${_cap_diff_built:-}" ]]; then
        echo "  closest is '$_cap_diff_name', which would run:" >&2
        echo "    $_cap_diff_built" >&2
        echo "  while the process runs:" >&2
        echo "    ${_ARGV[*]}" >&2
    fi
    return 1
}

cmd_preset_save() {
    local name="" label="" dry_run=false force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --force) force=true; shift ;;
            --label) _need_value "$@" || exit 1; label="$2"; shift 2 ;;
            -*) echo "Unknown option: $1"; exit 1 ;;
            *) [[ -z "$name" ]] && name="$1"; shift ;;
        esac
    done

    [[ -z "$name" ]] && { echo "Usage: $PROG preset-save <name> [--label TEXT] [--dry-run] [--force]"; exit 1; }
    if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "Error: a preset name may hold letters, digits, dot, dash and underscore; got '$name'"; exit 1
    fi
    # A dry run writes nothing, so an existing name is worth showing, not refusing.
    if _resolve_preset "$name" && [[ "$force" != true && "$dry_run" != true ]]; then
        echo "Error: preset '$name' already exists in presets.conf."
        echo "       Pass --force to replace it, or pick another name."
        exit 1
    fi

    local -a entries=() labels=()
    local slot
    for slot in $(_active_slots); do
        _slot_server_pid "$slot" > /dev/null || continue
        _capture_slot "$slot" || exit 1
        entries+=("$_cap_entry")
        labels+=("$_cap_label")
    done
    if (( ${#entries[@]} == 0 )); then
        echo "Nothing is running — there is no configuration to save."
        exit 1
    fi

    # Default label: the models themselves, which is what the listing shows.
    if [[ -z "$label" ]]; then
        local l
        for l in "${labels[@]}"; do label+="${label:+ + }$l"; done
    fi
    label="${label//\"/\'}"     # the label is written inside a double-quoted assignment

    # Align the model column the way the hand-written entries are aligned.
    local width=0 e
    for e in "${entries[@]}"; do
        local m="${e%% *}"
        (( ${#m} > width )) && width=${#m}
    done

    local block=""
    block+="# Captured from the running configuration on $(date +%F)."$'\n'
    block+="# Verified: each entry reproduces its server's own argv flag for flag."$'\n'
    block+="_preset_name=\"$name\""$'\n'
    block+="_preset_label=\"$label\""$'\n'
    block+="_preset_entries=("$'\n'
    for e in "${entries[@]}"; do
        local m="${e%% *}" rest="${e#* }"
        rest="${rest%"${rest##*[! ]}"}"          # an entry without flags ends in a space
        block+="$(printf '    "%-*s %s"' "$width" "$m" "$rest")"$'\n'
    done
    block+=")"$'\n'
    block+="add_preset"$'\n'

    if [[ "$dry_run" == true ]]; then
        echo ""
        if _resolve_preset "$name"; then
            echo "Would replace the existing preset '$name' in $CONFIG_DIR/presets.conf with:"
        else
            echo "Would append to $CONFIG_DIR/presets.conf:"
        fi
        echo ""
        printf '%s' "$block" | sed 's/^/  /'
        echo ""
        return 0
    fi

    # Resolved, so a presets.conf linked to a checkout is rewritten there and the
    # link itself survives.
    local conf
    conf="$(readlink -f "$CONFIG_DIR/presets.conf")"
    if [[ ! -w "$conf" ]]; then
        echo "Error: cannot write $conf"; exit 1
    fi
    # Replacing: drop the old block and the comment lines that belong to it, so
    # --force leaves no stale description behind.
    if _resolve_preset "$name"; then
        local tmp
        tmp=$(mktemp) || { echo "Error: cannot create a temporary file"; exit 1; }
        PRESET_NAME="$name" awk '
            /^_preset_name="/ {
                if ($0 == "_preset_name=\"" ENVIRON["PRESET_NAME"] "\"") { drop = 1; hold_n = 0; next }
                for (i = 1; i <= hold_n; i++) print hold[i]
                hold_n = 0
            }
            drop { if ($0 == "add_preset") drop = 0; next }
            /^#/ { hold[++hold_n] = $0; next }          # comments may belong to the next block
            /^[[:space:]]*$/ && hold_n > 0 { for (i = 1; i <= hold_n; i++) print hold[i]; hold_n = 0 }
            { for (i = 1; i <= hold_n; i++) print hold[i]; hold_n = 0; print }
            END { for (i = 1; i <= hold_n; i++) print hold[i] }
        ' "$conf" > "$tmp" || { rm -f "$tmp"; echo "Error: rewriting $conf failed"; exit 1; }
        # Collapse the blank lines the removed block left behind.
        awk 'NF == 0 { blank++; next } { while (blank > 2) blank--; while (blank-- > 0) print ""; blank = 0; print }' \
            "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
        cat "$tmp" > "$conf" && rm -f "$tmp"
        echo "Replaced the previous preset '$name'."
    fi

    printf '\n%s' "$block" >> "$conf"

    # Read it back the way llmctl will: a block that does not load is a bug that
    # has to surface here, not on the next start.
    if ! bash -n "$conf" 2>/dev/null; then
        echo "Error: $conf no longer parses — please check the end of the file."
        exit 1
    fi
    echo ""
    echo "Saved preset '$name' to $conf:"
    echo ""
    printf '%s' "$block" | sed 's/^/  /'
    echo ""
    echo "  $PROG preset $name          bring the machine back to it"
    echo "  $PROG preset $name --dry-run   check it against what runs now"
    echo ""
}

# Read a running process's argv (NUL-separated in /proc) into $_ARGV.
_read_argv() {
    local pid="$1"
    _ARGV=()
    [[ -r "/proc/$pid/cmdline" ]] || return 1
    mapfile -d '' -t _ARGV < "/proc/$pid/cmdline" 2>/dev/null || return 1
    (( ${#_ARGV[@]} > 0 )) || return 1
    return 0
}

# Find the models.conf entry whose model file matches $1; on a hit the label is
# printed and the name returned, so status can name the model the way `list` does.
_label_for_model_path() {
    local path="$1" entry
    local -a f
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        if [[ "${f[2]//\~/$HOME}" == "$path" ]]; then
            echo "${f[5]}"
            return 0
        fi
    done
    return 1
}

# Describe a running llama-server from its own argv rather than from what the
# last start printed: the process is the ground truth even when the log belongs
# to an older run or the server was started by hand.
_describe_server() {
    local pid="$1"
    local indent="${2:-         }"
    if ! _read_argv "$pid"; then
        echo "${indent}Model:     unknown (cannot read /proc/$pid/cmdline)"
        return 0
    fi
    if _is_halogen_argv; then
        _describe_halogen "$indent"
        return 0
    fi
    if _is_gufo_argv; then
        _describe_gufo "$pid" "$indent"
        return 0
    fi
    if _is_comfyui_argv; then
        _describe_comfyui "$pid" "$indent"
        return 0
    fi
    if _is_tts_argv; then
        _describe_tts "$indent"
        return 0
    fi
    if _is_audiocpp_argv; then
        _describe_audiocpp "$indent"
        return 0
    fi

    local model="" served="" ctx="" parallel="" predict="" cache_ram="" mmproj="" host="" similarity=""
    local spec_type="" spec_draft="" spec_n=""
    local reason="" reason_effort="" reason_budget=""
    local auth=false role="" port=""
    local i=0
    while (( i < ${#_ARGV[@]} )); do
        case "${_ARGV[i]}" in
            -m|--model)          model="${_ARGV[i+1]}";        i=$(( i + 2 )) ;;
            --alias)             served="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            -c|--ctx-size)       ctx="${_ARGV[i+1]}";          i=$(( i + 2 )) ;;
            -np|--parallel)      parallel="${_ARGV[i+1]}";     i=$(( i + 2 )) ;;
            -n|--n-predict)      predict="${_ARGV[i+1]}";      i=$(( i + 2 )) ;;
            --cache-ram)         cache_ram="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --slot-prompt-similarity) similarity="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --mmproj)            mmproj="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --host)              host="${_ARGV[i+1]}";         i=$(( i + 2 )) ;;
            --spec-type)         spec_type="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            -md|--model-draft)   spec_draft="${_ARGV[i+1]}";   i=$(( i + 2 )) ;;
            --spec-draft-n-max)  spec_n="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --reasoning)         reason="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --reasoning-effort)  reason_effort="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --reasoning-budget)  reason_budget="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --api-key-file)      auth=true;                    i=$(( i + 2 )) ;;
            --port)              port="${_ARGV[i+1]}";         i=$(( i + 2 )) ;;
            --embedding|--embeddings) role=embedding;          i=$(( i + 1 )) ;;
            --reranking|--rerank) role=rerank;                 i=$(( i + 1 )) ;;
            *)                                                 i=$(( i + 1 )) ;;
        esac
    done

    # A model started outside llmctl has no models.conf entry — fall back to the file.
    local label=""
    [[ -n "$model" ]] && label=$(_label_for_model_path "$model")
    [[ -z "$label" && -n "$model" ]] && label="$(basename "$model")"
    echo "${indent}Model:     ${label:-unknown}${served:+ ($served)}"

    # Parameters that change what the server does, in the order start prints them.
    local -a params=("ctx ${ctx:-default}" "parallel ${parallel:-1}")
    [[ -n "$predict" ]]   && params+=("n-predict $predict")
    case "$cache_ram" in
        "")   ;;
        0)    params+=("prompt-cache off") ;;
        -1)   params+=("prompt-cache unlimited") ;;
        *)    params+=("prompt-cache ${cache_ram} MiB") ;;
    esac
    case "$similarity" in
        "")     ;;
        0|0.0*) params+=("slot pick LRU") ;;
        *)      params+=("slot similarity $similarity") ;;
    esac
    [[ -n "$mmproj" ]]    && params+=("mmproj")
    [[ -n "$host" ]]      && params+=("host $host")
    [[ "$auth" == true ]] && params+=("token auth")
    local joined="" p
    for p in "${params[@]}"; do joined+="${joined:+, }$p"; done
    echo "${indent}Params:    $joined"

    # Nothing is generated: reasoning and drafting do not apply.
    case "$role" in
        embedding) echo "${indent}Serves:    embeddings — POST http://${host:-127.0.0.1}:$port/v1/embeddings"; return 0 ;;
        rerank)    echo "${indent}Serves:    reranking — POST http://${host:-127.0.0.1}:$port/v1/rerank"; return 0 ;;
    esac

    # --reasoning off comes with a budget of 0; naming both would say it twice.
    if [[ "$reason" == "off" ]]; then
        echo "${indent}Reasoning: off"
    elif [[ -n "$reason$reason_effort$reason_budget" ]]; then
        local note="${reason:-on}"
        [[ -n "$reason_effort" ]] && note+=", effort $reason_effort"
        [[ -n "$reason_budget" ]] && note+=", budget $reason_budget"
        echo "${indent}Reasoning: $note"
    else
        echo "${indent}Reasoning: template default"
    fi

    if [[ -n "$spec_type$spec_draft$spec_n" ]]; then
        local note="${spec_type:-on}"
        [[ -n "$spec_draft" ]] && note+=", draft $(basename "$spec_draft")"
        [[ -n "$spec_n" ]]     && note+=", n-max $spec_n"
        echo "${indent}Spec:      $note"
    else
        echo "${indent}Spec:      off"
    fi
}

# _describe_server for a halogen server, from the container environment in $_ARGV.
_describe_halogen() {
    local indent="$1" model label host="" i
    model=$(_argv_halogen_model) || model=""
    label=$(_label_for_model_path "$model") || label="$(basename "${model:-unknown}")"
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "-p" ]] && host="${_ARGV[i+1]%%:*}"
    done
    echo "${indent}Model:     $label ($(_argv_env HALOGEN_MODEL_ID || echo "?"))"
    if [[ "$(_argv_halogen_flavor)" == server ]]; then
        _describe_halogen_server "$indent" "$host"
        return
    fi
    local ctx yarn
    ctx=$(_argv_env HALOGEN_CTX); yarn=$(_argv_env HALOGEN_ROPE_YARN)
    local -a params=("ctx ${ctx:-$HALOGEN_NATIVE_CTX}${yarn:+ (YaRN x$yarn)}"
                     "parallel $(_argv_env HALOGEN_KV_SLOTS || echo 4)"
                     "pool $(_argv_env HALOGEN_KV_POOL_POSITIONS || echo default)")
    local v
    v=$(_argv_env HALOGEN_MAX_TOKENS_CAP) && params+=("token cap $v")
    [[ "$(_argv_env HALOGEN_PROMPT_CACHE)" == "0" ]] && params+=("prompt-cache off")
    _argv_env HALOGEN_VISION_TOWER > /dev/null && params+=("vision")
    [[ -n "$host" && "$host" != "127.0.0.1" ]] && params+=("host $host")
    local joined="" p
    for p in "${params[@]}"; do joined+="${joined:+, }$p"; done
    echo "${indent}Params:    $joined"
    if [[ "$(_argv_env HALOGEN_ENABLE_THINKING)" == "0" ]]; then
        echo "${indent}Reasoning: off by default"
    elif v=$(_argv_env HALOGEN_REASONING_EFFORT); then
        echo "${indent}Reasoning: default effort $v"
    elif v=$(_argv_env HALOGEN_MAX_THINKING_TOKENS); then
        echo "${indent}Reasoning: budget $v"
    else
        echo "${indent}Reasoning: server default (effort xhigh)"
    fi
    echo "${indent}Spec:      MTP (always on)"
    if [[ "$(_argv_env HALOGEN_WEIGHTS_LOCK)" == "1" ]]; then
        echo "${indent}Memory:    $(_halogen_mem_line "$LOG_DIR/server-${slot}.log")"
    else
        echo "${indent}Memory:    real use — free(1) counts the pinned weights as cache:"
        echo "${indent}           $(_halogen_mem_line "$LOG_DIR/server-${slot}.log")"
    fi
}

# _describe_halogen for halogen-server.
_describe_halogen_server() {
    local indent="$1" host="$2" v slots
    slots=$(_argv_env HALOGEN_KV_SLOTS) || slots=1
    local -a params=("ctx $(_argv_env HALOGEN_SLOT_CTX || echo "$HALOGEN_NATIVE_CTX")" "parallel $slots")
    v=$(_argv_env HALOGEN_MAX_TOKENS_CAP) && params+=("token cap $v")
    case "$(_argv_env HALOGEN_CACHE_MB)" in
        "") params+=("prompt-cache auto") ;;
        0)  params+=("prompt-cache off") ;;
        *)  params+=("prompt-cache $(_argv_env HALOGEN_CACHE_MB) MiB") ;;
    esac
    [[ -n "$host" && "$host" != "127.0.0.1" ]] && params+=("host $host")
    local joined="" p
    for p in "${params[@]}"; do joined+="${joined:+, }$p"; done
    echo "${indent}Params:    $joined"
    if v=$(_argv_default reasoning_effort); then
        echo "${indent}Reasoning: request default effort $v"
    else
        echo "${indent}Reasoning: template default (effort xhigh)"
    fi
    local -a dn=(serial MTP DFlash2)
    v=$(_argv_env HALOGEN_DRAFTER) || v=2
    if (( slots > 1 )); then
        echo "${indent}Spec:      off ($slots slots)"
    else
        echo "${indent}Spec:      ${dn[v]:-drafter $v} by default"
    fi
    local gtt rss
    gtt=$(_slot_gtt_mib "$slot" 2>/dev/null) || gtt=0
    rss=$(_container_rss_mib "$(_halogen_container "$slot")")
    awk -v g="$gtt" -v r="$rss" -v i="$indent" 'BEGIN {
        printf "%sMemory:    GPU (GTT) %.1f GiB, RAM %.1f GiB (mapped checkpoint and prompt cache)\n", i, g / 1024, r / 1024 }'
}

# _describe_server for ComfyUI: where its UI is, what it is doing, and how much
# memory it holds right now — which changes with every workflow it loads.
_describe_comfyui() {
    local pid="$1" indent="$2" models host port label q
    models=$(_argv_flag --models-directory) || models=""
    host=$(_argv_flag --listen) || host="127.0.0.1"
    port=$(_argv_flag --port) || port="?"
    label=$(_label_for_model_path "$models") || label="ComfyUI"
    echo "${indent}Model:     $label ($models)"
    [[ "$host" == "0.0.0.0" ]] && host="$(hostname)"
    echo "${indent}UI:        http://$host:$port"
    q=$(_comfyui_queue "$port")
    echo "${indent}Queue:     ${q:-no answer (still starting?)}"
    awk -v g="$(_proc_gpu_mib "$pid")" -v r="$(_proc_rss_mib "$pid")" -v i="$indent" 'BEGIN {
        printf "%sMemory:    GPU %.1f GiB, RAM %.1f GiB (unloaded before every LLM start)\n", i, g / 1024, r / 1024 }'
}

# What is really left: MemAvailable minus the weights halogen pinned, which the
# kernel files under reclaimable page cache although nothing can reclaim them.
# With HALOGEN_WEIGHTS_LOCK=1 (0.13.2) they are mlock'ed, so MemAvailable has
# already dropped by them and subtracting again would count them twice.
_halogen_mem_line() {
    local log="$1" weights gtt
    weights=$(sed -n 's/.*memory: \([0-9.]*\) GiB of weights locked.*/\1/p' "$log" 2>/dev/null | tail -1)
    [[ "$(_argv_env HALOGEN_WEIGHTS_LOCK)" == "1" ]] && weights=0
    gtt=$(cat /sys/class/drm/card*/device/mem_info_gtt_used 2>/dev/null | head -1)
    awk -v w="${weights:-0}" -v gtt="${gtt:-0}" '
        /^MemAvailable:/ { avail = $2 / 1048576 }
        END { real = avail - w; if (real < 0) real = 0
              if (w == 0) printf "GPU (GTT) %.1f GiB, available %.1f GiB (the weights are mlocked, so free(1) counts them)", gtt / 1073741824, avail
              else printf "weights %.1f GiB pinned, GPU (GTT) %.1f GiB, really available %.1f GiB (free(1): %.1f)", w, gtt / 1073741824, real, avail }' /proc/meminfo
}

cmd_status() {
    local found=0
    for slot in $(_active_slots); do
        local port_server=$(( PORT_BASE_SERVER + slot ))
        local port_proxy=$(( PORT_BASE_PROXY + slot ))

        local server_pid="" proxy_pid=""
        server_pid=$(_slot_server_pid "$slot") || server_pid=""
        proxy_pid=$(_slot_proxy_pid "$slot") || proxy_pid=""

        # Written by `preset`, removed by `start` and `stop` — so it only ever
        # names a slot this machine still holds for that preset.
        local preset_note=""
        [[ -s "$PID_DIR/preset-${slot}" ]] && preset_note="  [Preset: $(cat "$PID_DIR/preset-${slot}")]"

        # The detail lines hang under the "Slot N:" prefix, which grows with N.
        local indent
        printf -v indent '%*s' $(( 9 + ${#slot} - 1 )) ''
        if _halogen_orphan "$slot"; then
            echo "Slot $slot: $(printf '%-12s' "$(_slot_container_kind "$slot")") (container $(_slot_container "$slot"), no client process)"
            echo "${indent}Note:      its podman client is gone — the container still holds the weights"
            echo "${indent}           and :$port_server. '$PROG stop $slot' ends it; start it again to manage it."
            found=1
            continue
        fi
        if [[ -n "$server_pid" ]] && ps -p "$server_pid" > /dev/null 2>&1; then
            local kind="llama-server"
            _slot_is_halogen "$slot" && kind="halogen     "
            _slot_is_gufo "$slot" && kind="gufo        "
            _read_argv "$server_pid" && _is_comfyui_argv && kind="comfyui     "
            _read_argv "$server_pid" && _is_tts_argv && kind="tts         "
            _read_argv "$server_pid" && _is_audiocpp_argv && kind="audiocpp    "
            echo "Slot $slot: $kind (PID: $server_pid) on :$port_server$preset_note"
            # A loaded server's footprint, for preset's memory balance. Not
            # ComfyUI's: it swings with every workflow; preset records it idle.
            [[ "$kind" != comfyui* ]] && _record_footprint "$slot"
            _describe_server "$server_pid" "$indent"
            echo "${indent}Log: tail -f $LOG_DIR/server-${slot}.log"
            found=1
        fi
        if [[ -n "$proxy_pid" ]] && ps -p "$proxy_pid" > /dev/null 2>&1; then
            if [[ "$(tr '\0' ' ' < "/proc/$proxy_pid/cmdline" 2>/dev/null)" == *"$IMAGES_SERVER_SCRIPT"* ]]; then
                echo "Slot $slot: image API   (PID: $proxy_pid) on :$port_proxy  POST /v1/images/generations, /v1/images/edits"
            else
                echo "Slot $slot: proxy       (PID: $proxy_pid) on :$port_proxy"
            fi
            found=1
        fi

        local tunnel_pid=""
        [[ -f "$PID_DIR/tunnel-${slot}.pid" ]] && tunnel_pid=$(cat "$PID_DIR/tunnel-${slot}.pid")
        if [[ -n "$tunnel_pid" ]] && ps -p "$tunnel_pid" > /dev/null 2>&1; then
            echo "Slot $slot: tunnel      (PID: $tunnel_pid) to $TUNNEL_HOST"
            found=1
        fi
    done
    [[ "$found" -eq 0 ]] && echo "Nothing running."
    # Explicit, or the guard above would make a slot that IS running exit 1.
    return 0
}

# Candidates for the word being completed, one per line; the shell filters them
# by what is typed so far. The completion scripts in completions/ only hand over
# the words and print this, so both shells complete the same thing.
# "@files" asks the shell for file names instead.
# Usage: _complete <words after llmctl, the last being the one completed>
_complete_models() {   # [backend...]: only models on these backends
    local entry name backend
    local -a f
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        name="${f[0]}" backend="${f[19]:-llama}"
        [[ " ${f[6]} " == *" --embedding "* || " ${f[6]} " == *" --reranking "* ]] && backend=service
        (( $# == 0 )) || [[ " $* " == *" $backend "* ]] && echo "$name"
    done
}
cmd__complete() {
    local -a w=("$@")
    (( ${#w[@]} )) || w=("")
    local n=${#w[@]} sub="${w[0]}" prev=""
    (( n >= 2 )) && prev="${w[n-2]}"
    if (( n == 1 )); then
        printf '%s\n' start preset preset-save presets stop status logs cache-stats clear-kv \
            probe-reasoning bench list env clear shell-init download update voice service darkroom prune outdated help version
        return 0
    fi
    # Positional words before the one completed, options and their values left out.
    local -a pos=()
    local i
    for (( i=1; i < n-1; i++ )); do
        case "${w[i]}" in
            --reasoning|--reasoning-budget|--max-predict|--parallel|--ctx|--cache-ram|--similarity|\
            --host|--gpu-priority|--spec|--temp|--top-p|--output|--lang|--seed|--wait|--label|--from|-n)
                (( i++ )) ;;
            -*) ;;
            *) pos+=("${w[i]}") ;;
        esac
    done
    local k=${#pos[@]}
    case "$prev" in
        --reasoning)    printf '%s\n' off on low medium high max; return 0 ;;
        --spec)         printf '%s\n' on off; return 0 ;;
        --gpu-priority) printf '%s\n' low medium high realtime; return 0 ;;
        --lang)         printf '%s\n' de en zh ja ko fr es it pt ru; return 0 ;;
        --output|--from) echo @files; return 0 ;;
        --reasoning-budget|--max-predict|--parallel|--ctx|--cache-ram|--similarity|--host|\
        --temp|--top-p|--seed|--wait|--label|-n) return 0 ;;
    esac
    local slot_nums; slot_nums=$(seq 1 $(( SLOT_MAX < 9 ? SLOT_MAX : 9 )))
    case "$sub" in
        start)
            case $k in 0) _complete_models ;; 1) echo "$slot_nums" ;; esac
            printf '%s\n' --ignore-memory --proxy --compact --max-predict --reasoning --no-reasoning --reasoning-budget \
                --parallel --ctx --cache-ram --similarity --verbose --clear-logs --host --gpu-priority --mmproj \
                --spec --no-spec --temp --top-p --print-cmd --output --lang --seed --vision --tunnel ;;
        preset)
            (( k == 0 )) && { local e; for e in "${_PRESETS[@]}"; do echo "${e%%|*}"; done; }
            printf '%s\n' --dry-run --force --repair --wait --output --proxy --host --clear-logs --verbose --gpu-priority ;;
        preset-save) printf '%s\n' --dry-run --force --label ;;
        prune) echo --dry-run ;;
        outdated) echo --quick ;;
        self-update) echo --check ;;
        service)
            case $k in
                0) printf '%s\n' enable disable start stop status ;;
                1) [[ "${pos[0]}" == enable ]] && { local e; for e in "${_PRESETS[@]}"; do echo "${e%%|*}"; done; } ;;
            esac ;;
        darkroom) (( k == 0 )) && printf '%s\n' enable disable status key ;;
        stop|clear-kv) (( k == 0 )) && _active_slots ;;
        cache-stats)   (( k == 0 )) && _log_slots ;;
        logs) (( k == 0 )) && _log_slots; printf '%s\n' --proxy -f -n ;;
        env)
            case $k in 0) _complete_models llama halogen ;; 1) echo "$slot_nums" ;; esac
            printf '%s\n' --proxy --direct ;;
        download) (( k == 0 )) && { _complete_models; echo all; }; printf '%s\n' --check --force --from ;;
        update)   (( k == 0 )) && _complete_models comfyui; echo --torch ;;
        bench)    (( k == 0 )) && { _complete_models; echo all; }; echo --full ;;
        probe-reasoning) (( k == 0 )) && _complete_models llama ;;
        voice)
            case "${pos[0]:-}" in
                "") (( k == 0 )) && printf '%s\n' list add design rm export import ;;
                rm) (( k == 1 )) && { local v; for v in "$TTS_VOICES"/*.{wav,mp3,flac}; do
                        [[ -f "$v" ]] && { v="${v##*/}"; echo "${v%.*}"; }; done; } ;;
                add)    (( k == 2 )) && echo @files ;;
                export) (( k == 1 )) && echo @files ;;
                import) (( k == 1 )) && echo @files; echo --force ;;
            esac ;;
    esac
    return 0
}

# Run a preset as a systemd user service: started at login, stopped at logout,
# and its slots brought back when a server dies. The servers live in the
# service's cgroup — `preset` runs as ExecStart, and the repair as ExecReload,
# which a timer asks for every two minutes — so systemd stops what the service
# started. The repair is `preset --repair`: it restarts only slots this preset
# still claims, so switching presets by hand is not undone behind your back.
# Usage: service enable <preset> | disable | start | stop | status
SERVICE_UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
cmd_service() {
    local action="${1:-status}"; shift || true
    local unit="$SERVICE_UNIT_DIR/llmctl.service"
    _check_deps systemctl || return 1
    case "$action" in
        enable)
            local name="${1:-}"
            [[ -n "$name" ]] || { echo "Usage: $PROG service enable <preset>"; return 1; }
            _resolve_preset "$name" || { echo "Unknown preset: $name"; cmd_presets; return 1; }
            local bin; bin=$(command -v "$PROG" 2>/dev/null || readlink -f "$0")
            # A user service starts with systemd's own environment: the PATH that
            # finds llama-server, podman and hf here, and any directory override.
            local -a env=("PATH=$PATH") v
            for v in LLMCTL_CONFIG_DIR LLMCTL_DATA_DIR LLMCTL_STATE_DIR LLMCTL_MODELS_DIR; do
                [[ -n "${!v:-}" ]] && env+=("$v=${!v}")
            done
            mkdir -p "$SERVICE_UNIT_DIR"
            {
                echo "# Written by llmctl service enable — rewritten by the next enable."
                echo "[Unit]"
                echo "Description=llmctl preset $name"
                echo ""
                echo "[Service]"
                echo "Type=oneshot"
                echo "RemainAfterExit=yes"
                for v in "${env[@]}"; do printf 'Environment="%s"\n' "$v"; done
                echo "ExecStart=$bin preset $name"
                echo "ExecReload=$bin preset $name --repair"
                echo "ExecStop=$bin service stop-slots $name"
                echo "TimeoutStartSec=30min"
                echo "TimeoutStopSec=2min"
                echo ""
                echo "[Install]"
                echo "WantedBy=default.target"
            } > "$unit"
            {
                echo "# Written by llmctl service enable."
                echo "[Unit]"
                echo "Description=llmctl: restart what died in the service's preset"
                echo ""
                echo "[Service]"
                echo "Type=oneshot"
                echo "ExecCondition=/usr/bin/systemctl --user is-active --quiet llmctl.service"
                echo "ExecStart=/usr/bin/systemctl --user reload llmctl.service"
            } > "$SERVICE_UNIT_DIR/llmctl-repair.service"
            {
                echo "# Written by llmctl service enable."
                echo "[Unit]"
                echo "Description=llmctl: look for dead slots every two minutes"
                echo ""
                echo "[Timer]"
                echo "OnActiveSec=5min"
                echo "OnUnitActiveSec=2min"
                echo ""
                echo "[Install]"
                echo "WantedBy=timers.target"
            } > "$SERVICE_UNIT_DIR/llmctl-repair.timer"
            systemctl --user daemon-reload
            systemctl --user enable llmctl.service llmctl-repair.timer 2>&1 | grep -v '^Created symlink' || true
            systemctl --user start llmctl-repair.timer
            echo "Preset '$name' starts at your next login, and dead slots come back within ~2 min."
            echo "  Start it now:  $PROG service start   (brings the machine to '$name')"
            if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
                echo "  At boot, before anyone logs in: loginctl enable-linger $USER"
            fi
            ;;
        disable)
            systemctl --user disable --now llmctl-repair.timer 2>/dev/null || true
            systemctl --user disable llmctl.service 2>&1 | grep -v '^Removed' || true
            echo "No preset at login any more, and no repairs. What runs keeps running;"
            echo "  $PROG service stop ends the service's slots, $PROG stop everything."
            ;;
        start|stop)
            [[ -f "$unit" ]] || { echo "No service set up — $PROG service enable <preset>"; return 1; }
            # Not while the service's own start is still running: it may take minutes.
            systemctl --user "$action" --no-block llmctl.service
            [[ "$action" == start ]] && echo "Starting — follow it with: $PROG service status"
            [[ "$action" == stop ]] && echo "Stopping the service's slots — $PROG status shows what is left."
            ;;
        status)
            if [[ ! -f "$unit" ]]; then
                echo "No service set up — $PROG service enable <preset>"
                return 0
            fi
            local name; name=$(sed -n 's/^Description=llmctl preset //p' "$unit")
            printf 'Preset:   %s\n' "$name"
            printf 'Login:    %s\n' "$(systemctl --user is-enabled llmctl.service 2>/dev/null)"
            printf 'Service:  %s\n' "$(systemctl --user is-active llmctl.service 2>/dev/null)"
            printf 'Repairs:  %s, next %s\n' "$(systemctl --user is-active llmctl-repair.timer 2>/dev/null)" \
                "$(systemctl --user show llmctl-repair.timer -p NextElapseUSecRealtime --value 2>/dev/null)"
            printf 'Linger:   %s\n' "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)"
            echo "Last lines:"
            journalctl --user -u llmctl.service -n 6 --no-pager -o cat 2>/dev/null | sed 's/^/  /'
            ;;
        stop-slots)
            # ExecStop: the slots the preset still holds; whatever else runs stays.
            local name="${1:-}" f sl
            for f in "$PID_DIR"/preset-*; do
                [[ -f "$f" && "$(cat "$f")" == "$name" ]] || continue
                sl="${f##*/preset-}"
                _stop_slot "$sl" || true
            done
            ;;
        *) echo "Usage: $PROG service enable <preset> | disable | start | stop | status"; return 1 ;;
    esac
}

# ── Darkroom: photo editing from the phone ──────────────────
# Called "fotos" (llmctl fotos, /fotos) until 1.86; _darkroom_migrate takes over
# what that left. A page (darkroom_server.py, darkroom.html) in front of the image API that does not
# belong to the ComfyUI slot: a user service of its own, with its own tunnel, so
# it is there with ComfyUI stopped and can start it ("comfy" on DARKROOM_SLOT, with
# the image API). The tunnel logs in with a key of its own, without a
# passphrase — a service has no agent — which the server's authorized_keys
# restricts to this one forward (`llmctl darkroom key` prints the line).
DARKROOM_SCRIPT="$LIB_DIR/darkroom_server.py"
DARKROOM_PORT="${LLMCTL_DARKROOM_PORT:-${LLMCTL_FOTOS_PORT:-8190}}"   # → the server's 127.0.0.1:18190 through the tunnel
DARKROOM_SLOT="${LLMCTL_DARKROOM_SLOT:-${LLMCTL_FOTOS_SLOT:-9}}"      # where it starts ComfyUI, as preset comfy-remote does
DARKROOM_MODEL="${LLMCTL_DARKROOM_MODEL:-${LLMCTL_FOTOS_MODEL:-comfy}}"
# The vision slot ComfyUI's image API starts for Find flaws (--vision), as
# preset comfy-remote has it; 0 for none.
DARKROOM_VISION_SLOT="${LLMCTL_DARKROOM_VISION_SLOT:-${LLMCTL_FOTOS_VISION_SLOT:-2}}"
# Ausbauen: the model that spells out a short wish, started on this slot on the
# first request and stopped after 10 idle minutes; 0 for none.
DARKROOM_EXPAND_SLOT="${LLMCTL_DARKROOM_EXPAND_SLOT:-4}"
DARKROOM_EXPAND_MODEL="${LLMCTL_DARKROOM_EXPAND_MODEL:-gemma-moe}"
DARKROOM_DIR="$DATA_DIR/darkroom"
DARKROOM_KEY="$CONFIG_DIR/darkroom_tunnel_key"
DARKROOM_UNIT="llmctl-darkroom.service"
FOTOS_UNIT="llmctl-fotos.service"           # the old name's service

# What "fotos" left: its service gone (stopped first, so nothing writes while
# its jobs move), its jobs, templates, subscriptions and key under the new name.
_darkroom_migrate() {
    local old="$SERVICE_UNIT_DIR/$FOTOS_UNIT" f
    if [[ -f "$old" ]]; then
        systemctl --user disable --now "$FOTOS_UNIT" 2>&1 | grep -v '^Removed' || true
        rm -f "$old"
        systemctl --user daemon-reload 2>/dev/null || true
        echo "Removed the old $FOTOS_UNIT."
    fi
    if [[ -d "$DATA_DIR/fotos" && ! -e "$DARKROOM_DIR" ]]; then
        mv "$DATA_DIR/fotos" "$DARKROOM_DIR" && echo "Moved $DATA_DIR/fotos to $DARKROOM_DIR."
    fi
    for f in "" .pub; do
        if [[ -f "$CONFIG_DIR/fotos_tunnel_key$f" && ! -e "$DARKROOM_KEY$f" ]]; then
            mv "$CONFIG_DIR/fotos_tunnel_key$f" "$DARKROOM_KEY$f"
        fi
    done
}

_darkroom_remote_port() { echo $(( DARKROOM_PORT + TUNNEL_PORT_OFFSET )); }

# The line for ~/.ssh/authorized_keys on the tunnel host: this key may open the
# one remote forward and nothing else — no shell, no command, no other port.
_darkroom_authorized_line() {
    printf 'restrict,port-forwarding,permitlisten="localhost:%s",command="/bin/false" %s\n' \
        "$(_darkroom_remote_port)" "$(cat "$DARKROOM_KEY.pub")"
}

_darkroom_ensure_key() {
    [[ -f "$DARKROOM_KEY" ]] && return 0
    mkdir -p "$CONFIG_DIR"
    ssh-keygen -q -t ed25519 -N "" -C "llmctl-darkroom@$(hostname -s)" -f "$DARKROOM_KEY" ||
        { echo "Error: could not make $DARKROOM_KEY"; return 1; }
    chmod 600 "$DARKROOM_KEY"
    echo "Made $DARKROOM_KEY for the tunnel."
}

_darkroom_ssh_opts() {
    printf '%s\n' -i "$DARKROOM_KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15 \
        -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes
}

# The tunnel, kept up: plain ssh in a loop rather than autossh, so a host that
# refuses is asked again only every five minutes (fail2ban, sshguard).
_darkroom_tunnel_loop() {
    local -a opts; mapfile -t opts < <(_darkroom_ssh_opts)
    local forward
    forward="$(_darkroom_remote_port):127.0.0.1:$DARKROOM_PORT"
    while true; do
        pkill -f -- "-R $forward" 2>/dev/null
        if ssh "${opts[@]}" "$TUNNEL_HOST" true 2>/dev/null ||
           # command="/bin/false" answers a login with exit 1, and that is a login too
           [[ $? -eq 1 ]]; then
            echo "tunnel: $TUNNEL_HOST, forwarding :$DARKROOM_PORT → its localhost:$(_darkroom_remote_port)"
            ssh "${opts[@]}" -N -R "$forward" "$TUNNEL_HOST"
            echo "tunnel: ended ($?), again in 15 s"
            sleep 15
        else
            echo "tunnel: cannot log in to $TUNNEL_HOST with $DARKROOM_KEY — is its line in authorized_keys"
            echo "        there ($PROG darkroom key)? Again in 5 min."
            sleep 300
        fi
    done
}

# Usage: darkroom enable | disable | status | key | run
cmd_darkroom() {
    local action="${1:-status}"; shift || true
    local unit="$SERVICE_UNIT_DIR/$DARKROOM_UNIT"
    case "$action" in
        run)
            # The service's ExecStart: the page in the foreground, the tunnel beside it.
            _check_deps python3 || return 1
            if ss -tlnp 2>/dev/null | grep -q ":${DARKROOM_PORT} "; then
                echo "Error: something already listens on :$DARKROOM_PORT — the darkroom service, most likely"
                echo "       ($PROG darkroom status). 'darkroom run' is what that service runs; to start it: $PROG darkroom enable."
                return 1
            fi
            # Not the old unit, which may be what runs this ("llmctl fotos run").
            [[ -d "$DATA_DIR/fotos" && ! -e "$DARKROOM_DIR" ]] && mv "$DATA_DIR/fotos" "$DARKROOM_DIR"
            local tun=""
            if [[ -n "$TUNNEL_HOST" && -f "$DARKROOM_KEY" ]]; then
                _darkroom_tunnel_loop & tun=$!
            else
                echo "No tunnel: $([[ -z "$TUNNEL_HOST" ]] && echo "no tunnel host (~/.config/llmctl/tunnel-host)" || echo "no key ($PROG darkroom key)")."
            fi
            # shellcheck disable=SC2064  # the pid is meant to be fixed now
            trap "[[ -n '$tun' ]] && { kill $tun 2>/dev/null; pkill -f -- '-R $(_darkroom_remote_port):127.0.0.1:$DARKROOM_PORT'; }" EXIT
            python3 -u "$DARKROOM_SCRIPT" --port "$DARKROOM_PORT" \
                --api "http://127.0.0.1:$(( PORT_BASE_PROXY + DARKROOM_SLOT ))" \
                --comfy "http://127.0.0.1:$(( PORT_BASE_SERVER + DARKROOM_SLOT ))" \
                --comfy-slot "$DARKROOM_SLOT" --comfy-model "$DARKROOM_MODEL" --vision-slot "$DARKROOM_VISION_SLOT" \
                --llmctl "$(readlink -f "${BASH_SOURCE[0]}")" --data "$DARKROOM_DIR" --docs "$SHARE_DIR/docs" \
                --version "$LLMCTL_VERSION" --expand-slot "$DARKROOM_EXPAND_SLOT" \
                --expand-port "$(( PORT_BASE_SERVER + DARKROOM_EXPAND_SLOT ))" --expand-model "$DARKROOM_EXPAND_MODEL"
            ;;
        key)
            _darkroom_migrate
            _darkroom_ensure_key || return 1
            echo "Add this line to ~/.ssh/authorized_keys on ${TUNNEL_HOST:-the tunnel host} — it lets the key"
            echo "open the one forward to localhost:$(_darkroom_remote_port), and nothing else:"
            echo ""
            _darkroom_authorized_line
            if [[ -n "$TUNNEL_HOST" ]]; then
                echo ""
                echo "Or, with a key that logs in there now:"
                echo "  $PROG darkroom key | grep '^restrict' | ssh $TUNNEL_HOST 'cat >> ~/.ssh/authorized_keys'"
            fi
            ;;
        enable)
            _check_deps systemctl python3 || return 1
            _darkroom_migrate
            _darkroom_ensure_key || return 1
            local bin; bin=$(command -v "$PROG" 2>/dev/null || readlink -f "$0")
            local -a env=("PATH=$PATH") v
            for v in LLMCTL_CONFIG_DIR LLMCTL_DATA_DIR LLMCTL_STATE_DIR LLMCTL_MODELS_DIR LLMCTL_TUNNEL_HOST \
                     LLMCTL_TUNNEL_PORT_OFFSET LLMCTL_DARKROOM_PORT LLMCTL_DARKROOM_SLOT LLMCTL_DARKROOM_MODEL \
                     LLMCTL_DARKROOM_VISION_SLOT LLMCTL_DARKROOM_EXPAND_SLOT LLMCTL_DARKROOM_EXPAND_MODEL; do
                [[ -n "${!v:-}" ]] && env+=("$v=${!v}")
            done
            mkdir -p "$SERVICE_UNIT_DIR"
            {
                echo "# Written by llmctl darkroom enable — rewritten by the next enable."
                echo "[Unit]"
                echo "Description=llmctl darkroom: photo editing from the phone"
                echo "After=network-online.target"
                echo ""
                echo "[Service]"
                echo "Type=simple"
                for v in "${env[@]}"; do printf 'Environment="%s"\n' "$v"; done
                echo "ExecStart=$bin darkroom run"
                echo "Restart=on-failure"
                echo "RestartSec=10"
                echo ""
                echo "[Install]"
                echo "WantedBy=default.target"
            } > "$unit"
            systemctl --user daemon-reload
            systemctl --user enable "$DARKROOM_UNIT" 2>&1 | grep -v '^Created symlink' || true
            systemctl --user restart "$DARKROOM_UNIT"
            echo "Darkroom runs on http://127.0.0.1:$DARKROOM_PORT/darkroom, and from now on at every login."
            [[ -n "$TUNNEL_HOST" ]] && echo "  From outside: https://<your ComfyUI vhost>/darkroom (the vhost needs its /darkroom lines,"
            [[ -n "$TUNNEL_HOST" ]] && echo "  deploy/vps-comfy-vhost.conf), once $TUNNEL_HOST takes the key: $PROG darkroom key"
            if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
                echo "  At boot, before anyone logs in: loginctl enable-linger $USER"
            fi
            ;;
        disable)
            systemctl --user disable --now "$DARKROOM_UNIT" 2>&1 | grep -v '^Removed' || true
            echo "Darkroom stopped, and not at login any more. ComfyUI, if it runs, keeps running."
            ;;
        status)
            local active="not set up"
            [[ -f "$unit" ]] && active=$(systemctl --user is-active "$DARKROOM_UNIT" 2>/dev/null)
            printf 'Service:  %s (%s)\n' "$active" "$DARKROOM_UNIT"
            [[ -f "$SERVICE_UNIT_DIR/$FOTOS_UNIT" ]] &&
                echo "          the old $FOTOS_UNIT is still there: $PROG darkroom enable replaces it"
            if ss -tlnp 2>/dev/null | grep -q ":${DARKROOM_PORT} "; then
                printf 'Page:     http://127.0.0.1:%s/darkroom\n' "$DARKROOM_PORT"
            else
                printf 'Page:     nothing listens on :%s\n' "$DARKROOM_PORT"
            fi
            if pgrep -f -- "-R $(_darkroom_remote_port):127.0.0.1:$DARKROOM_PORT" >/dev/null; then
                printf 'Tunnel:   up — %s localhost:%s\n' "$TUNNEL_HOST" "$(_darkroom_remote_port)"
            else
                printf 'Tunnel:   down%s\n' "$([[ -f "$DARKROOM_KEY" ]] || echo " (no key yet: $PROG darkroom key)")"
            fi
            printf 'ComfyUI:  slot %s (%s), started and stopped from the page\n' "$DARKROOM_SLOT" "$DARKROOM_MODEL"
            if [[ "$DARKROOM_VISION_SLOT" != 0 ]]; then
                printf 'Vision:   slot %s (%s), started for Find flaws and stopped after\n' "$DARKROOM_VISION_SLOT" "$VISION_MODEL"
            fi
            if [[ "$DARKROOM_EXPAND_SLOT" != 0 ]]; then
                printf 'Expand:   slot %s (%s), started for Expand and stopped after 10 idle minutes\n' \
                    "$DARKROOM_EXPAND_SLOT" "$DARKROOM_EXPAND_MODEL"
            fi
            printf 'Jobs:     %s\n' "$(find "$DARKROOM_DIR/jobs" -name job.json 2>/dev/null | wc -l) in $DARKROOM_DIR/jobs"
            if [[ -f "$unit" ]]; then
                echo "Last lines:"
                journalctl --user -u "$DARKROOM_UNIT" -n 6 --no-pager -o cat 2>/dev/null | sed 's/^/  /'
            fi
            ;;
        *) echo "Usage: $PROG darkroom enable | disable | status | key | run"; return 1 ;;
    esac
}

# Models nothing names any more, and what deleting them would free. A directory
# under the models directory that no models.conf entry reaches into goes as a
# whole; inside a directory that one does reach, a .gguf (or a leftover part of
# a split one) that no entry names. Halogen directories are mounted whole and
# left alone, as are llmctl's own (the VoiceDesign model) and the hf cache.
# ComfyUI's models are the ones no installed workflow names. Nothing is deleted
# without a yes typed at a terminal.
# Usage: prune [--dry-run]
cmd_prune() {
    local dry_run=false
    [[ "${1:-}" == --dry-run ]] && dry_run=true
    local models; models="$(realpath -m "$MODELS_DIR")"
    # Every path models.conf names, and llmctl's own.
    local -a refs=("$(realpath -m "$TTS_DESIGN_DIR")") whole=("$models/comfyui")
    local entry word name
    local -a f
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        name="${f[0]}"
        _resolve_model "$name" || continue
        for word in ${f[1]} ${f[2]} ${f[3]} ${f[6]} ${f[16]}; do
            word="${word//\~/$HOME}"
            [[ "$word" == /* ]] && refs+=("$(realpath -m "$word")")
        done
        # halogen mounts the checkpoint's directory: tokenizer, n-gram table, vision.
        [[ "$_r_backend" == halogen ]] && whole+=("$(dirname "$(realpath -m "${_r_model//\~/$HOME}")")")
    done
    local -a cand=() why=()
    local d p r used named
    for d in "$models"/*/; do
        d="${d%/}"
        [[ " ${whole[*]} " == *" $d "* ]] && continue
        used=false
        for r in "${refs[@]}"; do [[ "$r" == "$d" || "$r" == "$d/"* ]] && { used=true; break; }; done
        if [[ "$used" == false ]]; then
            cand+=("$d"); why+=("no entry in models.conf uses this directory")
            continue
        fi
        while IFS= read -r -d '' p; do
            named=false
            # A sharded GGUF is named by its first shard; llama.cpp loads the rest.
            local first="$p"
            [[ "$p" =~ ^(.*)-[0-9]{5}-of-([0-9]{5})\.gguf$ ]] && first="${BASH_REMATCH[1]}-00001-of-${BASH_REMATCH[2]}.gguf"
            for r in "${refs[@]}"; do [[ "$r" == "$p" || "$r" == "$first" || "$p" == "$r/"* ]] && { named=true; break; }; done
            [[ "$named" == true ]] && continue
            cand+=("$p"); why+=("no entry in models.conf names it")
        # Only *.gguf: the parts of a joined download are gone after the join, and
        # its X.gguf.parts.json (their hashes, for download --check) is no model.
        done < <(find "$d" -maxdepth 2 -type f -name '*.gguf' -not -path '*/.cache/*' -print0 | sort -z)
    done
    # ComfyUI: what its installed workflows do not name.
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        _resolve_model "${f[0]}" && [[ "$_r_backend" == comfyui ]] || continue
        _comfyui_paths
        [[ -d "$c_wf" ]] || continue
        while IFS= read -r p; do
            [[ -n "$p" ]] && { cand+=("$p"); why+=("no ComfyUI workflow names it"); }
        done < <(python3 "$COMFYUI_MODELS_SCRIPT" orphans "$c_wf" "$c_models" 2>/dev/null)
    done

    # The voice-design venv, once ComfyUI's serves instead.
    if [[ -d "$TTS_DIR/venv" ]] && _voice_python && [[ -n "$_vd_path" ]]; then
        cand+=("$TTS_DIR/venv"); why+=("voice design runs in ComfyUI's venv now")
    fi

    if (( ${#cand[@]} == 0 )); then
        echo "Nothing to prune: every model here is named by models.conf or a workflow."
        return 0
    fi
    # What goes away for real: on btrfs, blocks shared with a file that stays
    # (a reflinked copy, say) are not freed.
    local btrfs=false
    [[ "$(stat -f -c %T "$models" 2>/dev/null)" == btrfs ]] && command -v btrfs > /dev/null && btrfs=true
    local i total=0 freed=0 sz ex
    echo "Named by nothing (sizes: on disk / freed by deleting):"
    for (( i=0; i<${#cand[@]}; i++ )); do
        sz=$(du -sb "${cand[i]}" 2>/dev/null | cut -f1); sz=${sz:-0}
        ex="$sz"
        if [[ "$btrfs" == true ]]; then
            ex=$(btrfs filesystem du -s --raw "${cand[i]}" 2>/dev/null | awk 'NR == 2 { print $2 }')
            ex=${ex:-$sz}
        fi
        total=$(( total + sz )); freed=$(( freed + ex ))
        printf '  %9s / %9s  %s\n' "$(_gib $(( sz / 1048576 )))" "$(_gib $(( ex / 1048576 )))" "${cand[i]#"$models"/}"
        printf '  %21s  %s\n' "" "${why[i]}"
    done
    printf 'Together %s on disk; deleting frees %s.\n' "$(_gib $(( total / 1048576 )))" "$(_gib $(( freed / 1048576 )))"
    [[ "$btrfs" == true ]] || echo "  (not btrfs: shared blocks are not told apart, so freed is at most that)"
    [[ "$dry_run" == true ]] && return 0
    if [[ ! -t 0 ]]; then
        echo "Not deleting: that takes a yes typed at a terminal."
        return 0
    fi
    local answer=""
    read -r -p "Delete these ${#cand[@]}? Type yes: " answer
    [[ "$answer" == yes ]] || { echo "Nothing deleted."; return 0; }
    for (( i=0; i<${#cand[@]}; i++ )); do
        rm -rf -- "${cand[i]}" && echo "  deleted ${cand[i]#"$models"/}"
    done
}

# What has moved on since it was installed — reported, nothing changed:
# halogen images, the llama.cpp builds, the speech server's PR, ComfyUI and its
# custom nodes, and every installed model against its Hugging Face repo (GGUFs
# and halogen through hf's own record of each file's SHA-256, ComfyUI's models
# by SHA-256 read once and cached, --quick: by size and date).
# Usage: outdated [--quick]   exit 0: all current, 1: something newer
_gh_json() {   # path jq-filter: GitHub API, through gh when it is logged in
    if command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
        gh api "$1" -q "$2" 2>/dev/null
    else
        curl -sf "https://api.github.com/$1" | python3 -c '
import json, sys
j = json.load(sys.stdin)
for k in sys.argv[1].lstrip(".").split("."):
    j = j.get(k) if isinstance(j, dict) else None
print("" if j is None else str(j).lower() if isinstance(j, bool) else j)' "$2" 2>/dev/null
    fi
}
# ── llmctl itself ────────────────────────────────────────────

# The git checkout this llmctl comes from: the one it runs in (install-link), or
# the one `make install` was run from (share/llmctl/source). Empty without one.
_self_source() {
    local src=""
    if [[ "$SHARE_DIR" == "$LIB_DIR" ]]; then src="$SHARE_DIR"
    elif [[ -f "$SHARE_DIR/source" ]]; then src=$(cat "$SHARE_DIR/source")
    fi
    [[ -n "$src" && -d "$src/.git" && -f "$src/llmctl" ]] && echo "$src"
}

_version_of() { sed -n 's/^LLMCTL_VERSION=\([0-9.]*\).*/\1/p' "$1/llmctl" 2>/dev/null; }

# newer A B: A is a later version than B
_newer() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]; }

_outdated_self() {
    printf '\033[1mllmctl\033[0m\n'
    local latest lead src checkout
    latest=$(_gh_json "repos/$LLMCTL_REPO/releases/latest" .tag_name); latest=${latest#v}
    if [[ -z "$latest" ]]; then echo "  llmctl $LLMCTL_VERSION: cannot ask GitHub"; return; fi
    lead=$(_gh_json "repos/$LLMCTL_REPO/compare/v$latest...master" .ahead_by)
    lead=${lead:+, master is $lead commits further}
    [[ "$lead" == ", master is 0 commits further" ]] && lead=""
    local counted=false
    if [[ "${master:-false}" == true ]]; then
        # Against master: the checkout's commit where there is one, else how far
        # master is past the release installed.
        src=$(_self_source)
        local head behind=""
        [[ -n "$src" ]] && head=$(git -C "$src" rev-parse HEAD 2>/dev/null) &&
            behind=$(_gh_json "repos/$LLMCTL_REPO/compare/$head...master" .ahead_by)
        [[ -z "$behind" ]] && ! _newer "$latest" "$LLMCTL_VERSION" &&
            behind=$(_gh_json "repos/$LLMCTL_REPO/compare/v$LLMCTL_VERSION...master" .ahead_by)
        if [[ "$behind" =~ ^[1-9] ]]; then
            echo "  llmctl $LLMCTL_VERSION — $behind commits behind master: $PROG self-update --master ($latest is the newest release)"
            newer=$(( newer + 1 ))
        elif [[ -n "$behind" ]]; then
            echo "  llmctl $LLMCTL_VERSION — current with master ($latest is the newest release)"
        else
            echo "  llmctl $LLMCTL_VERSION: cannot compare with master"
        fi
        return
    fi
    if _newer "$latest" "$LLMCTL_VERSION"; then
        echo "  llmctl $LLMCTL_VERSION — $latest is out: $PROG self-update$lead"
        newer=$(( newer + 1 )); counted=true
        _gh_json "repos/$LLMCTL_REPO/releases/tags/v$latest" .body | grep -v '^\s*$' | head -4 | cut -c1-110 | sed 's/^/      /'
    else
        echo "  llmctl $LLMCTL_VERSION — current: $latest is the newest release$lead"
    fi
    src=$(_self_source)
    if [[ -n "$src" && "$src" != "$SHARE_DIR" ]]; then
        checkout=$(_version_of "$src")
        if [[ -n "$checkout" ]] && _newer "$checkout" "$LLMCTL_VERSION"; then
            echo "  the checkout in $src is at $checkout, newer than this installation: $PROG self-update"
            [[ "$counted" == true ]] || newer=$(( newer + 1 ))     # one thing to do, said twice
        fi
    fi
}

# self-update: to the newest release — or to the checkout, where that is newer.
# self-update --master: master instead of the newest release — the checkout
# fast-forwarded to origin/master (never over local work), or master's archive.
# Its version number is the last release's until the next one, so it installs
# whenever asked.
_self_update_master() {
    local check="$1" src tmp head
    src=$(_self_source)
    if [[ -n "$src" ]]; then
        git -C "$src" fetch -q origin master || { echo "Error: cannot fetch master into $src"; return 1; }
        if [[ -n "$(git -C "$src" status --porcelain --untracked-files=no)" ]]; then
            echo "Error: $src has local changes; commit or stash them, then run self-update again"; return 1
        fi
        head=$(git -C "$src" rev-parse --short origin/master)
        if [[ "$check" == true ]]; then echo "  would fast-forward $src to master ($head) and install it"; return 1; fi
        git -C "$src" merge -q --ff-only origin/master || { echo "Error: $src has diverged from master — not touched"; return 1; }
        echo "  $src at master ($head)"
        [[ "$src" == "$SHARE_DIR" ]] && { echo "  llmctl runs from $src"; return 0; }
        echo "  installing master from $src — sudo asks for your password"
        sudo make -C "$src" install > /dev/null || { echo "Error: make install failed"; return 1; }
    else
        if [[ "$check" == true ]]; then echo "  would download master and install it (sudo make install)"; return 1; fi
        tmp=$(mktemp -d)
        curl -fsSL "https://github.com/$LLMCTL_REPO/archive/refs/heads/master.tar.gz" | tar xz -C "$tmp" --strip-components=1 ||
            { rm -rf "$tmp"; echo "Error: cannot download master"; return 1; }
        echo "  installing master — sudo asks for your password"
        sudo make -C "$tmp" install > /dev/null || { rm -rf "$tmp"; echo "Error: make install failed"; return 1; }
        rm -rf "$tmp"
    fi
    echo "  installed: $("$(command -v "$PROG" || echo /usr/local/bin/llmctl)" version) (master)"
}

cmd_self_update() {
    local check=false master=false a
    for a in "$@"; do
        case "$a" in
            --check) check=true ;;
            --master) master=true ;;
            *) echo "Usage: $PROG self-update [--check] [--master]"; return 1 ;;
        esac
    done
    [[ "$master" == true ]] && { _self_update_master "$check"; return; }
    local latest src checkout tmp
    latest=$(_gh_json "repos/$LLMCTL_REPO/releases/latest" .tag_name); latest=${latest#v}
    [[ -n "$latest" ]] || { echo "Error: cannot ask GitHub for llmctl's newest release"; return 1; }
    src=$(_self_source)
    echo "  installed $LLMCTL_VERSION, newest release $latest${src:+, checkout $src}"

    if [[ -n "$src" ]]; then
        git -C "$src" fetch -q --tags origin 2>/dev/null || echo "  (cannot fetch — going by what the checkout has)"
        if ! git -C "$src" merge-base --is-ancestor "v$latest" HEAD 2>/dev/null; then
            # the checkout is behind the release: fast-forward it, never over local work
            if [[ -n "$(git -C "$src" status --porcelain --untracked-files=no)" ]]; then
                echo "Error: $src has local changes; commit or stash them, then run self-update again"; return 1
            fi
            if [[ "$check" == true ]]; then echo "  would fast-forward $src to v$latest"
            else
                git -C "$src" merge -q --ff-only "v$latest" ||
                    { echo "Error: $src has diverged from v$latest — not touched"; return 1; }
                echo "  $src fast-forwarded to v$latest"
            fi
        fi
        if [[ "$src" == "$SHARE_DIR" ]]; then          # install-link: the checkout is the program
            [[ "$check" == true ]] || echo "  llmctl runs from $src: $(_version_of "$src") now"
            return 0
        fi
        checkout=$(_version_of "$src")
        [[ "$check" == true ]] && _newer "$latest" "$checkout" && checkout=$latest
        if ! _newer "$checkout" "$LLMCTL_VERSION"; then echo "  nothing newer to install"; return 0; fi
        if [[ "$check" == true ]]; then echo "  would install $checkout from $src (sudo make install)"; return 1; fi
        echo "  installing $checkout from $src — sudo asks for your password"
        sudo make -C "$src" install > /dev/null || { echo "Error: make install failed"; return 1; }
    else
        if ! _newer "$latest" "$LLMCTL_VERSION"; then echo "  nothing newer to install"; return 0; fi
        if [[ "$check" == true ]]; then echo "  would download v$latest and install it (sudo make install)"; return 1; fi
        tmp=$(mktemp -d)
        curl -fsSL "https://github.com/$LLMCTL_REPO/archive/refs/tags/v$latest.tar.gz" | tar xz -C "$tmp" --strip-components=1 ||
            { rm -rf "$tmp"; echo "Error: cannot download v$latest"; return 1; }
        echo "  installing $latest — sudo asks for your password"
        sudo make -C "$tmp" install > /dev/null || { rm -rf "$tmp"; echo "Error: make install failed"; return 1; }
        rm -rf "$tmp"
    fi
    echo "  installed: $("$(command -v "$PROG" || echo /usr/local/bin/llmctl)" version)"
    echo "  then, if they apply: $PROG update comfy, $PROG download llama, $PROG download asr-live"
}

cmd_outdated() {
    local quick=false master=false a
    for a in "$@"; do
        case "$a" in
            --quick) quick=true ;;
            --master) master=true ;;
            *) echo "Usage: $PROG outdated [--quick] [--master]"; return 2 ;;
        esac
    done
    local newer=0 entry name
    local -a f
    _check_deps hf python3 || return 2

    _outdated_self
    printf '\n\033[1mhalogen and gufo\033[0m\n'
    local seen=""
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        _resolve_model "${f[0]}" && [[ "$_r_backend" == halogen || "$_r_backend" == gufo ]] || continue
        local image="${_r_binary%:*}" tag="${_r_binary##*:}"
        [[ " $seen " == *" $image "* ]] && continue
        seen+=" $image"
        local latest
        latest=$(podman search --list-tags --limit 1000 "$image" 2>/dev/null |
                 awk 'NR > 1 { print $2 }' | grep -E '^[0-9]+(\.[0-9]+)+$' | sort -V | tail -1)
        if [[ -z "$latest" ]]; then
            echo "  $image: cannot ask the registry"
        elif [[ "$latest" == "$tag" || "$(printf '%s\n%s\n' "$latest" "$tag" | sort -V | tail -1)" == "$tag" ]]; then
            echo "  $image:$tag — current"
        else
            echo "  $image:$tag — $latest is out"
            newer=$(( newer + 1 ))
            # The changelog of a ghcr.io/<owner>/<repo> image, if GitHub has one;
            # gufo's image lives under toolboxes/, its changelog in the main repo.
            local gh_repo="${image#ghcr.io/}"
            [[ "$_r_backend" == gufo ]] && gh_repo="$GUFO_REPO"
            [[ "$_r_backend" == halogen && "$(_halogen_flavor "$image")" == server ]] && gh_repo="$HALOGEN_SERVER_REPO"
            # Each newer version's heading and the first lines under it.
            curl -sf "https://raw.githubusercontent.com/$gh_repo/main/CHANGELOG.md" |
                awk -v t="$tag" '/^## / { v = $2; gsub(/^\[|\].*$/, "", v)   # "## [0.4.0](…) (date)" too
                                          if (v == t) exit; print "    ## " v; n = 0; next }
                                 v != "" && NF && n < 6 { line = $0; gsub(/\]\([^)]*\)/, "]", line); gsub(/\[|\]/, "", line)
                                          print "      " substr(line, 1, 110); n++ }'
        fi
    done

    # Against the newest stable release (a v-tag, GitHub's "latest"), not master:
    # a build at or past it is current; master's lead is only shown.
    printf '\n\033[1mllama.cpp builds\033[0m\n'
    local bin path out commit behind stable status kind
    stable=$(_gh_json "repos/ggml-org/llama.cpp/releases/latest" .tag_name)
    local -a bins=("${LLAMA_DEFAULT_BIN:-llama-server}" "${LLAMA_ROCM_BIN:-}")
    for kind in vulkan rocm; do [[ -x "$LLAMA_DIR/$kind/current/llama-server" ]] && bins+=("$LLAMA_DIR/$kind/current/llama-server"); done
    # --master: against the newest builds of master (ggml-org's for Vulkan,
    # lemonade's for ROCm), not the release.
    local builds=""
    [[ "$master" == true ]] && builds=$(python3 "$LLAMA_BUILDS_SCRIPT" resolve-master 2>/dev/null)
    for bin in $(printf '%s\n' "${bins[@]}" | awk 'NF && !s[$0]++'); do
        path=$(command -v "$bin" 2>/dev/null) || { echo "  $bin: not installed"; continue; }
        out=$("$path" --version 2>&1)
        commit=$(grep -oE 'commit [0-9a-f]{7,}|\(([0-9a-f]{7,})\)' <<< "$out" | head -1 | grep -oE '[0-9a-f]{7,}')
        if [[ -z "$commit" ]]; then echo "  $path: no commit in --version"; continue; fi
        behind=$(_gh_json "repos/ggml-org/llama.cpp/compare/$commit...master" .ahead_by)
        [[ -n "$stable" ]] && status=$(_gh_json "repos/ggml-org/llama.cpp/compare/$stable...$commit" .status)
        if [[ "$master" == true ]]; then
            local want="" build=""
            case "$(readlink -f "$path")" in
                */rocm/*) want=$(jq -r '.rocm.commit // empty' <<< "$builds"); build=$(jq -r '.rocm.build // empty' <<< "$builds") ;;
                *)        want=$(jq -r '.vulkan.commit // empty' <<< "$builds"); build=$(jq -r '.vulkan.build // empty' <<< "$builds") ;;
            esac
            if [[ -z "$want" ]]; then echo "  $path ($commit): cannot ask for master's builds"
            elif [[ "$want" == "$commit"* || "$commit" == "$want"* ]]; then
                echo "  $path ($commit) — current: master's newest build ($build)${stable:+; $stable is the newest stable release}"
            else
                echo "  $path ($commit) — master's newest build is $build${behind:+, $behind commits on}: $PROG update llama --master"
                newer=$(( newer + 1 ))
            fi
        elif [[ -z "$stable" || -z "${status:-}" ]]; then
            echo "  $path ($commit): cannot compare with a release${behind:+ ($behind commits behind master)}"
        elif [[ "$status" == identical || "$status" == ahead ]]; then
            echo "  $path ($commit) — current: $stable is the newest stable release${behind:+, master is $behind commits further}"
        else
            echo "  $path ($commit) — older than $stable, the newest stable release"
            newer=$(( newer + 1 ))
        fi
    done

    printf '\n\033[1mspeech server (llama.cpp PR)\033[0m\n'
    local script="$SHARE_DIR/patches/build-tts-server.sh" pr pinned
    pr=$(sed -n 's/^PR=//p' "$script" 2>/dev/null); pinned=$(sed -n 's/^PR_COMMIT=//p' "$script" 2>/dev/null)
    if [[ -n "$pr" ]]; then
        local merged state head
        merged=$(_gh_json "repos/ggml-org/llama.cpp/pulls/$pr" .merged)
        state=$(_gh_json "repos/ggml-org/llama.cpp/pulls/$pr" .state)
        head=$(_gh_json "repos/ggml-org/llama.cpp/pulls/$pr" .head.sha)
        if [[ "$merged" == true ]]; then
            echo "  PR #$pr is merged — the ordinary llama-server has /tts now; build-tts-server.sh can go"
            newer=$(( newer + 1 ))
        elif [[ -n "$head" && "$head" != "$pinned" ]]; then
            echo "  PR #$pr ($state) has commits past ours (${pinned:0:9} → ${head:0:9})"
            newer=$(( newer + 1 ))
        elif [[ -n "$head" ]]; then
            echo "  PR #$pr ($state), at ${pinned:0:9} — current"
        else
            echo "  PR #$pr: cannot ask GitHub"
        fi
    fi

    # Kolibri-1 (models.conf "kolibri") runs on a patched build until llama.cpp
    # knows its architecture; once master does, build-kolibri-server.sh can go.
    if [[ -x "$DATA_DIR/llama.cpp-kolibri/build/bin/llama-server" ]]; then
        printf '\n\033[1mKolibri build (patched llama.cpp)\033[0m\n'
        local master_arch
        master_arch=$(curl -fsSL --max-time 20 https://raw.githubusercontent.com/ggml-org/llama.cpp/master/src/llama-arch.cpp 2>/dev/null)
        if [[ -z "$master_arch" ]]; then
            echo "  cannot ask GitHub"
        elif grep -q '"kolibri1"' <<< "$master_arch"; then
            echo "  llama.cpp master knows kolibri1 now — point kolibri at the ordinary build; build-kolibri-server.sh can go"
            newer=$(( newer + 1 ))
        else
            echo "  llama.cpp master does not know kolibri1 yet (#29922) — the patched build stays"
        fi
    fi

    printf '\n\033[1maudio.cpp\033[0m\n'
    if [[ -d "$AUDIOCPP_DIR/.git" ]]; then
        local built; built=$(git -C "$AUDIOCPP_DIR" rev-parse HEAD 2>/dev/null)
        # Against the newest release tag (--master: main): built at it, or past it, is current.
        local DL_MASTER="$master"; _audiocpp_wanted
        # Its version: the release tag it is built at, else its commit.
        local at=""; [[ "$built" == "$AC_SHA" ]] && at="$AC_REF"
        local lead; lead=$(_gh_json "repos/0xShug0/audio.cpp/compare/$built...main" .ahead_by)
        [[ "$lead" =~ ^[1-9] ]] && lead=", main is $lead commits further" || lead=""
        if [[ "$master" == true ]]; then
            if [[ "$built" == "$AC_SHA" ]] || git -C "$AUDIOCPP_DIR" merge-base --is-ancestor "$AC_SHA" "$built" 2>/dev/null; then
                echo "  audio.cpp (${built:0:9}) — current with main"
            else
                local by; by=$(sed -E 's/.* ([0-9]+) commits.*/\1/' <<< "$lead")
                echo "  audio.cpp (${built:0:9}) — ${by:+$by commits }behind main: $PROG download asr-live --master"
                newer=$(( newer + 1 ))
            fi
        elif git -C "$AUDIOCPP_DIR" merge-base --is-ancestor "$AC_SHA" "$built" 2>/dev/null; then
            echo "  audio.cpp (${at:-${built:0:9}}) — current: $AC_REF is the newest release$lead"
        else
            echo "  audio.cpp (${at:-${built:0:9}}) — $AC_REF is the newest release: $PROG download asr-live builds it$lead"
            newer=$(( newer + 1 ))
        fi
    else
        echo "  not set up"
    fi

    printf '\n\033[1mComfyUI\033[0m\n'
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        _resolve_model "${f[0]}" && [[ "$_r_backend" == comfyui ]] || continue
        _comfyui_paths
        [[ -d "$c_app/.git" ]] || { echo "  not set up"; continue; }
        # Against the newest release tag (patch releases have no GitHub release
        # page, so the tags themselves): on it, or past it, is current.
        local here version newest on_master="" lead=""
        here=$(git -C "$c_app" rev-parse HEAD 2>/dev/null)
        version=$(_comfyui_version "$c_app"); version=${version:-${here:0:9}}
        newest=$(git ls-remote --tags --refs "$COMFYUI_GIT" 'v*' 2>/dev/null | sed 's#.*refs/tags/##' |
                 grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)
        if git -C "$c_app" symbolic-ref -q HEAD > /dev/null; then
            on_master=", master"
            lead=$(git -C "$c_app" rev-list --count HEAD..origin/master 2>/dev/null)
            [[ "$lead" =~ ^[1-9] ]] && lead=", $lead commits behind origin/master" || lead=""
        fi
        if [[ "$master" == true ]]; then
            # Against origin/master as GitHub has it now.
            local tip; tip=$(git ls-remote "$COMFYUI_GIT" refs/heads/master 2>/dev/null | cut -f1)
            if [[ -z "$tip" ]]; then echo "  ComfyUI ($version$on_master): cannot ask for master"
            elif [[ "$tip" == "$here" ]] || git -C "$c_app" merge-base --is-ancestor "$tip" HEAD 2>/dev/null; then
                echo "  ComfyUI ($version$on_master) — current with master${newest:+ ($newest is the newest release)}"
            else
