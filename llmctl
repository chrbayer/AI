# Where a model's draft belongs: the directory of the file its spec_args point
# --model-draft at. Deriving it keeps one source of truth for that path, instead
# of a second field that silently disagrees after an edit.
_draft_dir_from_spec() {
    local prev="" word
    for word in "$@"; do
        case "$prev" in
            -md|--model-draft|--spec-draft-model|--dflash-model|--mtp-model) dirname "$word"; return 0 ;;
        esac
        prev="$word"
    done
    return 1
}

# Some files a model needs live in a different repo than the model itself: the
# draft it speculates with, and — for the uncensored gemmas — the vision projector,
# which only the stock repo ships. Both fields hold "<repo> <include-pattern>".
_download_draft() {
    local draft_spec="$1" force="${2:-}"
    shift 2 2>/dev/null || shift $#
    local repo pat
    read -r repo pat <<< "$draft_spec"
    [[ -z "$repo" ]] && return 0
    local dir
    dir=$(_draft_dir_from_spec "$@") || {
        echo "  Skipping draft: spec_args name no --model-draft path" >&2
        return 0
    }
    echo "  Draft model:"
    _download_model "$repo" "$(_model_dl_dir "$dir/-" "" "$pat")" "$pat" "$force"
}

# Same idea for the mmproj, whose destination is simply where _model_mmproj says
# the file goes.
_download_mmproj() {
    local spec="$1" mmproj_path="$2" force="${3:-}"
    local repo pat
    read -r repo pat <<< "$spec"
    [[ -z "$repo" || -z "$mmproj_path" ]] && return 0
    echo "  Vision projector:"
    _download_model "$repo" "$(_model_dl_dir "$mmproj_path" "" "$pat")" "$pat" "$force"
}


# Where hf download puts a model's repo: _model_hf_dir, else the model file's
# directory — or above it, where the includes name the subdirectory the model
# lies in (UD-Q4_K_XL/* for …/UD-Q4_K_XL/x.gguf): hf keeps the repo's paths
# under --local-dir, which would nest them one level too deep.
_model_dl_dir() {
    local model="${1//\~/$HOME}" hf_dir="${2//\~/$HOME}" dir pat sub
    [[ -n "$hf_dir" ]] && { echo "$hf_dir"; return; }
    dir="$(dirname "$model")"
    local -a pats=(); read -ra pats <<< "$3"
    for pat in "${pats[@]}"; do
        [[ "$pat" == */* ]] || continue
        sub="${pat%/*}"
        # shellcheck disable=SC2053  # the include's directory may be a glob
        if [[ "$dir" == */$sub ]]; then
            local n="${sub//[^\/]/}"; n=$(( ${#n} + 1 ))
            while (( n-- )); do dir="$(dirname "$dir")"; done
            break
        fi
    done
    echo "$dir"
}

_download_model() {
    local repo="$1"
    local model_path="$2"
    local includes="$3"
    local force="${4:-}"

    local -a include_args=()
    read -ra include_pats <<< "$includes"
    for pat in "${include_pats[@]}"; do
        include_args+=(--include "$pat")
    done
    # Parts of a joined file (X.gguf.partNofM) are gone after the join; its
    # X.gguf.parts.json names them. While the Hub still has exactly those, they
    # are not to be fetched again.
    local x
    if [[ -d "$model_path" && -z "$force" ]]; then
        while IFS= read -r x; do
            [[ -n "$x" ]] && include_args+=(--exclude "$x")
        done < <(python3 "$HF_PARTS_SCRIPT" excludes "$repo" "$model_path" 2>/dev/null)
    fi

    # --check: hf compares with what is in the directory and fetches nothing.
    if [[ "$DL_CHECK" == true ]]; then
        # hf creates the directory and its .cache even for a dry run. Where there
        # is no directory yet, everything is missing, so a throwaway one answers.
        local out line dir="$model_path" tmp="" had_cache=true
        if [[ ! -d "$dir" ]]; then
            tmp=$(mktemp -d); dir="$tmp"
        fi
        [[ -e "$dir/.cache" ]] || had_cache=false
        out=$(hf download "$repo" --local-dir "$dir" "${include_args[@]}" --dry-run 2>&1)
        [[ "$had_cache" == true ]] || rm -rf "$dir/.cache"
        [[ -n "$tmp" ]] && rm -rf "$tmp"
        line=$(grep -m1 -oE 'Will download [0-9]+ files? \(out of [0-9]+\) totalling [0-9.]+ ?[A-Za-z]*' <<< "$out")
        if [[ -z "$line" ]]; then
            echo "  $repo: cannot tell — $(tail -1 <<< "$out")"
            DL_UNKNOWN=$(( DL_UNKNOWN + 1 ))
            return 0
        fi
        local n total size
        read -r _ _ n _ _ _ total _ size <<< "${line//[()]/}"
        size="${size%.}"
        if (( n == 0 )); then
            echo "  $repo: complete ($total file(s))"
        else
            echo "  $repo: $n of $total file(s) to download, $size"
            # The files that make the size; a repo's README and configs only as a count.
            awk -F'\t' 'f && $2 ~ /[MGT]$/ { printf "    %-8s %s\n", $2, $1; next }
                        f && $2 != "-" { small++ }
                        /^file\tsize/ { f = 1 }
                        END { if (small) printf "    and %d small file(s)\n", small }' <<< "$out"
            DL_PENDING=$(( DL_PENDING + 1 ))
        fi
        # Joined files: their parts against the Hub, not against local parts.
        if [[ -d "$model_path" ]]; then
            local state file count how
            while IFS=$'\t' read -r state file count how; do
                case "$state" in
                    current) echo "    $file: ${how:-joined from} $count, the same on the Hub" ;;
                    changed) if [[ "$how" == made* ]]; then
                                 echo "    $file: its sources changed on the Hub — download fetches them and makes it again"
                             else
                                 echo "    $file: its parts changed on the Hub — download fetches and joins them again"
                             fi ;;
                    unknown) echo "    $file" ;;
                esac
            done < <(python3 "$HF_PARTS_SCRIPT" check "$repo" "$model_path" 2>/dev/null)
        fi
        return 0
    fi

    echo "  Downloading $repo ..."
    mkdir -p "$model_path"

    if [[ -n "$force" ]]; then
        HF_FORCE_DOWNLOAD=1 hf download "$repo" --local-dir "$model_path" "${include_args[@]}" || return 1
    else
        hf download "$repo" --local-dir "$model_path" "${include_args[@]}" || return 1
    fi
    # Parts on the Hub: checked, joined with cat, recorded, deleted. A file made
    # here from the repo (quantized down) is made again where its sources came anew.
    LLAMA_QUANTIZE="$(dirname "$(command -v "${LLAMA_DEFAULT_BIN:-llama-server}" 2>/dev/null || echo "$LLAMA_DIR/vulkan/current/llama-server")")/llama-quantize" \
        python3 "$HF_PARTS_SCRIPT" join "$repo" "$model_path"
}

# ── ComfyUI setup ───────────────────────────────────────────
#
# A comfyui entry is set up rather than downloaded: a git checkout of ComfyUI with
# a venv beside main.py that holds torch built for ROCm, the patches this machine
# needs (comfyui/patches), the bundled workflows (comfyui/workflows), and every
# model those workflows name (comfyui_models.py). `download` does whatever of that
# is still missing, `update` pulls ComfyUI and its dependencies forward.

# Paths of the comfyui entry in _r_*: the checkout, its parent (--base-directory),
# the models and the workflows ComfyUI shows.
_comfyui_paths() {
    c_app="${_r_binary//\~/$HOME}"
    c_base="$(dirname "$c_app")"
    c_models="${_r_model//\~/$HOME}"
    c_wf="$c_base/user/default/workflows"
}

_comfyui_running() {
    local s pid
    for s in $(_comfyui_slots); do
        pid=$(_slot_server_pid "$s") && _read_argv "$pid" && [[ "${_ARGV[1]}" == "$c_app/main.py" ]] && return 0
    done
    return 1
}

_comfyui_pip() {
    TMPDIR="$COMFYUI_TMP" "$c_app/.venv/bin/python" -m pip --disable-pip-version-check "$@"
}

# requirements.txt without letting it swap the ROCm torch for a CUDA one, then the
# clean-up a CUDA-flavoured dependency leaves behind. $1 = torch: torch too.
_comfyui_python_deps() {
    mkdir -p "$COMFYUI_TMP"
    if [[ "${1:-}" == torch ]]; then
        echo "  torch, torchvision from $COMFYUI_TORCH_INDEX, torchaudio from $COMFYUI_TORCHAUDIO_INDEX"
        _comfyui_pip install -q --upgrade torch torchvision --index-url "$COMFYUI_TORCH_INDEX" || return 1
        _comfyui_pip install -q --upgrade --no-deps torchaudio --index-url "$COMFYUI_TORCHAUDIO_INDEX" || return 1
    fi
    echo "  requirements.txt (torch stays on the installed ROCm build)"
    local constraints="$COMFYUI_TMP/torch-constraints.txt"
    _comfyui_pip freeze | grep -E '^(torch|torchvision|torchaudio)==' > "$constraints"
    _comfyui_pip install -q -r "$c_app/requirements.txt" -c "$constraints" || { rm -f "$constraints"; return 1; }
    rm -f "$constraints"
    local cuda
    cuda=$(_comfyui_pip list 2>/dev/null | awk '/^nvidia-/ { print $1 }')
    if [[ -n "$cuda" ]]; then
        echo "  removing CUDA packages: $(echo $cuda)"
        _comfyui_pip uninstall -q -y $cuda
    fi
    if _comfyui_pip show -q triton 2>/dev/null; then
        echo "  replacing CUDA triton with triton-rocm"
        _comfyui_pip uninstall -q -y triton
        _comfyui_pip install -q --force-reinstall --no-deps triton-rocm --index-url "$COMFYUI_TORCH_INDEX"
    fi
}

_comfyui_gpu_check() {
    "$c_app/.venv/bin/python" - <<'EOF' 2>&1 | grep -v -e '^(null)' -e 'rocSHMEM.*libnuma'
import sys, torch
ok = torch.version.hip is not None and torch.cuda.is_available()
print(f"  torch {torch.__version__}, HIP {torch.version.hip}, GPU: {torch.cuda.get_device_name(0) if ok else 'NOT available'}")
sys.exit(0 if ok else 1)
EOF
}

# Bring the patches in comfyui/patches onto the checkout. One that applies in
# reverse is already there — applied before, or taken over upstream.
_comfyui_apply_patches() {
    local p
    for p in "$COMFYUI_SHARE"/patches/*.patch; do
        [[ -f "$p" ]] || continue
        if git -C "$c_app" apply --check "$p" 2>/dev/null; then
            git -C "$c_app" apply "$p" && echo "  patch $(basename "$p"): applied"
        elif git -C "$c_app" apply -R --check "$p" 2>/dev/null; then
            echo "  patch $(basename "$p"): already in place"
        else
            echo "  patch $(basename "$p"): NO LONGER APPLIES — ComfyUI changed the code it touches."
            echo "        ComfyUI runs without it; check whether upstream fixed the problem itself."
        fi
    done
}

# Take our patches out again before a pull, so git sees a clean tree. Only where
# the file is locally modified: a patch that applies in reverse on an unmodified
# file has been taken over upstream, and reverting it would undo upstream's code.
_comfyui_revert_patches() {
    local p f modified
    modified=" $(git -C "$c_app" diff --name-only | tr '\n' ' ') "
    for p in "$COMFYUI_SHARE"/patches/*.patch; do
        [[ -f "$p" ]] || continue
        local mine=true
        for f in $(git -C "$c_app" apply --numstat "$p" 2>/dev/null | awk '{ print $3 }'); do
            [[ "$modified" == *" $f "* ]] || mine=false
        done
        [[ "$mine" == true ]] && git -C "$c_app" apply -R --check "$p" 2>/dev/null &&
            git -C "$c_app" apply -R "$p"
    done
}

# Copy the bundled workflows that ComfyUI does not have yet, and replace a copy
# that is still an earlier bundled version (workflow_versions.txt) with the
# current one. One the user changed in the UI matches no bundled version: it is
# theirs and stays; it is only named. A workflow directory that is a symlink into
# the checkout (see README) already is the bundled set.
_comfyui_sync_workflows() {
    local src="$COMFYUI_SHARE/workflows" f name
    [[ -d "$src" ]] || return 0
    mkdir -p "$c_wf"
    [[ "$(readlink -f "$c_wf")" == "$(readlink -f "$src")" ]] && { echo "  workflows: linked to $src"; return 0; }
    local -A earlier=()
    local sum
    while read -r sum name; do
        [[ -z "$sum" || "$sum" == \#* ]] || earlier["$sum  $name"]=1
    done < "$COMFYUI_SHARE/workflow_versions.txt" 2>/dev/null
    local added=0 updated=0 differ=()
    for f in "$src"/*.json; do
        name="$(basename "$f")"
        if [[ ! -e "$c_wf/$name" ]]; then
            cp "$f" "$c_wf/$name"; added=$(( added + 1 ))
        elif ! cmp -s "$f" "$c_wf/$name"; then
            if [[ -n "${earlier["$(sha256sum "$c_wf/$name" | cut -d' ' -f1)  $name"]:-}" ]]; then
                cp "$f" "$c_wf/$name"; updated=$(( updated + 1 ))
            else
                differ+=("$name")
            fi
        fi
    done
    echo "  workflows: $added added to $c_wf"
    (( updated )) && echo "  workflows: $updated updated to the bundled version (unchanged since the last one)"
    # Retired ones (now variants of a workflow with switches): gone if untouched.
    local removed=0 kept=()
    while read -r sum name; do
        [[ -z "$sum" || "$sum" == \#* || ! -e "$c_wf/$name" ]] && continue
        if [[ "$(sha256sum "$c_wf/$name" | cut -d' ' -f1)" == "$sum" ]]; then
            rm -f "$c_wf/$name"; removed=$(( removed + 1 ))
        else
            kept+=("$name")
        fi
    done < "$COMFYUI_SHARE/retired_workflows.txt" 2>/dev/null
    (( removed )) && echo "  workflows: $removed replaced by one with switches, removed"
    if (( ${#kept[@]} )); then
        echo "  replaced by a workflow with switches, but kept as you changed them:"
        printf '    %s\n' "${kept[@]}"
    fi
    if (( ${#differ[@]} )); then
        echo "  kept as you changed them (bundled version differs):"
        printf '    %s\n' "${differ[@]}"
    fi
}

# Install the custom node packs comfyui/custom_nodes.txt names, each at its pinned
# commit (or a release tag after it; with "master", its main branch), into --base-directory's custom_nodes/ (where ComfyUI looks), and their
# requirements into ComfyUI's venv with torch held to its ROCm build; "-name"
# after the commit drops a requirement, "+name" adds one.
# The newest version tag of a node pack's repo (local after a fetch, or remote
# by URL), or nothing. Packs tag loosely (8.28, 1.3.4, v.1.0.0): any tag of
# digits and dots, with an optional v or v. in front.
_node_pack_tag() {
    local src="$1"
    if [[ -d "$src/.git" ]]; then git -C "$src" tag -l; else git ls-remote --tags --refs "$src" 2>/dev/null | sed 's#.*refs/tags/##'; fi |
        grep -E '^v?\.?[0-9]+(\.[0-9]+)*$' | sort -V | tail -1
}

_comfyui_custom_nodes() {
    local list="$COMFYUI_SHARE/custom_nodes.txt"
    [[ -f "$list" ]] || return 0
    mkdir -p "$c_base/custom_nodes" "$COMFYUI_TMP"
    local dir url commit rest line
    while read -r dir url commit rest; do
        [[ -z "$dir" || "$dir" == \#* ]] && continue
        local target="$c_base/custom_nodes/$dir"
        if [[ ! -d "$target/.git" ]]; then
            git clone -q "$url" "$target" || { echo "  custom nodes $dir: clone failed"; continue; }
        fi
        # The pin, or a release tag of the pack made after it: tags count, commits
        # do not. Most packs tag rarely, and their newest tag lies behind the pin.
        git -C "$target" fetch -q --tags origin 2>/dev/null
        local want="$commit" label="${commit:0:12}" tag
        tag=$(_node_pack_tag "$target")
        if [[ "${1:-}" == master ]]; then
            # update --master: the pack's main branch, tags or not.
            git -C "$target" remote set-head origin --auto > /dev/null 2>&1
            want=$(git -C "$target" rev-parse origin/HEAD 2>/dev/null) || want="$commit"
            label="${want:0:12} (its main branch; the pin is ${commit:0:12})"
        elif [[ -n "$tag" ]] && ! git -C "$target" merge-base --is-ancestor "$tag" "$commit" 2>/dev/null &&
           git -C "$target" merge-base --is-ancestor "$commit" "$tag" 2>/dev/null; then
            want="$tag" label="$tag (released after the pin ${commit:0:12})"
        fi
        # Never backwards: past what it would get (a --master from before), it stays.
        if [[ "${1:-}" != master ]] && git -C "$target" merge-base --is-ancestor "$want" HEAD 2>/dev/null; then
            want=$(git -C "$target" rev-parse HEAD)
            [[ "$want" != "$(git -C "$target" rev-parse "$commit^{commit}" 2>/dev/null)" ]] &&
                label="${want:0:12} (past the pin ${commit:0:12}; staying put)"
        fi
        if [[ "$(git -C "$target" rev-parse HEAD 2>/dev/null)" != "$(git -C "$target" rev-parse "$want^{commit}" 2>/dev/null)" ]]; then
            git -C "$target" -c advice.detachedHead=false checkout -q "$want" ||
                { echo "  custom nodes $dir: ${want:0:12} not found"; continue; }
            echo "  custom nodes $dir: at $label"
        else
            echo "  custom nodes $dir: at $label (unchanged)"
        fi
        if [[ -f "$target/requirements.txt" ]]; then
            local skip req="$COMFYUI_TMP/req-$dir.txt" constraints="$COMFYUI_TMP/torch-constraints.txt"
            cp "$target/requirements.txt" "$req"
            for skip in $rest; do
                case "$skip" in
                    # The name taken literally: a git+https:// requirement is full of regex characters.
                    -*) sed -i -E "s/^[[:space:]]*$(printf '%s' "${skip#-}" | sed 's/[][\\.*^$+?(){}|/]/\\&/g')([[:space:]<>=!~;#].*)?$/# skipped by llmctl: &/" "$req" ;;
                    +*) printf '\n%s\n' "${skip#+}" >> "$req" ;;   # the file may lack a final newline
                esac
            done
            _comfyui_pip freeze | grep -E '^(torch|torchvision|torchaudio)==' > "$constraints"
            _comfyui_pip install -q -r "$req" -c "$constraints" || echo "  custom nodes $dir: requirements failed"
            rm -f "$req" "$constraints"
        fi
    done < "$list"
}

# Move an existing ComfyUI checkout into place instead of building a new one: the
# checkout becomes app/, its models, user data, input and output move to where
# llmctl keeps them. All on one filesystem that is a rename, however many GB.
# A venv is not relocatable — its scripts carry the old path — so that is rewritten.
_comfyui_migrate() {
    local from="${1%/}"
    from="$(readlink -f "$from")"
    if [[ ! -f "$from/main.py" || ! -d "$from/.venv" ]]; then
        echo "Error: $from is no ComfyUI checkout with a .venv"; return 1
    fi
    if [[ -e "$c_app" ]]; then
        echo "Error: $c_app exists already — nothing to move it into"; return 1
    fi
    local p
    for p in $(pgrep -f 'main.py'); do
        if [[ "$(readlink -f /proc/$p/cwd 2>/dev/null)" == "$from" ]]; then
            echo "Error: ComfyUI is running from $from (PID $p) — stop it first"; return 1
        fi
    done
    if [[ -e "$c_models" ]] && [[ -n "$(ls -A "$c_models" 2>/dev/null)" ]]; then
        echo "Error: $c_models is not empty — move the models by hand, or clear it first"; return 1
    fi
    local d
    for d in user input output; do
        if [[ -d "$from/$d" && -e "$c_base/$d" ]]; then
            echo "Error: both $from/$d and $c_base/$d exist — merge them by hand first"; return 1
        fi
    done

    echo "  moving $from → $c_app"
    mkdir -p "$c_base" "$(dirname "$c_models")"
    if [[ -d "$from/models" ]]; then
        rmdir "$c_models" 2>/dev/null
        mv "$from/models" "$c_models" && echo "  models → $c_models"
    fi
    for d in user input output; do
        [[ -d "$from/$d" ]] && mv "$from/$d" "$c_base/$d" && echo "  $d/ → $c_base/$d"
    done
    rm -rf "$from/temp"
    mv "$from" "$c_app" || return 1
    # The checkout tracks placeholders in models/, input/ and output/. Unused now —
    # the flags point elsewhere — but git would count them as deleted, and `update`
    # wants a clean tree.
    git -C "$c_app" checkout -q -- models input output 2>/dev/null

    echo "  rewriting the venv's paths"
    local f
    for f in "$c_app/.venv/pyvenv.cfg" "$c_app"/.venv/bin/*; do
        [[ -f "$f" && ! -L "$f" ]] && grep -Iq "$from/" "$f" 2>/dev/null &&
            sed -i "s#$from/#$c_app/#g" "$f"
    done
    local left
    left=$(grep -rlI "$from/" "$c_app/.venv/bin" "$c_app/.venv/pyvenv.cfg" 2>/dev/null)
    [[ -n "$left" ]] && { echo "  still naming $from:"; printf '    %s\n' $left; }
    return 0
}

# ComfyUI publishes releases (vX.Y.Z tags, about one a week; patch releases
# vX.Y.1, .2 … on a release/vX.Y branch with fixes backported); llmctl follows
# the newest tag, not master: the frontend and template packages its
# requirements pin belong together at a release. `update --master` follows
# master instead.
# The newest release tag in the checkout (after a fetch), or nothing.
_comfyui_release_tag() {
    git -C "$1" tag -l 'v[0-9]*.[0-9]*.[0-9]*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1
}

# Where the checkout stands: the release it is at or past, and how far past.
_comfyui_version() {
    git -C "$1" describe --tags --match 'v[0-9]*' 2>/dev/null | sed -E 's/-([0-9]+)-g[0-9a-f]+$/+\1/'
}

# A fresh checkout and venv. COMFYUI_PYTHON picks the interpreter — it needs to be
# one the ROCm torch wheels are built for.
_comfyui_install() {
    local py
    py=$(_find_python "${COMFYUI_PYTHON:-}") || { echo "Error: no working Python 3 found (set COMFYUI_PYTHON)"; return 1; }
    _check_deps git || return 1
    echo "  git clone $COMFYUI_GIT"
    mkdir -p "$c_base"
    git clone -q "$COMFYUI_GIT" "$c_app" || return 1
    local tag; tag=$(_comfyui_release_tag "$c_app")
    if [[ "${DL_MASTER:-false}" == true ]]; then
        echo "  on master (--master)"
    elif [[ -n "$tag" ]]; then
        echo "  at the newest release, $tag"
        git -C "$c_app" checkout -q "$tag" || return 1
    fi
    echo "  venv with $("$py" --version 2>&1)"
    "$py" -m venv "$c_app/.venv" || return 1
    _comfyui_python_deps torch
}

# download for a comfyui entry. $1 = workflow name pattern or "", $2 = --from dir or "".
_download_comfyui() {
    local pattern="$1" from="$2"
    _comfyui_paths
    echo "=== $_r_label ==="
    [[ "$DL_CHECK" == true ]] && { _check_comfyui "$pattern"; return 0; }
    if [[ -n "$from" ]]; then
        _comfyui_migrate "$from" || return 1
    elif [[ ! -x "$c_app/.venv/bin/python" ]]; then
        if [[ -e "$c_app" ]]; then
            echo "Error: $c_app exists but has no .venv — remove it, or complete it by hand"; return 1
        fi
        _comfyui_install || return 1
    else
        echo "  ComfyUI in $c_app (update it with: $PROG update $_r_name)"
    fi
    _comfyui_apply_patches
    _comfyui_custom_nodes
    _comfyui_gpu_check || echo "  Warning: torch sees no GPU — ComfyUI would run on the CPU."
    _comfyui_sync_workflows
    mkdir -p "$c_models"
    _comfyui_links "$c_base" "$c_models"
    # The VoiceDesign model `voice design` already has: a reflink costs no space
    # on btrfs, and an ordinary copy elsewhere.
    local qd
    qd="$c_models/qwen-tts/$(basename "$TTS_DESIGN_DIR")"
    if [[ -f "$TTS_DESIGN_DIR/model.safetensors" && ! -e "$qd" ]]; then
        mkdir -p "$(dirname "$qd")" && cp -r --reflink=auto "$TTS_DESIGN_DIR" "$qd"
    fi
    # Model configs for old checkpoints ship in the checkout's models/configs, and
    # --models-directory looks for them beside the models.
    [[ -d "$c_models/configs" || ! -d "$c_app/models/configs" ]] || cp -r "$c_app/models/configs" "$c_models/"
    _check_deps hf python3 || return 1
    # Civitai's API key, for workflows whose models come from there; the helper
    # asks for one (and stores it here) when it is missing or refused.
    export LLMCTL_CIVITAI_TOKEN_FILE="$CONFIG_DIR/civitai-token"
    if [[ -z "${CIVITAI_TOKEN:-}" && -r "$LLMCTL_CIVITAI_TOKEN_FILE" ]]; then
        CIVITAI_TOKEN="$(< "$LLMCTL_CIVITAI_TOKEN_FILE")"
        export CIVITAI_TOKEN
    fi
    python3 -u "$COMFYUI_MODELS_SCRIPT" download "$c_wf" "$c_models" ${pattern:+"$pattern"} --sources "$COMFYUI_SHARE/sources.json"
}

# download --check for a comfyui entry: the checkout and its venv, the custom
# nodes at their commit, and the models the workflows name. Changes nothing.
_check_comfyui() {
    local pattern="$1" wf="$c_wf"
    if [[ -x "$c_app/.venv/bin/python" ]]; then
        echo "  ComfyUI: present in $c_app"
    else
        echo "  ComfyUI: to set up — git clone, venv with ROCm torch (~17 GB of wheels)"
        DL_PENDING=$(( DL_PENDING + 1 ))
    fi
    local dir url commit rest
    while read -r dir url commit rest; do
        [[ -z "$dir" || "$dir" == \#* ]] && continue
        local target="$c_base/custom_nodes/$dir"
        if [[ ! -d "$target/.git" ]]; then
            echo "  custom nodes $dir: to clone"; DL_PENDING=$(( DL_PENDING + 1 ))
        elif [[ "$(git -C "$target" rev-parse HEAD 2>/dev/null)" != "$commit" ]]; then
            if git -C "$target" cat-file -e "$commit^{commit}" 2>/dev/null; then
                echo "  custom nodes $dir: to move to ${commit:0:12} (already fetched)"
            else
                echo "  custom nodes $dir: to fetch ${commit:0:12}"; DL_PENDING=$(( DL_PENDING + 1 ))
            fi
        else
            echo "  custom nodes $dir: at ${commit:0:12}"
        fi
    done < <(grep -v '^[[:space:]]*$' "$COMFYUI_SHARE/custom_nodes.txt" 2>/dev/null)
    # Before the first download the workflows are only the bundled ones.
    [[ -d "$wf" ]] || wf="$COMFYUI_SHARE/workflows"
    _check_deps hf python3 || return 1
    python3 "$COMFYUI_MODELS_SCRIPT" check "$wf" "$c_models" ${pattern:+"$pattern"} --sources "$COMFYUI_SHARE/sources.json"
    case $? in
        0) ;;
        1) DL_PENDING=$(( DL_PENDING + 1 )) ;;
        *) DL_UNKNOWN=$(( DL_UNKNOWN + 1 )) ;;
    esac
}

# An interpreter the ROCm torch wheels are built for. `command -v` is no test:
# a pyenv shim for a version that is installed but not selected exists and
# fails when run. $1 is an explicit choice, tried first.
_find_python() {
    local py
    for py in ${1:+"$1"} python3.13 "$HOME"/.pyenv/versions/3.13*/bin/python3.13 python3; do
        "$py" -c 'import sys; sys.exit(0)' 2>/dev/null && { echo "$py"; return 0; }
    done
    return 1
}

# ── Speech setup ────────────────────────────────────────────
#
# download for a tts entry fetches its GGUFs the usual way (hf_repo); this adds
# what `voice design` needs — a Python with ROCm torch and qwen_tts, and the
# VoiceDesign model — and the bundled starter voices.

# The Python that designs voices, in _vd_py, with _vd_path for PYTHONPATH:
# ComfyUI's venv where ComfyUI is set up, with the qwen_tts its Qwen-TTS node
# ships as source — the same torch, 16 GB not installed twice. (The pip package
# qwen-tts would not do: it pins transformers 4.57 and would break ComfyUI.)
# Otherwise a venv of its own, which `download` builds.
_voice_python() {
    local entry app lib
    local -a f
    _vd_py="" _vd_path=""
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        [[ "${f[19]:-}" == comfyui ]] || continue
        app="${f[1]//\~/$HOME}"
        for lib in "$(dirname "$app")"/custom_nodes/*/qwen_tts; do
            if [[ -x "$app/.venv/bin/python" && -f "$lib/__init__.py" ]]; then
                _vd_py="$app/.venv/bin/python" _vd_path="$(dirname "$lib")"
                return 0
            fi
        done
    done
    [[ -x "$TTS_DIR/venv/bin/python" ]] && { _vd_py="$TTS_DIR/venv/bin/python"; return 0; }
    return 1
}

_tts_setup() {
    if [[ "$DL_CHECK" == true ]]; then
        if _voice_python && [[ -n "$_vd_path" ]]; then
            echo "  voice design: ComfyUI's venv"
        elif [[ -n "$_vd_py" ]]; then
            echo "  venv for voice design: present"
        else
            echo "  venv for voice design: to build — torch and torchaudio for ROCm, qwen-tts (several GB)"
            DL_PENDING=$(( DL_PENDING + 1 ))
        fi
        echo "  VoiceDesign model:"
        _download_model "$TTS_DESIGN_REPO" "$TTS_DESIGN_DIR" ""
        return 0
    fi
    mkdir -p "$TTS_VOICES"
    local f n=0
    for f in "$TTS_SHARE"/voices/*; do
        [[ -f "$f" && ! -e "$TTS_VOICES/$(basename "$f")" ]] && { cp "$f" "$TTS_VOICES/"; n=$(( n + 1 )); }
    done
    echo "  voices: $n file(s) added to $TTS_VOICES"
    if _voice_python && [[ -n "$_vd_path" ]]; then
        echo "  voice design runs in ComfyUI's venv (${_vd_py%/bin/python})"
    elif [[ ! -x "$TTS_DIR/venv/bin/python" ]]; then
        local py
        py=$(_find_python "${TTS_PYTHON:-}") || { echo "Error: no working Python 3 found (set TTS_PYTHON)"; return 1; }
        echo "  venv for voice design with $("$py" --version 2>&1)"
        "$py" -m venv "$TTS_DIR/venv" || return 1
        mkdir -p "$COMFYUI_TMP"
        echo "  torch from $COMFYUI_TORCH_INDEX, torchaudio from $COMFYUI_TORCHAUDIO_INDEX"
        TMPDIR="$COMFYUI_TMP" "$TTS_DIR/venv/bin/python" -m pip install -q --disable-pip-version-check \
            torch --index-url "$COMFYUI_TORCH_INDEX" || return 1
        TMPDIR="$COMFYUI_TMP" "$TTS_DIR/venv/bin/python" -m pip install -q --disable-pip-version-check \
            --no-deps torchaudio --index-url "$COMFYUI_TORCHAUDIO_INDEX" || return 1
        echo "  qwen-tts"
        TMPDIR="$COMFYUI_TMP" "$TTS_DIR/venv/bin/python" -m pip install -q --disable-pip-version-check qwen-tts || return 1
    else
        echo "  venv for voice design in $TTS_DIR/venv"
    fi
    if [[ ! -f "$TTS_DESIGN_DIR/model.safetensors" ]]; then
        echo "  VoiceDesign model ($TTS_DESIGN_REPO)"
        hf download "$TTS_DESIGN_REPO" --local-dir "$TTS_DESIGN_DIR" > /dev/null || return 1
    fi
    echo "  VoiceDesign model in $TTS_DESIGN_DIR"
    if [[ "$(basename "$_r_binary")" == llama-server* && ! -x "${_r_binary//\~/$HOME}" ]]; then
        echo "  Streaming needs a llama-server with /tts (llama.cpp PR #26603), not built yet:"
        echo "    $SHARE_DIR/patches/build-tts-server.sh"
        echo "  Until then the slot speaks through llama-tts, without streaming."
    fi
}

# llmctl voice list|add|design|rm — the reference recordings speech slots speak in.
cmd_voice() {
    local sub="${1:-list}"; shift 2>/dev/null || true
    mkdir -p "$TTS_VOICES"
    case "$sub" in
        list)
            local f any=0
            printf "\n\033[1mVoices\033[0m (%s)\n\n" "$TTS_VOICES"
            for f in "$TTS_VOICES"/*.wav "$TTS_VOICES"/*.mp3 "$TTS_VOICES"/*.flac; do
                [[ -f "$f" ]] || continue
                any=1
                local n="${f##*/}"; n="${n%.*}"
                local desc=""
                [[ -f "$TTS_VOICES/$n.txt" ]] && desc=$(head -1 "$TTS_VOICES/$n.txt")
                printf "  \033[36m%-12s\033[0m %s\n" "$n" "${desc:-(${f##*.} recording)}"
            done
            (( any )) || echo "  none yet — $PROG voice design <name> \"<description>\"  or  $PROG voice add <name> <file>"
            echo ""
            ;;
        add)
            local name="${1:-}" file="${2:-}" desc="${3:-}"
            [[ -n "$name" && -f "$file" ]] || { echo "Usage: $PROG voice add <name> <file.wav|.mp3|.flac> [\"description\"]"; return 1; }
            [[ "$name" =~ ^[a-z0-9_-]+$ ]] || { echo "Error: a voice name is lowercase letters, digits, - and _"; return 1; }
            local ext="${file##*.}"; ext="${ext,,}"
            [[ " wav mp3 flac " == *" $ext "* ]] || { echo "Error: llama-tts reads wav, mp3 or flac"; return 1; }
            rm -f "$TTS_VOICES/$name".{wav,mp3,flac}
            # Stored as WAV at one loudness: a clone speaks as loud as its reference.
            # Without the voice-design venv (download not run), as it comes.
            if _voice_python &&
               PYTHONPATH="$_vd_path" "$_vd_py" "$TTS_DESIGN_SCRIPT" --normalize "$file" "$TTS_VOICES/$name.wav" 2>/dev/null; then
                :
            else
                cp "$file" "$TTS_VOICES/$name.$ext"
            fi
            printf '%s\n' "${desc:-recording: $(basename "$file")}" > "$TTS_VOICES/$name.txt"
            _comfyui_voice_links_all
            echo "Voice '$name' added. A few seconds of clean speech are enough; the clone keeps its timbre."
            ;;
        design)
            local name="${1:-}" desc="${2:-}"; shift 2 2>/dev/null || true
            local language="German" text=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --language) language="$2"; shift 2 ;;
                    --text) text="$2"; shift 2 ;;
                    *) echo "Unknown option: $1"; return 1 ;;
                esac
            done
            if [[ -z "$name" || -z "$desc" ]]; then
                echo "Usage: $PROG voice design <name> \"<description>\" [--language German] [--text \"sample sentence\"]"
                echo "  Describe the speaker as a native speaker of the language — the clone keeps any accent."
                return 1
            fi
            [[ "$name" =~ ^[a-z0-9_-]+$ ]] || { echo "Error: a voice name is lowercase letters, digits, - and _"; return 1; }
            if ! _voice_python || [[ ! -f "$TTS_DESIGN_DIR/model.safetensors" ]]; then
                echo "Error: voice design is not set up — run: $PROG download <speech model>"; return 1
            fi
            echo "Designing '$name' (Qwen3-TTS VoiceDesign, ~15 s) ..."
            local -a targs=("$TTS_DESIGN_DIR" "$TTS_VOICES/$name.wav" "$desc" --language "$language")
            [[ -n "$text" ]] && targs+=(--text "$text")
            TMPDIR="$COMFYUI_TMP" PYTHONPATH="$_vd_path" "$_vd_py" "$TTS_DESIGN_SCRIPT" "${targs[@]}" 2>&1 |
                grep -vE 'SoX|sox|flash-attn|^\*+$|If you do|double-check|path variables|- - -|MIOpen|pad_token|^\s*$|\(null\)' || true
            [[ -f "$TTS_VOICES/$name.wav" ]] || { echo "Error: no recording was written"; return 1; }
            rm -f "$TTS_VOICES/$name".{mp3,flac}
            printf '%s\n' "$desc" > "$TTS_VOICES/$name.txt"
            _comfyui_voice_links_all
            echo "Voice '$name' ready. Listen: $TTS_VOICES/$name.wav"
            ;;
        export)
            # The voices exist nowhere else: a lost home directory means
            # recording and designing them again.
            local out="${1:-$HOME/llmctl-voices-$(date +%Y%m%d).tar.gz}"
            local -a files=()
            local f
            for f in "$TTS_VOICES"/*.{wav,mp3,flac,txt}; do [[ -f "$f" ]] && files+=("${f##*/}"); done
            (( ${#files[@]} )) || { echo "No voices in $TTS_VOICES."; return 1; }
            tar -czf "$out" -C "$TTS_VOICES" "${files[@]}" || return 1
            printf 'Wrote %s (%s, %d voice file(s)).\n' "$out" "$(du -h "$out" | cut -f1)" "${#files[@]}"
            ;;
        import)
            local archive="${1:-}" force=false
            [[ "${2:-}" == --force || "$archive" == --force ]] && force=true
            [[ "$archive" == --force ]] && archive="${2:-}"
            [[ -f "$archive" ]] || { echo "Usage: $PROG voice import <archive.tar.gz> [--force]"; return 1; }
            mkdir -p "$TTS_VOICES"
            local tmp; tmp=$(mktemp -d)
            tar -xzf "$archive" -C "$tmp" || { rm -rf "$tmp"; return 1; }
            # Decided per voice, not per file: a voice is its audio in any of the
            # three formats, and its .txt goes wherever the audio goes.
            local n=0 present=0 stem ext here audio
            local -a stems
            mapfile -t stems < <(cd "$tmp" && for f in *.{wav,mp3,flac,txt}; do
                [[ -f "$f" ]] && echo "${f%.*}"; done | sort -u)
            for stem in "${stems[@]}"; do
                [[ "$stem" =~ ^[a-z0-9_-]+$ ]] || { echo "Skipped '$stem': not a voice name."; continue; }
                here=false audio=""
                for ext in wav mp3 flac; do
                    [[ -f "$TTS_VOICES/$stem.$ext" ]] && here=true
                    [[ -f "$tmp/$stem.$ext" ]] && audio="$stem.$ext"
                done
                if [[ "$here" == true && "$force" != true ]]; then
                    [[ -n "$audio" ]] && present=$(( present + 1 ))
                    continue
                fi
                if [[ -n "$audio" ]]; then
                    rm -f "$TTS_VOICES/$stem".{wav,mp3,flac}
                    cp "$tmp/$audio" "$TTS_VOICES/$audio"
                    n=$(( n + 1 ))
                fi
                # A description without audio only fills a gap.
                [[ -f "$tmp/$stem.txt" ]] && { [[ -n "$audio" || ! -e "$TTS_VOICES/$stem.txt" ]]; } \
                    && cp "$tmp/$stem.txt" "$TTS_VOICES/$stem.txt"
            done
            rm -rf "$tmp"
            _comfyui_voice_links_all
            local note=""
            (( present )) && note=", kept $present already here (--force replaces them)"
            echo "Imported $n voice(s)$note."
            ;;
        rm)
            local name="${1:-}" ext found=0
            [[ -n "$name" ]] || { echo "Usage: $PROG voice rm <name>"; return 1; }
            # A voice has one of these; ls on all three would fail for the two it lacks.
            for ext in wav mp3 flac; do [[ -f "$TTS_VOICES/$name.$ext" ]] && found=1; done
            (( found )) || { echo "No voice '$name'."; return 1; }
            rm -f "$TTS_VOICES/$name".{wav,mp3,flac,txt}
            # Its links in ComfyUI's input no longer have a voice to be matched by.
            local entry m_name
            for entry in "${_MODELS[@]}"; do
                IFS='|' read -r m_name _ <<< "$entry"
                _resolve_model "$m_name" && [[ "$_r_backend" == comfyui ]] || continue
                rm -f "$(dirname "${_r_binary//\~/$HOME}")/input/voice-$name".{wav,mp3,flac}
            done
            _comfyui_voice_links_all
            echo "Voice '$name' removed."
            ;;
        *) echo "Usage: $PROG voice list | add <name> <file> | design <name> \"<description>\" | rm <name>"
           echo "       $PROG voice export [archive.tar.gz] | import <archive.tar.gz> [--force]"; return 1 ;;
    esac
}

# ── llama.cpp builds ─────────────────────────────────────────

# The smallest llama.cpp model on disk, for the load test of a new build.
_llama_test_model() {
    local entry name best="" best_size=0 size
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r name _ <<< "$entry"
        _resolve_model "$name" 2>/dev/null || continue
        [[ "$_r_backend" == llama && -f "$_r_model" ]] || continue
        size=$(stat -L -c %s "$_r_model" 2>/dev/null) || continue
        if [[ -z "$best" ]] || (( size < best_size )); then best="$_r_model"; best_size=$size; fi
    done
    echo "$best"
}

# A build passes when --version names a commit and it serves a small model on the GPU.
_llama_test_build() {
    local bin="$1" model port=$(( 18990 + RANDOM % 9 )) pid ok=1 i
    "$bin" --version 2>&1 | grep -q "commit" || { echo "    --version failed:"; "$bin" --version 2>&1 | tail -3 | sed 's/^/      /'; return 1; }
    model=$(_llama_test_model)
    if [[ -z "$model" ]]; then echo "    no llama.cpp model on disk to load — skipped the load test"; return 0; fi
    "$bin" -m "$model" -ngl 99 -c 2048 --port "$port" --host 127.0.0.1 > "$STATE_DIR/llama-test.log" 2>&1 &
    pid=$!
    for i in $(seq 120); do
        curl -sf "http://127.0.0.1:$port/health" > /dev/null && { ok=0; break; }
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    if (( ok )); then
        echo "    load test with $(basename "$model") failed:"; tail -5 "$STATE_DIR/llama-test.log" | sed 's/^/      /'
        return 1
    fi
    echo "    loads $(basename "$model") and answers /health"
}

# Bring KIND (vulkan, rocm) to the build the resolver names: download, unpack,
# test, then move current. Builds other than the new and the previous go.
_llama_install() {
    local kind="$1" info="$2" check="$3" build url asset dir cur tmp top
    build=$(jq -r ".$kind.build // empty" <<< "$info"); url=$(jq -r ".$kind.url // empty" <<< "$info")
    asset=$(jq -r ".$kind.asset // empty" <<< "$info")
    if [[ -z "$build" ]]; then echo "  $kind: no build for $(jq -r .tag <<< "$info") found"; return 1; fi
    dir="$LLAMA_DIR/$kind/$build"
    cur=$(readlink "$LLAMA_DIR/$kind/current" 2>/dev/null)
    if [[ "$cur" == "$build" && -x "$dir/llama-server" ]]; then
        echo "  $kind: $build — current ($(jq -r .tag <<< "$info"))"; return 0
    fi
    if [[ "$check" == true ]]; then
        echo "  $kind: $build to install ($asset, $(( $(jq -r ".$kind.size" <<< "$info") / 1000000 )) MB)${cur:+, now $cur}"
        DL_PENDING=$(( DL_PENDING + 1 )); return 0
    fi
    echo "  $kind: $build ($asset)"
    if [[ -x "$dir/llama-server" ]]; then           # there from before (a rollback, or a broken link)
        _llama_test_build "$dir/llama-server" || return 1
        ln -sfn "$build" "$LLAMA_DIR/$kind/current"
        echo "    current again: $dir"; return 0
    fi
    mkdir -p "$LLAMA_DIR/$kind"
    tmp="$LLAMA_DIR/$kind/.$build.part"; rm -rf "$tmp"; mkdir -p "$tmp"
    echo "    downloading $(( $(jq -r ".$kind.size" <<< "$info") / 1000000 )) MB"
    curl -fsSL -o "$tmp/$asset" "$url" || { rm -rf "$tmp"; echo "    download failed"; return 1; }
    case "$asset" in
        *.tar.gz) tar xzf "$tmp/$asset" -C "$tmp" ;;
        *.zip)    python3 -m zipfile -e "$tmp/$asset" "$tmp" ;;
    esac || { rm -rf "$tmp"; echo "    unpacking failed"; return 1; }
    rm -f "$tmp/$asset"
    # The tarball holds one directory (llama-b11146/), the zip its files flat.
    top=$(find "$tmp" -name llama-server -type f | head -1)
    [[ -n "$top" ]] || { rm -rf "$tmp"; echo "    no llama-server in $asset"; return 1; }
    top=$(dirname "$top")
    chmod +x "$top"/llama-* "$top"/ggml-* 2>/dev/null
    _llama_test_build "$top/llama-server" || { rm -rf "$tmp"; echo "    $build not installed; $kind stays at ${cur:-nothing}"; return 1; }
    rm -rf "$dir"; mv "$top" "$dir"; rm -rf "$tmp"
    ln -sfn "$build" "$LLAMA_DIR/$kind/current"
    echo "    installed: $LLAMA_DIR/$kind/current/llama-server${cur:+ (was $cur, kept for a rollback)}"
    local old
    for old in "$LLAMA_DIR/$kind"/*/; do
        old=$(basename "$old")
        [[ "$old" == current || "$old" == "$build" || "$old" == "$cur" ]] || rm -rf "${LLAMA_DIR:?}/$kind/$old"
    done
}

# download llama / update llama: both builds at the newest stable release.
_llama_setup() {
    local check="${1:-false}" info rc=0
    _check_deps jq curl || return 1
    if [[ "${DL_MASTER:-false}" == true ]]; then
        echo "==> llama.cpp: the newest master builds (--master)"
        info=$(python3 "$LLAMA_BUILDS_SCRIPT" resolve-master) || { echo "  cannot ask GitHub"; DL_UNKNOWN=$(( DL_UNKNOWN + 1 )); return 1; }
    else
        echo "==> llama.cpp: the newest stable release and its prebuilt builds"
        info=$(python3 "$LLAMA_BUILDS_SCRIPT" resolve) || { echo "  cannot ask GitHub"; DL_UNKNOWN=$(( DL_UNKNOWN + 1 )); return 1; }
    fi
    echo "  $(jq -r .tag <<< "$info") (${info:+$(jq -r '.commit[:9]' <<< "$info")})"
    _llama_install vulkan "$info" "$check" || rc=1
    if [[ "$(jq -r '.rocm.gfx // empty' <<< "$info")" ]]; then
        _llama_install rocm "$info" "$check" || rc=1
    else
        echo "  rocm: no AMD GPU target found (KFD) — skipped"
    fi
    [[ "$check" == true ]] || echo "  models.conf picks them with LLAMA_DEFAULT_BIN=\"$LLAMA_DIR/vulkan/current/llama-server\", LLAMA_ROCM_BIN=\"$LLAMA_DIR/rocm/current/llama-server\""
    return $rc
}

cmd_update() {
    local name="" torch="" master=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --torch) torch=torch; shift ;;
            --master) master=true; shift ;;
            -*) echo "Unknown option: $1"; return 1 ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -z "$name" ]] && { echo "Usage: $PROG update <comfyui-model> [--torch] [--master] | llama"; return 1; }
    [[ "$name" == llama ]] && { DL_MASTER="$master" _llama_setup; return; }
    _resolve_model "$name" || { echo "Unknown model: $name"; return 1; }
    if [[ "$_r_backend" != comfyui ]]; then
        echo "'$name' has nothing to update: its weights come from '$PROG download $name', its server"
        echo "binary from models.conf."
        return 1
    fi
    _comfyui_paths
    [[ -x "$c_app/.venv/bin/python" ]] || { echo "ComfyUI is not set up — run: $PROG download $name"; return 1; }
    if _comfyui_running; then
        echo "ComfyUI is running. Stop it first: $PROG stop $(_comfyui_slots | head -1)"
        return 1
    fi

    echo "==> ComfyUI in $c_app"
    local old new
    old=$(git -C "$c_app" rev-parse --short HEAD)
    _comfyui_revert_patches
    if ! git -C "$c_app" diff --quiet; then
        echo "  local changes beyond the bundled patches — git pull would clash with them:"
        git -C "$c_app" diff --stat | sed 's/^/    /'
        _comfyui_apply_patches > /dev/null
        return 1
    fi
    git -C "$c_app" fetch -q --tags origin || { _comfyui_apply_patches; return 1; }
    if [[ "$master" == true ]]; then
        git -C "$c_app" checkout -q master && git -C "$c_app" merge -q --ff-only origin/master ||
            { _comfyui_apply_patches; return 1; }
    else
        # The newest release, unless the checkout is at or past it already (a
        # master from before, say): never backwards.
        local tag; tag=$(_comfyui_release_tag "$c_app")
        if [[ -z "$tag" ]]; then
            echo "  no release tag found — staying put ($PROG update $name --master follows master)"
        elif git -C "$c_app" merge-base --is-ancestor "$tag" HEAD; then
            echo "  at or past the newest release $tag — staying put"
        else
            git -C "$c_app" checkout -q "$tag" || { _comfyui_apply_patches; return 1; }
        fi
    fi
    new=$(git -C "$c_app" rev-parse --short HEAD)
    if [[ "$old" == "$new" ]]; then
        echo "  already current ($(_comfyui_version "$c_app"))"
    else
        echo "  $old → $new, now $(_comfyui_version "$c_app") ($(git -C "$c_app" rev-list --count "$old..$new") new commits)"
    fi
    _comfyui_apply_patches
    echo "==> Python dependencies"
    _comfyui_python_deps "$torch" || return 1
    echo "==> Custom nodes"
    if [[ "$master" == true ]]; then _comfyui_custom_nodes master; else _comfyui_custom_nodes; fi
    echo "==> GPU"
    _comfyui_gpu_check || return 1
    echo "==> Workflows"
    _comfyui_sync_workflows
}

cmd_download() {
    local target=""
    local force=""

    local from="" pattern=""
    DL_CHECK=false DL_PENDING=0 DL_UNKNOWN=0 DL_MASTER=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force="1"; shift ;;
            --check|--dry-run) DL_CHECK=true; shift ;;
            --master) DL_MASTER=true; shift ;;
            --from) _need_value "$@" || return 1; from="$2"; shift 2 ;;
            -*) echo "Unknown option: $1"; return 1 ;;
            *) if [[ -z "$target" ]]; then target="$1"; else pattern="$1"; fi; shift ;;
        esac
    done

    if [[ -z "$target" ]]; then
        echo "Usage: $PROG download [--force|--check] <model-name|all>"
        echo "       $PROG download <comfyui-model> [PATTERN] [--from DIR]"
        echo ""
        echo "  Options:"
        echo "    --force, -f   force re-download even if model exists"
        echo "    --check       only tell what would be downloaded; exit 0 when nothing"
        echo "    --master      llama, audio.cpp, a new ComfyUI: master instead of the newest release"
        echo "    PATTERN       comfyui: only the models of workflows whose file name contains it"
        echo "    --from DIR    comfyui: move an existing ComfyUI checkout (with .venv) into place"
        echo ""
        echo "  Available models:"
        for entry in "${_MODELS[@]}"; do
            IFS='|' read -r m_name _ _ _ _ m_label _ _ _ _ _ <<< "$entry"
            echo "    $m_name"
        done
        return
    fi

    _check_deps hf || return 1
    if [[ "$DL_CHECK" == true ]]; then
        [[ -z "$force$from" ]] || { echo "Error: --check fetches nothing, so --force and --from have no meaning with it"; return 1; }
        # A subshell's exit is caught here, so the verdict comes last either way.
        local rc=0
        _download_target "$target" "$pattern" "$force" "$from" || rc=$?
        (( rc == 0 || DL_PENDING > 0 )) || return 2
        echo ""
        if (( DL_PENDING )); then
            echo "To download: $DL_PENDING item(s) above — $PROG download $target${pattern:+ \"$pattern\"}"
            return 1
        fi
        if (( DL_UNKNOWN )); then
            echo "Could not check $DL_UNKNOWN item(s); nothing else to download."
            return 2
        fi
        echo "Nothing to download: $target is complete."
        return 0
    fi
    _download_target "$target" "$pattern" "$force" "$from"
}

_download_target() {
    local target="$1" pattern="$2" force="$3" from="$4"
    if [[ "$target" == "all" ]]; then
        [[ "$DL_CHECK" == true ]] || echo "Downloading all models..."
        for entry in "${_MODELS[@]}"; do
            IFS='|' read -r m_name _ m_model m_mmproj _ m_label _ _ _ m_hf_repo m_hf_includes m_hf_dir _ _ _ _ m_spec_args m_hf_draft m_hf_mmproj _ <<< "$entry"
            _resolve_model "$m_name"
            if [[ "$_r_backend" == comfyui ]]; then
                _download_comfyui "" ""
                continue
            fi
            if [[ -z "$m_hf_repo" ]]; then
                echo "  Skipping $m_label: no download info configured"
                continue
            fi
            local model_dir
            model_dir=$(_model_dl_dir "$m_model" "$m_hf_dir" "$m_hf_includes")
            echo "=== $m_label ==="
            _download_model "$m_hf_repo" "$model_dir" "$m_hf_includes" "$force"
            if [[ -n "$m_hf_draft" ]]; then
                local -a sa=(); read -ra sa <<< "$m_spec_args"
                _download_draft "$m_hf_draft" "$force" "${sa[@]}"
            fi
            [[ -n "$m_hf_mmproj" ]] && _download_mmproj "$m_hf_mmproj" "$m_mmproj" "$force"
            [[ "$_r_backend" == halogen || "$_r_backend" == gufo ]] && _pull_halogen_image
            [[ "$_r_backend" == tts ]] && _tts_setup
            [[ "$_r_backend" == audiocpp ]] && _audiocpp_setup
        done
        return
    fi

    if [[ "$target" == llama ]]; then
        [[ -z "$pattern$from$force" ]] || { echo "Error: download llama takes no pattern, --from or --force"; return 1; }
        _llama_setup "$DL_CHECK"; return
    fi
    _resolve_model "$target" || { echo "Unknown model: $target"; echo "Run '$PROG download' to see available models."; return 1; }

    if [[ "$_r_backend" == comfyui ]]; then
        _download_comfyui "$pattern" "$from"
        return
    fi
    if [[ -n "$pattern$from" ]]; then
        echo "Error: a workflow pattern and --from are for comfyui models only"; return 1
    fi
    if [[ -z "$_r_hf_repo" ]]; then
        echo "No download info configured for model: $target"
        return 1
    fi

    local model_dir
    model_dir=$(_model_dl_dir "$_r_model" "$_r_hf_dir" "$_r_hf_includes")
    _download_model "$_r_hf_repo" "$model_dir" "$_r_hf_includes" "$force"
    # A model made here from a repo that offers it only bigger (scout): the
    # download brought the sources; the file named in models.conf comes from
    # them, quantized to the type its name carries (…-Q5_K_M.gguf). Afterwards
    # its .parts.json keeps the recipe for every later download.
    local mf="${_r_model//\~/$HOME}" qtype
    if [[ "$DL_CHECK" != true && ! -e "$mf" && ! -e "$mf.parts.json" ]] &&
       qtype=$(grep -oE '(IQ[1-4]_[A-Z]+|Q[2-8]_(K_[SML]|K|0|1))' <<< "$(basename "$mf")" | tail -1) && [[ -n "$qtype" ]]; then
        echo "  $(basename "$mf"): not on the Hub — making it from what was downloaded ($qtype)"
        LLAMA_QUANTIZE="$(dirname "$(command -v "${LLAMA_DEFAULT_BIN:-llama-server}" 2>/dev/null || echo "$LLAMA_DIR/vulkan/current/llama-server")")/llama-quantize" \
            python3 "$HF_PARTS_SCRIPT" derive "$_r_hf_repo" "$(dirname "$mf")" "$(basename "$mf")" "$qtype" || return 1
    fi
    [[ -n "$_r_hf_draft" ]] && _download_draft "$_r_hf_draft" "$force" "${_r_spec_args[@]}"
    [[ -n "$_r_hf_mmproj" ]] && _download_mmproj "$_r_hf_mmproj" "$_r_mmproj" "$force"
    [[ "$_r_backend" == halogen || "$_r_backend" == gufo ]] && _pull_halogen_image
    [[ "$_r_backend" == tts ]] && _tts_setup
    [[ "$_r_backend" == audiocpp ]] && _audiocpp_setup
    return 0
}

# The container image of the halogen entry in _r_*. podman run would pull it on
# the first start anyway, but then that start waits for gigabytes of image.
_pull_halogen_image() {
    _check_deps podman || return 1
    if [[ "$DL_CHECK" == true ]]; then
        if podman image exists "$_r_binary"; then
            echo "  Container image $_r_binary: present"
        else
            echo "  Container image $_r_binary: to pull"
            DL_PENDING=$(( DL_PENDING + 1 ))
        fi
        return 0
    fi
    echo "  Container image $_r_binary:"
    podman pull -q "$_r_binary" > /dev/null && echo "  present"
    _prune_halogen_images "$_r_binary"
}

# Older tags of an image stay behind when models.conf moves to a new one, a few
# GB each. Offer to remove those that no halogen entry names and no container
# runs; without a terminal, only say how.
_prune_halogen_images() {
    local repo="${1%:*}" keep="$_r_name" entry img
    local -a wanted=() stale=()
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name _ <<< "$entry"
        _resolve_model "$m_name" && [[ "$_r_backend" == halogen || "$_r_backend" == gufo ]] && wanted+=("$_r_binary")
    done
    _resolve_model "$keep"      # leave _r_* as the caller had them
    local running
    running=" $(podman ps --format '{{.Image}}' 2>/dev/null | tr '\n' ' ') "
    while read -r img; do
        [[ " ${wanted[*]} " == *" $img "* || "$running" == *" $img "* ]] && continue
        stale+=("$img")
    done < <(podman images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep "^$repo:" | grep -v ':<none>$')
    (( ${#stale[@]} )) || return 0
    echo "  Older images no models.conf entry uses any more:"
    local size
    for img in "${stale[@]}"; do
        size=$(podman image inspect --format '{{.Size}}' "$img" 2>/dev/null)
        printf '    %s (%s GB)\n' "$img" "$(awk -v b="${size:-0}" 'BEGIN { printf "%.1f", b / 1e9 }')"
    done
    if [[ -t 0 ]]; then
        local answer=""
        read -r -p "  Remove them? [y/N] " answer
        if [[ "$answer" =~ ^[yYjJ] ]]; then
            podman rmi "${stale[@]}" > /dev/null && echo "  removed"
        fi
    else
        echo "  Remove with: podman rmi ${stale[*]}"
    fi
}

# storyboard: a scene from a plan file on the running ComfyUI (storyboard.py,
# #48): keyframes from a photo, a contact sheet and a check by a vision model,
# then with --render four LTX-2.5 clips through them.
cmd_storyboard() {
    case "${1:-}" in
        ""|-h|--help) python3 "$LIB_DIR/storyboard.py" --help | sed "s|^usage: storyboard.py|usage: $PROG storyboard|"; return ;;
    esac
    _check_deps python3 || return 1
    local slot url=""
    slot=$(_comfyui_slots | head -1)
    [[ -n "$slot" ]] && url="http://127.0.0.1:$(( PORT_BASE_SERVER + slot ))"
    python3 "$LIB_DIR/storyboard.py" --url "$url" --workflows "$COMFYUI_SHARE/api" "$@"
}

# docs: the gallery of examples and results (docs/build.py, #53) — built from
# docs/examples.json with every medium in full, where it lies, then opened.
cmd_docs() {
    case "${1:-}" in
        -h|--help) echo "Usage: $PROG docs [--no-open]   build the local gallery ($DATA_DIR/docs) and open it"; return ;;
    esac
    _check_deps python3 ffprobe || return 1
    python3 "$SHARE_DIR/docs/build.py" --local --out "$DATA_DIR/docs" || return 1
    [[ "${1:-}" == --no-open ]] && return
    command -v xdg-open > /dev/null && xdg-open "$DATA_DIR/docs/index.html" > /dev/null 2>&1 &
}

# videocheck: where a video jumps, halts or freezes, by optical flow
# (videocheck.py, #48) — any video; storyboard runs it on its own after a render.
cmd_videocheck() {
    case "${1:-}" in
        ""|-h|--help) python3 "$LIB_DIR/videocheck.py" --help | sed "s|^usage: videocheck.py|usage: $PROG videocheck|"; return ;;
    esac
    _check_deps python3 || return 1
    python3 -c "import cv2" 2> /dev/null || { echo "videocheck needs OpenCV for Python (python3-opencv, or pip install opencv-python)"; return 1; }
    python3 "$LIB_DIR/videocheck.py" "$@"
}

# musicvideo: a song and pictures of the singer made into a music video on the
# running ComfyUI (musicvideo.py, #47): sections sung with LTX-2.5 Talking or
# played as scenes, cut to the frame, joined, the song underneath.
cmd_musicvideo() {
    case "${1:-}" in
        ""|-h|--help) python3 "$LIB_DIR/musicvideo.py" --help | sed "s|^usage: musicvideo.py|usage: $PROG musicvideo|"; return ;;
    esac
    _check_deps python3 || return 1          # ffmpeg: musicvideo.py checks, where it needs it
    # No ComfyUI: an empty URL, which only a run that renders minds (not --dry-run).
    local slot url=""
    slot=$(_comfyui_slots | head -1)
    [[ -n "$slot" ]] && url="http://127.0.0.1:$(( PORT_BASE_SERVER + slot ))"
    python3 "$LIB_DIR/musicvideo.py" --url "$url" --workflows "$COMFYUI_SHARE/api/video" "$@"
}

# ── Dispatch ────────────────────────────────────────────────
case "${1:-}" in
    start)      shift; cmd_start "$@" ;;
    preset)     shift; cmd_preset "$@" ;;
    preset-save) shift; cmd_preset_save "$@" ;;
    presets)    cmd_presets ;;
    stop)       shift; cmd_stop "$@" ;;
    status)     cmd_status ;;
    cache-stats) shift; cmd_cache_stats "$@" ;;
    logs)        shift; cmd_logs "$@" ;;
    service)     shift; cmd_service "$@" ;;
    darkroom)    shift; cmd_darkroom "$@" ;;
    fotos)       shift   # the old name, until 1.86; its service still runs "fotos run"
                 [[ "${1:-}" == run ]] || echo "Note: 'fotos' is now '$PROG darkroom'." >&2
                 cmd_darkroom "$@" ;;
    prune)       shift; cmd_prune "$@" ;;
    outdated)    shift; cmd_outdated "$@" ;;
    self-update) shift; cmd_self_update "$@" ;;
    _complete)   shift; cmd__complete "$@" 2>/dev/null ;;
    clear-kv)   shift; cmd_clear_kv "$@" ;;
    probe-reasoning) shift; cmd_probe_reasoning "$@" ;;
    bench)      shift; cmd_benchmark "$@" ;;
    list)       cmd_list ;;
    help)       cmd_help ;;
    version|--version|-V) cmd_version ;;
    env)        shift; cmd_env "$@" ;;
    clear)      cmd_clear ;;
    shell-init) cmd_shell_init ;;
    download)   shift; cmd_download "$@" ;;
    update)     shift; cmd_update "$@" ;;
    voice)      shift; cmd_voice "$@" ;;
    musicvideo) shift; cmd_musicvideo "$@" ;;
    storyboard) shift; cmd_storyboard "$@" ;;
    videocheck) shift; cmd_videocheck "$@" ;;
    docs)       shift; cmd_docs "$@" ;;
    *)          cmd_help; cmd_list ;;
esac
