cmd_list() {
    printf "\n\033[1mAvailable models:\033[0m\n\n"
    printf "  %-14s %-32s %-40s %s\n" "NAME" "LABEL" "BINARY" "ROCm ENV"
    printf "  %-14s %-32s %-40s %s\n" "----" "-----" "------" "---------"
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name m_binary m_model m_mmproj m_alias m_label m_args m_client m_rocm_env _ _ _ <<< "$entry"
        printf "  \033[36m%-14s\033[0m %-32s %-40s %s\n" "$m_name" "$m_label" "$m_binary" "${m_rocm_env:-—}"
    done
    # ComfyUI's models are whatever its workflows need, so they are listed per workflow.
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name _ <<< "$entry"
        _resolve_model "$m_name" && [[ "$_r_backend" == comfyui ]] || continue
        _comfyui_paths
        printf "\n  \033[36m%s\033[0m workflows (%s):\n" "$m_name" "$c_wf"
        if [[ ! -x "$c_app/.venv/bin/python" ]]; then
            echo "    not set up — $PROG download $m_name"
        else
            python3 "$COMFYUI_MODELS_SCRIPT" list "$c_wf" "$c_models"
        fi
    done
    echo ""
    echo "  $PROG start <name> [slot]     start server + proxy (slot N, default 1)"
    echo "  $PROG presets                 configurations that start several of them at once"
    echo "  eval \"\$($PROG env <name> [slot])\"  set Claude Code env vars in this shell"
    echo ""
}

# ── Reasoning ───────────────────────────────────────────────
#
# One switch for every model: --reasoning off|on|low|medium|high|max|N. What each
# model can actually do lives in models.conf (`reasoning`, `reasoning_levels`),
# because the mechanism is the chat template, not the server: --reasoning sets the
# template kwarg enable_thinking, --reasoning-effort sets the template variables
# reasoning_effort / reasoning_strength. A template that reads neither cannot be
# steered, and templates raise on level names they do not know — so a request the
# model cannot honour is refused here instead of failing per request later.
#
# Fills _reasoning_args (llama-server flags) and _reasoning_note (one line for the
# start output). Returns 1 with an explanation on stderr if the model cannot comply.
REASONING_LEVELS="low medium high max"

_translate_reasoning() {
    local spec="$1" mode="$2" level_map="$3"
    _reasoning_args=()
    _reasoning_note=""

    # A token budget is spelled as a number; 0 means off, -1 unrestricted.
    if [[ "$spec" =~ ^(-1|[0-9]+)$ ]]; then
        [[ "$spec" == "0" ]] && spec="off"
    elif [[ ! " off on $REASONING_LEVELS " == *" $spec "* ]]; then
        echo "Error: --reasoning takes off, on, a level ($REASONING_LEVELS), or a token budget (N, -1); got '$spec'" >&2
        return 1
    fi

    local is_level=false
    [[ " $REASONING_LEVELS " == *" $spec "* ]] && is_level=true

    case "$mode" in
        none)
            if [[ "$spec" == "off" ]]; then
                _reasoning_note="not applicable — this model has no thinking mode"
                return 0
            fi
            echo "Error: model '$_r_name' has no thinking mode (its chat template has no reasoning at all)" >&2
            return 1
            ;;
        locked-off)
            if [[ "$spec" == "off" ]]; then
                _reasoning_note="already off — the chat template locks thinking closed"
                return 0
            fi
            echo "Error: the chat template of '$_r_name' locks thinking closed, so '--reasoning $spec' cannot work." >&2
            echo "       Only a different template (--chat-template-file with the stock one) would restore it." >&2
            return 1
            ;;
        toggle)
            if [[ "$is_level" == true ]]; then
                echo "Error: model '$_r_name' supports on/off and a token budget, but no reasoning levels." >&2
                echo "       Use --reasoning on, off, or a token budget (e.g. --reasoning 2048)." >&2
                return 1
            fi
            ;;
        effort|unknown) ;;
        *)
            echo "Error: model '$_r_name' has an unknown reasoning mode '$mode' in models.conf" >&2
            return 1
            ;;
    esac

    if [[ "$spec" == "off" ]]; then
        # The model's own sampler tweaks for non-thinking mode come first, so an
        # explicit flag later in the command line still wins.
        [[ ${#_r_no_reasoning_args[@]} -gt 0 ]] && _reasoning_args+=("${_r_no_reasoning_args[@]}")
        _reasoning_args+=(--reasoning off --reasoning-budget 0)
        _reasoning_note="off (--reasoning off --reasoning-budget 0)"
        return 0
    fi

    if [[ "$spec" == "on" ]]; then
        _reasoning_args+=(--reasoning on)
        _reasoning_note="on, template default depth"
        return 0
    fi

    if [[ "$is_level" == true ]]; then
        local mapped=""
        if [[ "$mode" == "effort" ]]; then
            # "low=low medium=medium high=high max=xhigh" → the name this template takes
            local pair
            for pair in $level_map; do
                [[ "${pair%%=*}" == "$spec" ]] && mapped="${pair#*=}"
            done
            if [[ -z "$mapped" ]]; then
                echo "Error: model '$_r_name' does not map the level '$spec' (has: ${level_map:-none})" >&2
                return 1
            fi
        else
            mapped="$spec"   # unknown mode: pass the canonical name through
        fi
        _reasoning_args+=(--reasoning on --reasoning-effort "$mapped")
        _reasoning_note="level $spec (--reasoning-effort $mapped)"
        return 0
    fi

    # Remaining case: a token budget.
    _reasoning_args+=(--reasoning on --reasoning-budget "$spec")
    if [[ "$spec" == "-1" ]]; then
        _reasoning_note="on, unrestricted budget"
    else
        _reasoning_note="on, budget ${spec} tokens"
    fi
    return 0
}

# ── Public exposure helpers ─────────────────────────────────

# Count real tokens in the token file (blank lines and # comments don't count).
_token_count() {
    # grep -c prints 0 *and* exits 1 when nothing matches, so capture first and
    # only then fall back — piping the failure into `echo 0` yields "0\n0".
    local n
    n=$(grep -cvE '^[[:space:]]*(#|$)' "$TOKEN_FILE" 2>/dev/null) || n=0
    echo "${n:-0}"
}

# Everything --public needs must exist *before* a single port opens.
_check_public_prereqs() {
    local ok=true

    if ! command -v stunnel > /dev/null; then
        echo "Error: --public needs stunnel (sudo dnf install stunnel)"
        ok=false
    fi

    if [[ ! -f "$TOKEN_FILE" ]]; then
        echo "Error: no token file at $TOKEN_FILE"
        echo "       Create one (0600, one token per line), e.g.:"
        echo "         mkdir -p $LLM_CONF_DIR && umask 077"
        echo "         openssl rand -hex 32 > $TOKEN_FILE"
        ok=false
    else
        local perms
        perms=$(stat -c %a "$TOKEN_FILE")
        if [[ ! "$perms" =~ ^[0-7]00$ ]]; then
            echo "Error: $TOKEN_FILE is mode $perms — must not be readable by group or others."
            echo "       chmod 600 $TOKEN_FILE"
            ok=false
        elif [[ "$(_token_count)" -eq 0 ]]; then
            echo "Error: $TOKEN_FILE contains no tokens (blank lines and # comments don't count)"
            ok=false
        fi
    fi

    local f
    for f in server.pem server.key ca.pem; do
        if [[ ! -f "$TLS_DIR/$f" ]]; then
            echo "Error: missing $TLS_DIR/$f — run: $PROG gen-certs <public-hostname>"
            ok=false
        fi
    done

    [[ "$ok" == true ]]
}

# Generate the stunnel config for one slot. verifyPeer + CAfile mean only a
# client holding a certificate from our own CA (i.e. the VPS) can complete the
# handshake — a scanner hitting the port never gets past the TLS layer.
_write_stunnel_conf() {
    local slot="$1" with_proxy="$2" conf="$3" with_server="${4:-true}"
    local port_server=$(( PORT_BASE_SERVER + slot ))
    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local tls_server=$(( PORT_BASE_TLS_SERVER + slot ))
    local tls_proxy=$(( PORT_BASE_TLS_PROXY + slot ))

    {
        echo "foreground = yes"
        echo "pid ="
        echo "sslVersionMin = TLSv1.2"
        echo "TIMEOUTidle = 900"
        if [[ "$with_server" == true ]]; then
            echo ""
            echo "[server-${slot}]"
            echo "accept = 0.0.0.0:${tls_server}"
            echo "connect = 127.0.0.1:${port_server}"
            echo "cert = $TLS_DIR/server.pem"
            echo "key = $TLS_DIR/server.key"
            echo "CAfile = $TLS_DIR/ca.pem"
            echo "verifyPeer = yes"
        fi
        if [[ "$with_proxy" == true ]]; then
            echo ""
            echo "[proxy-${slot}]"
            echo "accept = 0.0.0.0:${tls_proxy}"
            echo "connect = 127.0.0.1:${port_proxy}"
            echo "cert = $TLS_DIR/server.pem"
            echo "key = $TLS_DIR/server.key"
            echo "CAfile = $TLS_DIR/ca.pem"
            echo "verifyPeer = yes"
        fi
    } > "$conf"
}

# The image API in front of a ComfyUI slot, on the slot's proxy port. The pid
# and log files are the proxy's, so stop, status and preset treat it as one.
_start_images_server() {
    local slot="$1" host="$2"
    local port_server=$(( PORT_BASE_SERVER + slot ))
    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local log="$LOG_DIR/proxy-${slot}.log" pid="" i
    mkdir -p "$PID_DIR" "$LOG_DIR"
    echo "Starting the image API [slot $slot] on port $port_proxy..."
    pid=$(_spawn_detached "$PID_DIR/proxy-${slot}.pid" "$log" truncate \
        python3 -u "$IMAGES_SERVER_SCRIPT" --comfy "http://127.0.0.1:$port_server" \
            --public-comfy "http://${host:-127.0.0.1}:$port_server" \
            --api "$COMFYUI_SHARE/api" --host "${host:-127.0.0.1}" --port "$port_proxy")
    [[ -n "$pid" ]] || { echo "Error: the image API did not report a PID. See $log"; return 1; }
    for (( i=0; i<10; i++ )); do
        sleep 1
        ps -p "$pid" > /dev/null 2>&1 || { echo "Error: the image API failed to start. See $log"; return 1; }
        if ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
            echo "Image API running (PID: $pid)"
            return 0
        fi
    done
    echo "Error: the image API did not listen on port $port_proxy within 10 s. See $log"
    return 1
}

# Start proxy.py for one slot and wait until it listens. Its own function so
# `preset` can add a missing proxy to a slot whose model already matches —
# reloading 70B of weights for a process that starts in a second would be absurd.
_start_proxy() {
    local slot="$1" host="$2" public="$3"
    # A ComfyUI slot's proxy is the image API, not proxy.py.
    if _slot_is_comfyui "$slot"; then
        _start_images_server "$slot" "$host"
        return
    fi
    local port_server=$(( PORT_BASE_SERVER + slot ))
    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local proxy_log="$LOG_DIR/proxy-${slot}.log"
    mkdir -p "$PID_DIR" "$LOG_DIR"

    # A halogen slot passes its cap explicitly while its server is still being
    # created; otherwise it is read from the server that runs there.
    local halogen_cap="${4:-}"
    local -a backend_env=()
    if [[ -n "$halogen_cap" ]] || _slot_is_halogen "$slot"; then
        [[ -z "$halogen_cap" ]] && halogen_cap=$(_halogen_cap_of_slot "$slot")
        backend_env=(LLM_TRANSLATE_MESSAGES=1 LLM_PROXY_TIMEOUT="$HALOGEN_PROXY_TIMEOUT"
                     LLM_MAX_TOKENS_CAP="$halogen_cap" LLM_INLINE_IMAGE_URLS=1)
    else
        backend_env=(LLM_PROXY_TIMEOUT="$LLAMA_SERVER_TIMEOUT")
        # llama-server fetches image URLs itself, from any address — through a
        # public proxy that would let a token holder reach this machine and the
        # LAN. So the proxy fetches them first, public hosts only, and the
        # server only ever sees data: URLs. (The direct path is not covered.)
        [[ "$public" == true ]] && backend_env+=(LLM_INLINE_IMAGE_URLS=1)
    fi

    echo "Starting proxy [slot $slot] on port $port_proxy..."
    # -u: unbuffered stdout/stderr so every log line lands in $proxy_log
    # immediately (and nothing is lost when the proxy is killed on stop).
    # LLM_TOKEN_FILE switches the proxy into hardened mode: token check,
    # path allowlist, concurrency and body-size caps. Unset = pass-through.
    # 127.0.0.1 rather than localhost: rootless podman publishes on IPv4 only,
    # and localhost may resolve to ::1 first.
    local proxy_pid=""
    proxy_pid=$(_spawn_detached "$PID_DIR/proxy-${slot}.pid" "$proxy_log" truncate \
        env LLM_BACKEND_URL="http://127.0.0.1:${port_server}" \
            LLM_PROXY_HOST="${host:-127.0.0.1}" \
            LLM_PROXY_PORT="${port_proxy}" \
            LLM_TOKEN_FILE="$([[ "$public" == true ]] && echo "$TOKEN_FILE")" \
            "${backend_env[@]}" \
            python3 -u "$PROXY_SCRIPT")
    if [[ -z "$proxy_pid" ]]; then
        echo "Error: the proxy did not report a PID. See $proxy_log"
        return 1
    fi

    local max_wait=10 i
    for (( i=0; i<max_wait; i++ )); do
        sleep 1
        if ! ps -p "$proxy_pid" > /dev/null 2>&1; then
            echo "Error: Proxy failed to start. See $proxy_log"
            return 1
        fi
        if ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
            echo "Proxy running (PID: $proxy_pid)"
            return 0
        fi
    done
    echo "Error: Proxy did not listen on port $port_proxy within ${max_wait}s. See $proxy_log"
    return 1
}

# Stop only the proxy of a slot, leaving the loaded model alone.
_stop_proxy() {
    local slot="$1"
    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local proxy_pid=""
    [[ -f "$PID_DIR/proxy-${slot}.pid" ]] && proxy_pid=$(cat "$PID_DIR/proxy-${slot}.pid")
    if [[ -z "$proxy_pid" ]] || ! ps -p "$proxy_pid" > /dev/null 2>&1; then
        proxy_pid=$(_pid_on_port "$port_proxy")
    fi
    if [[ -n "$proxy_pid" ]] && ps -p "$proxy_pid" > /dev/null 2>&1; then
        kill "$proxy_pid" 2>/dev/null
        rm -f "$PID_DIR/proxy-${slot}.pid"
        echo "Slot $slot: proxy (PID: $proxy_pid) stopped."
        return 0
    fi
    return 1
}

# cmd_start for a halogen model. Runs inside cmd_start and reads its locals
# (bash scoping is dynamic): the options are parsed and checked there already.
_start_halogen() {
    local -a refused=()
    [[ -n "$cache_ram" && "$cache_ram" != "0" ]] && refused+=("--cache-ram $cache_ram (only 0 = prompt cache off)")
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    [[ "$verbose" == true ]] && refused+=("--verbose")
    [[ "$spec" == "off" ]] && refused+=("--spec off (its MTP draft is byte-identical to plain decoding)")
    if (( ${#refused[@]} )); then
        echo "Error: not available with the halogen backend: ${refused[*]}"
        exit 1
    fi
    local lan=false
    [[ -n "$host" && "$host" != "127.0.0.1" && "$host" != "localhost" ]] && lan=true
    if [[ "$public" == true && "$lan" == true ]]; then
        echo "Error: --public with --host $host would publish halogen on the LAN without a token —"
        echo "       the server has no authentication of its own. Leave --host out: --public"
        echo "       reaches it through the proxy, which checks the token."
        exit 1
    fi
    _check_deps podman python3 || exit 1

    local model_path="${_r_model//\~/$HOME}"
    local model_dir; model_dir="$(dirname "$model_path")"

    # The container's environment, in a fixed order so that the same options
    # always produce the same command — preset compares it word for word.
    local -a keys=()
    local -A val=()
    _henv() { [[ -v "val[$1]" ]] || keys+=("$1"); val[$1]="$2"; }

    _henv HALOGEN_CHECKPOINT "/models/$(basename "$model_path")"
    _henv HALOGEN_MODEL_ID "$_r_client"
    local kv
    for kv in "${_r_args[@]}"; do
        [[ "$kv" == HALOGEN_*=* ]] || { echo "Error: extra_args of '$_r_name' must be HALOGEN_*=VALUE pairs (got '$kv')"; exit 1; }
        _henv "${kv%%=*}" "${kv#*=}"
    done

    local ctx_n="${ctx:-${_r_ctx:-$HALOGEN_NATIVE_CTX}}"
    _henv HALOGEN_CTX "$ctx_n"
    local yarn=""
    if (( ctx_n > HALOGEN_NATIVE_CTX )); then
        yarn=$(( (ctx_n + HALOGEN_NATIVE_CTX - 1) / HALOGEN_NATIVE_CTX ))
        _henv HALOGEN_ROPE_YARN "$yarn"
    fi
    # The pool holds every running conversation's KV; one request must fit.
    if [[ -z "${val[HALOGEN_KV_POOL_POSITIONS]:-}" ]] || (( val[HALOGEN_KV_POOL_POSITIONS] < ctx_n )); then
        _henv HALOGEN_KV_POOL_POSITIONS "$ctx_n"
    fi
    [[ -n "$parallel" ]] && _henv HALOGEN_KV_SLOTS "$parallel"

    if [[ -n "$reasoning" ]]; then
        local r="$reasoning"
        [[ "$r" == "0" ]] && r=off
        if [[ "$r" == off ]]; then
            _henv HALOGEN_ENABLE_THINKING 0
        elif [[ " $REASONING_LEVELS " == *" $r "* ]]; then
            local pair mapped=""
            for pair in $_r_reasoning_levels; do [[ "${pair%%=*}" == "$r" ]] && mapped="${pair#*=}"; done
            _henv HALOGEN_REASONING_EFFORT "$mapped"
        elif [[ "$r" =~ ^[1-9][0-9]*$ ]]; then
            _henv HALOGEN_MAX_THINKING_TOKENS "$r"
        fi
        # on and -1: the server's own default (thinking on, effort xhigh).
    fi
    [[ -n "$temp" ]]  && _henv HALOGEN_TEMPERATURE "$temp"
    [[ -n "$top_p" ]] && _henv HALOGEN_TOP_P "$top_p"
    [[ "$cache_ram" == "0" ]] && _henv HALOGEN_PROMPT_CACHE 0
    local cap="$HALOGEN_MAX_TOKENS_CAP"
    if [[ -n "$max_predict" && "$max_predict" != "-1" ]]; then
        cap="$max_predict"
        _henv HALOGEN_MAX_TOKENS_CAP "$cap"
    fi
    if [[ "$use_mmproj" == true ]]; then
        if [[ -z "$_r_mmproj" ]]; then
            echo "Error: --mmproj requested but model '$name' defines no mmproj"; exit 1
        fi
        # The engine looks for its vision tower beside the checkpoint.
        if [[ "$(dirname "${_r_mmproj//\~/$HOME}")" != "$model_dir" ]]; then
            echo "Error: halogen loads the vision file from beside the checkpoint; mmproj of '$name' is elsewhere"; exit 1
        fi
        _henv HALOGEN_VISION_TOWER 1
    fi

    local -a env_args=()
    local k
    for k in "${keys[@]}"; do env_args+=(-e "$k=${val[$k]}"); done

    local -a cmd=(podman run --rm --name "$(_halogen_container "$slot")"
        --label "llmctl.model=$model_path"
        -p "${host:-127.0.0.1}:${port_server}:${HALOGEN_API_PORT}"
        --device /dev/kfd --device /dev/dri --group-add keep-groups
        --ipc=host --ulimit memlock=-1:-1
        "${env_args[@]}"
        -v "$model_dir:/models:ro"
        "$_r_binary")

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    # ── Exclusive: nothing else may run while halogen holds the machine ──
    local -a others=()
    local s
    for s in $(_active_slots); do
        [[ "$s" == "$slot" ]] && continue
        if _slot_server_pid "$s" > /dev/null || _slot_proxy_pid "$s" > /dev/null; then others+=("$s"); fi
    done
    if (( ${#others[@]} )); then
        echo "Error: halogen runs exclusively — it holds most of this machine's memory — and"
        echo "       slot(s) ${others[*]} are running. Stop them first: $PROG stop"
        exit 1
    fi
    local container; container=$(_halogen_container "$slot")
    if podman container exists "$container" 2>/dev/null; then
        # Left behind by a podman client that died without cleaning up; the port
        # check above already proved nothing is serving from it.
        podman rm -f "$container" > /dev/null 2>&1
    fi
    if [[ ! -f "$model_path" ]]; then
        echo "Error: checkpoint not found: $model_path — run: $PROG download $_r_name"; exit 1
    fi

    [[ "$compact" == true ]] && { _compact_memory || exit 1; }
    local contig; contig=$(_contig_gib)
    if (( contig < HALOGEN_MIN_CONTIG_GIB )); then
        echo "Note: only $contig GiB of host memory are free in 2 MiB blocks (want >= $HALOGEN_MIN_CONTIG_GIB)."
        if [[ "$compact" == true ]]; then
            echo "      Stop other large programs (a VM, ComfyUI, …) or reboot, or prefill may stall for minutes."
        else
            echo "      Prefill may stall for minutes; consider: $PROG start $name $slot --compact"
        fi
    fi

    _render_halogen_config() {
        echo "Model:    $_r_label ($_r_client)"
        echo "Backend:  halogen — $_r_binary (podman, container $container)"
        echo "Checkpoint: $model_path"
        if [[ "$use_mmproj" == true ]]; then
            echo "Vision:   on (--mmproj)"
        elif [[ -n "$_r_mmproj" ]]; then
            echo "Vision:   available but not loaded (pass --mmproj)"
        fi
        echo "Host:     ${host:-127.0.0.1 (default)}"
        [[ "$lan" == true ]] && echo "  WARNING: published beyond localhost ($host) without authentication — trusted networks only."
        if [[ "$public" == true ]]; then
            echo "Public:   enabled (--public) — TLS front for the proxy only: 0.0.0.0:$(( PORT_BASE_TLS_PROXY + slot )) → :$port_proxy"
            echo "  Tokens:  $(_token_count) from $TOKEN_FILE; token budgets capped at $cap"
        else
            echo "Public:   disabled — reachable only via localhost/LAN (pass --public to expose via the VPS)"
        fi
        echo "Proxy:    always on :$port_proxy — translates /v1/messages (Claude Code), normalizes time stamps,"
        echo "          clamps token budgets to $cap, fetches http(s) image URLs and passes them inline"
        echo "Context:  $ctx_n${yarn:+ (YaRN x$yarn over the native $HALOGEN_NATIVE_CTX)}"
        echo "Parallel: ${val[HALOGEN_KV_SLOTS]:-4 (server default)} over a pool of ${val[HALOGEN_KV_POOL_POSITIONS]} positions"
        case "${val[HALOGEN_PROMPT_CACHE]:-}" in
            0) echo "PromptCache: off (--cache-ram 0)" ;;
            *) echo "PromptCache: on (server default)" ;;
        esac
        if [[ -n "$reasoning" ]]; then
            echo "Reasoning: $reasoning — ${val[HALOGEN_ENABLE_THINKING]:+thinking off by default}${val[HALOGEN_REASONING_EFFORT]:+default effort ${val[HALOGEN_REASONING_EFFORT]}}${val[HALOGEN_MAX_THINKING_TOKENS]:+thinking budget ${val[HALOGEN_MAX_THINKING_TOKENS]} tokens}"
        else
            echo "Reasoning: server default (thinking on, effort xhigh; requests may override)"
        fi
        echo "Speculative: on (MTP head, byte-identical to plain decoding)"
        [[ -n "$temp$top_p" ]] && echo "Samplers: ${temp:+temp $temp}${temp:+${top_p:+, }}${top_p:+top-p $top_p} (server defaults; requests may override)"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "----------------------------"
    }
    local config_text; config_text="$(_render_halogen_config)"
    echo "$config_text"

    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting halogen [slot $slot] on port $port_server..."
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: podman did not report a PID. See $server_log" >&2
        exit 1
    fi
    echo "Server running (PID: $server_pid, detached) — loading takes ~15-30 s with the"
    echo "weights in the file cache, a few minutes from disk."

    _start_proxy "$slot" "$host" "$public" "$cap" || { _stop_slot "$slot" > /dev/null; exit 1; }

    local stunnel_log="$LOG_DIR/stunnel-${slot}.log"
    if [[ "$public" == true ]]; then
        mkdir -p "$STUNNEL_DIR"
        local stunnel_conf="$STUNNEL_DIR/slot-${slot}.conf"
        _write_stunnel_conf "$slot" true "$stunnel_conf" false
        local stunnel_pid=""
        stunnel_pid=$(_spawn_detached "$PID_DIR/stunnel-${slot}.pid" "$stunnel_log" truncate \
            stunnel "$stunnel_conf")
        sleep 1
        if [[ -z "$stunnel_pid" ]] || ! ps -p "$stunnel_pid" > /dev/null 2>&1; then
            echo "Error: stunnel failed to start. See $stunnel_log"
            exit 1
        fi
        echo "TLS front running (PID: $stunnel_pid) on :$(( PORT_BASE_TLS_PROXY + slot ))"
    fi

    echo ""
    echo "  Logs:  tail -f $server_log"
    echo "         tail -f $proxy_log"
    [[ "$public" == true ]] && echo "         tail -f $stunnel_log"
    echo "  Env:   $PROG env $_r_name $slot"
    echo "  Stop:  $PROG stop $slot"
}

cmd_start() {
    local name=""
    local slot="1"
    local reasoning=""          # "" = model/template default; off|on|<level>|N (see _translate_reasoning)
    local parallel=""
    local ctx=""                # "" = model default; N>0 = override context size
    local cache_ram=""          # "" = server default (8192 MiB); 0 = disable prompt cache; -1 = no limit; N>0 = MiB cap
    local similarity=""         # "" = server default (0.1); 0 = pure LRU slot pick; F in 0..1 = prefix share a slot must already hold
    local verbose=false         # true = -lv 4 (TRACE): reveals ggml/backend + buffer-size startup logs
    local clear_logs=false      # true = truncate this slot's server/proxy logs before starting
    local host=""               # "" = llama-server default (127.0.0.1); e.g. 0.0.0.0 to expose on LAN
    local gpu_priority=""       # "" = driver default; low|medium|high|realtime (needs patched ggml-vulkan)
    local use_mmproj=false      # true = load the model's mmproj (multimodal projector), if defined
    local start_proxy=false     # true = also start proxy.py (timestamp normalization for prompt caching)
    local public=false          # true = token auth + hardening + stunnel TLS front for the VPS
    local max_predict=""        # "" = model/server default; N = cap tokens per generation
    local spec=""               # "" = on when the model declares spec_args; on|off forces it
    # Samplers otherwise live in models.conf, per model. These two override them
    # for one run, which is what a task-specific preset needs: the same model at
    # temp 0.1 for code and at its own 0.6 for prose.
    local temp=""
    local top_p=""
    # --print-cmd builds and validates everything, prints the llama-server command
    # and starts nothing. `preset` uses it to compare a slot's target state against
    # the argv of what is actually running there.
    local print_cmd=false
    local compact=false         # true = defragment host memory first (sudo)
    local output_dir=""         # comfyui: where generated images go (default <base>/output)
    local lang=""               # tts: default language of the speech slot (ISO 639-1)
    local seed=""               # tts: sampling seed when a request names none (-1 = random)

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --proxy) start_proxy=true; shift ;;
            --compact) compact=true; shift ;;
            --public) public=true; shift ;;
            --max-predict) _need_value "$@" || exit 1; max_predict="$2"; shift 2 ;;
            --reasoning) _need_value "$@" || exit 1; reasoning="$2"; shift 2 ;;
            --reasoning-budget) _need_value "$@" || exit 1; reasoning="$2"; shift 2 ;;   # alias: a budget is a valid --reasoning spec
            --no-reasoning) reasoning=off; shift ;;          # alias for --reasoning off
            --parallel) _need_value "$@" || exit 1; parallel="$2"; shift 2 ;;
            --ctx) _need_value "$@" || exit 1; ctx="$2"; shift 2 ;;
            --cache-ram) _need_value "$@" || exit 1; cache_ram="$2"; shift 2 ;;
            --similarity) _need_value "$@" || exit 1; similarity="$2"; shift 2 ;;
            --verbose) verbose=true; shift ;;
            --clear-logs) clear_logs=true; shift ;;
            --host) _need_value "$@" || exit 1; host="$2"; shift 2 ;;
            --gpu-priority) _need_value "$@" || exit 1; gpu_priority="$2"; shift 2 ;;
            --mmproj) use_mmproj=true; shift ;;
            --spec) _need_value "$@" || exit 1; spec="$2"; shift 2 ;;
            --temp) _need_value "$@" || exit 1; temp="$2"; shift 2 ;;
            --top-p) _need_value "$@" || exit 1; top_p="$2"; shift 2 ;;
            --no-spec) spec=off; shift ;;                     # alias for --spec off
            --print-cmd) print_cmd=true; shift ;;
            --output) _need_value "$@" || exit 1; output_dir="$2"; shift 2 ;;
            --lang) _need_value "$@" || exit 1; lang="$2"; shift 2 ;;
            --seed) _need_value "$@" || exit 1; seed="$2"; shift 2 ;;
            -*) echo "Unknown option: $1"; exit 1 ;;
            *) if [[ -z "$name" ]]; then name="$1"; elif [[ "$slot" == "1" ]]; then slot="$1"; fi; shift ;;
        esac
    done

    [[ -z "$name" ]] && { echo "Usage: $PROG start <model-name> [slot] [--proxy] [--public] [--max-predict N] [--reasoning off|on|low|medium|high|max|N] [--no-reasoning] [--reasoning-budget N] [--parallel N] [--ctx N] [--cache-ram N] [--similarity F] [--verbose] [--clear-logs] [--host ADDR] [--gpu-priority low|medium|high|realtime] [--mmproj] [--spec on|off] [--no-spec]"; exit 1; }
    _check_slot "$slot" || exit 1
    # The TLS fronts sit closer together than the plain ports, so --public runs
    # out of room first — and silently, since the collision would only surface as
    # a bind error in stunnel's log.
    if [[ "$public" == true ]] && (( slot > SLOT_MAX_PUBLIC )); then
        echo "Error: --public reaches slots 1-$SLOT_MAX_PUBLIC (TLS ports $PORT_BASE_TLS_SERVER+N for the server, $PORT_BASE_TLS_PROXY+N for the proxy); slot $slot would collide."
        echo "       Set LLMCTL_PORT_BASE_TLS_PROXY higher to make room for more."
        exit 1
    fi
    if [[ -n "$parallel" && ! "$parallel" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --parallel requires a positive integer (got '$parallel')"; exit 1
    fi
    if [[ -n "$ctx" && ! "$ctx" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --ctx requires a positive integer (got '$ctx')"; exit 1
    fi
    if [[ -n "$cache_ram" && ! "$cache_ram" =~ ^(-1|0|[1-9][0-9]*)$ ]]; then
        echo "Error: --cache-ram requires -1 (no limit), 0 (disable prompt cache), or N>0 (MiB cap); got '$cache_ram'"; exit 1
    fi
    if [[ -n "$similarity" && ! "$similarity" =~ ^(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)$ ]]; then
        echo "Error: --similarity requires a fraction from 0 to 1 (0 = pure LRU); got '$similarity'"; exit 1
    fi
    if [[ -n "$gpu_priority" && ! "$gpu_priority" =~ ^(low|medium|high|realtime)$ ]]; then
        echo "Error: --gpu-priority requires low, medium, high, or realtime; got '$gpu_priority'"; exit 1
    fi
    if [[ -n "$max_predict" && ! "$max_predict" =~ ^(-1|[1-9][0-9]*)$ ]]; then
        echo "Error: --max-predict requires -1 (no limit) or N>0 (token cap); got '$max_predict'"; exit 1
    fi
    if [[ -n "$temp" && ! "$temp" =~ ^([0-1](\.[0-9]+)?|2(\.0+)?|\.[0-9]+)$ ]]; then
        echo "Error: --temp requires a number from 0 to 2 (0 = greedy); got '$temp'"; exit 1
    fi
    if [[ -n "$top_p" && ! "$top_p" =~ ^(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)$ ]]; then
        echo "Error: --top-p requires a fraction from 0 to 1; got '$top_p'"; exit 1
    fi
    if [[ "$public" == true ]]; then
        _check_public_prereqs || exit 1
        # --public without a cap would let one request generate until --timeout.
        [[ -z "$max_predict" ]] && max_predict="$PUBLIC_MAX_PREDICT_DEFAULT"
    fi

    local port_server=$(( PORT_BASE_SERVER + slot ))
    local port_proxy=$(( PORT_BASE_PROXY + slot ))

    _resolve_model "$name" || { echo "Unknown model: $name"; cmd_list; exit 1; }
    case "$_r_backend" in
        llama) ;;
        # Its proxy is what speaks the Messages API, so it always runs.
        halogen) start_proxy=true ;;
        comfyui|tts) ;;
        *) echo "Error: model '$name' names an unknown backend '$_r_backend' in models.conf (llama, halogen, comfyui or tts)"; exit 1 ;;
    esac
    if [[ -n "$output_dir" && "$_r_backend" != comfyui ]]; then
        echo "Error: --output is for comfyui models — '$name' generates no images"; exit 1
    fi
    if [[ -n "$lang$seed" && "$_r_backend" != tts ]]; then
        echo "Error: --lang and --seed are for speech (tts) models; '$name' is not one"; exit 1
    fi
    if [[ -n "$seed" && ! "$seed" =~ ^(-1|[0-9]+)$ ]]; then
        echo "Error: --seed takes a number, or -1 for a random one each time (got '$seed')"; exit 1
    fi
    [[ "$start_proxy" == true ]] && { _check_deps python3 || exit 1; }
    if [[ "$print_cmd" != true && "$_r_backend" == llama ]]; then
        local hs
        hs=$(_halogen_slots | head -1)
        if [[ -n "$hs" ]]; then
            echo "Error: a halogen server runs on slot $hs, and halogen runs exclusively — it holds"
            echo "       most of this machine's memory. Stop it first: $PROG stop $hs"
            exit 1
        fi
        [[ "$compact" == true ]] && { _compact_memory || exit 1; }
    fi

    # Needs the resolved model, since what --reasoning can mean depends on it.
    _reasoning_args=(); _reasoning_note=""
    if [[ -n "$reasoning" && "$_r_backend" != comfyui && "$_r_backend" != tts ]]; then
        _translate_reasoning "$reasoning" "$_r_reasoning" "$_r_reasoning_levels" || exit 1
    fi

    # Guard: abort if ports are already in use. Skipped for --print-cmd, which
    # describes a slot rather than claiming it — usually one that is running.
    if [[ "$print_cmd" != true ]]; then
        if ss -tlnp 2>/dev/null | grep -q ":${port_server} "; then
            echo "Error: Port $port_server already in use. Is slot $slot already running?"
            exit 1
        fi
        if [[ "$start_proxy" == true ]] && ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
            echo "Error: Port $port_proxy already in use. Is a proxy for slot $slot already running?"
            exit 1
        fi

        mkdir -p "$PID_DIR" "$LOG_DIR" "$SLOT_STATE_DIR"
        # Whatever preset once owned this slot does not own what starts here now;
        # `preset` writes the marker back after this call returns.
        rm -f "$PID_DIR/preset-${slot}"

        # ComfyUI keeps its models until something inside it needs the room; it
        # cannot see this model coming. (halogen needs no such step: it refuses
        # to start beside ComfyUI at all.)
        [[ "$_r_backend" == llama ]] && _comfyui_unload
    fi

    local proxy_log="$LOG_DIR/proxy-${slot}.log"
    local server_log="$LOG_DIR/server-${slot}.log"

    # --clear-logs: start this slot's logs fresh (e.g. for a clean cache-stats run)
    if [[ "$clear_logs" == true && "$print_cmd" != true ]]; then
        : > "$server_log"
        : > "$proxy_log"
        echo "Cleared logs for slot $slot"
    fi

    if [[ "$_r_backend" == halogen ]]; then
        _start_halogen
        return
    fi
    if [[ "$_r_backend" == comfyui ]]; then
        _start_comfyui
        return
    fi
    if [[ "$_r_backend" == tts ]]; then
        _start_tts
        return
    fi

    # Expand tilde in model paths
    local model_path="${_r_model//\~/$HOME}"
    # mmproj (multimodal projector) is only loaded on explicit --mmproj request.
    local mmproj_path=""
    if [[ "$use_mmproj" == true ]]; then
        if [[ -n "$_r_mmproj" ]]; then
            mmproj_path="${_r_mmproj//\~/$HOME}"
        else
            echo "Error: --mmproj requested but model '$name' defines no mmproj"; exit 1
        fi
    fi

    if [[ -n "$spec" && "$spec" != "on" && "$spec" != "off" ]]; then
        echo "Error: --spec takes on or off; got '$spec'" >&2
        exit 1
    fi
    if [[ "$spec" == "on" && ${#_r_spec_args[@]} -eq 0 ]]; then
        echo "Error: model '$_r_name' declares no speculative decoding in models.conf." >&2
        echo "       It needs a draft head in its own GGUF to speculate without a second model." >&2
        exit 1
    fi

    # Build llama-server command
    local -a cmd=("${_r_binary}" \
        --model "$model_path" \
        --port "$port_server")

    # --host exposes the server beyond localhost (e.g. 0.0.0.0 for LAN access).
    [[ -n "$host" ]] && cmd+=(--host "$host")
    [[ -n "$mmproj_path" ]] && cmd+=(--mmproj "$mmproj_path")
    # --parallel and --timeout are managed centrally here, not in models.conf.
    cmd+=(--alias "$_r_client" "${_r_args[@]}" --parallel "${parallel:-1}" --timeout "$LLAMA_SERVER_TIMEOUT")
    # --ctx overrides the model's default context size when given.
    [[ -n "$ctx" ]] && _r_ctx="$ctx"
    [[ -n "$_r_ctx" ]] && cmd+=(--ctx-size "$_r_ctx")
    # --cache-ram overrides the server's default prompt-cache size (8192 MiB).
    # 0 disables the host-RAM prompt cache (keeps system RAM flat during use).
    [[ -n "$cache_ram" ]] && cmd+=(--cache-ram "$cache_ram")
    # --similarity is llama-server's --slot-prompt-similarity: how much of a prompt
    # a slot must already hold (longest common prefix) to be reused; 0 = pure LRU.
    [[ -n "$similarity" ]] && cmd+=(--slot-prompt-similarity "$similarity")
    # Unconditional, so `clear-kv` works on every slot. The trailing slash is
    # required: llama-server concatenates path + filename without a separator.
    cmd+=(--slot-save-path "$SLOT_STATE_DIR/")
    # --public authenticates at llama-server itself. proxy.py forwards the
    # Authorization header untouched, so this one key file covers the direct and
    # the proxied endpoint alike. --no-slots matters most: /slots is enabled by
    # default and exposes other clients' prompts.
    if [[ "$public" == true ]]; then
        cmd+=(--api-key-file "$TOKEN_FILE" --no-webui --no-slots)
    fi
    # A cap on generated tokens; without it a single request can hold the GPU
    # until --timeout expires.
    [[ -n "$max_predict" && "$max_predict" != "-1" ]] && cmd+=(--n-predict "$max_predict")
    # llama.cpp maps ggml/model-load INFO logs to TRACE (level 4); the default
    # verbosity (3=INFO) filters them, so backend detection and buffer-size
    # lines never reach the log. -lv 4 reveals them (also more runtime logging).
    [[ "$verbose" == true ]] && cmd+=(-lv 4)
    # Whatever --reasoning translated into for this model (may be empty).
    [[ ${#_reasoning_args[@]} -gt 0 ]] && cmd+=("${_reasoning_args[@]}")
    # Speculative decoding: on whenever the model declares it, unless --spec off.
    # The draft head ships inside the model's own GGUF, so this costs no extra file.
    [[ "$spec" != "off" && ${#_r_spec_args[@]} -gt 0 ]] && cmd+=("${_r_spec_args[@]}")
    # Last, on purpose: llama-server takes the last occurrence of a sampler flag,
    # so these override both models.conf and the sampler set that --reasoning off
    # brings with it.
    [[ -n "$temp" ]] && cmd+=(--temp "$temp")
    [[ -n "$top_p" ]] && cmd+=(--top-p "$top_p")

    # Everything above only assembled the command; nothing has been started yet,
    # which is what makes --print-cmd a safe way to ask "what would this slot run?".
    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    # The proxy is opt-in (--proxy): it only rewrites time/date stamps to keep the
    # prompt cache warm, which a client that sends no such stamps does not need.
    # Without it, clients talk to llama-server directly (see cmd_env).
    if [[ "$start_proxy" == true ]]; then
        _start_proxy "$slot" "$host" "$public" || exit 1
    fi

    # Start llama-server in background
    echo "Starting llama.cpp server [slot $slot] on port $port_server..."

    # Behaviour-relevant llama.cpp defaults we do NOT pass, so they stay hidden.
    _has_flag() { local f; for f in "${cmd[@]}"; do [[ "$f" == "$1" ]] && return 0; done; return 1; }

    # Render the effective start config once. It is printed to the terminal AND
    # written to the top of the server log (below), so a saved log is self-describing.
    # The Command line is the ground truth of every flag (samplers, cache-type-k/v,
    # flash-attn, threads, ngl come from models.conf); the Defaults section shows
    # behaviour-relevant llama.cpp defaults we never pass.
    _render_config() {
        echo "Model: $_r_label ($_r_alias)"
        if [[ -n "$mmproj_path" ]]; then
            echo "mmproj: $mmproj_path (--mmproj)"
        elif [[ -n "$_r_mmproj" ]]; then
            echo "mmproj: available but not loaded (pass --mmproj)"
        fi
        case "$_r_role" in
            embedding) echo "Serves:   embeddings — POST /v1/embeddings" ;;
            rerank)    echo "Serves:   reranking — POST /v1/rerank" ;;
        esac
        echo "ROCm env: ${_r_rocm_env:-—}"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        # The LAN listener carries no authentication unless --public added a key
        # file; the TLS front below is a separate, always-authenticated path.
        if [[ -n "$host" && "$host" != "127.0.0.1" && "$host" != "localhost" && "$host" != "::1" ]]; then
            local where="beyond localhost ($host)"
            [[ "$host" == "0.0.0.0" || "$host" == "::" ]] && where="to ALL interfaces"
            if [[ "$public" == true ]]; then
                echo "  NOTE: bound $where; token auth is active (--public)."
            else
                echo "  WARNING: bound $where without authentication —"
                echo "           expose only inside a trusted network."
            fi
        fi
        if [[ "$public" == true ]]; then
            echo "Public:   enabled (--public)"
            echo "  Tokens:  $(_token_count) from $TOKEN_FILE"
            echo "  TLS in:  0.0.0.0:$(( PORT_BASE_TLS_SERVER + slot )) → server :$port_server (mTLS, client cert required)"
            if [[ "$start_proxy" == true ]]; then
                echo "           0.0.0.0:$(( PORT_BASE_TLS_PROXY + slot )) → proxy  :$port_proxy (mTLS, client cert required)"
            fi
            echo "  Server:  --no-webui --no-slots, generation capped at ${max_predict} tokens"
            echo "  Proxy:   path allowlist, token check, concurrency cap; fetches image URLs itself (public hosts only)"
        else
            echo "Public:   disabled — reachable only via localhost/LAN (pass --public to expose via the VPS)"
        fi
        if [[ "$start_proxy" == true ]]; then
            echo "Proxy:    enabled on :$port_proxy (--proxy) — normalizes time/date stamps for the prompt cache"
        else
            echo "Proxy:    disabled — clients talk to :$port_server directly (pass --proxy to enable)"
        fi
        echo "Context:  ${_r_ctx:-default}"
        echo "Parallel: ${parallel:-1}"
        echo "Timeout:  ${LLAMA_SERVER_TIMEOUT}s (server and proxy)"
        if [[ -n "$cache_ram" ]]; then
            case "$cache_ram" in
                0)  echo "PromptCache: disabled (--cache-ram 0)" ;;
                -1) echo "PromptCache: no limit (--cache-ram -1)" ;;
                *)  echo "PromptCache: ${cache_ram} MiB (--cache-ram ${cache_ram})" ;;
            esac
        else
            echo "PromptCache: 8192 MiB (server default)"
        fi
        if [[ -n "$similarity" ]]; then
            case "$similarity" in
                0|0.0*) echo "SlotSimilarity: 0 — pure LRU slot pick (--similarity $similarity)" ;;
                *)      echo "SlotSimilarity: $similarity (--similarity $similarity)" ;;
            esac
        fi
        if [[ -n "$reasoning" ]]; then
            echo "Reasoning: ${_reasoning_note}"
            [[ "$_r_reasoning" == "unknown" ]] && \
                echo "  NOTE: this model's template support is unverified in models.conf —"
            [[ "$_r_reasoning" == "unknown" ]] && \
                echo "        the flags are passed through, run '$PROG probe-reasoning' once it is downloaded."
        else
            echo "Reasoning: template default (model supports: $_r_reasoning)"
        fi
        if [[ ${#_r_spec_args[@]} -eq 0 ]]; then
            echo "Speculative: not available for this model"
        elif [[ "$spec" == "off" ]]; then
            echo "Speculative: off (--spec off)"
        else
            echo "Speculative: on (${_r_spec_args[*]})"
        fi
        if [[ -n "$temp$top_p" ]]; then
            local sam=""
            [[ -n "$temp" ]] && sam+="temp $temp"
            [[ -n "$top_p" ]] && sam+="${sam:+, }top-p $top_p"
            echo "Samplers: $sam — overriding what models.conf sets for this model"
        fi
        [[ -n "$gpu_priority" ]] && echo "GPU priority: $gpu_priority (GGML_VK_QUEUE_PRIORITY; needs patched ggml-vulkan)"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "Defaults in effect (not overridden):"
        _has_flag --slot-prompt-similarity || echo "  slot-prompt-similarity: 0.1  (LCP slot routing; 0 = pure LRU)"
        _has_flag --batch-size            || echo "  batch-size:             2048"
        _has_flag --ubatch-size           || echo "  ubatch-size:            512"
        _has_flag --keep                  || echo "  keep:                   0"
        _has_flag -lv                     || echo "  verbosity:              3 (INFO)  — use --verbose for TRACE"
        echo "----------------------------"
    }
    local config_text
    config_text="$(_render_config)"
    echo "$config_text"

    # Preload jemalloc for the server (better allocation behaviour under load).
    # stdbuf -oL -eL line-buffers stdio so raw ggml/ROCm prints (llama.cpp only
    # flushes its own LOG_* lines) also reach $server_log promptly; it appends
    # libstdbuf to LD_PRELOAD, coexisting with the jemalloc preload.
    # _r_rocm_env is intentionally unquoted — word-splits space-separated KEY=VAL pairs for env
    # --gpu-priority sets GGML_VK_QUEUE_PRIORITY for the patched ggml-vulkan backend
    # (VK_EXT_global_priority). Empty var = not set = driver default. See patches/.
    local gpu_prio_env=""
    [[ -n "$gpu_priority" ]] && gpu_prio_env="GGML_VK_QUEUE_PRIORITY=$gpu_priority"
    # Write the effective config to the top of a fresh server log, then let the
    # server append below it (>>), so the saved log is self-describing. Each start
    # truncates first, preserving the fresh-log-per-start behaviour.
    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    # Detached, so the model outlives the terminal it was started from.
    # _r_rocm_env is unquoted on purpose: it word-splits into KEY=VAL pairs for env.
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append \
        env LD_PRELOAD=/lib64/libjemalloc.so.2 $gpu_prio_env $_r_rocm_env stdbuf -oL -eL "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: the server did not report a PID. See $server_log" >&2
        return 1
    fi

    echo "Server running (PID: $server_pid, detached)"

    # Start the TLS front last, so the port only opens once there is a backend
    # behind it.
    local stunnel_log="$LOG_DIR/stunnel-${slot}.log"
    if [[ "$public" == true ]]; then
        mkdir -p "$STUNNEL_DIR"
        local stunnel_conf="$STUNNEL_DIR/slot-${slot}.conf"
        _write_stunnel_conf "$slot" "$start_proxy" "$stunnel_conf"
        local stunnel_pid=""
        stunnel_pid=$(_spawn_detached "$PID_DIR/stunnel-${slot}.pid" "$stunnel_log" truncate \
            stunnel "$stunnel_conf")
        if [[ -z "$stunnel_pid" ]]; then
            echo "Error: stunnel did not report a PID. See $stunnel_log"
            exit 1
        fi

        sleep 1
        if ! ps -p "$stunnel_pid" > /dev/null 2>&1; then
            echo "Error: stunnel failed to start. See $stunnel_log"
            exit 1
        fi
        echo "TLS front running (PID: $stunnel_pid) on :$(( PORT_BASE_TLS_SERVER + slot ))$(
            [[ "$start_proxy" == true ]] && echo ", :$(( PORT_BASE_TLS_PROXY + slot ))")"
    fi

    echo ""
    echo "  Logs:  tail -f $server_log"
    [[ "$start_proxy" == true ]] && echo "         tail -f $proxy_log"
    [[ "$public" == true ]] && echo "         tail -f $stunnel_log"
    echo "  Stop:  $PROG stop $slot"
}

# The server / proxy actually running on a slot: the PID file if it still names a
# live process, otherwise whoever holds the port. Prints the PID, or returns 1.
_slot_server_pid() {
    local slot="$1" pid=""
    [[ -f "$PID_DIR/server-${slot}.pid" ]] && pid=$(cat "$PID_DIR/server-${slot}.pid")
    if [[ -z "$pid" ]] || ! ps -p "$pid" > /dev/null 2>&1; then
        pid=$(_pid_on_port $(( PORT_BASE_SERVER + slot )))
    fi
    [[ -n "$pid" ]] && ps -p "$pid" > /dev/null 2>&1 || return 1
    echo "$pid"
}

_slot_proxy_pid() {
    local slot="$1" pid=""
    [[ -f "$PID_DIR/proxy-${slot}.pid" ]] && pid=$(cat "$PID_DIR/proxy-${slot}.pid")
    if [[ -z "$pid" ]] || ! ps -p "$pid" > /dev/null 2>&1; then
        pid=$(_pid_on_port $(( PORT_BASE_PROXY + slot )))
    fi
    [[ -n "$pid" ]] && ps -p "$pid" > /dev/null 2>&1 || return 1
    echo "$pid"
}

# Is this PID one of ours? Asked of whoever holds a port in our ranges, before
# that port is taken as evidence of a slot: with dozens of slots possible, some
# unrelated service on :8010 would otherwise show up in `status` as a slot.
# Every server llmctl starts carries --slot-save-path, every proxy is proxy.py,
# every ComfyUI --base-directory.
_is_llmctl_process() {
    local pid="$1" cmdline=""
    cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
    [[ "$cmdline" == *"--slot-save-path $SLOT_STATE_DIR/"* || "$cmdline" == *"$PROXY_SCRIPT"* ||
       "$cmdline" == *"--name $HALOGEN_CONTAINER_PREFIX"* ||
       "$cmdline" == *"/main.py --listen "*" --base-directory "* ||
       "$cmdline" == *"$TTS_SERVER_SCRIPT"* || "$cmdline" == *"$IMAGES_SERVER_SCRIPT"* ]]
}

# The slots this machine currently has something on, ascending. Nothing keeps a
# list of slots, so it is reconstructed: the PID and preset files name the slots
# llmctl knows about, and the listening ports catch the rest — a server whose PID
# file was lost still answers on its port, which is the same fallback
# _slot_server_pid uses for a single slot.
_active_slots() {
    local -a slots=()
    local f n port pid
    for f in "$PID_DIR"/server-*.pid "$PID_DIR"/proxy-*.pid "$PID_DIR"/stunnel-*.pid "$PID_DIR"/preset-*; do
        [[ -e "$f" ]] || continue
        n="${f##*/}"; n="${n#*-}"; n="${n%.pid}"
        [[ "$n" =~ ^[1-9][0-9]*$ ]] && slots+=("$n")
    done
    while read -r port pid; do
        [[ "$port" =~ ^[0-9]+$ && -n "$pid" ]] || continue
        if   (( port > PORT_BASE_SERVER && port <= PORT_BASE_SERVER + SLOT_MAX )); then
            n=$(( port - PORT_BASE_SERVER ))
        elif (( port > PORT_BASE_PROXY  && port <= PORT_BASE_PROXY  + SLOT_MAX )); then
            n=$(( port - PORT_BASE_PROXY ))
        else
            continue
        fi
        _is_llmctl_process "$pid" && slots+=("$n")
    done < <(ss -tlnp 2>/dev/null | awk 'NR > 1 { n = split($4, a, ":"); p = ""
                                                 if (match($0, /pid=[0-9]+/)) p = substr($0, RSTART + 4, RLENGTH - 4)
                                                 print a[n], p }')
    # A halogen port is held by podman's network helper, not by anything of ours;
    # its container name is what gives the slot away.
    for n in $(_halogen_slots); do slots+=("$n"); done
    (( ${#slots[@]} )) || return 0
    printf '%s\n' "${slots[@]}" | sort -un
}

# The slots that have a server log, ascending — which is what cache-stats reads,
# and the reason it has its own enumeration: a log outlives the server it came
# from, so the numbers here are the ones with statistics, not the running ones.
_log_slots() {
    local -a slots=()
    local f n
    for f in "$LOG_DIR"/server-*.log; do
        [[ -e "$f" ]] || continue
        n="${f##*/server-}"; n="${n%.log}"
        [[ "$n" =~ ^[1-9][0-9]*$ ]] && slots+=("$n")
    done
    (( ${#slots[@]} )) || return 0
    printf '%s\n' "${slots[@]}" | sort -un
}

# The label of whatever model a slot is running, read from the process itself.
# Falls back to the file name, and to "unknown" for anything unreadable.
_slot_model_label() {
    local slot="$1" pid="" i
    pid=$(_slot_server_pid "$slot") || { echo "unknown"; return 1; }
    _read_argv "$pid" || { echo "unknown"; return 1; }
    if _is_tts_argv; then
        local path label
        path=$(_argv_flag --model) || { echo "unknown"; return 1; }
        label=$(_label_for_model_path "$path") || label="$(basename "$path")"
        echo "$label"; return 0
    fi
    if _is_comfyui_argv; then
        local path label
        path=$(_argv_flag --models-directory) || { echo "unknown"; return 1; }
        label=$(_label_for_model_path "$path") || label="ComfyUI"
        echo "$label"; return 0
    fi
    if _is_halogen_argv; then
        local path label
        path=$(_argv_halogen_model) || { echo "unknown"; return 1; }
        label=$(_label_for_model_path "$path") || label="$(basename "$path")"
        echo "$label"; return 0
    fi
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        case "${_ARGV[i]}" in
            -m|--model)
                local label
                label=$(_label_for_model_path "${_ARGV[i+1]}") || label="$(basename "${_ARGV[i+1]}")"
                echo "$label"; return 0 ;;
        esac
    done
    echo "unknown"
}

# Find a PID listening on a given port (uses ss or lsof).
_pid_on_port() {
    local port="$1"
    if command -v ss > /dev/null; then
        ss -tlnp 2>/dev/null | grep ":${port} " | grep -oP 'pid=\K[0-9]+' | head -1
    elif command -v lsof > /dev/null; then
        lsof -ti ":$port" 2>/dev/null | head -1
    fi
}

_stop_slot() {
    local slot="$1"
    local stopped=0

    local server_pid=""
    if _slot_is_halogen "$slot"; then
        # podman stop, not a signal to the client: it waits for the container to
        # exit and removes it (--rm), so the name is free for the next start.
        _stop_proxy "$slot" && stopped=$(( stopped + 1 ))
        server_pid=$(_slot_server_pid "$slot") || server_pid=""
        podman stop -t 30 "$(_halogen_container "$slot")" > /dev/null 2>&1
        podman rm -f "$(_halogen_container "$slot")" > /dev/null 2>&1
        [[ -n "$server_pid" ]] && kill "$server_pid" 2>/dev/null
        echo "Slot $slot: halogen (container $(_halogen_container "$slot")) stopped."
        stopped=$(( stopped + 1 ))
    elif server_pid=$(_slot_server_pid "$slot"); then
        local kind="llama-server"
        _read_argv "$server_pid" && _is_comfyui_argv && kind="ComfyUI"
        _read_argv "$server_pid" && _is_tts_argv && kind="speech server"
        kill "$server_pid" 2>/dev/null
        # Until it is gone: a restart on the same slot needs the port free, and
        # ComfyUI takes a moment to let go of it. SIGKILL after 15 s.
        local t
        for (( t=0; t < 75; t++ )); do
            ps -p "$server_pid" > /dev/null 2>&1 || break
            sleep 0.2
        done
        ps -p "$server_pid" > /dev/null 2>&1 && kill -9 "$server_pid" 2>/dev/null
        echo "Slot $slot: $kind (PID: $server_pid) stopped."
        stopped=$(( stopped + 1 ))
    fi

    _stop_proxy "$slot" && stopped=$(( stopped + 1 ))

    # Stop the TLS front — closing the public port first would be nicer, but the
    # slot is going down either way and stunnel is the cheapest to restart.
    local stunnel_pid=""
    [[ -f "$PID_DIR/stunnel-${slot}.pid" ]] && stunnel_pid=$(cat "$PID_DIR/stunnel-${slot}.pid")
    if [[ -n "$stunnel_pid" ]] && ps -p "$stunnel_pid" > /dev/null 2>&1; then
        kill "$stunnel_pid" 2>/dev/null
        echo "Slot $slot: stunnel (PID: $stunnel_pid) stopped."
        stopped=$(( stopped + 1 ))
    fi

    rm -f "$PID_DIR/server-${slot}.pid" "$PID_DIR/proxy-${slot}.pid" "$PID_DIR/stunnel-${slot}.pid"
    rm -f "$PID_DIR/preset-${slot}"
    rm -f "$STUNNEL_DIR/slot-${slot}.conf"
    rmdir "$STUNNEL_DIR" 2>/dev/null || true
    # Only succeeds while nothing was saved there via ?action=save.
    rmdir "$SLOT_STATE_DIR" 2>/dev/null || true
    return $(( stopped == 0 ))
}

cmd_stop() {
    local slot="${1:-}"

    if [[ -n "$slot" ]]; then
        _check_slot "$slot" || return 1
        _stop_slot "$slot" || echo "Slot $slot: nothing was running."
    else
        local total=0
        for s in $(_active_slots); do
            _stop_slot "$s" && total=$(( total + 1 ))
        done
        [[ "$total" -eq 0 ]] && echo "Nothing was running."
    fi

    rmdir "$PID_DIR" 2>/dev/null || true
}

# ── Presets ─────────────────────────────────────────────────
#
# A preset is a whole configuration under one name: the models, their slots and
# their start flags (presets.conf). Every entry goes through cmd_start unchanged,
# so a preset can do exactly what `start` can do and nothing has to be mirrored.

cmd_presets() {
    printf "\n\033[1mAvailable presets:\033[0m\n\n"
    if (( ${#_PRESETS[@]} == 0 )); then
        echo "  none defined — add one to presets.conf"
        echo ""
        return 0
    fi
    local entry line
    local -a f w
    for entry in "${_PRESETS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        printf "  \033[36m%-14s\033[0m %s\n" "${f[0]}" "${f[1]}"
        for line in "${f[@]:2}"; do
            w=(); read -ra w <<< "$line"
            printf "  %-14s   slot %-3s %-14s %s\n" "" "${w[1]}" "${w[0]}" "${w[*]:2}"
        done
        echo ""
    done
    echo "  $PROG preset <name>            bring the machine to that configuration:"
    echo "                                    keep what already matches, stop the rest, start what is missing"
    echo "  $PROG preset <name> --dry-run  show the plan, change nothing"
    echo ""
}

# A model is ready when llama-server says so itself:
#
#   2.11.562.067 I srv  llama_server: listening on http://127.0.0.1:8001
#
# It prints that line after 'model loaded', so it marks the end of the load and
# not the moment the socket exists. Nothing else is as reliable: the port alone
# could be an older server that never went away, and the process being alive
# says nothing about how far it has got. Waiting for the line serializes GPU memory
# allocation across a preset's models — the next one may only start allocating
# once this one has all it needs — and it makes the last model in a preset
# finish loading before the shell prompt comes back.
#
# The wait ends early on an error: the server log marks those with severity E
# ('E srv  llama_server: exiting due to model loading error'), and a load that
# dies leaves no process behind. Either way there is nothing left to wait for.
#
# The log is appended to across starts, so the caller passes the size it had
# before this start; only what was written after that may decide anything.
_wait_for_slot() {
    local slot="$1" limit="$2" offset="${3:-0}"
    local port=$(( PORT_BASE_SERVER + slot ))
    local log="$LOG_DIR/server-${slot}.log"
    local pid=""
    [[ -f "$PID_DIR/server-${slot}.pid" ]] && pid=$(cat "$PID_DIR/server-${slot}.pid")
    local waited=0 size=0 fresh="" err=""
    while (( waited < limit )); do
        size=0
        [[ -f "$log" ]] && size=$(stat -c%s "$log" 2>/dev/null || echo 0)
        # --clear-logs truncated it under us; what is there now is all this run's.
        (( size < offset )) && offset=0
        fresh=$(tail -c "+$(( offset + 1 ))" "$log" 2>/dev/null)

        # halogen: uvicorn announces the API once the engine behind it answers.
        # ComfyUI: the address of its web UI, once the server is up.
        if grep -Eq "(llama_server:|server is) listening on http://[^[:space:]]*:${port}([^0-9]|\$)|Uvicorn running on http://|To see the GUI go to: https?://[^[:space:]]*:${port}([^0-9]|\$)|tts_server listening on http://[^[:space:]]*:${port}([^0-9]|\$)" <<< "$fresh"; then
            echo "  loaded after ${waited}s — listening on :$port"
            return 0
        fi
        err=$(grep -m1 -E "^[0-9][0-9.]* E " <<< "$fresh")
        if [[ -n "$err" ]]; then
            echo "  the server reported an error while loading:" >&2
            echo "    ${err}" >&2
            echo "  see $log" >&2
            return 1
        fi
        if [[ -n "$pid" ]] && ! ps -p "$pid" > /dev/null 2>&1; then
            echo "  the server exited while loading — see $log" >&2
            return 1
        fi
        sleep 1
        waited=$(( waited + 1 ))
        (( waited % 30 == 0 )) && echo "  loading… ${waited}s"
    done
    echo "  not loaded after ${limit}s — the log has no 'listening on :$port' yet." >&2
    echo "  Raise the limit with --wait N if this model is simply slow to load; see $log" >&2
    return 1
}

cmd_preset() {
    local name=""
    local dry_run=false
    local force=false           # true = reload every model, even one that already matches
    local repair=false          # true = only restart this preset's slots whose server died
    local wait_limit=300        # per model, until it reports itself loaded (--wait N)
    # start options that describe how a slot is run and reached rather than what
    # the model does. Those apply to a whole configuration equally, so they are
    # given here and appended to every entry; what shapes the model itself
    # (--ctx, --reasoning, --temp, --parallel, …) stays with its entry in
    # presets.conf, where it belongs to one model and not to the set.
    local -a extra=()
    local output_dir=""         # --output: where ComfyUI entries put their images

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --output) _need_value "$@" || exit 1; output_dir="$2"; shift 2 ;;
            --force) force=true; shift ;;
            --repair) repair=true; shift ;;
            --wait) _need_value "$@" || exit 1; wait_limit="$2"; shift 2 ;;
            --proxy|--public|--clear-logs|--verbose) extra+=("$1"); shift ;;
            --host|--gpu-priority) _need_value "$@" || exit 1; extra+=("$1" "$2"); shift 2 ;;
            -*) echo "Unknown option for preset: $1"
                echo "  preset takes --dry-run, --force, --repair, --wait N, and the start options that"
                echo "  apply to the whole configuration:"
                echo "    --proxy  --public  --host ADDR  --clear-logs  --verbose  --gpu-priority L"
                echo "    --output DIR  (ComfyUI entries only)"
                echo "  They are appended to every entry, so they win over what the entry itself"
                echo "  says. Per-model options such as --ctx or --reasoning belong in the entry."
                exit 1 ;;
            *) [[ -z "$name" ]] && name="$1"; shift ;;
        esac
    done

    [[ -z "$name" ]] && { cmd_presets; exit 1; }
    if [[ ! "$wait_limit" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --wait requires a positive number of seconds (got '$wait_limit')"; exit 1
    fi
    _resolve_preset "$name" || { echo "Unknown preset: $name"; cmd_presets; exit 1; }
    (( ${#_p_entries[@]} == 0 )) && { echo "Error: preset '$name' lists no models."; exit 1; }
    if [[ -n "$output_dir" ]]; then
        local has_comfy=false l
        for l in "${_p_entries[@]}"; do
            _resolve_model "${l%% *}" && [[ "$_r_backend" == comfyui ]] && has_comfy=true
        done
        [[ "$has_comfy" == true ]] || { echo "Error: --output is for ComfyUI, and preset '$name' has no ComfyUI entry."; exit 1; }
    fi

    # ── Read the preset, and ask start what each entry would run ────────────
    # Everything is checked before anything is touched: a name typo or an
    # impossible flag in the last entry must not disturb a running slot.
    local -a e_model=() e_slot=() e_flags=() e_label=() e_cmd=() e_proxy=() e_public=() e_host=()
    local word
    local line seen=""
    local -a w
    for line in "${_p_entries[@]}"; do
        w=(); read -ra w <<< "$line"
        if (( ${#w[@]} < 2 )); then
            echo "Error: preset '$name': entry '$line' needs a model and a slot."; exit 1
        fi
        local m="${w[0]}" s="${w[1]}"
        _resolve_model "$m" || { echo "Error: preset '$name': unknown model '$m'."; exit 1; }
        if ! _check_slot "$s" 2> /dev/null; then
            echo "Error: preset '$name': '$m' asks for slot '$s'; slots are 1-$SLOT_MAX."; exit 1
        fi
        if [[ " $seen " == *" $s "* ]]; then
            echo "Error: preset '$name': slot $s is claimed twice — one server per slot."; exit 1
        fi
        seen+=" $s"

        # The entry's own flags first, the command-level ones after, so a --host
        # given here overrides one written into the entry rather than the reverse.
        # Each backend gets the ones that mean something to it: ComfyUI has no
        # proxy, no public front and no Vulkan queue, and only it takes --output.
        local -a eff=("${w[@]:2}")
        if [[ "$_r_backend" == comfyui || "$_r_backend" == tts ]]; then
            local k=0
            while (( k < ${#extra[@]} )); do
                case "${extra[k]}" in
                    --proxy|--public) k=$(( k + 1 )) ;;
                    --verbose)        [[ "$_r_backend" == tts ]] || eff+=("${extra[k]}"); k=$(( k + 1 )) ;;
                    --gpu-priority)   k=$(( k + 2 )) ;;
                    --host)           eff+=("${extra[k]}" "${extra[k+1]}"); k=$(( k + 2 )) ;;
                    *)                eff+=("${extra[k]}"); k=$(( k + 1 )) ;;
                esac
            done
            [[ -n "$output_dir" && "$_r_backend" == comfyui ]] && eff+=(--output "$output_dir")
        else
            eff+=("${extra[@]}")
        fi

        # start itself is the authority on what this entry means — flags, samplers,
        # reasoning translation, speculation and all. Asking it beats re-deriving
        # any of that here, and it validates the entry on the way.
        local out rc
        out=$( cmd_start "$m" "$s" "${eff[@]}" --print-cmd 2>&1 ); rc=$?
        if (( rc != 0 )); then
            echo "Error: preset '$name': entry '$line' cannot be started:"
            printf '  %s\n' "$out"
            exit 1
        fi

        if [[ "$_r_backend" == halogen && ${#_p_entries[@]} -gt 1 ]]; then
            echo "Error: preset '$name': '$m' is a halogen model, which runs exclusively —"
            echo "       a preset with it can name no other model."
            exit 1
        fi
        e_model+=("$m"); e_slot+=("$s"); e_flags+=("${eff[*]}"); e_label+=("$_r_label")
        e_cmd+=("$out")
        # A halogen slot always has its proxy, asked for or not.
        if [[ " ${eff[*]} " == *" --proxy "* || "$_r_backend" == halogen ]]; then e_proxy+=(true); else e_proxy+=(false); fi
        [[ " ${eff[*]} " == *" --public "* ]] && e_public+=(true) || e_public+=(false)
        # The host a reconciled proxy has to bind, read from the same effective flags.
        local eh="" prev=""
        for word in "${eff[@]}"; do
            [[ "$prev" == "--host" ]] && eh="$word"
            prev="$word"
        done
        e_host+=("$eh")
    done

    # ── --repair: bring back what died, and nothing else ────────────────────
    # For a watchdog (llmctl service). A slot counts only while `preset` still
    # claims it for this preset — `start` and `stop` drop that claim, and so
    # does another preset — so a machine switched to something else by hand is
    # left alone. Nothing is stopped, no other slot is touched.
    if [[ "$repair" == true ]]; then
        local total=${#e_model[@]} i n=0
        for (( i=0; i<total; i++ )); do
            local sl="${e_slot[i]}"
            [[ "$(cat "$PID_DIR/preset-${sl}" 2>/dev/null)" == "$_p_name" ]] || continue
            if _halogen_orphan "$sl"; then
                echo "Slot $sl: an orphaned halogen container holds it — left for '$PROG stop $sl'."
                continue
            fi
            if _slot_server_pid "$sl" > /dev/null; then
                if [[ "${e_proxy[i]}" == true ]] && ! _slot_proxy_pid "$sl" > /dev/null; then
                    echo "Slot $sl: its proxy died — starting it again."
                    _start_proxy "$sl" "${e_host[i]}" "${e_public[i]}" || true
                    n=$(( n + 1 ))
                fi
                continue
            fi
            echo "Slot $sl: ${e_model[i]} of preset '$_p_name' is gone — starting it again."
            local -a flags=(); read -ra flags <<< "${e_flags[i]}"
            local off=0
            [[ -f "$LOG_DIR/server-${sl}.log" ]] && off=$(stat -c%s "$LOG_DIR/server-${sl}.log" 2>/dev/null || echo 0)
            if [[ "$dry_run" == true ]]; then
                echo "  (dry run) $PROG start ${e_model[i]} $sl ${e_flags[i]}"
            elif ( cmd_start "${e_model[i]}" "$sl" "${flags[@]}" ) && _wait_for_slot "$sl" "$wait_limit" "$off"; then
                echo "$_p_name" > "$PID_DIR/preset-${sl}"
            else
                # Keep the claim, so the next round tries again.
                echo "$_p_name" > "$PID_DIR/preset-${sl}"
                echo "Slot $sl: did not come back. See $LOG_DIR/server-${sl}.log"
            fi
            n=$(( n + 1 ))
        done
        (( n )) || echo "Preset '$_p_name': nothing to repair."
        return 0
    fi

    # ── Compare against what is running ─────────────────────────────────────
    # Per slot, the target command against the running process's own argv. A full
    # comparison, so a slot counts as matching only when every flag agrees — model,
    # context, parallel, samplers, mmproj, speculation, reasoning.
    local total=${#e_model[@]} i
    local -a e_action=() e_proxy_action=()
    local keep_n=0 start_n=0 restart_n=0
    for (( i=0; i<total; i++ )); do
        local s="${e_slot[i]}" pid="" action="start" proxy_action="none"
        if pid=$(_slot_server_pid "$s"); then
            if [[ "$force" == true ]]; then
                action="restart"
            elif _read_argv "$pid" && [[ "${_ARGV[*]}" == "${e_cmd[i]}" ]]; then
                action="keep"
            else
                action="restart"
            fi
        fi
        # A proxy is a second, cheap process; when the model itself is right, the
        # proxy is added or removed on its own rather than reloading the weights.
        if [[ "$action" == "keep" ]]; then
            local proxy_up=false
            _slot_proxy_pid "$s" > /dev/null && proxy_up=true
            if [[ "${e_proxy[i]}" == true && "$proxy_up" == false ]]; then
                proxy_action="start"
            elif [[ "${e_proxy[i]}" == false && "$proxy_up" == true ]]; then
                proxy_action="stop"
            fi
        fi
        e_action+=("$action"); e_proxy_action+=("$proxy_action")
        case "$action" in
            keep)    keep_n=$(( keep_n + 1 )) ;;
            start)   start_n=$(( start_n + 1 )) ;;
            restart) restart_n=$(( restart_n + 1 )) ;;
        esac
    done

    # Slots the preset does not name: a preset describes the whole machine, so
    # anything else running is stopped — including a model this preset itself put
    # on a slot it no longer uses.
    local -a foreign=()
    local s
    for s in $(_active_slots); do
        [[ " $seen " == *" $s "* ]] && continue
        if _slot_server_pid "$s" > /dev/null || _slot_proxy_pid "$s" > /dev/null || _halogen_orphan "$s"; then
            foreign+=("$s")
        fi
    done

    # ── The plan ────────────────────────────────────────────────────────────
    echo ""
    printf "\033[1mPreset '%s' — %s\033[0m\n" "$_p_name" "$_p_label"
    (( ${#extra[@]} > 0 )) && printf "applied to every entry: %s\n" "${extra[*]}"
    echo ""
    for s in "${foreign[@]}"; do
        local running=""
        running=$(_slot_model_label "$s")
        _halogen_orphan "$s" && running="halogen (container only)"
        [[ "$running" == "unknown" ]] && running="(proxy only)"
        printf "  slot %-3s %-14s %-24s %s\n" "$s" "-" "$running" "stop — not part of this preset"
    done
    for (( i=0; i<total; i++ )); do
        local note=""
        case "${e_action[i]}" in
            keep)    note="already running like this — keep" ;;
            start)   note="start" ;;
            restart) note=$([[ "$force" == true ]] && echo "restart (--force)" || echo "runs a different configuration — stop and start") ;;
        esac
        case "${e_proxy_action[i]}" in
            start) note+=", add proxy" ;;
            stop)  note+=", stop proxy" ;;
        esac
        printf "  slot %-3s %-14s %-24s %s\n" "${e_slot[i]}" "${e_model[i]}" "${e_label[i]}" "$note"
    done

    if [[ " ${extra[*]} " == *" --clear-logs "* ]] && (( keep_n > 0 )); then
        echo ""
        echo "Note: --clear-logs only reaches slots that are started here."
        echo "      $keep_n slot(s) keep running, and keep their logs."
    fi

    _preset_memory_check

    if [[ "$dry_run" == true ]]; then
        if (( start_n + restart_n > 0 )); then
            echo ""
            echo "Would start:"
            for (( i=0; i<total; i++ )); do
                [[ "${e_action[i]}" == "keep" ]] && continue
                echo "  $PROG start ${e_model[i]} ${e_slot[i]} ${e_flags[i]}"
            done
        fi
        echo ""
        return 0
    fi

    if (( start_n + restart_n == 0 )) && (( ${#foreign[@]} == 0 )); then
        local pending=0 j
        for (( j=0; j<total; j++ )); do [[ "${e_proxy_action[j]}" == "none" ]] || pending=1; done
        if (( pending == 0 )); then
            echo ""
            echo "Preset '$_p_name' is already running exactly like this — nothing to do."
            for (( j=0; j<total; j++ )); do echo "$_p_name" > "$PID_DIR/preset-${e_slot[j]}"; done
            echo ""
            return 0
        fi
    fi

    # ── Stop first, start second ────────────────────────────────────────────
    # Everything that has to go goes before the first model loads: the new weights
    # need the GPU memory the old ones are holding.
    echo ""
    for s in "${foreign[@]}"; do
        local running=""
        running=$(_slot_model_label "$s")
        _stop_slot "$s" > /dev/null && \
            echo "Slot $s: $running stopped (not part of preset '$_p_name')."
    done
    for (( i=0; i<total; i++ )); do
        [[ "${e_action[i]}" == "restart" ]] || continue
        _stop_slot "${e_slot[i]}" > /dev/null && echo "Slot ${e_slot[i]}: stopped (ran a different configuration)."
    done

    # Kept slots: reconcile the proxy alone, and claim the slot for this preset.
    for (( i=0; i<total; i++ )); do
        [[ "${e_action[i]}" == "keep" ]] || continue
        case "${e_proxy_action[i]}" in
            start) _start_proxy "${e_slot[i]}" "${e_host[i]}" "${e_public[i]}" || {
                       echo "Error: could not add the proxy to slot ${e_slot[i]}."; exit 1; } ;;
            stop)  _stop_proxy "${e_slot[i]}" > /dev/null && \
                       echo "Slot ${e_slot[i]}: proxy stopped (this preset does not ask for one)." ;;
        esac
        echo "$_p_name" > "$PID_DIR/preset-${e_slot[i]}"
        printf "Slot %s: %s keeps running (%s).\n" "${e_slot[i]}" "${e_model[i]}" "${e_label[i]}"
    done

    local -a started=()
    local n=0
    for (( i=0; i<total; i++ )); do
        [[ "${e_action[i]}" == "keep" ]] && continue
        n=$(( n + 1 ))
        local m="${e_model[i]}" sl="${e_slot[i]}"
        local -a flags=(); read -ra flags <<< "${e_flags[i]}"
        echo ""
        printf "\033[1m[%d/%d] %s → slot %s\033[0m\n" "$n" "$(( start_n + restart_n ))" "$m" "$sl"
        # In a subshell: cmd_start ends a failed start with `exit`, which would
        # otherwise take the preset — and the rollback below — down with it.
        # Where this run's output starts in the appended server log — what was
        # there before belongs to an earlier start and must not answer for this one.
        local off=0
        [[ -f "$LOG_DIR/server-${sl}.log" ]] && off=$(stat -c%s "$LOG_DIR/server-${sl}.log" 2>/dev/null || echo 0)
        if ( cmd_start "$m" "$sl" "${flags[@]}" ) && _wait_for_slot "$sl" "$wait_limit" "$off"; then
            _record_footprint "$sl"
            echo "$_p_name" > "$PID_DIR/preset-${sl}"
            started+=("$sl")
            continue
        fi

        # Rolling back what this run started: a half-loaded preset is a
        # configuration nobody asked for, and its slots hold GPU memory the next
        # attempt needs. Slots that were already running and matched are left
        # alone — stopping a good model to tidy up would help no one.
        echo ""
        echo "Preset '$_p_name' failed at $m (slot $sl) — rolling back this run."
        _stop_slot "$sl" > /dev/null 2>&1 || true
        local r
        for r in "${started[@]}"; do
            _stop_slot "$r" || true
        done
        if (( keep_n > 0 )); then
            echo "Still running from before: $(
                for (( r=0; r<total; r++ )); do
                    [[ "${e_action[r]}" == "keep" ]] && printf '%s (slot %s) ' "${e_model[r]}" "${e_slot[r]}"
                done)"
        else
            echo "Nothing of preset '$_p_name' is running."
        fi
        exit 1
    done

    echo ""
    printf "\033[1mPreset '%s' is up.\033[0m\n" "$_p_name"
    for (( i=0; i<total; i++ )); do
        printf "  slot %-3s %-32s :%s\n" "${e_slot[i]}" "${e_label[i]}" "$(( PORT_BASE_SERVER + e_slot[i] ))"
    done
    echo ""
    local -a env_lines=() ui_lines=()
    for (( i=0; i<total; i++ )); do
        if _resolve_model "${e_model[i]}" && [[ "$_r_backend" == comfyui ]]; then
            ui_lines+=("http://127.0.0.1:$(( PORT_BASE_SERVER + e_slot[i] ))  (${e_model[i]})")
        else
            env_lines+=("eval \"\$($PROG env ${e_model[i]} ${e_slot[i]})\"")
        fi
    done
    if (( ${#env_lines[@]} )); then
        echo "  Env:    each shell picks one of them:"
        printf '            %s\n' "${env_lines[@]}"
    fi
    (( ${#ui_lines[@]} )) && printf '  UI:     %s\n' "${ui_lines[@]}"
    echo "  Status: $PROG status"
    echo "  Stop:   $PROG stop"
    echo ""
}

# ── GPU memory a configuration needs ────────────────────────
#
# What a model takes on the GPU depends on far more than its file: KV cache per
# context and slot, hybrid and sliding-window layers that hold no KV, the cache
# type, the draft, the vision projector, compute buffers. Rather than model all
# of that, llmctl measures: once a slot has loaded, what its process holds on
# the GPU is written down under its exact start command, and `preset` adds those
# numbers up before it loads anything. A command never measured counts with the
# size of its weight files — a lower bound, and said as such.
FOOTPRINT_FILE="$STATE_DIR/footprints.tsv"   # sha1 of the command, MiB, date, label
GTT_RESERVE_MIB=2048                        # headroom kept free beside the models

_footprint_key() { printf '%s' "$1" | sha1sum | cut -c1-16; }

# GPU memory of whatever runs on a slot, in MiB. A halogen container runs its
# engine outside our process tree, but it runs alone, so the GPU total is its.
# A speech slot's model lives in the engine it started as a child.
_slot_gpu_mib() {
    local pid c sum
    pid=$(_slot_server_pid "$1") || return 1
    if _slot_is_halogen "$1"; then
        echo $(( $(_gtt_used_bytes) / 1048576 ))
    else
        sum=$(_proc_gpu_mib "$pid")
        for c in $(pgrep -P "$pid"); do sum=$(( sum + $(_proc_gpu_mib "$c") )); done
        echo "$sum"
    fi
}

# The GPU with the largest GTT pool: its total and what is in use, in bytes.
_gtt_card() { ls -d /sys/class/drm/card*/device 2>/dev/null | while read -r d; do
    [[ -r "$d/mem_info_gtt_total" ]] && echo "$(cat "$d/mem_info_gtt_total") $d"; done | sort -n | tail -1 | cut -d' ' -f2; }
_gtt_total_bytes() { local d; d=$(_gtt_card); cat "$d/mem_info_gtt_total" 2>/dev/null || echo 0; }
_gtt_used_bytes()  { local d; d=$(_gtt_card); cat "$d/mem_info_gtt_used" 2>/dev/null || echo 0; }

# Write down what the slot's server holds now, under its command line. Below
# 256 MiB it has not loaded anything worth recording.
_record_footprint() {
    local slot="$1" pid mib key label
    pid=$(_slot_server_pid "$slot") || return 0
    _read_argv "$pid" || return 0
    mib=$(_slot_gpu_mib "$slot") || return 0
    (( mib >= 256 )) || return 0
    key=$(_footprint_key "${_ARGV[*]}")
    label=$(_slot_model_label "$slot")
    mkdir -p "$STATE_DIR"
    { grep -v "^$key	" "$FOOTPRINT_FILE" 2>/dev/null
      printf '%s\t%s\t%s\t%s\n' "$key" "$mib" "$(date +%F)" "$label"; } > "$FOOTPRINT_FILE.new" &&
        mv "$FOOTPRINT_FILE.new" "$FOOTPRINT_FILE"
}

_lookup_footprint() {
    local key
    key=$(_footprint_key "$1")
    awk -F'\t' -v k="$key" '$1 == k { print $2; exit }' "$FOOTPRINT_FILE" 2>/dev/null
}

# Lower bound for a command never measured: the size of the files it loads.
_estimate_cmd_mib() {
    local -a w; read -ra w <<< "$1"
    local i bytes=0 f
    if [[ "${w[1]:-}" == */main.py ]]; then
        echo 1024; return          # ComfyUI idle; its workflows load later
    fi
    for (( i=0; i < ${#w[@]} - 1; i++ )); do
        case "${w[i]}" in
            -m|--model|--mmproj|-md|--model-draft)
                f="${w[i+1]}"
                # A split GGUF loads all of its parts.
                if [[ "$f" =~ -00001-of-[0-9]+\.gguf$ ]]; then
                    for f in "${f%-00001-of-*}"-*-of-*.gguf; do bytes=$(( bytes + $(stat -c%s "$f" 2>/dev/null || echo 0) )); done
                else
                    bytes=$(( bytes + $(stat -c%s "$f" 2>/dev/null || echo 0) ))
                fi ;;
        esac
    done
    # halogen: its files are no guide — the n-gram table beside the weights is
    # read through the page cache, not loaded. ~68 GiB pinned weights and ~30 GiB
    # of KV pool and working memory, as models.conf describes it.
    [[ " ${w[*]} " == *" --name $HALOGEN_CONTAINER_PREFIX"* ]] && { echo $(( 98 * 1024 )); return; }
    echo $(( bytes / 1048576 ))
}

# The memory balance of a preset's target set, printed under its plan.
# Expects e_cmd, e_slot, e_model, e_label from cmd_preset.
_preset_memory_check() {
    local total_mib=$(( $(_gtt_total_bytes) / 1048576 ))
    (( total_mib > 0 )) || return 0
    # Whatever else is on the GPU now (desktop, programs outside llmctl): the
    # pool minus what our running slots hold.
    local ours=0 s m
    for s in $(_active_slots); do
        m=$(_slot_gpu_mib "$s" 2>/dev/null) && ours=$(( ours + m ))
    done
    local outside_mib=$(( $(_gtt_used_bytes) / 1048576 - ours ))
    (( outside_mib < 0 )) && outside_mib=0
    local budget=$(( total_mib - outside_mib - GTT_RESERVE_MIB ))

    echo ""
    echo "GPU memory (GTT pool $(_gib "$total_mib"), $(_gib "$outside_mib") used outside llmctl, $(_gib "$GTT_RESERVE_MIB") kept free):"
    local i sum=0 estimated=0 comfy=""
    for (( i=0; i < ${#e_cmd[@]}; i++ )); do
        local mib how
        mib=$(_lookup_footprint "${e_cmd[i]}")
        if [[ -n "$mib" ]]; then
            how="measured"
        else
            mib=$(_estimate_cmd_mib "${e_cmd[i]}"); how="weights only — not measured yet"
            [[ " ${e_cmd[i]} " == *" --name $HALOGEN_CONTAINER_PREFIX"* ]] && how="estimate — not measured yet"
            estimated=1
        fi
        _resolve_model "${e_model[i]}" && [[ "$_r_backend" == comfyui ]] && { comfy="${e_model[i]}"; how="idle; workflows load on top"; }
        _resolve_model "${e_model[i]}" && [[ "$_r_backend" == tts && "$(basename "$_r_binary")" != llama-server* ]] && how="only while it speaks"
        sum=$(( sum + mib ))
        printf "  slot %-3s %-14s %9s  (%s)\n" "${e_slot[i]}" "${e_model[i]}" "$(_gib "$mib")" "$how"
    done
    printf "  %-23s %9s  of %s available\n" "total" "$(_gib "$sum")" "$(_gib "$budget")"
    if (( sum > budget )); then
        echo "  WARNING: this set needs more than the GPU has free — a model will likely fail"
        echo "           to load. Loading anyway; what fails is rolled back."
    elif (( estimated )); then
        echo "  (estimates are lower bounds: KV cache and buffers come on top)"
    fi
    if [[ -n "$comfy" ]]; then
        local left=$(( budget - sum )) bytes wf n_fit=0 biggest="" 
        local -a too=()
        _resolve_model "$comfy"
        _comfyui_paths
        while IFS=$'\t' read -r bytes wf; do
            if (( bytes / 1048576 <= left )); then
                n_fit=$(( n_fit + 1 )); biggest="$wf, $(_gib $(( bytes / 1048576 )))"
            else
                too+=("$wf ($(_gib $(( bytes / 1048576 ))))")
            fi
        done < <(python3 "$COMFYUI_MODELS_SCRIPT" sizes "$c_wf" "$c_models" 2>/dev/null | sort -n)
        if (( ${#too[@]} == 0 )); then
            echo "  ComfyUI has $(_gib "$left") left: all $n_fit workflows fit (largest: $biggest of weights)"
        else
            echo "  ComfyUI has $(_gib "$left") left: $n_fit workflows fit, these do not (weights):"
            printf '    %s\n' "${too[@]}"
        fi
    fi
}

_gib() { awk -v m="$1" 'BEGIN { printf "%.1f GiB", m / 1024 }'; }

# ── Capturing a running configuration ───────────────────────
#
# The reverse of `preset`: read what is running and write it back as a preset.
# Nothing here is trusted on derivation alone — every entry it builds is fed
# back through `start --print-cmd` and has to reproduce the server's own argv
# flag for flag before it may be written (see _capture_slot).

# Every model name in models.conf that points at a given .gguf. Usually one, but
# two entries may share a file and differ only in flags, and then the
# verification below is what tells them apart.
_names_for_model_path() {
    local path="$1" entry
    local -a f
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        [[ "${f[2]//\~/$HOME}" == "$path" ]] && echo "${f[0]}"
    done
}

# The level name that produced a given --reasoning-effort for this model, i.e.
# _translate_reasoning read backwards through reasoning_levels.
_level_for_effort() {
    local effort="$1" map="$2" pair level
    for level in $REASONING_LEVELS; do
        for pair in $map; do
            [[ "${pair%%=*}" == "$level" && "${pair#*=}" == "$effort" ]] && { echo "$level"; return 0; }
        done
    done
    # No map (mode "unknown"): the canonical name was passed through unchanged.
    [[ -z "$map" ]] && { echo "$effort"; return 0; }
    return 1
}

# Turn the process running on a slot back into a preset entry.
# Sets _cap_entry ("<model> <slot> [flags...]") and _cap_label; returns 1 with an
# explanation on stderr when the running server cannot be expressed as one.
_capture_slot() {
    local slot="$1"
    _cap_diff_name=""; _cap_diff_built=""
    local pid=""
    pid=$(_slot_server_pid "$slot") || { echo "slot $slot: nothing is running there" >&2; return 1; }
    _read_argv "$pid" || { echo "slot $slot: cannot read /proc/$pid/cmdline" >&2; return 1; }
    if _is_halogen_argv; then
        _capture_halogen_slot "$slot"
        return
    fi
    if _is_comfyui_argv; then
        _capture_comfyui_slot "$slot"
        return
    fi
    if _is_tts_argv; then
        _capture_tts_slot "$slot"
        return
    fi

    local model="" mmproj="" ctx="" parallel="" predict="" cache_ram="" similarity="" host=""
    local spec_type="" reason="" reason_effort="" reason_budget=""
    local last_temp="" last_top_p=""
    local auth=false verbose=false
    local i=0
    while (( i < ${#_ARGV[@]} )); do
        case "${_ARGV[i]}" in
            -m|--model)               model="${_ARGV[i+1]}";        i=$(( i + 2 )) ;;
            --mmproj)                 mmproj="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            -c|--ctx-size)            ctx="${_ARGV[i+1]}";          i=$(( i + 2 )) ;;
            -np|--parallel)           parallel="${_ARGV[i+1]}";     i=$(( i + 2 )) ;;
            -n|--n-predict)           predict="${_ARGV[i+1]}";      i=$(( i + 2 )) ;;
            --cache-ram)              cache_ram="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --slot-prompt-similarity) similarity="${_ARGV[i+1]}";   i=$(( i + 2 )) ;;
            --host)                   host="${_ARGV[i+1]}";         i=$(( i + 2 )) ;;
            --spec-type)              spec_type="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --reasoning)              reason="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --reasoning-effort)       reason_effort="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --reasoning-budget)       reason_budget="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --api-key-file)           auth=true;                    i=$(( i + 2 )) ;;
            -lv)                      verbose=true;                 i=$(( i + 2 )) ;;
            # Samplers may legitimately repeat — models.conf sets them, --reasoning
            # off may reset them, --temp/--top-p override both. The last wins, so
            # keep overwriting and end up with what the server actually uses.
            --temp)                   last_temp="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --top-p)                  last_top_p="${_ARGV[i+1]}";   i=$(( i + 2 )) ;;
            *)                                                      i=$(( i + 1 )) ;;
        esac
    done

    if [[ -z "$model" ]]; then
        echo "slot $slot: the running process names no --model; it was not started from here" >&2
        return 1
    fi
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    if (( ${#candidates[@]} == 0 )); then
        echo "slot $slot: $(basename "$model") is not in models.conf — add it there first" >&2
        return 1
    fi

    # GGML_VK_QUEUE_PRIORITY lives in the environment, not in argv, so the
    # verification below cannot see it — read it from the process itself.
    local gpu_priority=""
    if [[ -r "/proc/$pid/environ" ]]; then
        gpu_priority=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null |
                       sed -n 's/^GGML_VK_QUEUE_PRIORITY=//p' | head -1)
    fi
    local proxy_up=false
    _slot_proxy_pid "$slot" > /dev/null && proxy_up=true

    local name
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local -a flags=()
        [[ "$proxy_up" == true ]] && flags+=(--proxy)
        [[ "$auth" == true ]] && flags+=(--public)
        [[ -n "$predict" ]] && flags+=(--max-predict "$predict")

        # Reasoning, read back through _translate_reasoning's own rules.
        if [[ "$reason" == "off" ]]; then
            flags+=(--reasoning off)
        elif [[ -n "$reason_effort" ]]; then
            local level=""
            level=$(_level_for_effort "$reason_effort" "$_r_reasoning_levels") || {
                echo "slot $slot: reasoning effort '$reason_effort' matches no level of '$name'" >&2
                continue; }
            flags+=(--reasoning "$level")
        elif [[ -n "$reason_budget" ]]; then
            flags+=(--reasoning "$reason_budget")
        elif [[ "$reason" == "on" ]]; then
            flags+=(--reasoning on)
        fi

        [[ -n "$parallel" && "$parallel" != "1" ]] && flags+=(--parallel "$parallel")
        [[ -n "$ctx" && "$ctx" != "$_r_ctx" ]] && flags+=(--ctx "$ctx")
        [[ -n "$cache_ram" ]] && flags+=(--cache-ram "$cache_ram")
        [[ -n "$similarity" ]] && flags+=(--similarity "$similarity")
        [[ -n "$mmproj" ]] && flags+=(--mmproj)
        [[ -n "$host" ]] && flags+=(--host "$host")
        [[ -n "$gpu_priority" ]] && flags+=(--gpu-priority "$gpu_priority")
        [[ "$verbose" == true ]] && flags+=(--verbose)
        # Speculation is on by default wherever the model declares it, so only
        # its absence needs saying.
        [[ ${#_r_spec_args[@]} -gt 0 && -z "$spec_type" ]] && flags+=(--spec off)

        # The proof: what these flags mean has to be what is actually running.
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot ${flags[*]}"
            _cap_label="$_r_label"
            return 0
        fi

        # Second try with the samplers the process ends on. Unlike every other flag
        # these cannot simply be read off: models.conf sets them for every model, so
        # only a comparison shows whether this server was given different ones. The
        # smallest set that reproduces the command wins, so a captured entry never
        # carries a --temp that merely repeats the model's own.
        local attempt
        for attempt in temp top-p both; do
            local -a flags2=("${flags[@]}")
            case "$attempt" in
                temp)  [[ -n "$last_temp" ]] || continue
                       flags2+=(--temp "$last_temp") ;;
                top-p) [[ -n "$last_top_p" ]] || continue
                       flags2+=(--top-p "$last_top_p") ;;
                both)  [[ -n "$last_temp" && -n "$last_top_p" ]] || continue
                       flags2+=(--temp "$last_temp" --top-p "$last_top_p") ;;
            esac
            local built2=""
            built2=$( cmd_start "$name" "$slot" "${flags2[@]}" --print-cmd 2>/dev/null ) || continue
            if [[ "$built2" == "${_ARGV[*]}" ]]; then
                _cap_entry="$name $slot ${flags2[*]}"
                _cap_label="$_r_label"
                return 0
            fi
        done
        _cap_diff_name="$name"
        _cap_diff_built="$built"
    done

    # Nothing verified: say where it parts ways rather than writing a guess.
    echo "slot $slot: cannot express the running server as start options." >&2
    if [[ -n "${_cap_diff_built:-}" ]]; then
        echo "  closest is '$_cap_diff_name', which would run:" >&2
        echo "    $_cap_diff_built" >&2
        echo "  while the process runs:" >&2
        echo "    ${_ARGV[*]}" >&2
    fi
    echo "  it was probably started by hand with flags llmctl does not offer." >&2
    return 1
}

# _capture_slot for a halogen server: its settings are the container's
# environment, read back into the start options that produce them.
_capture_halogen_slot() {
    local slot="$1" model
    model=$(_argv_halogen_model) || { echo "slot $slot: the container carries no llmctl.model label" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    if (( ${#candidates[@]} == 0 )); then
        echo "slot $slot: $(basename "$model") is not in models.conf — add it there first" >&2
        return 1
    fi
    local host="" i
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "-p" ]] && host="${_ARGV[i+1]%%:*}"
    done
    [[ "$host" == "127.0.0.1" ]] && host=""
    local ctx slots think effort budget temp top_p cap cache vision
    ctx=$(_argv_env HALOGEN_CTX); slots=$(_argv_env HALOGEN_KV_SLOTS)
    think=$(_argv_env HALOGEN_ENABLE_THINKING); effort=$(_argv_env HALOGEN_REASONING_EFFORT)
    budget=$(_argv_env HALOGEN_MAX_THINKING_TOKENS)
    temp=$(_argv_env HALOGEN_TEMPERATURE); top_p=$(_argv_env HALOGEN_TOP_P)
    cap=$(_argv_env HALOGEN_MAX_TOKENS_CAP); cache=$(_argv_env HALOGEN_PROMPT_CACHE)
    vision=$(_argv_env HALOGEN_VISION_TOWER)
    local public=false
    [[ -f "$PID_DIR/stunnel-${slot}.pid" ]] && ps -p "$(cat "$PID_DIR/stunnel-${slot}.pid")" > /dev/null 2>&1 && public=true

    local name
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local -a flags=()
        [[ "$public" == true ]] && flags+=(--public)
        # --public implies a cap of its own; only a different one needs saying.
        if [[ -n "$cap" ]] && ! [[ "$public" == true && "$cap" == "$PUBLIC_MAX_PREDICT_DEFAULT" ]]; then
            flags+=(--max-predict "$cap")
        fi
        if [[ "$think" == "0" ]]; then
            flags+=(--reasoning off)
        elif [[ -n "$effort" ]]; then
            local level=""
            level=$(_level_for_effort "$effort" "$_r_reasoning_levels") || continue
            flags+=(--reasoning "$level")
        elif [[ -n "$budget" ]]; then
            flags+=(--reasoning "$budget")
        fi
        # The entry's own extra_args may set the slots; only a change is a flag.
        local own_slots="" kv
        for kv in "${_r_args[@]}"; do [[ "$kv" == HALOGEN_KV_SLOTS=* ]] && own_slots="${kv#*=}"; done
        [[ -n "$slots" && "$slots" != "$own_slots" ]] && flags+=(--parallel "$slots")
        [[ -n "$ctx" && "$ctx" != "${_r_ctx:-$HALOGEN_NATIVE_CTX}" ]] && flags+=(--ctx "$ctx")
        [[ "$cache" == "0" ]] && flags+=(--cache-ram 0)
        [[ -n "$vision" ]] && flags+=(--mmproj)
        [[ -n "$host" ]] && flags+=(--host "$host")
        [[ -n "$temp" ]] && flags+=(--temp "$temp")
        [[ -n "$top_p" ]] && flags+=(--top-p "$top_p")

        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot ${flags[*]}"
            _cap_label="$_r_label"
            return 0
        fi
        _cap_diff_name="$name"; _cap_diff_built="$built"
    done
    echo "slot $slot: cannot express the running halogen server as start options." >&2
    if [[ -n "${_cap_diff_built:-}" ]]; then
        echo "  closest is '$_cap_diff_name', which would run:" >&2
        echo "    $_cap_diff_built" >&2
        echo "  while the process runs:" >&2
        echo "    ${_ARGV[*]}" >&2
    fi
    return 1
}

# _capture_slot for ComfyUI: the entry is found by its models directory, and
# only --host and --verbose can differ between two starts of it.
_capture_comfyui_slot() {
    local slot="$1" models host name
    models=$(_argv_flag --models-directory) || { echo "slot $slot: ComfyUI runs without --models-directory" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$models")
    if (( ${#candidates[@]} == 0 )); then
        echo "slot $slot: no comfyui entry in models.conf has $models as its model directory" >&2
        return 1
    fi
    host=$(_argv_flag --listen) || host=""
    [[ "$host" == "127.0.0.1" ]] && host=""
    local -a flags=()
    [[ -n "$host" ]] && flags+=(--host "$host")
    local out
    out=$(_argv_flag --output-directory) && flags+=(--output "$out")
    [[ "$(_argv_flag --verbose)" == DEBUG ]] && flags+=(--verbose)
    _slot_proxy_pid "$slot" > /dev/null && flags+=(--proxy)
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot${flags[*]:+ ${flags[*]}}"
            _cap_label="$_r_label"
            return 0
        fi
        _cap_diff_name="$name"; _cap_diff_built="$built"
    done
    echo "slot $slot: cannot express the running ComfyUI as start options." >&2
    if [[ -n "${_cap_diff_built:-}" ]]; then
        echo "  closest is '$_cap_diff_name', which would run:" >&2
        echo "    $_cap_diff_built" >&2
        echo "  while the process runs:" >&2
        echo "    ${_ARGV[*]}" >&2
    fi
    return 1
}

cmd_preset_save() {
    local name="" label="" dry_run=false force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --force) force=true; shift ;;
            --label) _need_value "$@" || exit 1; label="$2"; shift 2 ;;
            -*) echo "Unknown option: $1"; exit 1 ;;
            *) [[ -z "$name" ]] && name="$1"; shift ;;
        esac
    done

    [[ -z "$name" ]] && { echo "Usage: $PROG preset-save <name> [--label TEXT] [--dry-run] [--force]"; exit 1; }
    if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "Error: a preset name may hold letters, digits, dot, dash and underscore; got '$name'"; exit 1
    fi
    # A dry run writes nothing, so an existing name is worth showing, not refusing.
    if _resolve_preset "$name" && [[ "$force" != true && "$dry_run" != true ]]; then
        echo "Error: preset '$name' already exists in presets.conf."
        echo "       Pass --force to replace it, or pick another name."
        exit 1
    fi

    local -a entries=() labels=()
    local slot
    for slot in $(_active_slots); do
        _slot_server_pid "$slot" > /dev/null || continue
        _capture_slot "$slot" || exit 1
        entries+=("$_cap_entry")
        labels+=("$_cap_label")
    done
    if (( ${#entries[@]} == 0 )); then
        echo "Nothing is running — there is no configuration to save."
        exit 1
    fi

    # Default label: the models themselves, which is what the listing shows.
    if [[ -z "$label" ]]; then
        local l
        for l in "${labels[@]}"; do label+="${label:+ + }$l"; done
    fi
    label="${label//\"/\'}"     # the label is written inside a double-quoted assignment

    # Align the model column the way the hand-written entries are aligned.
    local width=0 e
    for e in "${entries[@]}"; do
        local m="${e%% *}"
        (( ${#m} > width )) && width=${#m}
    done

    local block=""
    block+="# Captured from the running configuration on $(date +%F)."$'\n'
    block+="# Verified: each entry reproduces its server's own argv flag for flag."$'\n'
    block+="_preset_name=\"$name\""$'\n'
    block+="_preset_label=\"$label\""$'\n'
    block+="_preset_entries=("$'\n'
    for e in "${entries[@]}"; do
        local m="${e%% *}" rest="${e#* }"
        rest="${rest%"${rest##*[! ]}"}"          # an entry without flags ends in a space
        block+="$(printf '    "%-*s %s"' "$width" "$m" "$rest")"$'\n'
    done
    block+=")"$'\n'
    block+="add_preset"$'\n'

    if [[ "$dry_run" == true ]]; then
        echo ""
        if _resolve_preset "$name"; then
            echo "Would replace the existing preset '$name' in $CONFIG_DIR/presets.conf with:"
        else
            echo "Would append to $CONFIG_DIR/presets.conf:"
        fi
        echo ""
        printf '%s' "$block" | sed 's/^/  /'
        echo ""
        return 0
    fi

    # Resolved, so a presets.conf linked to a checkout is rewritten there and the
    # link itself survives.
    local conf
    conf="$(readlink -f "$CONFIG_DIR/presets.conf")"
    if [[ ! -w "$conf" ]]; then
        echo "Error: cannot write $conf"; exit 1
    fi
    # Replacing: drop the old block and the comment lines that belong to it, so
    # --force leaves no stale description behind.
    if _resolve_preset "$name"; then
        local tmp
        tmp=$(mktemp) || { echo "Error: cannot create a temporary file"; exit 1; }
        PRESET_NAME="$name" awk '
            /^_preset_name="/ {
                if ($0 == "_preset_name=\"" ENVIRON["PRESET_NAME"] "\"") { drop = 1; hold_n = 0; next }
                for (i = 1; i <= hold_n; i++) print hold[i]
                hold_n = 0
            }
            drop { if ($0 == "add_preset") drop = 0; next }
            /^#/ { hold[++hold_n] = $0; next }          # comments may belong to the next block
            /^[[:space:]]*$/ && hold_n > 0 { for (i = 1; i <= hold_n; i++) print hold[i]; hold_n = 0 }
            { for (i = 1; i <= hold_n; i++) print hold[i]; hold_n = 0; print }
            END { for (i = 1; i <= hold_n; i++) print hold[i] }
        ' "$conf" > "$tmp" || { rm -f "$tmp"; echo "Error: rewriting $conf failed"; exit 1; }
        # Collapse the blank lines the removed block left behind.
        awk 'NF == 0 { blank++; next } { while (blank > 2) blank--; while (blank-- > 0) print ""; blank = 0; print }' \
            "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
        cat "$tmp" > "$conf" && rm -f "$tmp"
        echo "Replaced the previous preset '$name'."
    fi

    printf '\n%s' "$block" >> "$conf"

    # Read it back the way llmctl will: a block that does not load is a bug that
    # has to surface here, not on the next start.
    if ! bash -n "$conf" 2>/dev/null; then
        echo "Error: $conf no longer parses — please check the end of the file."
        exit 1
    fi
    echo ""
    echo "Saved preset '$name' to $conf:"
    echo ""
    printf '%s' "$block" | sed 's/^/  /'
    echo ""
    echo "  $PROG preset $name          bring the machine back to it"
    echo "  $PROG preset $name --dry-run   check it against what runs now"
    echo ""
}

# Read a running process's argv (NUL-separated in /proc) into $_ARGV.
_read_argv() {
    local pid="$1"
    _ARGV=()
    [[ -r "/proc/$pid/cmdline" ]] || return 1
    mapfile -d '' -t _ARGV < "/proc/$pid/cmdline" 2>/dev/null || return 1
    (( ${#_ARGV[@]} > 0 )) || return 1
    return 0
}

# Find the models.conf entry whose model file matches $1; on a hit the label is
# printed and the name returned, so status can name the model the way `list` does.
_label_for_model_path() {
    local path="$1" entry
    local -a f
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        if [[ "${f[2]//\~/$HOME}" == "$path" ]]; then
            echo "${f[5]}"
            return 0
        fi
    done
    return 1
}

# Describe a running llama-server from its own argv rather than from what the
# last start printed: the process is the ground truth even when the log belongs
# to an older run or the server was started by hand.
_describe_server() {
    local pid="$1"
    local indent="${2:-         }"
    if ! _read_argv "$pid"; then
        echo "${indent}Model:     unknown (cannot read /proc/$pid/cmdline)"
        return 0
    fi
    if _is_halogen_argv; then
        _describe_halogen "$indent"
        return 0
    fi
    if _is_comfyui_argv; then
        _describe_comfyui "$pid" "$indent"
        return 0
    fi
    if _is_tts_argv; then
        _describe_tts "$indent"
        return 0
    fi

    local model="" served="" ctx="" parallel="" predict="" cache_ram="" mmproj="" host="" similarity=""
    local spec_type="" spec_draft="" spec_n=""
    local reason="" reason_effort="" reason_budget=""
    local auth=false role="" port=""
    local i=0
    while (( i < ${#_ARGV[@]} )); do
        case "${_ARGV[i]}" in
            -m|--model)          model="${_ARGV[i+1]}";        i=$(( i + 2 )) ;;
            --alias)             served="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            -c|--ctx-size)       ctx="${_ARGV[i+1]}";          i=$(( i + 2 )) ;;
            -np|--parallel)      parallel="${_ARGV[i+1]}";     i=$(( i + 2 )) ;;
            -n|--n-predict)      predict="${_ARGV[i+1]}";      i=$(( i + 2 )) ;;
            --cache-ram)         cache_ram="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            --slot-prompt-similarity) similarity="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --mmproj)            mmproj="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --host)              host="${_ARGV[i+1]}";         i=$(( i + 2 )) ;;
            --spec-type)         spec_type="${_ARGV[i+1]}";    i=$(( i + 2 )) ;;
            -md|--model-draft)   spec_draft="${_ARGV[i+1]}";   i=$(( i + 2 )) ;;
            --spec-draft-n-max)  spec_n="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --reasoning)         reason="${_ARGV[i+1]}";       i=$(( i + 2 )) ;;
            --reasoning-effort)  reason_effort="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --reasoning-budget)  reason_budget="${_ARGV[i+1]}"; i=$(( i + 2 )) ;;
            --api-key-file)      auth=true;                    i=$(( i + 2 )) ;;
            --port)              port="${_ARGV[i+1]}";         i=$(( i + 2 )) ;;
            --embedding|--embeddings) role=embedding;          i=$(( i + 1 )) ;;
            --reranking|--rerank) role=rerank;                 i=$(( i + 1 )) ;;
            *)                                                 i=$(( i + 1 )) ;;
        esac
    done

    # A model started outside llmctl has no models.conf entry — fall back to the file.
    local label=""
    [[ -n "$model" ]] && label=$(_label_for_model_path "$model")
    [[ -z "$label" && -n "$model" ]] && label="$(basename "$model")"
    echo "${indent}Model:     ${label:-unknown}${served:+ ($served)}"

    # Parameters that change what the server does, in the order start prints them.
    local -a params=("ctx ${ctx:-default}" "parallel ${parallel:-1}")
    [[ -n "$predict" ]]   && params+=("n-predict $predict")
    case "$cache_ram" in
        "")   ;;
        0)    params+=("prompt-cache off") ;;
        -1)   params+=("prompt-cache unlimited") ;;
        *)    params+=("prompt-cache ${cache_ram} MiB") ;;
    esac
    case "$similarity" in
        "")     ;;
        0|0.0*) params+=("slot pick LRU") ;;
        *)      params+=("slot similarity $similarity") ;;
    esac
    [[ -n "$mmproj" ]]    && params+=("mmproj")
    [[ -n "$host" ]]      && params+=("host $host")
    [[ "$auth" == true ]] && params+=("token auth")
    local joined="" p
    for p in "${params[@]}"; do joined+="${joined:+, }$p"; done
    echo "${indent}Params:    $joined"

    # Nothing is generated: reasoning and drafting do not apply.
    case "$role" in
        embedding) echo "${indent}Serves:    embeddings — POST http://${host:-127.0.0.1}:$port/v1/embeddings"; return 0 ;;
        rerank)    echo "${indent}Serves:    reranking — POST http://${host:-127.0.0.1}:$port/v1/rerank"; return 0 ;;
    esac

    # --reasoning off comes with a budget of 0; naming both would say it twice.
    if [[ "$reason" == "off" ]]; then
        echo "${indent}Reasoning: off"
    elif [[ -n "$reason$reason_effort$reason_budget" ]]; then
        local note="${reason:-on}"
        [[ -n "$reason_effort" ]] && note+=", effort $reason_effort"
        [[ -n "$reason_budget" ]] && note+=", budget $reason_budget"
        echo "${indent}Reasoning: $note"
    else
        echo "${indent}Reasoning: template default"
    fi

    if [[ -n "$spec_type$spec_draft$spec_n" ]]; then
        local note="${spec_type:-on}"
        [[ -n "$spec_draft" ]] && note+=", draft $(basename "$spec_draft")"
        [[ -n "$spec_n" ]]     && note+=", n-max $spec_n"
        echo "${indent}Spec:      $note"
    else
        echo "${indent}Spec:      off"
    fi
}

# _describe_server for a halogen server, from the container environment in $_ARGV.
_describe_halogen() {
    local indent="$1" model label host="" i
    model=$(_argv_halogen_model) || model=""
    label=$(_label_for_model_path "$model") || label="$(basename "${model:-unknown}")"
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "-p" ]] && host="${_ARGV[i+1]%%:*}"
    done
    echo "${indent}Model:     $label ($(_argv_env HALOGEN_MODEL_ID || echo "?"))"
    local ctx yarn
    ctx=$(_argv_env HALOGEN_CTX); yarn=$(_argv_env HALOGEN_ROPE_YARN)
    local -a params=("ctx ${ctx:-$HALOGEN_NATIVE_CTX}${yarn:+ (YaRN x$yarn)}"
                     "parallel $(_argv_env HALOGEN_KV_SLOTS || echo 4)"
                     "pool $(_argv_env HALOGEN_KV_POOL_POSITIONS || echo default)")
    local v
    v=$(_argv_env HALOGEN_MAX_TOKENS_CAP) && params+=("token cap $v")
    [[ "$(_argv_env HALOGEN_PROMPT_CACHE)" == "0" ]] && params+=("prompt-cache off")
    _argv_env HALOGEN_VISION_TOWER > /dev/null && params+=("vision")
    [[ -n "$host" && "$host" != "127.0.0.1" ]] && params+=("host $host")
    local joined="" p
    for p in "${params[@]}"; do joined+="${joined:+, }$p"; done
    echo "${indent}Params:    $joined"
    if [[ "$(_argv_env HALOGEN_ENABLE_THINKING)" == "0" ]]; then
        echo "${indent}Reasoning: off by default"
    elif v=$(_argv_env HALOGEN_REASONING_EFFORT); then
        echo "${indent}Reasoning: default effort $v"
    elif v=$(_argv_env HALOGEN_MAX_THINKING_TOKENS); then
        echo "${indent}Reasoning: budget $v"
    else
        echo "${indent}Reasoning: server default (effort xhigh)"
    fi
    echo "${indent}Spec:      MTP (always on)"
    if [[ "$(_argv_env HALOGEN_WEIGHTS_LOCK)" == "1" ]]; then
        echo "${indent}Memory:    $(_halogen_mem_line "$LOG_DIR/server-${slot}.log")"
    else
        echo "${indent}Memory:    real use — free(1) counts the pinned weights as cache:"
        echo "${indent}           $(_halogen_mem_line "$LOG_DIR/server-${slot}.log")"
    fi
}

# _describe_server for ComfyUI: where its UI is, what it is doing, and how much
# memory it holds right now — which changes with every workflow it loads.
_describe_comfyui() {
    local pid="$1" indent="$2" models host port label q
    models=$(_argv_flag --models-directory) || models=""
    host=$(_argv_flag --listen) || host="127.0.0.1"
    port=$(_argv_flag --port) || port="?"
    label=$(_label_for_model_path "$models") || label="ComfyUI"
    echo "${indent}Model:     $label ($models)"
    [[ "$host" == "0.0.0.0" ]] && host="$(hostname)"
    echo "${indent}UI:        http://$host:$port"
    q=$(_comfyui_queue "$port")
    echo "${indent}Queue:     ${q:-no answer (still starting?)}"
    awk -v g="$(_proc_gpu_mib "$pid")" -v r="$(_proc_rss_mib "$pid")" -v i="$indent" 'BEGIN {
        printf "%sMemory:    GPU %.1f GiB, RAM %.1f GiB (unloaded before every LLM start)\n", i, g / 1024, r / 1024 }'
}

# What is really left: MemAvailable minus the weights halogen pinned, which the
# kernel files under reclaimable page cache although nothing can reclaim them.
# With HALOGEN_WEIGHTS_LOCK=1 (0.13.2) they are mlock'ed, so MemAvailable has
# already dropped by them and subtracting again would count them twice.
_halogen_mem_line() {
    local log="$1" weights gtt
    weights=$(sed -n 's/.*memory: \([0-9.]*\) GiB of weights locked.*/\1/p' "$log" 2>/dev/null | tail -1)
    [[ "$(_argv_env HALOGEN_WEIGHTS_LOCK)" == "1" ]] && weights=0
    gtt=$(cat /sys/class/drm/card*/device/mem_info_gtt_used 2>/dev/null | head -1)
    awk -v w="${weights:-0}" -v gtt="${gtt:-0}" '
        /^MemAvailable:/ { avail = $2 / 1048576 }
        END { real = avail - w; if (real < 0) real = 0
              if (w == 0) printf "GPU (GTT) %.1f GiB, available %.1f GiB (the weights are mlocked, so free(1) counts them)", gtt / 1073741824, avail
              else printf "weights %.1f GiB pinned, GPU (GTT) %.1f GiB, really available %.1f GiB (free(1): %.1f)", w, gtt / 1073741824, real, avail }' /proc/meminfo
}

cmd_status() {
    local found=0
    for slot in $(_active_slots); do
        local port_server=$(( PORT_BASE_SERVER + slot ))
        local port_proxy=$(( PORT_BASE_PROXY + slot ))

        local server_pid="" proxy_pid=""
        server_pid=$(_slot_server_pid "$slot") || server_pid=""
        proxy_pid=$(_slot_proxy_pid "$slot") || proxy_pid=""

        # Written by `preset`, removed by `start` and `stop` — so it only ever
        # names a slot this machine still holds for that preset.
        local preset_note=""
        [[ -s "$PID_DIR/preset-${slot}" ]] && preset_note="  [Preset: $(cat "$PID_DIR/preset-${slot}")]"

        # The detail lines hang under the "Slot N:" prefix, which grows with N.
        local indent
        printf -v indent '%*s' $(( 9 + ${#slot} - 1 )) ''
        if _halogen_orphan "$slot"; then
            echo "Slot $slot: halogen      (container $(_halogen_container "$slot"), no client process)"
            echo "${indent}Note:      its podman client is gone — the container still holds the weights"
            echo "${indent}           and :$port_server. '$PROG stop $slot' ends it; start it again to manage it."
            found=1
            continue
        fi
        if [[ -n "$server_pid" ]] && ps -p "$server_pid" > /dev/null 2>&1; then
            local kind="llama-server"
            _slot_is_halogen "$slot" && kind="halogen     "
            _read_argv "$server_pid" && _is_comfyui_argv && kind="comfyui     "
            _read_argv "$server_pid" && _is_tts_argv && kind="tts         "
            echo "Slot $slot: $kind (PID: $server_pid) on :$port_server$preset_note"
            # A loaded server's footprint, for preset's memory balance. Not
            # ComfyUI's: it swings with every workflow; preset records it idle.
            [[ "$kind" != comfyui* ]] && _record_footprint "$slot"
            _describe_server "$server_pid" "$indent"
            echo "${indent}Log: tail -f $LOG_DIR/server-${slot}.log"
            found=1
        fi
        if [[ -n "$proxy_pid" ]] && ps -p "$proxy_pid" > /dev/null 2>&1; then
            if [[ "$(tr '\0' ' ' < "/proc/$proxy_pid/cmdline" 2>/dev/null)" == *"$IMAGES_SERVER_SCRIPT"* ]]; then
                echo "Slot $slot: image API   (PID: $proxy_pid) on :$port_proxy  POST /v1/images/generations, /v1/images/edits"
            else
                echo "Slot $slot: proxy       (PID: $proxy_pid) on :$port_proxy"
            fi
            found=1
        fi

        local stunnel_pid=""
        [[ -f "$PID_DIR/stunnel-${slot}.pid" ]] && stunnel_pid=$(cat "$PID_DIR/stunnel-${slot}.pid")
        if [[ -n "$stunnel_pid" ]] && ps -p "$stunnel_pid" > /dev/null 2>&1; then
            local tls_ports=":$(( PORT_BASE_TLS_SERVER + slot ))"
            ss -tlnp 2>/dev/null | grep -q ":$(( PORT_BASE_TLS_PROXY + slot )) " && \
                tls_ports="$tls_ports, :$(( PORT_BASE_TLS_PROXY + slot ))"
            echo "Slot $slot: stunnel     (PID: $stunnel_pid) on $tls_ports  [public, mTLS]"
            found=1
        fi
    done
    [[ "$found" -eq 0 ]] && echo "Nothing running."
    # Explicit, or the guard above would make a slot that IS running exit 1.
    return 0
}

# Candidates for the word being completed, one per line; the shell filters them
# by what is typed so far. The completion scripts in completions/ only hand over
# the words and print this, so both shells complete the same thing.
# "@files" asks the shell for file names instead.
# Usage: _complete <words after llmctl, the last being the one completed>
_complete_models() {   # [backend...]: only models on these backends
    local entry name backend
    local -a f
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        name="${f[0]}" backend="${f[19]:-llama}"
        [[ " ${f[6]} " == *" --embedding "* || " ${f[6]} " == *" --reranking "* ]] && backend=service
        (( $# == 0 )) || [[ " $* " == *" $backend "* ]] && echo "$name"
    done
}
cmd__complete() {
    local -a w=("$@")
    (( ${#w[@]} )) || w=("")
    local n=${#w[@]} sub="${w[0]}" prev=""
    (( n >= 2 )) && prev="${w[n-2]}"
    if (( n == 1 )); then
        printf '%s\n' start preset preset-save presets stop status logs cache-stats clear-kv \
            probe-reasoning gen-certs bench list env clear shell-init download update voice service help version
        return 0
    fi
    # Positional words before the one completed, options and their values left out.
    local -a pos=()
    local i
    for (( i=1; i < n-1; i++ )); do
        case "${w[i]}" in
            --reasoning|--reasoning-budget|--max-predict|--parallel|--ctx|--cache-ram|--similarity|\
            --host|--gpu-priority|--spec|--temp|--top-p|--output|--lang|--seed|--wait|--label|--from|-n)
                (( i++ )) ;;
            -*) ;;
            *) pos+=("${w[i]}") ;;
        esac
    done
    local k=${#pos[@]}
    case "$prev" in
        --reasoning)    printf '%s\n' off on low medium high max; return 0 ;;
        --spec)         printf '%s\n' on off; return 0 ;;
        --gpu-priority) printf '%s\n' low medium high realtime; return 0 ;;
        --lang)         printf '%s\n' de en zh ja ko fr es it pt ru; return 0 ;;
        --output|--from) echo @files; return 0 ;;
        --reasoning-budget|--max-predict|--parallel|--ctx|--cache-ram|--similarity|--host|\
        --temp|--top-p|--seed|--wait|--label|-n) return 0 ;;
    esac
    local slot_nums; slot_nums=$(seq 1 $(( SLOT_MAX < 9 ? SLOT_MAX : 9 )))
    case "$sub" in
        start)
            case $k in 0) _complete_models ;; 1) echo "$slot_nums" ;; esac
            printf '%s\n' --proxy --public --compact --max-predict --reasoning --no-reasoning --reasoning-budget \
                --parallel --ctx --cache-ram --similarity --verbose --clear-logs --host --gpu-priority --mmproj \
                --spec --no-spec --temp --top-p --print-cmd --output --lang --seed ;;
        preset)
            (( k == 0 )) && { local e; for e in "${_PRESETS[@]}"; do echo "${e%%|*}"; done; }
            printf '%s\n' --dry-run --force --repair --wait --output --proxy --public --host --clear-logs --verbose --gpu-priority ;;
        preset-save) printf '%s\n' --dry-run --force --label ;;
        service)
            case $k in
                0) printf '%s\n' enable disable start stop status ;;
                1) [[ "${pos[0]}" == enable ]] && { local e; for e in "${_PRESETS[@]}"; do echo "${e%%|*}"; done; } ;;
            esac ;;
        stop|clear-kv) (( k == 0 )) && _active_slots ;;
        cache-stats)   (( k == 0 )) && _log_slots ;;
        logs) (( k == 0 )) && _log_slots; printf '%s\n' --proxy --tls -f -n ;;
        env)
            case $k in 0) _complete_models llama halogen ;; 1) echo "$slot_nums" ;; esac
            printf '%s\n' --proxy --direct ;;
        download) (( k == 0 )) && { _complete_models; echo all; }; printf '%s\n' --force --from ;;
        update)   (( k == 0 )) && _complete_models comfyui; echo --torch ;;
        bench)    (( k == 0 )) && { _complete_models; echo all; }; echo --full ;;
        probe-reasoning) (( k == 0 )) && _complete_models llama ;;
        voice)
            case "${pos[0]:-}" in
                "") (( k == 0 )) && printf '%s\n' list add design rm export import ;;
                rm) (( k == 1 )) && { local v; for v in "$TTS_VOICES"/*.{wav,mp3,flac}; do
                        [[ -f "$v" ]] && { v="${v##*/}"; echo "${v%.*}"; }; done; } ;;
                add)    (( k == 2 )) && echo @files ;;
                export) (( k == 1 )) && echo @files ;;
                import) (( k == 1 )) && echo @files; echo --force ;;
            esac ;;
    esac
    return 0
}

# Run a preset as a systemd user service: started at login, stopped at logout,
# and its slots brought back when a server dies. The servers live in the
# service's cgroup — `preset` runs as ExecStart, and the repair as ExecReload,
# which a timer asks for every two minutes — so systemd stops what the service
# started. The repair is `preset --repair`: it restarts only slots this preset
# still claims, so switching presets by hand is not undone behind your back.
# Usage: service enable <preset> | disable | start | stop | status
SERVICE_UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
cmd_service() {
    local action="${1:-status}"; shift || true
    local unit="$SERVICE_UNIT_DIR/llmctl.service"
    _check_deps systemctl || return 1
    case "$action" in
        enable)
            local name="${1:-}"
            [[ -n "$name" ]] || { echo "Usage: $PROG service enable <preset>"; return 1; }
            _resolve_preset "$name" || { echo "Unknown preset: $name"; cmd_presets; return 1; }
            local bin; bin=$(command -v "$PROG" 2>/dev/null || readlink -f "$0")
            # A user service starts with systemd's own environment: the PATH that
            # finds llama-server, podman and hf here, and any directory override.
            local -a env=("PATH=$PATH") v
            for v in LLMCTL_CONFIG_DIR LLMCTL_DATA_DIR LLMCTL_STATE_DIR LLMCTL_MODELS_DIR; do
                [[ -n "${!v:-}" ]] && env+=("$v=${!v}")
            done
            mkdir -p "$SERVICE_UNIT_DIR"
            {
                echo "# Written by llmctl service enable — rewritten by the next enable."
                echo "[Unit]"
                echo "Description=llmctl preset $name"
                echo ""
                echo "[Service]"
                echo "Type=oneshot"
                echo "RemainAfterExit=yes"
                for v in "${env[@]}"; do printf 'Environment="%s"\n' "$v"; done
                echo "ExecStart=$bin preset $name"
                echo "ExecReload=$bin preset $name --repair"
                echo "ExecStop=$bin service stop-slots $name"
                echo "TimeoutStartSec=30min"
                echo "TimeoutStopSec=2min"
                echo ""
                echo "[Install]"
                echo "WantedBy=default.target"
            } > "$unit"
            {
                echo "# Written by llmctl service enable."
                echo "[Unit]"
                echo "Description=llmctl: restart what died in the service's preset"
                echo ""
                echo "[Service]"
                echo "Type=oneshot"
                echo "ExecCondition=/usr/bin/systemctl --user is-active --quiet llmctl.service"
                echo "ExecStart=/usr/bin/systemctl --user reload llmctl.service"
            } > "$SERVICE_UNIT_DIR/llmctl-repair.service"
            {
                echo "# Written by llmctl service enable."
                echo "[Unit]"
                echo "Description=llmctl: look for dead slots every two minutes"
                echo ""
                echo "[Timer]"
                echo "OnActiveSec=5min"
                echo "OnUnitActiveSec=2min"
                echo ""
                echo "[Install]"
                echo "WantedBy=timers.target"
            } > "$SERVICE_UNIT_DIR/llmctl-repair.timer"
            systemctl --user daemon-reload
            systemctl --user enable llmctl.service llmctl-repair.timer 2>&1 | grep -v '^Created symlink' || true
            systemctl --user start llmctl-repair.timer
            echo "Preset '$name' starts at your next login, and dead slots come back within ~2 min."
            echo "  Start it now:  $PROG service start   (brings the machine to '$name')"
            if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
                echo "  At boot, before anyone logs in: loginctl enable-linger $USER"
            fi
            ;;
        disable)
            systemctl --user disable --now llmctl-repair.timer 2>/dev/null || true
            systemctl --user disable llmctl.service 2>&1 | grep -v '^Removed' || true
            echo "No preset at login any more, and no repairs. What runs keeps running;"
            echo "  $PROG service stop ends the service's slots, $PROG stop everything."
            ;;
        start|stop)
            [[ -f "$unit" ]] || { echo "No service set up — $PROG service enable <preset>"; return 1; }
            # Not while the service's own start is still running: it may take minutes.
            systemctl --user "$action" --no-block llmctl.service
            [[ "$action" == start ]] && echo "Starting — follow it with: $PROG service status"
            [[ "$action" == stop ]] && echo "Stopping the service's slots — $PROG status shows what is left."
            ;;
        status)
            if [[ ! -f "$unit" ]]; then
                echo "No service set up — $PROG service enable <preset>"
                return 0
            fi
            local name; name=$(sed -n 's/^Description=llmctl preset //p' "$unit")
            printf 'Preset:   %s\n' "$name"
            printf 'Login:    %s\n' "$(systemctl --user is-enabled llmctl.service 2>/dev/null)"
            printf 'Service:  %s\n' "$(systemctl --user is-active llmctl.service 2>/dev/null)"
            printf 'Repairs:  %s, next %s\n' "$(systemctl --user is-active llmctl-repair.timer 2>/dev/null)" \
                "$(systemctl --user show llmctl-repair.timer -p NextElapseUSecRealtime --value 2>/dev/null)"
            printf 'Linger:   %s\n' "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)"
            echo "Last lines:"
            journalctl --user -u llmctl.service -n 6 --no-pager -o cat 2>/dev/null | sed 's/^/  /'
            ;;
        stop-slots)
            # ExecStop: the slots the preset still holds; whatever else runs stays.
            local name="${1:-}" f sl
            for f in "$PID_DIR"/preset-*; do
                [[ -f "$f" && "$(cat "$f")" == "$name" ]] || continue
                sl="${f##*/preset-}"
                _stop_slot "$sl" || true
            done
            ;;
        *) echo "Usage: $PROG service enable <preset> | disable | start | stop | status"; return 1 ;;
    esac
}

# Show a slot's log without knowing where it lives.
# Usage: logs [slot] [--proxy|--tls] [-f] [-n N]
#   no slot: every log there is, with size and last change
cmd_logs() {
    local slot="" kind=server follow=false lines=50
    while (( $# )); do
        case "$1" in
            --proxy) kind=proxy ;;
            --tls)   kind=stunnel ;;
            -f|--follow) follow=true ;;
            -n) lines="${2:-}"; shift
                [[ "$lines" =~ ^[0-9]+$ ]] || { echo "Error: -n takes a number of lines"; return 1; } ;;
            -*) echo "Usage: $PROG logs [slot] [--proxy|--tls] [-f] [-n N]"; return 1 ;;
            *)  slot="$1" ;;
        esac
        shift
    done
    if [[ -z "$slot" ]]; then
        [[ -n "$(compgen -G "$LOG_DIR/*-*.log")" ]] || { echo "No logs yet (start a server first)."; return 0; }
        local f
        for f in "$LOG_DIR"/{server,proxy,stunnel}-*.log; do
            [[ -f "$f" ]] || continue
            printf '  %-18s %8s  %s\n' "${f##*/}" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
        done | sort -t- -k2 -n
        return 0
    fi
    _check_slot "$slot" || return 1
    local log="$LOG_DIR/${kind}-${slot}.log"
    [[ -f "$log" ]] || { echo "No $kind log for slot $slot ($log)."; return 1; }
    if [[ "$follow" == true ]]; then
        exec tail -n "$lines" -F "$log"
    fi
    tail -n "$lines" "$log"
}

# Summarize prompt-cache effectiveness from the server log (works whether or
# not clients go through the proxy). Per finished task the INFO log carries
# processed prompt tokens ("prompt eval time = .. / N"), generated tokens
# ("eval time = .. / M") and the final context size ("stop processing:
# n_tokens = T"); prompt_total = T - M and cached = prompt_total - N, which
# equals llama-server's own n_prompt_tokens_cache. The log is truncated on
# each start, so this reflects the current server session.
# Usage: cache-stats [slot]  (default: all slots with a server log)
cmd_cache_stats() {
    local want_slot="${1:-}"
    [[ -n "$want_slot" ]] && { _check_slot "$want_slot" || return 1; }
    local found=0
    for slot in ${want_slot:-$(_log_slots)}; do
        local log="$LOG_DIR/server-${slot}.log"
        [[ -f "$log" ]] || continue
        found=1
        if grep -q '^Backend:  ComfyUI' "$log"; then
            echo "Slot $slot: ComfyUI — no prompt cache"
            continue
        fi
        if grep -q '^Serves:   ' "$log"; then
            echo "Slot $slot: $(grep -m1 '^Serves:   ' "$log" | sed 's/^Serves: *//; s/ —.*//') — no prompt cache"
            continue
        fi
        if grep -q '^Backend:  tts' "$log"; then
            echo "Slot $slot: speech — no prompt cache"
            continue
        fi
        if _slot_is_halogen "$slot"; then
            # Its log has no per-task token counts; the server keeps its own tally.
            echo "Slot $slot: halogen, from :$(( PORT_BASE_SERVER + slot ))/cache"
            curl -sf "http://127.0.0.1:$(( PORT_BASE_SERVER + slot ))/cache" | python3 -c '
import json, sys
c = json.load(sys.stdin)
hits, misses = c.get("hits", 0), c.get("misses", 0)
rate = 100 * hits / (hits + misses) if hits + misses else 0
entries, cap, saved = c.get("entries"), c.get("max_entries"), c.get("prompt_tokens_saved", 0)
print(f"  entries={entries}/{cap}  hits={hits}  misses={misses}  "
      f"hit_rate={rate:.1f}%  prompt_tokens_saved={saved}")
' || echo "  the server does not answer (still loading?)"
            continue
        fi
        echo "Slot $slot: $log"
        python3 - "$log" <<'PY'
import re, sys
proc, gen, total = {}, {}, {}
re_pe = re.compile(r"task\s+(\d+) \| prompt eval time =.*?/\s*(\d+) tokens")
re_ev = re.compile(r"task\s+(\d+) \|\s+eval time =.*?/\s*(\d+) tokens")
re_st = re.compile(r"task\s+(\d+) \| stop processing: n_tokens = (\d+)")
for ln in open(sys.argv[1], errors="replace"):
    m = re_pe.search(ln);  m and proc.update({m.group(1): int(m.group(2))})
    m = re_ev.search(ln);  m and gen.update({m.group(1): int(m.group(2))})
    m = re_st.search(ln);  m and total.update({m.group(1): int(m.group(2))})
n = tp = tc = 0
for tid, T in total.items():
    ptotal = T - gen.get(tid, 0)          # prompt tokens = context minus generated
    if ptotal <= 0:
        continue
    cached = max(0, ptotal - proc.get(tid, 0))
    n += 1; tp += ptotal; tc += cached
if tp:
    print(f"  tasks={n}  prompt_tokens={tp}  cached={tc}  "
          f"reprocessed={tp-tc}  hit_rate={100*tc/tp:.1f}%")
else:
    print("  no finished completion tasks in the log yet")
PY
    done
    [[ "$found" -eq 0 ]] && echo "No server logs yet (start a server first)."
    return 0
}

# Drop the KV cache of the running slots without restarting the server:
# POST /slots/{id}?action=erase for every server slot (--parallel N creates
# ids 0..N-1). That action needs --slot-save-path, which cmd_start always passes.
#
# Two things this does *not* do: it never interrupts a running generation (the
# server defers the erase until the slot falls idle, so the call can block), and
# it leaves the host-RAM prompt cache alone (--cache-ram, 8192 MiB by default) —
# a matching prompt can be restored from there afterwards.
#
# Usage: clear-kv [slot]  (default: every running slot)
cmd_clear_kv() {
    local want_slot="${1:-}"
    [[ -n "$want_slot" ]] && { _check_slot "$want_slot" || return 1; }
    _check_deps python3 || return 1

    # A slot started with --public requires a token; reuse the first one, exactly
    # as cmd_env does. A server without --api-key-file ignores the header.
    local token=""
    if [[ -r "$TOKEN_FILE" ]]; then
        token=$(grep -m1 -vE '^[[:space:]]*(#|$)' "$TOKEN_FILE" 2>/dev/null)
    fi

    local found=0
    for slot in ${want_slot:-$(_active_slots)}; do
        local server_pid=""
        [[ -f "$PID_DIR/server-${slot}.pid" ]] && server_pid=$(cat "$PID_DIR/server-${slot}.pid")
        [[ -n "$server_pid" ]] && ps -p "$server_pid" > /dev/null 2>&1 || continue
        found=1
        if _slot_is_comfyui "$slot"; then
            # Its counterpart of a KV cache: the models and cached node outputs.
            _comfyui_unload_slot "$slot"
            continue
        fi
        if _slot_is_tts "$slot"; then
            echo "Slot $slot: speech holds nothing between requests — each one loads and frees its model."
            continue
        fi
        if _slot_is_halogen "$slot"; then
            echo "Slot $slot: halogen has no endpoint to erase its KV; a request's region is freed when it"
            echo "        ends, and only the prompt cache keeps anything. For a hard reset: $PROG stop $slot"
            echo "        and start it again with --cache-ram 0 (prompt cache off)."
            continue
        fi

        echo "Slot $slot: clearing KV on :$(( PORT_BASE_SERVER + slot ))"
        LLM_KV_TOKEN="$token" python3 - "$(( PORT_BASE_SERVER + slot ))" <<'KVPY'
import json, os, sys, urllib.error, urllib.request

base    = f"http://127.0.0.1:{sys.argv[1]}"
token   = os.environ.get("LLM_KV_TOKEN", "")
headers = {"Authorization": f"Bearer {token}"} if token else {}

def call(path, method="GET", timeout=30):
    req = urllib.request.Request(f"{base}{path}", method=method, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)

try:
    # /props reports the slot count and stays readable even with --no-slots.
    n_slots = int(call("/props").get("total_slots", 1))
except Exception as e:
    print(f"  Error: cannot read /props ({e})")
    sys.exit(1)

total = 0
for i in range(n_slots):
    try:
        # Generous timeout: a busy slot only frees up once its generation ends,
        # which the server bounds with --timeout 600.
        res = call(f"/slots/{i}?action=erase", method="POST", timeout=620)
    except urllib.error.HTTPError as e:
        print(f"  slot {i}: HTTP {e.code} — {e.read().decode(errors='replace').strip()}")
        continue
    except Exception as e:
        print(f"  slot {i}: {e}")
        continue
    n = int(res.get("n_erased", 0))
    total += n
    print(f"  slot {i}: {n} tokens erased")

print(f"  total: {total} tokens")
KVPY

        # The prompt could still come back from host RAM, which no endpoint clears.
        local pc
        pc=$(grep -m1 '^PromptCache:' "$LOG_DIR/server-${slot}.log" 2>/dev/null)
        if [[ -n "$pc" && "$pc" != *disabled* ]]; then
            echo "  Note: ${pc#PromptCache: } — a matching prompt may be restored from host RAM."
            echo "        Start the slot with --cache-ram 0 for a hard reset."
        fi
    done
    if [[ "$found" -eq 0 ]]; then
        echo "No running server${want_slot:+ in slot $want_slot}."
        return 1
    fi
    return 0
}

# Read the chat template each model actually runs with and report what it
# supports, next to what models.conf claims. This is the same signal llama.cpp
# probes at load time (jinja::caps_*): enable_thinking for on/off,
# reasoning_effort / reasoning_strength for levels. The template is the one baked
# into the GGUF unless extra_args override it with --chat-template-file, which is
# what the server would then load — probing the GGUF there would report the
# template the model ships with rather than the one it runs.
#
# Usage: probe-reasoning [model]
cmd_probe_reasoning() {
    local want="${1:-}"
    _check_deps python3 || return 1

    # gguf-py ships with the llama.cpp sources, not with the binary.
    local gguf_py=""
    if python3 -c "import gguf" 2>/dev/null; then
        gguf_py=""
    elif [[ -d "${LLAMA_SRC:-$HOME/src/llama.cpp}/gguf-py" ]]; then
        gguf_py="${LLAMA_SRC:-$HOME/src/llama.cpp}/gguf-py"
    else
        echo "Error: needs the gguf python module — either 'pip install gguf' or a"
        echo "       llama.cpp checkout (set LLAMA_SRC, default ~/src/llama.cpp)"
        return 1
    fi

    printf "  %-11s %-11s %-11s %s\n" "MODEL" "CONFIGURED" "TEMPLATE" "READS"
    printf "  %-11s %-11s %-11s %s\n" "-----" "----------" "--------" "-----"

    local entry
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name _ m_model _ _ _ m_args _ _ _ _ _ _ _ m_reasoning _ <<< "$entry"
        [[ -n "$want" && "$m_name" != "$want" ]] && continue
        _resolve_model "$m_name" && [[ "$_r_backend" == comfyui || "$_r_backend" == tts || "$_r_role" != chat ]] && continue
        local path="${m_model//\~/$HOME}"

        if [[ ! -f "$path" ]]; then
            # ASCII dash: bash pads printf by bytes, so a multibyte one misaligns.
            printf "  %-11s %-11s %-11s %s\n" "$m_name" "$m_reasoning" "-" "not downloaded"
            continue
        fi
        # --chat-template-file <path> anywhere in extra_args wins over the GGUF.
        # read -ra rather than an unquoted expansion: args are split on spaces
        # here, but a stray glob in them must not hit the filesystem.
        local tmpl_file="" prev=""
        local -a args_arr=()
        read -ra args_arr <<< "$m_args"
        local word
        for word in "${args_arr[@]}"; do
            [[ "$prev" == "--chat-template-file" ]] && { tmpl_file="$word"; break; }
            prev="$word"
        done
        # A halogen checkpoint is no GGUF; its template ships beside it.
        _resolve_model "$m_name" && [[ "$_r_backend" == halogen ]] && \
            tmpl_file="$(dirname "$path")/tokenizer/chat_template.jinja"
        GGUF_PY="$gguf_py" python3 - "$m_name" "$m_reasoning" "$path" "$tmpl_file" <<'PROBEPY'
import os, sys
if os.environ.get("GGUF_PY"):
    sys.path.insert(0, os.environ["GGUF_PY"])
from gguf import GGUFReader

name, configured, path, tmpl_file = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

tmpl, source = None, ""
if tmpl_file:
    source = f"  [{os.path.basename(tmpl_file)}]"
    if not os.path.isfile(tmpl_file):
        print(f"  {name:<11} {configured:<11} {'?':<11} --chat-template-file {tmpl_file} is missing")
        sys.exit(0)
    with open(tmpl_file, encoding="utf-8") as fh:
        tmpl = fh.read()
else:
    for f in GGUFReader(path).fields.values():
        if f.name == "tokenizer.chat_template":
            tmpl = f.contents()

if tmpl is None:
    print(f"  {name:<11} {configured:<11} {'—':<11} no chat template in the GGUF")
    sys.exit(0)

reads = [v for v in ("enable_thinking", "reasoning_effort", "reasoning_strength") if v in tmpl]
if "reasoning_effort" in reads or "reasoning_strength" in reads:
    seen = "effort"
elif "enable_thinking" in reads:
    seen = "toggle"
elif "<think>" in tmpl:
    # Think tags present but nothing to switch on them: hard-coded either way.
    seen = "locked-off"
else:
    seen = "none"

mark = "" if seen == configured else "   <-- differs"
print(f"  {name:<11} {configured:<11} {seen:<11} {', '.join(reads) or '—'}{source}{mark}")
PROBEPY
    done
    return 0
}

# Everything env sets, in one list, so clear removes exactly that.
_ENV_VARS=(CLAUDE_CONFIG_DIR ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
    ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL
    ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL API_TIMEOUT_MS
    PI_STREAM_FIRST_EVENT_TIMEOUT_MS PI_OPENAI_STREAM_IDLE_TIMEOUT_MS
    OPENAI_BASE_URL OPENAI_API_KEY CLAUDE_CODE_MAX_CONTEXT_TOKENS)

# A child process cannot change its caller's environment, so env and clear print
# shell code on stdout for the caller to eval, and talk to the user on stderr
# only — anything else on stdout would be executed. `llmctl shell-init` wraps
# that eval into a function.
_eval_hint() {
    [[ -t 1 ]] && echo "  (only printed — apply with: eval \"\$($PROG $*)\", or once: eval \"\$($PROG shell-init)\" in ~/.zshrc)" >&2
    return 0
}

cmd_env() {
    local name=""
    local slot="1"
    local want=""               # "" = auto (proxy if one is listening); proxy|direct = forced
    local args="env $*"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --proxy) want="proxy"; shift ;;
            --direct) want="direct"; shift ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) if [[ -z "$name" ]]; then name="$1"; elif [[ "$slot" == "1" ]]; then slot="$1"; fi; shift ;;
        esac
    done

    [[ -z "$name" ]] && { echo "Usage: eval \"\$($PROG env <model-name> [slot] [--proxy|--direct])\"" >&2; return 1; }
    _check_slot "$slot" || return 1

    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local port_server=$(( PORT_BASE_SERVER + slot ))

    # Since the proxy is opt-in (start --proxy), point at whichever endpoint is
    # actually up: the proxy when it listens, the server otherwise. --proxy /
    # --direct force the choice (e.g. to set env before starting the slot).
    _resolve_model "$name" || { echo "Unknown model: $name" >&2; cmd_list >&2; return 1; }

    if [[ "$_r_backend" == comfyui ]]; then
        echo "Error: '$name' is ComfyUI, not an LLM — there is nothing to point Claude Code at." >&2
        echo "       Its UI: http://127.0.0.1:$port_server" >&2
        return 1
    fi
    if [[ "$_r_backend" == tts ]]; then
        echo "Error: '$name' is a speech model, not an LLM — there is nothing to point Claude Code at." >&2
        echo "       Its API: POST http://127.0.0.1:$port_server/v1/audio/speech" >&2
        return 1
    fi
    if [[ "$_r_backend" == llama && "$_r_role" != chat ]]; then
        local api="/v1/embeddings"; [[ "$_r_role" == rerank ]] && api="/v1/rerank"
        local what="an embedding model"; [[ "$_r_role" == rerank ]] && what="a reranking model"
        echo "Error: '$name' is $what, not a chat model — there is nothing to point Claude Code at." >&2
        echo "       Its API: POST http://127.0.0.1:$port_server$api" >&2
        return 1
    fi

    local port_target="$port_server" via="server"
    # halogen speaks no Messages API; only its proxy does, and it always runs.
    if [[ "$_r_backend" == halogen ]]; then
        [[ "$want" == direct ]] && echo "Note: halogen is reached through its proxy only — it translates the Messages API." >&2
        want="proxy"
    fi
    case "$want" in
        proxy)  port_target="$port_proxy"; via="proxy" ;;
        direct) port_target="$port_server"; via="server" ;;
        *)      if ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
                    port_target="$port_proxy"; via="proxy"
                fi ;;
    esac

    # Absolute, so the Claude Code profile does not depend on the directory the
    # command happens to be run from.
    local config_dir="$DATA_DIR/claude/${_r_name}"
    [[ "$slot" -gt 1 ]] && config_dir+="-${slot}"
    mkdir -p "$config_dir"

    # A slot started with --public demands a token. Reuse the first one from the
    # token file so the local workflow stays a plain `llmctl env`; a server
    # started without --public ignores the header anyway.
    local token="sk-no-key-required" token_src="placeholder"
    if [[ -r "$TOKEN_FILE" ]]; then
        local first
        first=$(grep -m1 -vE '^[[:space:]]*(#|$)' "$TOKEN_FILE" 2>/dev/null)
        [[ -n "$first" ]] && { token="$first"; token_src="$TOKEN_FILE"; }
    fi

    local -A val=(
        [CLAUDE_CONFIG_DIR]="$config_dir"
        [ANTHROPIC_BASE_URL]="http://localhost:$port_target"
        [ANTHROPIC_AUTH_TOKEN]="$token"
        [ANTHROPIC_MODEL]="$_r_client"
        [ANTHROPIC_SMALL_FAST_MODEL]="$_r_client"
        [ANTHROPIC_DEFAULT_SONNET_MODEL]="$_r_client"
        [ANTHROPIC_DEFAULT_OPUS_MODEL]="$_r_client"
        [ANTHROPIC_DEFAULT_HAIKU_MODEL]="$_r_client"
        [API_TIMEOUT_MS]="3000000"
        [PI_STREAM_FIRST_EVENT_TIMEOUT_MS]="600000"
        [PI_OPENAI_STREAM_IDLE_TIMEOUT_MS]="600000"
        [OPENAI_BASE_URL]="http://localhost:$port_target/v1"
        [OPENAI_API_KEY]="$token"
        # Claude Code knows no window for a model name outside its catalog and
        # assumes 200K. halogen serves one request up to its full context — the
        # running slot's, else the model's — so auto-compact can use all of it.
        # (A llama-server slot divides its context by --parallel; left unset.)
        [CLAUDE_CODE_MAX_CONTEXT_TOKENS]=""
    )
    if [[ "$_r_backend" == halogen ]]; then
        local ctx_now="" spid=""
        if spid=$(_slot_server_pid "$slot") && _read_argv "$spid" && _is_halogen_argv; then
            ctx_now=$(_argv_env HALOGEN_CTX)
        fi
        val[CLAUDE_CODE_MAX_CONTEXT_TOKENS]="${ctx_now:-${_r_ctx:-$HALOGEN_NATIVE_CTX}}"
    fi
    local var
    for var in "${_ENV_VARS[@]}"; do
        if [[ -n "${val[$var]}" ]]; then
            printf 'export %s=%q\n' "$var" "${val[$var]}"
        else
            printf 'unset %s\n' "$var"
        fi
    done

    {
        echo "Claude Code env set for $_r_label ($_r_client) [slot $slot] via $via"
        echo "  CLAUDE_CONFIG_DIR=$config_dir"
        echo "  Token: $token_src"
        echo "  ANTHROPIC_BASE_URL=http://localhost:$port_target"
        echo "  OPENAI_BASE_URL=http://localhost:$port_target/v1"
        echo "  ANTHROPIC_MODEL=$_r_client"
        [[ -n "${val[CLAUDE_CODE_MAX_CONTEXT_TOKENS]}" ]] && echo "  CLAUDE_CODE_MAX_CONTEXT_TOKENS=${val[CLAUDE_CODE_MAX_CONTEXT_TOKENS]}"
    } >&2
    _eval_hint "$args"
}

cmd_clear() {
    echo "unset ${_ENV_VARS[*]}"
    echo "Environment cleared. '$PROG env <name> [slot]' sets up a model again." >&2
    _eval_hint clear
}

# Shell function for ~/.zshrc or ~/.bashrc: `eval "$(llmctl shell-init)"`.
# It lets `llmctl env …` / `llmctl clear` apply their output to the current
# shell directly; every other command is passed through unchanged.
cmd_shell_init() {
    cat <<'EOF'
llmctl() {
    case "${1:-}" in
        env|clear)
            local _llmctl_out
            _llmctl_out="$(command llmctl "$@")" || return
            eval "$_llmctl_out" ;;
        *)  command llmctl "$@" ;;
    esac
}
EOF
}

# Create the private CA and the two certificates the public path needs:
#   server.pem/.key       — presented by stunnel here; SAN must be the hostname
#                           the VPS connects to, or SSLProxyCheckPeerName fails
#   vps-client-combined.pem — copied to the VPS; without it stunnel's verifyPeer
#                           refuses the handshake, so scanners never get through
cmd_gen_certs() {
    local hostname="" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force=true; shift ;;
            -*) echo "Unknown option: $1"; return 1 ;;
            *) [[ -z "$hostname" ]] && hostname="$1"; shift ;;
        esac
    done
    [[ -z "$hostname" ]] && { echo "Usage: $PROG gen-certs <public-hostname> [--force]"; return 1; }
    _check_deps openssl || return 1

    if [[ -f "$TLS_DIR/ca.pem" && "$force" != true ]]; then
        echo "Error: $TLS_DIR/ca.pem already exists."
        echo "       Re-issuing invalidates the client cert already on the VPS. Pass --force if that's intended."
        return 1
    fi

    mkdir -p "$TLS_DIR"
    chmod 700 "$TLS_DIR"
    ( umask 077 && cd "$TLS_DIR" && \
      openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
          -keyout ca.key -out ca.pem -subj "/CN=llm-local-ca" 2>/dev/null && \
      openssl req -newkey rsa:4096 -nodes -keyout server.key -out server.csr \
          -subj "/CN=$hostname" 2>/dev/null && \
      openssl x509 -req -in server.csr -CA ca.pem -CAkey ca.key -CAcreateserial \
          -out server.pem -days 3650 -sha256 \
          -extfile <(printf 'subjectAltName=DNS:%s\nextendedKeyUsage=serverAuth\n' "$hostname") 2>/dev/null && \
      openssl req -newkey rsa:4096 -nodes -keyout vps-client.key -out vps-client.csr \
          -subj "/CN=vps" 2>/dev/null && \
      openssl x509 -req -in vps-client.csr -CA ca.pem -CAkey ca.key -CAcreateserial \
          -out vps-client.pem -days 3650 -sha256 \
          -extfile <(printf 'extendedKeyUsage=clientAuth\n') 2>/dev/null && \
      cat vps-client.pem vps-client.key > vps-client-combined.pem && \
      rm -f server.csr vps-client.csr ) || { echo "Error: certificate generation failed"; return 1; }

    echo "Certificates written to $TLS_DIR (valid 10 years, CN/SAN = $hostname)"
    echo ""
    echo "  Stays here:      ca.pem  server.pem  server.key"
    echo "  Copy to the VPS: vps-client-combined.pem   → SSLProxyMachineCertificateFile"
    echo "                   ca.pem                    → SSLProxyCACertificateFile"
    echo ""
    echo "  scp $TLS_DIR/vps-client-combined.pem $TLS_DIR/ca.pem <vps>:/etc/apache2/llm/"
    echo ""
    echo "  Note: the VPS must reach $hostname (DynDNS → your router), and"
    echo "        vps-client-combined.pem holds a private key — chmod 600 it there."
}

