#!/bin/bash
# llmctl — LLM server manager for Claude Code.
# Usage:
#   llmctl                                     list available models
#   llmctl start <name> [slot] [--proxy] [--compact] [--public] [--max-predict N] [--reasoning off|on|low|medium|high|max|N] [--no-reasoning] [--reasoning-budget N] [--parallel N] [--ctx N] [--cache-ram N] [--similarity F] [--temp F] [--top-p F] [--verbose] [--clear-logs] [--host ADDR] [--gpu-priority low|medium|high|realtime] [--mmproj] [--spec on|off] [--no-spec] [--output DIR]  start server (+ proxy with --proxy) in background (slot N, default 1)
#   llmctl preset <name> [--dry-run] [--force] [--wait N] [--proxy] [--public] [--host ADDR] [--clear-logs] [--verbose] [--gpu-priority L] [--output DIR]  bring the machine to a whole configuration from presets.conf: keep what already matches, stop the rest, start what is missing
#   llmctl preset-save <name> [--label TEXT] [--dry-run] [--force]  write the running configuration to presets.conf as a preset
#   llmctl presets                             list the defined presets
#   llmctl stop [slot]                         stop slot (or all if omitted)
#   llmctl status                              show running state, model and key parameters per slot
#   llmctl clear-kv [slot]                     drop the KV cache without restarting (all slots, or one); ComfyUI: unload its models
#   llmctl download <name|all> [PATTERN] [--from DIR]  fetch models; for ComfyUI set it up and fetch what its workflows name
#   llmctl update <comfyui-model> [--torch]    pull ComfyUI and its Python dependencies forward
#   llmctl voice list|add|design|rm            voices for speech (tts) slots
#   llmctl probe-reasoning [model]             show what each model's chat template supports
#   llmctl gen-certs <public-hostname>         create CA + certificates for --public
#   eval "$(llmctl env <name> [slot] [--proxy|--direct])"   export Claude Code env vars in this shell
#   eval "$(llmctl shell-init)"                (in ~/.zshrc) makes `llmctl env|clear` do that eval itself
#
# Ports:  slot N → server :800N  proxy :808N   (slot 1 → :8001 / :8081, and so on)
#         Slots are not a fixed set — any N the ports have room for works.

PROG=llmctl
LLMCTL_VERSION=1.6.0

# ── Where things live ───────────────────────────────────────
# The program itself (this file, proxy.py, templates, example configs) is
# read-only and may be installed system-wide; everything a user owns or the
# servers produce follows XDG in the home directory.
#
# A checkout is recognised by proxy.py sitting next to this file — also when
# /usr/local/bin/llmctl is only a symlink into it (make install-link) — otherwise
# the installed layout <prefix>/{bin,lib/llmctl,share/llmctl} applies.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
_bin_dir="$(dirname "$_self")"
if [[ -f "$_bin_dir/proxy.py" ]]; then
    LIB_DIR="$_bin_dir"
    SHARE_DIR="$_bin_dir"
else
    LIB_DIR="$(cd "$_bin_dir/../lib/llmctl" 2>/dev/null && pwd)"
    SHARE_DIR="$(cd "$_bin_dir/../share/llmctl" 2>/dev/null && pwd)"
fi
unset _self _bin_dir

CONFIG_DIR="${LLMCTL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/llmctl}"
DATA_DIR="${LLMCTL_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/llmctl}"
STATE_DIR="${LLMCTL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/llmctl}"
# Default for models.conf's paths; models.conf may also set MODELS_DIR itself.
MODELS_DIR="${LLMCTL_MODELS_DIR:-$DATA_DIR/models}"

PROXY_SCRIPT="$LIB_DIR/proxy.py"
HALOGEN_BENCH_SCRIPT="$LIB_DIR/halogen_bench.py"
# A slot is nothing but a number: every port derives from it, so there is no
# list of slots anywhere and no fixed count. What does bound them is the port
# layout — the gap between two bases is how many slots fit between them, which
# is why SLOT_MAX below is computed rather than written down. Override a base to
# move that bound.
PORT_BASE_SERVER="${LLMCTL_PORT_BASE_SERVER:-8000}"  # slot N → port 8000+N
PORT_BASE_PROXY="${LLMCTL_PORT_BASE_PROXY:-8080}"    # slot N → port 8080+N
# Not $XDG_RUNTIME_DIR: that is removed at the last logout, while the detached
# servers keep running — stop/status would lose track of them.
PID_DIR="$STATE_DIR/pids"
LOG_DIR="$STATE_DIR/logs"
# --slot-save-path is what enables POST /slots/{id}?action=erase, the only way
# to drop a slot's KV cache without restarting the server (see clear-kv). The
# same flag also enables the save/restore actions, which write into this dir.
SLOT_STATE_DIR="$STATE_DIR/slots"

# ── Public exposure (--public) ───────────────────────────────
# Internet traffic never reaches llama-server or the proxy directly: stunnel
# terminates a mutually authenticated TLS connection from the VPS and forwards
# to 127.0.0.1. That keeps --public fully independent of --host, which stays
# what it always was — plain LAN exposure.
PORT_BASE_TLS_SERVER="${LLMCTL_PORT_BASE_TLS_SERVER:-8440}"  # slot N → port 8440+N  (TLS front for the server)
PORT_BASE_TLS_PROXY="${LLMCTL_PORT_BASE_TLS_PROXY:-8450}"    # slot N → port 8450+N  (TLS front for the proxy)
LLM_CONF_DIR="${LLM_CONF_DIR:-$CONFIG_DIR}"
TOKEN_FILE="${LLM_TOKEN_FILE:-$LLM_CONF_DIR/tokens}"
TLS_DIR="$LLM_CONF_DIR/tls"
STUNNEL_DIR="$STATE_DIR/stunnel"
PUBLIC_MAX_PREDICT_DEFAULT=8192   # --public caps generation length unless --max-predict says otherwise
# llama-server's --timeout, and so also how long its proxy waits for it: the
# proxy's own default of 300 s would cut off a prefill the server still allows.
LLAMA_SERVER_TIMEOUT=600

# ── How many slots ──────────────────────────────────────────
# As many as the ports allow. Server and proxy ports interleave from their two
# bases, so the smaller base's range ends where the larger one begins; the same
# holds for the two TLS fronts, which sit closer together and therefore bound
# --public more tightly. Both numbers follow the bases, so raising a base raises
# the limit with it.
SLOT_MAX=$(( PORT_BASE_PROXY - PORT_BASE_SERVER - 1 ))
SLOT_MAX_PUBLIC=$(( PORT_BASE_TLS_PROXY - PORT_BASE_TLS_SERVER - 1 ))

# Every command that takes a slot number goes through here. Errors go to stderr,
# because `env` is read by eval and must not have them land in the shell.
_check_slot() {
    local slot="$1"
    if [[ ! "$slot" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: slot must be a positive number (got '$slot')" >&2; return 1
    fi
    if (( slot > SLOT_MAX )); then
        echo "Error: slot $slot is past the port layout: server :$(( PORT_BASE_SERVER + 1 ))+ and proxy :$(( PORT_BASE_PROXY + 1 ))+ leave room for slots 1-$SLOT_MAX." >&2
        echo "       Set LLMCTL_PORT_BASE_PROXY higher to make room for more." >&2
        return 1
    fi
    return 0
}

# ── Load model definitions ──────────────────────────────────
# Only help and shell-init get by without one; everything else names models.
_MODELS=()
if [[ -f "$CONFIG_DIR/models.conf" ]]; then
    source "$CONFIG_DIR/models.conf"
elif [[ "${1:-}" != help && "${1:-}" != shell-init ]]; then
    echo "Error: no model definitions at $CONFIG_DIR/models.conf" >&2
    echo "  Start from the examples — copy them to edit freely:" >&2
    echo "    mkdir -p $CONFIG_DIR && cp $SHARE_DIR/examples/*.conf $CONFIG_DIR/" >&2
    echo "  or link them to a checkout, so changes stay under version control:" >&2
    echo "    mkdir -p $CONFIG_DIR && ln -s <checkout>/examples/{models,presets}.conf $CONFIG_DIR/" >&2
    exit 1
fi

# ── Load preset definitions ─────────────────────────────────
# A preset names a whole configuration: which models run, on which slots, with
# which start flags. models.conf has to be loaded first — a preset only ever
# refers to models defined there.
# Guarded, unlike models.conf: without presets there is nothing to start a preset
# from, but every other command still works.
_PRESETS=()
[[ -f "$CONFIG_DIR/presets.conf" ]] && source "$CONFIG_DIR/presets.conf"

# Parse a model entry by name; sets _r_* variables.
_resolve_model() {
    local name="$1"
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name m_binary m_model m_mmproj m_alias m_label m_args m_client m_rocm_env m_hf_repo m_hf_includes m_hf_dir m_no_reasoning_args m_ctx m_reasoning m_reasoning_levels m_spec_args m_hf_draft m_hf_mmproj m_backend <<< "$entry"
        if [[ "$m_name" == "$name" ]]; then
            _r_name="$m_name"
            _r_binary="$m_binary"
            _r_model="$m_model"
            _r_mmproj="$m_mmproj"
            _r_alias="$m_alias"
            _r_label="$m_label"
            # models.conf writes these as one string; splitting it into words is the point.
            # shellcheck disable=SC2206
            _r_args=($m_args)
            # What a llama-server entry serves, told by its flags: chat unless it
            # pools (embeddings) or scores pairs (rerank).
            case " $m_args " in
                *" --reranking "*|*" --rerank "*) _r_role=rerank ;;
                *" --embedding "*|*" --embeddings "*) _r_role=embedding ;;
                *) _r_role=chat ;;
            esac
            _r_client="${m_client:-$m_name}"
            _r_rocm_env="${m_rocm_env:-}"
            _r_hf_repo="${m_hf_repo:-}"
            _r_hf_includes="${m_hf_includes:-}"
            _r_hf_dir="${m_hf_dir:-}"
            # shellcheck disable=SC2206
            _r_no_reasoning_args=($m_no_reasoning_args)
            _r_ctx="${m_ctx:-}"
            _r_reasoning="${m_reasoning:-unknown}"
            _r_reasoning_levels="${m_reasoning_levels:-}"
            # shellcheck disable=SC2206
            _r_spec_args=($m_spec_args)
            _r_hf_draft="${m_hf_draft:-}"
            _r_hf_mmproj="${m_hf_mmproj:-}"
            _r_backend="${m_backend:-llama}"
            return 0
        fi
    done
    return 1
}

# Parse a preset entry by name; sets _p_name, _p_label and the _p_entries array
# (one "<model> <slot> [flags...]" line per model).
_resolve_preset() {
    local name="$1" entry
    local -a f
    for entry in "${_PRESETS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        if [[ "${f[0]}" == "$name" ]]; then
            _p_name="${f[0]}"
            _p_label="${f[1]}"
            _p_entries=("${f[@]:2}")
            return 0
        fi
    done
    return 1
}

# Start a long-lived process in its own session, so it survives the shell that
# started it: no controlling terminal means no SIGHUP when that terminal closes.
# Prints the PID and leaves it in $pidfile.
#
# The child writes its own PID immediately before exec rather than the caller
# taking $!. With job control on, setsid finds itself a process group leader and
# forks instead of exec-ing, so $! would name the wrapper — and stop/status,
# which read the PID file, would then be pointing at a process that is already
# gone. Any KEY=VAL environment has to be passed via `env`, since shell-level
# assignments would not survive being handed on as arguments.
_spawn_detached() {
    local pidfile="$1" logfile="$2" mode="$3"; shift 3
    rm -f "$pidfile"
    if [[ "$mode" == append ]]; then
        setsid bash -c 'echo $$ > "$1"; shift; exec "$@"' _ "$pidfile" "$@" \
            >> "$logfile" 2>&1 < /dev/null &
    else
        setsid bash -c 'echo $$ > "$1"; shift; exec "$@"' _ "$pidfile" "$@" \
            > "$logfile" 2>&1 < /dev/null &
    fi
    local i
    for i in $(seq 1 50); do
        [[ -s "$pidfile" ]] && { cat "$pidfile"; return 0; }
        sleep 0.1
    done
    return 1
}

# Guard for value-taking options: bash's `shift 2` quietly fails when only the
# flag itself is left, and the option loop would then spin forever. Call as
# `_need_value "$@"` so $1 is the flag and $2 its value.
_need_value() {
    if [[ $# -lt 2 ]]; then
        echo "Error: $1 requires a value"
        return 1
    fi
}

# Check that required commands exist; prints error and returns 1 if any are missing.
_check_deps() {
    local missing=() c
    for c in "$@"; do
        command -v "$c" > /dev/null 2>&1 || missing+=("$c")
    done
    if (( ${#missing[@]} > 0 )); then
        echo "Error: missing dependencies: ${missing[*]}"
        return 1
    fi
}

# ── halogen backend ─────────────────────────────────────────
#
# models.conf entries with _model_backend="halogen" run halogen-flash-server, a
# closed-source engine for Qwen3.8-Flash-Next on Strix Halo, shipped as a
# container. It fills the slot model like llama-server does — server :800N,
# proxy :808N, one PID file per process — with these differences:
#
#   - The server is `podman run` in the foreground under _spawn_detached, so the
#     PID file names the podman client, its argv is the full start command (what
#     preset and preset-save compare against), and the container's output is the
#     server log. The container is named llmctl-halogen-<slot>.
#   - It holds most of the machine: ~68 GiB of weights pinned, ~30 GiB of KV pool
#     and working memory. So it runs exclusively — it will not start beside any
#     other slot, and no other slot starts beside it.
#   - It speaks OpenAI Chat Completions and Responses, not Anthropic Messages, so
#     its proxy is not optional: it translates /v1/messages for Claude Code.
#   - Settings are environment variables of the container: models.conf's
#     extra_args hold KEY=VAL pairs, and start options map onto them.
HALOGEN_NATIVE_CTX=262144        # Qwen3.8-Flash-Next's trained context; more takes YaRN
HALOGEN_API_PORT=8731            # the API port inside the container
HALOGEN_CONTAINER_PREFIX="llmctl-halogen-"
HALOGEN_MAX_TOKENS_CAP=65536     # the server's own cap on a request's token budget
HALOGEN_PROXY_TIMEOUT=3600       # a full 256K prefill alone takes ~4 minutes
# Besides the weights, which it takes over from the file cache, the server
# reserves ~30 GiB in 2 MiB pieces. With less than this free in such pieces the
# kernel compacts memory on the fly, which stalls startup and later prefills for
# minutes (see --compact).
HALOGEN_MIN_CONTIG_GIB=40

_halogen_container() { echo "${HALOGEN_CONTAINER_PREFIX}$1"; }

# Slots with a halogen container, running or not, ascending.
_halogen_slots() {
    command -v podman > /dev/null || return 0
    podman ps -a --format '{{.Names}}' 2>/dev/null |
        sed -n "s/^${HALOGEN_CONTAINER_PREFIX}\([1-9][0-9]*\)\$/\1/p" | sort -un
}

_slot_is_halogen() {
    command -v podman > /dev/null && podman container exists "$(_halogen_container "$1")" 2>/dev/null
}

# A halogen container that outlived its `podman run` client — the client is what
# llmctl tracks, and killing it (a terminal that goes down with the command still
# in the foreground) leaves the container running, holding the weights and the
# port, while every PID-based check sees an empty slot.
_halogen_orphan() {
    _slot_is_halogen "$1" || return 1
    [[ "$(podman inspect -f '{{.State.Running}}' "$(_halogen_container "$1")" 2>/dev/null)" == "true" ]] || return 1
    # Whatever still holds the port then is podman's own plumbing, not the client:
    # its argv is not the run command, so status would describe an empty slot.
    local pid
    pid=$(_slot_server_pid "$1") || return 0
    _read_argv "$pid" && _is_halogen_argv && return 1
    return 0
}

# The value of `-e KEY=VAL` in a halogen server's argv ($_ARGV), or nothing.
_argv_env() {
    local key="$1" i
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "-e" && "${_ARGV[i+1]}" == "$key="* ]] && { echo "${_ARGV[i+1]#*=}"; return 0; }
    done
    return 1
}

# The host model path a halogen server's argv carries in its llmctl.model label.
_argv_halogen_model() {
    local i
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "--label" && "${_ARGV[i+1]}" == llmctl.model=* ]] && { echo "${_ARGV[i+1]#*=}"; return 0; }
    done
    return 1
}

_is_halogen_argv() {
    [[ "${#_ARGV[@]}" -gt 0 && "$(basename "${_ARGV[0]}")" == podman && " ${_ARGV[*]} " == *" --name ${HALOGEN_CONTAINER_PREFIX}"* ]]
}

# Free host memory in blocks of 2 MiB or larger (buddy orders 9 and 10), in GiB.
_contig_gib() {
    awk '/zone +(DMA32|Normal)/ { mib += $14 * 2 + $15 * 4 } END { printf "%d", mib / 1024 }' /proc/buddyinfo
}

# --compact: have the kernel defragment free memory now, rather than on the fly
# while a server reserves it.
_compact_memory() {
    echo "Defragmenting host memory (needs sudo) ..."
    echo "  free in 2 MiB blocks before: $(_contig_gib) GiB"
    sudo sh -c 'sync; echo 1 > /proc/sys/vm/compact_memory' || return 1
    echo "  free in 2 MiB blocks after:  $(_contig_gib) GiB"
}

# The token cap a halogen slot runs with — what its proxy clamps budgets to.
_halogen_cap_of_slot() {
    local pid="" cap=""
    if pid=$(_slot_server_pid "$1") && _read_argv "$pid"; then
        cap=$(_argv_env HALOGEN_MAX_TOKENS_CAP)
    fi
    echo "${cap:-$HALOGEN_MAX_TOKENS_CAP}"
}

# ── comfyui backend ─────────────────────────────────────────
#
# models.conf entries with _model_backend="comfyui" run ComfyUI, the node-based
# image generator. It is no LLM, but it draws on the same GPU memory — 15 GB for
# FLUX.2 klein, ~105 GB for FLUX.2 dev — so it takes a slot like any server, and
# start/stop/status/preset see it. What differs:
#
#   - binary is the ComfyUI checkout (with its .venv beside main.py), model the
#     directory the image models live in (--models-directory). Everything else it
#     writes — user settings and workflows, input, output, temp — goes to the
#     checkout's parent via --base-directory. That flag is also what marks the
#     process as ours, the way --slot-save-path marks a llama-server.
#   - ComfyUI loads models per workflow and keeps them until something else needs
#     the room. It cannot see an LLM coming, so starting a llama model first asks
#     every running ComfyUI to unload (POST /free).
#   - halogen runs exclusively, and ComfyUI is no exception.
#   - It serves its own web UI on the slot's server port; there is no proxy and no
#     Claude Code environment.
#
# `download` sets it up (checkout, venv with ROCm torch, patches, workflows and the
# models those workflows name), `update` keeps it current; see further below.
COMFYUI_GIT="https://github.com/Comfy-Org/ComfyUI.git"
COMFYUI_TORCH_INDEX="https://download.pytorch.org/whl/rocm7.2"
COMFYUI_MODELS_SCRIPT="$LIB_DIR/comfyui_models.py"
COMFYUI_SHARE="$SHARE_DIR/comfyui"      # bundled workflows/ and patches/
IMAGES_SERVER_SCRIPT="$LIB_DIR/images_server.py"   # OpenAI image API, a comfyui slot's --proxy
# Not /tmp: that is a small tmpfs here, and pip unpacks multi-GB torch wheels.
COMFYUI_TMP="${XDG_CACHE_HOME:-$HOME/.cache}/llmctl/comfyui-tmp"

_is_comfyui_argv() {
    [[ "${#_ARGV[@]}" -gt 1 && "${_ARGV[1]}" == */main.py && " ${_ARGV[*]} " == *" --base-directory "* ]]
}

# The value following flag $1 in $_ARGV, or nothing.
_argv_flag() {
    local key="$1" i
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "$key" ]] && { echo "${_ARGV[i+1]}"; return 0; }
    done
    return 1
}

_slot_is_comfyui() {
    local pid
    pid=$(_slot_server_pid "$1") && _read_argv "$pid" && _is_comfyui_argv
}

# Slots running ComfyUI, ascending.
_comfyui_slots() {
    local s
    for s in $(_active_slots); do _slot_is_comfyui "$s" && echo "$s"; done
}

# GPU memory a process holds, in MiB: GTT plus VRAM from its DRM fdinfo, counted
# once per DRM client (several fds can share one). This is what the process
# itself has — unlike the sysfs total, which sums every program on the GPU.
_proc_gpu_mib() {
    local pid="$1"
    cat /proc/"$pid"/fdinfo/* 2>/dev/null | awk '
        /^drm-client-id:/  { id = $2 }
        /^drm-memory-gtt:/ { gtt[id] = $2 }
        /^drm-memory-vram:/ { vram[id] = $2 }
        END { for (c in gtt) kib += gtt[c]; for (c in vram) kib += vram[c]; printf "%d", kib / 1024 }'
}

_proc_rss_mib() {
    awk '/^VmRSS:/ { printf "%d", $2 / 1024 }' /proc/"$1"/status 2>/dev/null
}

# "1 running, 2 pending" from ComfyUI's /queue, or nothing when it does not answer.
_comfyui_queue() {
    curl -sf -m 3 "http://127.0.0.1:$1/queue" | python3 -c '
import json, sys
q = json.load(sys.stdin)
running, pending = len(q.get("queue_running", [])), len(q.get("queue_pending", []))
print(f"{running} running, {pending} pending")
' 2>/dev/null
}

# Ask the ComfyUI on slot $1 to drop its models and caches, and wait until the
# memory has actually gone. A job in progress is left alone: /free would only
# take effect once it ends, and the models it needs would be reloaded anyway.
_comfyui_unload_slot() {
    local slot="$1" port=$(( PORT_BASE_SERVER + $1 )) pid q
    pid=$(_slot_server_pid "$slot") || return 0
    q=$(_comfyui_queue "$port")
    if [[ -z "$q" ]]; then
        echo "Slot $slot: ComfyUI does not answer on :$port — cannot unload its models."
        return 0
    fi
    if [[ "$q" != "0 running, 0 pending" ]]; then
        echo "Slot $slot: ComfyUI is busy ($q) — its models stay loaded until the queue is done."
        return 0
    fi
    local gpu0 rss0 gpu rss prev="" i
    gpu0=$(_proc_gpu_mib "$pid"); rss0=$(_proc_rss_mib "$pid")
    curl -sf -m 5 -X POST "http://127.0.0.1:$port/free" -H 'Content-Type: application/json' \
        -d '{"unload_models": true, "free_memory": true}' > /dev/null || {
        echo "Slot $slot: ComfyUI refused /free."; return 0; }
    # The worker picks the flag up between jobs, within a second or so; wait until
    # two readings in a row agree.
    for (( i=0; i < 30; i++ )); do
        sleep 0.5
        gpu=$(_proc_gpu_mib "$pid"); rss=$(_proc_rss_mib "$pid")
        (( i >= 2 )) && [[ "$gpu $rss" == "$prev" ]] && break
        prev="$gpu $rss"
    done
    awk -v g0="$gpu0" -v g="$gpu" -v r0="$rss0" -v r="$rss" -v s="$slot" 'BEGIN {
        printf "Slot %s: ComfyUI models unloaded — GPU %.1f → %.1f GiB, RAM %.1f → %.1f GiB\n",
               s, g0 / 1024, g / 1024, r0 / 1024, r / 1024 }'
}

_comfyui_unload() {
    local s
    for s in $(_comfyui_slots); do _comfyui_unload_slot "$s"; done
}

# ── tts backend ─────────────────────────────────────────────
#
# models.conf entries with _model_backend="tts" speak: Qwen3-TTS through
# llama.cpp's llama-tts, behind tts_server.py, which answers the OpenAI speech
# API (POST /v1/audio/speech) on the slot's server port. llama-server has no
# speech endpoint yet, so the server runs llama-tts once per request; the model
# is on the GPU only while it speaks (~4 GB), which is why this slot never needs
# unloading and runs beside anything.
#
# A voice is a short reference recording: Qwen3-TTS Base speaks in its voice,
# and in accent-free German, which its English and Chinese preset speakers do
# not manage. `llmctl voice design` makes such a recording from a description
# (Qwen3-TTS VoiceDesign, PyTorch, in its own venv); `llmctl voice add` takes one
# of your own.
#
#   binary       llama-tts (the llama.cpp build that has Qwen3-TTS, Aug 2026+)
#   model        the Base GGUF;  mmproj  its mmproj GGUF
#   client_name  the model id /v1/models reports
#   extra_args   further llama-tts flags (e.g. -ngl 99)
TTS_SERVER_SCRIPT="$LIB_DIR/tts_server.py"
TTS_DESIGN_SCRIPT="$LIB_DIR/tts_voice_design.py"
TTS_DIR="$DATA_DIR/tts"                     # venv/ for designing, voices/
TTS_VOICES="$TTS_DIR/voices"
TTS_SHARE="$SHARE_DIR/tts"                  # bundled starter voices
TTS_DESIGN_REPO="Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign"
TTS_DESIGN_DIR="$MODELS_DIR/qwen3-tts/Qwen3-TTS-12Hz-1.7B-VoiceDesign"
TTS_DEFAULT_LANG="de"

_is_tts_argv() { [[ " ${_ARGV[*]} " == *" $TTS_SERVER_SCRIPT "* ]]; }

_slot_is_tts() {
    local pid
    pid=$(_slot_server_pid "$1") && _read_argv "$pid" && _is_tts_argv
}

_start_tts() {
    local -a refused=()
    [[ -n "$reasoning" ]] && refused+=("--reasoning")
    [[ -n "$ctx" ]] && refused+=("--ctx")
    [[ -n "$parallel" ]] && refused+=("--parallel")
    [[ -n "$cache_ram" ]] && refused+=("--cache-ram")
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$spec" ]] && refused+=("--spec")
    [[ "$use_mmproj" == true ]] && refused+=("--mmproj")
    [[ -n "$temp" ]] && refused+=("--temp")
    [[ -n "$top_p" ]] && refused+=("--top-p")
    [[ -n "$max_predict" ]] && refused+=("--max-predict")
    [[ "$start_proxy" == true ]] && refused+=("--proxy")
    [[ "$public" == true ]] && refused+=("--public")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    [[ "$compact" == true ]] && refused+=("--compact")
    [[ "$verbose" == true ]] && refused+=("--verbose")
    [[ -n "$output_dir" ]] && refused+=("--output")
    if (( ${#refused[@]} )); then
        echo "Error: '$name' is a speech model — these options have no meaning for it: ${refused[*]}"
        exit 1
    fi
    local l="${lang:-$TTS_DEFAULT_LANG}"
    if [[ ! " zh en de it pt es ja ko fr ru " == *" $l "* ]]; then
        echo "Error: --lang takes zh, en, de, it, pt, es, ja, ko, fr or ru (got '$l')"; exit 1
    fi

    local model="${_r_model//\~/$HOME}" mm="${_r_mmproj//\~/$HOME}"
    # The streaming llama-server is a separate build (patches/build-tts-server.sh);
    # without it, llama-tts does the same job slower.
    if [[ "$(basename "$_r_binary")" == llama-server* && ! -x "${_r_binary//\~/$HOME}" ]]; then
        [[ "$print_cmd" == true ]] || echo "Note: $_r_binary is not built — using llama-tts (no streaming). Build it: $SHARE_DIR/patches/build-tts-server.sh"
        _r_binary="llama-tts"
    fi
    # The interpreter's own path, as Python rewrites argv[0] to it — and preset
    # compares this command against the running process's argv. Asked of Python
    # itself, since `command -v` may name a pyenv shim instead.
    local py; py=$(python3 -c 'import sys; print(sys.executable)' 2>/dev/null) || py=python3
    local -a cmd=("$py" "$TTS_SERVER_SCRIPT" --host "${host:-127.0.0.1}" --port "$port_server"
        --model "$model" --mmproj "$mm" --voices "$TTS_VOICES" --binary "$_r_binary"
        --lang "$l" --alias "$_r_client")
    [[ -n "$seed" ]] && cmd+=(--seed "$seed")
    (( ${#_r_args[@]} )) && cmd+=(-- "${_r_args[@]}")

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    _check_deps python3 "$_r_binary" || exit 1
    local f
    for f in "$model" "$mm"; do
        [[ -f "$f" ]] || { echo "Error: $f is missing — run: $PROG download $_r_name"; exit 1; }
    done
    local n_voices
    n_voices=$(find "$TTS_VOICES" -maxdepth 1 \( -name '*.wav' -o -name '*.mp3' -o -name '*.flac' \) 2>/dev/null | wc -l)
    (( n_voices > 0 )) || echo "Note: no voices in $TTS_VOICES yet — $PROG download $_r_name brings two, $PROG voice adds more."

    local url="http://${host:-127.0.0.1}:$port_server"
    local config_text
    config_text="$(
        echo "Model:    $_r_label ($_r_client)"
        if [[ "$(basename "$_r_binary")" == llama-server* ]]; then
            echo "Backend:  tts — $_r_binary (model resident, streaming) behind tts_server.py"
        else
            echo "Backend:  tts — $_r_binary behind tts_server.py, one run per request"
        fi
        echo "Weights:  $model"
        echo "          $mm"
        echo "Voices:   $TTS_VOICES ($n_voices)"
        echo "Language: $l (a request may name another)"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        echo "API:      POST $url/v1/audio/speech  {\"input\": \"…\", \"voice\": \"<name>\"}"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${cmd[*]}"
        echo "----------------------------"
    )"
    echo "$config_text"
    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting speech server [slot $slot] on port $port_server..."
    local server_pid=""
    server_pid=$(_spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: the speech server did not report a PID. See $server_log" >&2
        exit 1
    fi
    echo "Server running (PID: $server_pid, detached)"
    echo ""
    echo "  Try:   curl -s $url/v1/audio/speech -H 'Content-Type: application/json' \\"
    echo "           -d '{\"input\": \"Hallo!\", \"voice\": \"frau\"}' -o hallo.wav"
    echo "  Logs:  tail -f $server_log"
    echo "  Stop:  $PROG stop $slot"
}

# status for a speech slot.
_describe_tts() {
    local indent="$1" model host port lang label names
    model=$(_argv_flag --model) || model=""
    host=$(_argv_flag --host) || host="127.0.0.1"
    port=$(_argv_flag --port) || port="?"
    lang=$(_argv_flag --lang) || lang="$TTS_DEFAULT_LANG"
    label=$(_label_for_model_path "$model") || label="$(basename "$model")"
    names=$(curl -sf -m 3 "http://127.0.0.1:$port/v1/audio/voices" | python3 -c 'import json,sys; print(", ".join(json.load(sys.stdin)["voices"]))' 2>/dev/null)
    echo "${indent}Model:     $label"
    echo "${indent}API:       http://$host:$port/v1/audio/speech  (language $lang)"
    echo "${indent}Voices:    ${names:-no answer (still starting?)}"
    local bin; bin=$(_argv_flag --binary) || bin=""
    if [[ "$(basename "$bin")" == llama-server* ]]; then
        awk -v g="$(_slot_gpu_mib "$slot" 2>/dev/null || echo 0)" -v i="$indent" 'BEGIN {
            printf "%sEngine:    llama-server, model resident (%.1f GiB), streaming\n", i, g / 1024 }'
    else
        echo "${indent}Engine:    llama-tts, loaded per request"
    fi
}

# preset-save for a speech slot: the entry by its model file, plus --host and --lang.
_capture_tts_slot() {
    local slot="$1" model host lang name
    model=$(_argv_flag --model) || { echo "slot $slot: the speech server carries no --model" >&2; return 1; }
    local -a candidates=()
    mapfile -t candidates < <(_names_for_model_path "$model")
    (( ${#candidates[@]} )) || { echo "slot $slot: $(basename "$model") is not in models.conf" >&2; return 1; }
    host=$(_argv_flag --host) || host=""
    [[ "$host" == "127.0.0.1" ]] && host=""
    lang=$(_argv_flag --lang) || lang=""
    [[ "$lang" == "$TTS_DEFAULT_LANG" ]] && lang=""
    local seed; seed=$(_argv_flag --seed) || seed=""
    local -a flags=()
    [[ -n "$host" ]] && flags+=(--host "$host")
    [[ -n "$lang" ]] && flags+=(--lang "$lang")
    [[ -n "$seed" ]] && flags+=(--seed "$seed")
    for name in "${candidates[@]}"; do
        _resolve_model "$name" || continue
        local built=""
        built=$( cmd_start "$name" "$slot" "${flags[@]}" --print-cmd 2>/dev/null ) || continue
        if [[ "$built" == "${_ARGV[*]}" ]]; then
            _cap_entry="$name $slot${flags[*]:+ ${flags[*]}}"
            _cap_label="$_r_label"
            return 0
        fi
        _cap_diff_name="$name"; _cap_diff_built="$built"
    done
    echo "slot $slot: cannot express the running speech server as start options." >&2
    [[ -n "${_cap_diff_built:-}" ]] && printf '  closest: %s\n  running: %s\n' "$_cap_diff_built" "${_ARGV[*]}" >&2
    return 1
}

# Links that make ComfyUI and llmctl share what they both use:
#   <base>/models        → the models directory. Custom node packs (Qwen3-TTS)
#                          look for and download their models there, not under
#                          --models-directory.
#   <base>/input/voice-* → the speech voices, one hard link per voice file:
#                          LoadAudio lists only the input directory's own files
#                          and refuses a symlink that resolves outside it.
_comfyui_links() {
    local base="$1" models="$2"
    [[ -e "$base/models" || -L "$base/models" ]] || ln -s "$models" "$base/models"
    _comfyui_voice_links "$base"
}

_comfyui_voice_links() {
    local input="$1/input" f n
    [[ -d "$1" ]] || return 0
    mkdir -p "$input"
    # voice-<file> belongs to the voice <file>: replaced whenever that voice
    # exists — a voice rewritten in place gets a new inode, which leaves the old
    # link behind with the old sound. Symlinks are from an earlier layout.
    for f in "$input"/voice-*; do
        [[ -e "$f" || -L "$f" ]] || continue
        n="${f##*/voice-}"
        if [[ -L "$f" || -e "$TTS_VOICES/$n" ]]; then rm -f "$f"; fi
    done
    for f in "$TTS_VOICES"/*.wav "$TTS_VOICES"/*.mp3 "$TTS_VOICES"/*.flac; do
        [[ -f "$f" ]] || continue
        ln "$f" "$input/voice-${f##*/}" 2>/dev/null || cp "$f" "$input/voice-${f##*/}"
    done
}

# The same, for whichever comfyui entry is set up — after `voice` changed a voice.
_comfyui_voice_links_all() {
    local entry m_name
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name _ <<< "$entry"
        _resolve_model "$m_name" && [[ "$_r_backend" == comfyui ]] || continue
        _comfyui_voice_links "$(dirname "${_r_binary//\~/$HOME}")"
    done
}

_start_comfyui() {
    local -a refused=()
    [[ -n "$reasoning" ]] && refused+=("--reasoning")
    [[ -n "$ctx" ]] && refused+=("--ctx")
    [[ -n "$parallel" ]] && refused+=("--parallel")
    [[ -n "$cache_ram" ]] && refused+=("--cache-ram")
    [[ -n "$similarity" ]] && refused+=("--similarity")
    [[ -n "$spec" ]] && refused+=("--spec")
    [[ "$use_mmproj" == true ]] && refused+=("--mmproj")
    [[ -n "$temp" ]] && refused+=("--temp")
    [[ -n "$top_p" ]] && refused+=("--top-p")
    [[ -n "$max_predict" ]] && refused+=("--max-predict")
    [[ "$public" == true ]] && refused+=("--public")
    [[ -n "$gpu_priority" ]] && refused+=("--gpu-priority")
    [[ "$compact" == true ]] && refused+=("--compact")
    if (( ${#refused[@]} )); then
        echo "Error: '$name' is ComfyUI, not an LLM — these options have no meaning for it: ${refused[*]}"
        exit 1
    fi

    local app="${_r_binary//\~/$HOME}"
    local models="${_r_model//\~/$HOME}"
    local base; base="$(dirname "$app")"
    local -a cmd=("$app/.venv/bin/python" "$app/main.py"
        --listen "${host:-127.0.0.1}" --port "$port_server"
        --base-directory "$base" --models-directory "$models"
        "${_r_args[@]}")
    # Absolute, since ComfyUI runs from its checkout; a preset entry's "~" is
    # not expanded by any shell on the way here.
    local out=""
    if [[ -n "$output_dir" ]]; then
        out="$(realpath -m "${output_dir/#\~/$HOME}")"
        cmd+=(--output-directory "$out")
    fi
    [[ "$verbose" == true ]] && cmd+=(--verbose DEBUG)

    if [[ "$print_cmd" == true ]]; then
        printf '%s\n' "${cmd[*]}"
        return 0
    fi

    local hs
    hs=$(_halogen_slots | head -1)
    if [[ -n "$hs" ]]; then
        echo "Error: a halogen server runs on slot $hs, and halogen runs exclusively — it holds"
        echo "       most of this machine's memory. Stop it first: $PROG stop $hs"
        exit 1
    fi
    if [[ ! -x "$app/.venv/bin/python" || ! -f "$app/main.py" ]]; then
        echo "Error: ComfyUI is not set up at $app — run: $PROG download $_r_name"
        exit 1
    fi
    # --models-directory insists on an existing directory, and ComfyUI lists
    # custom_nodes/ under --base-directory without creating it.
    mkdir -p "$models" "$base/custom_nodes" "$COMFYUI_TMP" ${out:+"$out"}
    _comfyui_links "$base" "$models"

    local url="http://${host:-127.0.0.1}:$port_server"
    [[ "$host" == "0.0.0.0" ]] && url="http://$(hostname):$port_server"
    local config_text
    config_text="$(
        echo "Model:    $_r_label"
        echo "Backend:  ComfyUI — $app"
        echo "Models:   $models"
        echo "Data:     $base/{user,input,temp}"
        echo "Output:   ${out:-$base/output (default; --output DIR elsewhere)}"
        echo "Host:     ${host:-127.0.0.1 (default)}"
        [[ -n "$host" && "$host" != "127.0.0.1" && "$host" != "localhost" ]] && \
            echo "  WARNING: ComfyUI has no authentication — anyone who reaches $host:$port_server can run workflows."
        echo "UI:       $url"
        echo "----- effective config -----"
        echo "Command:"
        printf '  %s\n' "${_r_rocm_env:+$_r_rocm_env }${cmd[*]}"
        echo "----------------------------"
    )"
    echo "$config_text"

    : > "$server_log"
    printf '%s\n\n' "$config_text" >> "$server_log"
    echo "Starting ComfyUI [slot $slot] on port $port_server..."
    # From the checkout, as its own launcher would; _r_rocm_env is unquoted on
    # purpose — it word-splits into KEY=VAL pairs for env.
    local server_pid=""
    server_pid=$(cd "$app" && _spawn_detached "$PID_DIR/server-${slot}.pid" "$server_log" append \
        env TMPDIR="$COMFYUI_TMP" PYTHONUNBUFFERED=1 $_r_rocm_env "${cmd[@]}")
    if [[ -z "$server_pid" ]]; then
        echo "Error: ComfyUI did not report a PID. See $server_log" >&2
        exit 1
    fi
    echo "Server running (PID: $server_pid, detached) — up in ~10-20 s; models load per workflow."
    if [[ "$start_proxy" == true ]]; then
        _start_images_server "$slot" "$host" || { _stop_slot "$slot" > /dev/null; exit 1; }
    fi
    echo ""
    echo "  UI:    $url"
    [[ "$start_proxy" == true ]] && \
        echo "  API:   http://${host:-127.0.0.1}:$port_proxy/v1/images/generations (and /edits, /v1/models)"
    echo "  Logs:  tail -f $server_log"
    echo "  Stop:  $PROG stop $slot"
}

