# GPU memory a process holds, in MiB: GTT plus VRAM from its DRM fdinfo, counted
# once per DRM client (several fds can share one). This is what the process
# itself has — unlike the sysfs total, which sums every program on the GPU.
_proc_gpu_mib() {
    local pid="$1"
    cat /proc/"$pid"/fdinfo/* 2>/dev/null | awk '
        /^drm-client-id:/  { id = $2 }
        /^drm-memory-gtt:/ { gtt[id] = $2 }
        /^drm-memory-vram:/ { vram[id] = $2 }
        END { for (c in gtt) kib += gtt[c]; for (c in vram) kib += vram[c]; printf "%d", kib / 1024 }'
}

_proc_rss_mib() {
    awk '/^VmRSS:/ { printf "%d", $2 / 1024 }' /proc/"$1"/status 2>/dev/null
}

# "1 running, 2 pending" from ComfyUI's /queue, or nothing when it does not answer.
_comfyui_queue() {
    curl -sf -m 3 "http://127.0.0.1:$1/queue" | python3 -c '
import json, sys
q = json.load(sys.stdin)
running, pending = len(q.get("queue_running", [])), len(q.get("queue_pending", []))
print(f"{running} running, {pending} pending")
' 2>/dev/null
}

# Ask the ComfyUI on slot $1 to drop its models and caches, and wait until the
# memory has actually gone. A job in progress is left alone: /free would only
# take effect once it ends, and the models it needs would be reloaded anyway.
_comfyui_unload_slot() {
    local slot="$1" port=$(( PORT_BASE_SERVER + $1 )) pid q
    pid=$(_slot_server_pid "$slot") || return 0
    q=$(_comfyui_queue "$port")
    if [[ -z "$q" ]]; then
        echo "Slot $slot: ComfyUI does not answer on :$port — cannot unload its models."
        return 0
    fi
    if [[ "$q" != "0 running, 0 pending" ]]; then
        echo "Slot $slot: ComfyUI is busy ($q) — its models stay loaded until the queue is done."
        return 0
    fi
    local gpu0 rss0 gpu rss prev="" i
    gpu0=$(_proc_gpu_mib "$pid"); rss0=$(_proc_rss_mib "$pid")
    curl -sf -m 5 -X POST "http://127.0.0.1:$port/free" -H 'Content-Type: application/json' \
        -d '{"unload_models": true, "free_memory": true}' > /dev/null || {
        echo "Slot $slot: ComfyUI refused /free."; return 0; }
    # The worker picks the flag up between jobs, within a second or so; wait until
    # two readings in a row agree.
    for (( i=0; i < 30; i++ )); do
        sleep 0.5
        gpu=$(_proc_gpu_mib "$pid"); rss=$(_proc_rss_mib "$pid")
        (( i >= 2 )) && [[ "$gpu $rss" == "$prev" ]] && break
        prev="$gpu $rss"
    done
    awk -v g0="$gpu0" -v g="$gpu" -v r0="$rss0" -v r="$rss" -v s="$slot" 'BEGIN {
        printf "Slot %s: ComfyUI models unloaded — GPU %.1f → %.1f GiB, RAM %.1f → %.1f GiB\n",
               s, g0 / 1024, g / 1024, r0 / 1024, r / 1024 }'
}

_comfyui_unload() {
    local s
    for s in $(_comfyui_slots); do _comfyui_unload_slot "$s"; done
}

