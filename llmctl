# The value following flag $1 in $_ARGV, or nothing.
_argv_flag() {
    local key="$1" i
    for (( i=0; i < ${#_ARGV[@]} - 1; i++ )); do
        [[ "${_ARGV[i]}" == "$key" ]] && { echo "${_ARGV[i+1]}"; return 0; }
