    ids=$(curl -sf -m 3 "http://127.0.0.1:$port/v1/models" | python3 -c 'import json,sys; print(", ".join(m["id"] for m in json.load(sys.stdin)["data"]))' 2>/dev/null)
    echo "${indent}Model:     $label"
