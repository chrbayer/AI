                newer=$(( newer + 1 ))
            fi
        elif [[ -z "$newest" ]]; then echo "  ComfyUI ($version$on_master): cannot list its releases"
        elif git -C "$c_app" merge-base --is-ancestor "$newest" HEAD 2>/dev/null; then
            echo "  ComfyUI ($version$on_master) — current: $newest is the newest release$lead"
        else
            echo "  ComfyUI ($version$on_master) — $newest is the newest release; $PROG update ${f[0]} moves onto it"
            newer=$(( newer + 1 ))
        fi
        local dir url pin rest
        while read -r dir url pin rest; do
            [[ -z "$dir" || "$dir" == \#* ]] && continue
            # A release tag made after the pin is news (update comfy takes it); new
            # commits are only shown.
            gh_repo=$(sed -E 's#^https://github.com/##; s#\.git$##' <<< "$url")
            local tag status
            tag=$(_node_pack_tag "$url")
            status=""; [[ -n "$tag" ]] && status=$(_gh_json "repos/$gh_repo/compare/$pin...$tag" .status)
            behind=$(_gh_json "repos/$gh_repo/compare/$pin...HEAD" .ahead_by)
            [[ "$behind" =~ ^[1-9] ]] && behind=", $behind commits since the pin" || behind=""
            if [[ "$status" == ahead ]]; then
                echo "  custom nodes $dir (${pin:0:9}, pinned) — $tag is out, after the pin: $PROG update ${f[0]}"
                newer=$(( newer + 1 ))
            elif [[ "$master" == true && -n "$behind" ]]; then
                # Against its main branch, tags or not.
                echo "  custom nodes $dir (${pin:0:9}, pinned) — behind its main branch${behind}: $PROG update ${f[0]} --master"
                newer=$(( newer + 1 ))
            else
                echo "  custom nodes $dir (${pin:0:9}, pinned) — current${tag:+: $tag, its newest release, is older}$behind"
            fi
        done < "$COMFYUI_SHARE/custom_nodes.txt"
        echo "  models:"
        local -a qflag=()
        [[ "$quick" == true ]] && qflag=(--quick)
        python3 "$COMFYUI_MODELS_SCRIPT" outdated "$c_wf" "$c_models" --sources "$COMFYUI_SHARE/sources.json" \
            "${qflag[@]}" | sed 's/^/  /'
        (( PIPESTATUS[0] == 1 )) && newer=$(( newer + 1 ))
    done

    # New model versions beyond the files in use, and the ComfyUI templates open
    # issues wait for (comfyui/watch.conf).
    if [[ -f "$COMFYUI_SHARE/watch.conf" ]]; then
        printf '\n\033[1mWatch\033[0m (new model versions, templates issues wait for)\n'
        local tdir="" e
        for e in "${_MODELS[@]}"; do
            _resolve_model "${e%%|*}" && [[ "$_r_backend" == comfyui ]] && { _comfyui_paths; break; }
        done
        [[ -n "${c_app:-}" ]] && tdir=$(ls -d "$c_app"/.venv/lib/python*/site-packages/comfyui_workflow_templates_json/templates 2>/dev/null | head -1)
        python3 "$LIB_DIR/watch.py" "$COMFYUI_SHARE/watch.conf" "${tdir:-/nonexistent}" || newer=$(( newer + 1 ))
    fi

    printf '\n\033[1mModels\033[0m (installed ones, against their Hugging Face repos)\n'
    DL_CHECK=true DL_PENDING=0 DL_UNKNOWN=0
    local model_dir report
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r -a f <<< "$entry"
        _resolve_model "${f[0]}" || continue
        [[ -n "$_r_hf_repo" && -e "${_r_model//\~/$HOME}" ]] || continue
        model_dir=$(_model_dl_dir "$_r_model" "$_r_hf_dir" "$_r_hf_includes")
        report=$( {
            _download_model "$_r_hf_repo" "$model_dir" "$_r_hf_includes" ""
            [[ -n "$_r_hf_draft" ]] && _download_draft "$_r_hf_draft" "" "${_r_spec_args[@]}"
            [[ -n "$_r_hf_mmproj" ]] && _download_mmproj "$_r_hf_mmproj" "$_r_mmproj" ""
        } 2>&1 )
        if grep -q 'to download' <<< "$report"; then
            echo "  ${f[0]}: newer files on Hugging Face"
            grep -E 'to download|^    ' <<< "$report" | sed 's/^/  /'
            newer=$(( newer + 1 ))
        elif grep -q 'cannot tell' <<< "$report"; then
            echo "  ${f[0]}: $(grep -m1 'cannot tell' <<< "$report" | sed 's/^ *//')"
        else
            echo "  ${f[0]} — current"
        fi
    done
    if [[ -f "$TTS_DESIGN_DIR/model.safetensors" ]]; then
        report=$(_download_model "$TTS_DESIGN_REPO" "$TTS_DESIGN_DIR" "" 2>&1)
        if grep -q 'to download' <<< "$report"; then
            echo "  VoiceDesign: newer files on Hugging Face"; newer=$(( newer + 1 ))
        else
            echo "  VoiceDesign — current"
        fi
    fi

    echo ""
    if (( newer )); then
        echo "Newer: $newer item(s) above."
        return 1
    fi
    echo "Everything current."
}

# Show a slot's log without knowing where it lives.
# Usage: logs [slot] [--proxy] [-f] [-n N]
#   no slot: every log there is, with size and last change
cmd_logs() {
    local slot="" kind=server follow=false lines=50
    while (( $# )); do
        case "$1" in
            --proxy) kind=proxy ;;
            -f|--follow) follow=true ;;
            -n) lines="${2:-}"; shift
                [[ "$lines" =~ ^[0-9]+$ ]] || { echo "Error: -n takes a number of lines"; return 1; } ;;
            -*) echo "Usage: $PROG logs [slot] [--proxy] [-f] [-n N]"; return 1 ;;
            *)  slot="$1" ;;
        esac
        shift
    done
    if [[ -z "$slot" ]]; then
        [[ -n "$(compgen -G "$LOG_DIR/*-*.log")" ]] || { echo "No logs yet (start a server first)."; return 0; }
        local f
        for f in "$LOG_DIR"/{server,proxy}-*.log; do
            [[ -f "$f" ]] || continue
            printf '  %-18s %8s  %s\n' "${f##*/}" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
        done | sort -t- -k2 -n
        return 0
    fi
    _check_slot "$slot" || return 1
    local log="$LOG_DIR/${kind}-${slot}.log"
    [[ -f "$log" ]] || { echo "No $kind log for slot $slot ($log)."; return 1; }
    if [[ "$follow" == true ]]; then
        exec tail -n "$lines" -F "$log"
    fi
    tail -n "$lines" "$log"
}

# Summarize prompt-cache effectiveness from the server log (works whether or
# not clients go through the proxy). Per finished task the INFO log carries
# processed prompt tokens ("prompt eval time = .. / N"), generated tokens
# ("eval time = .. / M") and the final context size ("stop processing:
# n_tokens = T"); prompt_total = T - M and cached = prompt_total - N, which
# equals llama-server's own n_prompt_tokens_cache. The log is truncated on
# each start, so this reflects the current server session.
# Usage: cache-stats [slot]  (default: all slots with a server log)
cmd_cache_stats() {
    local want_slot="${1:-}"
    [[ -n "$want_slot" ]] && { _check_slot "$want_slot" || return 1; }
    local found=0
    for slot in ${want_slot:-$(_log_slots)}; do
        local log="$LOG_DIR/server-${slot}.log"
        [[ -f "$log" ]] || continue
        found=1
        if grep -q '^Backend:  ComfyUI' "$log"; then
            echo "Slot $slot: ComfyUI — no prompt cache"
            continue
        fi
        if grep -q '^Serves:   ' "$log"; then
            echo "Slot $slot: $(grep -m1 '^Serves:   ' "$log" | sed 's/^Serves: *//; s/ —.*//') — no prompt cache"
            continue
        fi
        if grep -q '^Backend:  audio.cpp' "$log"; then
            echo "Slot $slot: audio.cpp — no prompt cache"
            continue
        fi
        if grep -q '^Backend:  tts' "$log"; then
            echo "Slot $slot: speech — no prompt cache"
            continue
        fi
        if _slot_is_gufo "$slot"; then
            echo "Slot $slot: gufo — no prompt cache statistics (each response's usage carries its own cache hit)"
            continue
        fi
        if _slot_is_halogen "$slot"; then
            # Its log has no per-task token counts; the server keeps its own tally.
            echo "Slot $slot: halogen, from :$(( PORT_BASE_SERVER + slot ))/cache"
            curl -sf "http://127.0.0.1:$(( PORT_BASE_SERVER + slot ))/cache" | python3 -c '
import json, sys
c = json.load(sys.stdin)
hits, misses = c.get("hits", 0), c.get("misses", 0)
rate = 100 * hits / (hits + misses) if hits + misses else 0
entries, cap, saved = c.get("entries"), c.get("max_entries"), c.get("prompt_tokens_saved", 0)
# halogen-server sizes its cache in bytes, not entries.
used, room = c.get("bytes", 0) / 2**30, c.get("cap_bytes", 0) / 2**30
size = f"entries={entries}/{cap}" if cap is not None else f"entries={entries} ({used:.1f} of {room:.1f} GiB)"
print(f"  {size}  hits={hits}  misses={misses}  "
      f"hit_rate={rate:.1f}%  prompt_tokens_saved={saved}")
' || echo "  the server does not answer (still loading?)"
            continue
        fi
        echo "Slot $slot: $log"
        python3 - "$log" <<'PY'
import re, sys
proc, gen, total = {}, {}, {}
re_pe = re.compile(r"task\s+(\d+) \| prompt eval time =.*?/\s*(\d+) tokens")
re_ev = re.compile(r"task\s+(\d+) \|\s+eval time =.*?/\s*(\d+) tokens")
re_st = re.compile(r"task\s+(\d+) \| stop processing: n_tokens = (\d+)")
for ln in open(sys.argv[1], errors="replace"):
    m = re_pe.search(ln);  m and proc.update({m.group(1): int(m.group(2))})
    m = re_ev.search(ln);  m and gen.update({m.group(1): int(m.group(2))})
    m = re_st.search(ln);  m and total.update({m.group(1): int(m.group(2))})
n = tp = tc = 0
for tid, T in total.items():
    ptotal = T - gen.get(tid, 0)          # prompt tokens = context minus generated
    if ptotal <= 0:
        continue
    cached = max(0, ptotal - proc.get(tid, 0))
    n += 1; tp += ptotal; tc += cached
if tp:
    print(f"  tasks={n}  prompt_tokens={tp}  cached={tc}  "
          f"reprocessed={tp-tc}  hit_rate={100*tc/tp:.1f}%")
else:
    print("  no finished completion tasks in the log yet")
PY
    done
    [[ "$found" -eq 0 ]] && echo "No server logs yet (start a server first)."
    return 0
}

# Drop the KV cache of the running slots without restarting the server:
# POST /slots/{id}?action=erase for every server slot (--parallel N creates
# ids 0..N-1). That action needs --slot-save-path, which cmd_start always passes.
#
# Two things this does *not* do: it never interrupts a running generation (the
# server defers the erase until the slot falls idle, so the call can block), and
# it leaves the host-RAM prompt cache alone (--cache-ram, 8192 MiB by default) —
# a matching prompt can be restored from there afterwards.
#
# Usage: clear-kv [slot]  (default: every running slot)
cmd_clear_kv() {
    local want_slot="${1:-}"
    [[ -n "$want_slot" ]] && { _check_slot "$want_slot" || return 1; }
    _check_deps python3 || return 1

    # A tunnelled slot requires a token; reuse the first one, exactly
    # as cmd_env does. A server without --api-key-file ignores the header.
    local token=""
    if [[ -r "$TOKEN_FILE" ]]; then
        token=$(grep -m1 -vE '^[[:space:]]*(#|$)' "$TOKEN_FILE" 2>/dev/null)
    fi

    local found=0
    for slot in ${want_slot:-$(_active_slots)}; do
        local server_pid=""
        [[ -f "$PID_DIR/server-${slot}.pid" ]] && server_pid=$(cat "$PID_DIR/server-${slot}.pid")
        [[ -n "$server_pid" ]] && ps -p "$server_pid" > /dev/null 2>&1 || continue
        found=1
        if _slot_is_comfyui "$slot"; then
            # Its counterpart of a KV cache: the models and cached node outputs.
            _comfyui_unload_slot "$slot"
            continue
        fi
        if _slot_is_tts "$slot"; then
            echo "Slot $slot: speech holds nothing between requests — each one loads and frees its model."
            continue
        fi
        if _slot_is_gufo "$slot"; then
            echo "Slot $slot: gufo has no endpoint to erase its KV; a session's state is freed when it"
            echo "        ends. For a hard reset: $PROG stop $slot and start it again."
            continue
        fi
        if _slot_is_halogen "$slot"; then
            echo "Slot $slot: halogen has no endpoint to erase its KV; a request's region is freed when it"
            echo "        ends, and only the prompt cache keeps anything. For a hard reset: $PROG stop $slot"
            echo "        and start it again with --cache-ram 0 (prompt cache off)."
            continue
        fi

        echo "Slot $slot: clearing KV on :$(( PORT_BASE_SERVER + slot ))"
        LLM_KV_TOKEN="$token" python3 - "$(( PORT_BASE_SERVER + slot ))" <<'KVPY'
import json, os, sys, urllib.error, urllib.request

base    = f"http://127.0.0.1:{sys.argv[1]}"
token   = os.environ.get("LLM_KV_TOKEN", "")
headers = {"Authorization": f"Bearer {token}"} if token else {}

def call(path, method="GET", timeout=30):
    req = urllib.request.Request(f"{base}{path}", method=method, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)

try:
    # /props reports the slot count and stays readable even with --no-slots.
    n_slots = int(call("/props").get("total_slots", 1))
except Exception as e:
    print(f"  Error: cannot read /props ({e})")
    sys.exit(1)

total = 0
for i in range(n_slots):
    try:
        # Generous timeout: a busy slot only frees up once its generation ends,
        # which the server bounds with --timeout 600.
        res = call(f"/slots/{i}?action=erase", method="POST", timeout=620)
    except urllib.error.HTTPError as e:
        print(f"  slot {i}: HTTP {e.code} — {e.read().decode(errors='replace').strip()}")
        continue
    except Exception as e:
        print(f"  slot {i}: {e}")
        continue
    n = int(res.get("n_erased", 0))
    total += n
    print(f"  slot {i}: {n} tokens erased")

print(f"  total: {total} tokens")
KVPY

        # The prompt could still come back from host RAM, which no endpoint clears.
        local pc
        pc=$(grep -m1 '^PromptCache:' "$LOG_DIR/server-${slot}.log" 2>/dev/null)
        if [[ -n "$pc" && "$pc" != *disabled* ]]; then
            echo "  Note: ${pc#PromptCache: } — a matching prompt may be restored from host RAM."
            echo "        Start the slot with --cache-ram 0 for a hard reset."
        fi
    done
    if [[ "$found" -eq 0 ]]; then
        echo "No running server${want_slot:+ in slot $want_slot}."
        return 1
    fi
    return 0
}

# Read the chat template each model actually runs with and report what it
# supports, next to what models.conf claims. This is the same signal llama.cpp
# probes at load time (jinja::caps_*): enable_thinking for on/off,
# reasoning_effort / reasoning_strength for levels. The template is the one baked
# into the GGUF unless extra_args override it with --chat-template-file, which is
# what the server would then load — probing the GGUF there would report the
# template the model ships with rather than the one it runs.
#
# Usage: probe-reasoning [model]
cmd_probe_reasoning() {
    local want="${1:-}"
    _check_deps python3 || return 1

    # gguf-py ships with the llama.cpp sources, not with the binary.
    local gguf_py=""
    if python3 -c "import gguf" 2>/dev/null; then
        gguf_py=""
    elif [[ -d "${LLAMA_SRC:-$HOME/src/llama.cpp}/gguf-py" ]]; then
        gguf_py="${LLAMA_SRC:-$HOME/src/llama.cpp}/gguf-py"
    else
        echo "Error: needs the gguf python module — either 'pip install gguf' or a"
        echo "       llama.cpp checkout (set LLAMA_SRC, default ~/src/llama.cpp)"
        return 1
    fi

    printf "  %-11s %-11s %-11s %s\n" "MODEL" "CONFIGURED" "TEMPLATE" "READS"
    printf "  %-11s %-11s %-11s %s\n" "-----" "----------" "--------" "-----"

    local entry
    for entry in "${_MODELS[@]}"; do
        IFS='|' read -r m_name _ m_model _ _ _ m_args _ _ _ _ _ _ _ m_reasoning _ <<< "$entry"
        [[ -n "$want" && "$m_name" != "$want" ]] && continue
        _resolve_model "$m_name" && [[ "$_r_backend" == comfyui || "$_r_backend" == tts || "$_r_backend" == audiocpp || "$_r_role" != chat ]] && continue
        local path="${m_model//\~/$HOME}"

        if [[ ! -f "$path" ]]; then
            # ASCII dash: bash pads printf by bytes, so a multibyte one misaligns.
            printf "  %-11s %-11s %-11s %s\n" "$m_name" "$m_reasoning" "-" "not downloaded"
            continue
        fi
        # --chat-template-file <path> anywhere in extra_args wins over the GGUF.
        # read -ra rather than an unquoted expansion: args are split on spaces
        # here, but a stray glob in them must not hit the filesystem.
        local tmpl_file="" prev=""
        local -a args_arr=()
        read -ra args_arr <<< "$m_args"
        local word
        for word in "${args_arr[@]}"; do
            [[ "$prev" == "--chat-template-file" ]] && { tmpl_file="$word"; break; }
            prev="$word"
        done
        # A halogen checkpoint is no GGUF; its template ships beside it.
        _resolve_model "$m_name" && [[ "$_r_backend" == halogen ]] && \
            tmpl_file="$(dirname "$path")/tokenizer/chat_template.jinja"
        GGUF_PY="$gguf_py" python3 - "$m_name" "$m_reasoning" "$path" "$tmpl_file" <<'PROBEPY'
import os, sys
if os.environ.get("GGUF_PY"):
    sys.path.insert(0, os.environ["GGUF_PY"])
from gguf import GGUFReader

name, configured, path, tmpl_file = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

tmpl, source = None, ""
if tmpl_file:
    source = f"  [{os.path.basename(tmpl_file)}]"
    if not os.path.isfile(tmpl_file):
        print(f"  {name:<11} {configured:<11} {'?':<11} --chat-template-file {tmpl_file} is missing")
        sys.exit(0)
    with open(tmpl_file, encoding="utf-8") as fh:
        tmpl = fh.read()
else:
    for f in GGUFReader(path).fields.values():
        if f.name == "tokenizer.chat_template":
            tmpl = f.contents()

if tmpl is None:
    print(f"  {name:<11} {configured:<11} {'—':<11} no chat template in the GGUF")
    sys.exit(0)

reads = [v for v in ("enable_thinking", "reasoning_effort", "reasoning_strength") if v in tmpl]
if "reasoning_effort" in reads or "reasoning_strength" in reads:
    seen = "effort"
elif "enable_thinking" in reads:
    seen = "toggle"
elif "<think>" in tmpl:
    # Think tags present but nothing to switch on them: hard-coded either way.
    seen = "locked-off"
else:
    seen = "none"

mark = "" if seen == configured else "   <-- differs"
print(f"  {name:<11} {configured:<11} {seen:<11} {', '.join(reads) or '—'}{source}{mark}")
PROBEPY
    done
    return 0
}

# Everything env sets, in one list, so clear removes exactly that.
_ENV_VARS=(CLAUDE_CONFIG_DIR ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
    ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL
    ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL API_TIMEOUT_MS
    PI_STREAM_FIRST_EVENT_TIMEOUT_MS PI_OPENAI_STREAM_IDLE_TIMEOUT_MS
    OPENAI_BASE_URL OPENAI_API_KEY CLAUDE_CODE_MAX_CONTEXT_TOKENS)

# A child process cannot change its caller's environment, so env and clear print
# shell code on stdout for the caller to eval, and talk to the user on stderr
# only — anything else on stdout would be executed. `llmctl shell-init` wraps
# that eval into a function.
_eval_hint() {
    [[ -t 1 ]] && echo "  (only printed — apply with: eval \"\$($PROG $*)\", or once: eval \"\$($PROG shell-init)\" in ~/.zshrc)" >&2
    return 0
}

cmd_env() {
    local name=""
    local slot="1"
    local want=""               # "" = auto (proxy if one is listening); proxy|direct = forced
    local args="env $*"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --proxy) want="proxy"; shift ;;
            --direct) want="direct"; shift ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) if [[ -z "$name" ]]; then name="$1"; elif [[ "$slot" == "1" ]]; then slot="$1"; fi; shift ;;
        esac
    done

    [[ -z "$name" ]] && { echo "Usage: eval \"\$($PROG env <model-name> [slot] [--proxy|--direct])\"" >&2; return 1; }
    _check_slot "$slot" || return 1

    local port_proxy=$(( PORT_BASE_PROXY + slot ))
    local port_server=$(( PORT_BASE_SERVER + slot ))

    # Since the proxy is opt-in (start --proxy), point at whichever endpoint is
    # actually up: the proxy when it listens, the server otherwise. --proxy /
    # --direct force the choice (e.g. to set env before starting the slot).
    _resolve_model "$name" || { echo "Unknown model: $name" >&2; cmd_list >&2; return 1; }

    if [[ "$_r_backend" == comfyui ]]; then
        echo "Error: '$name' is ComfyUI, not an LLM — there is nothing to point Claude Code at." >&2
        echo "       Its UI: http://127.0.0.1:$port_server" >&2
        return 1
    fi
    if [[ "$_r_backend" == tts ]]; then
        echo "Error: '$name' is a speech model, not an LLM — there is nothing to point Claude Code at." >&2
        echo "       Its API: POST http://127.0.0.1:$port_server/v1/audio/speech" >&2
        return 1
    fi
    if [[ "$_r_backend" == audiocpp ]]; then
        echo "Error: '$name' is a speech recognizer, not an LLM — there is nothing to point Claude Code at." >&2
        echo "       Its API: POST http://127.0.0.1:$port_server/v1/audio/transcriptions (and …/live)" >&2
        return 1
    fi
    if [[ "$_r_backend" == llama && "$_r_role" != chat ]]; then
        local api="/v1/embeddings"; [[ "$_r_role" == rerank ]] && api="/v1/rerank"
        local what="an embedding model"; [[ "$_r_role" == rerank ]] && what="a reranking model"
        echo "Error: '$name' is $what, not a chat model — there is nothing to point Claude Code at." >&2
        echo "       Its API: POST http://127.0.0.1:$port_server$api" >&2
        return 1
    fi

    local port_target="$port_server" via="server"
    # halogen speaks no Messages API; only its proxy does, and it always runs.
    if [[ "$_r_backend" == halogen || "$_r_backend" == gufo ]]; then
        [[ "$want" == direct ]] && echo "Note: $_r_backend is reached through its proxy only — it translates the Messages API." >&2
        want="proxy"
    fi
    case "$want" in
        proxy)  port_target="$port_proxy"; via="proxy" ;;
        direct) port_target="$port_server"; via="server" ;;
        *)      if ss -tlnp 2>/dev/null | grep -q ":${port_proxy} "; then
                    port_target="$port_proxy"; via="proxy"
                fi ;;
    esac

    # Absolute, so the Claude Code profile does not depend on the directory the
    # command happens to be run from.
    local config_dir="$DATA_DIR/claude/${_r_name}"
    [[ "$slot" -gt 1 ]] && config_dir+="-${slot}"
    mkdir -p "$config_dir"

    # A tunnelled slot demands a token. Reuse the first one from the token file
    # so the local workflow stays a plain `llmctl env`; a slot without --tunnel
    # ignores the header anyway.
    local token="sk-no-key-required" token_src="placeholder"
    if [[ -r "$TOKEN_FILE" ]]; then
        local first
        first=$(grep -m1 -vE '^[[:space:]]*(#|$)' "$TOKEN_FILE" 2>/dev/null)
        [[ -n "$first" ]] && { token="$first"; token_src="$TOKEN_FILE"; }
    fi

    local -A val=(
        [CLAUDE_CONFIG_DIR]="$config_dir"
        [ANTHROPIC_BASE_URL]="http://localhost:$port_target"
        [ANTHROPIC_AUTH_TOKEN]="$token"
        [ANTHROPIC_MODEL]="$_r_client"
        [ANTHROPIC_SMALL_FAST_MODEL]="$_r_client"
        [ANTHROPIC_DEFAULT_SONNET_MODEL]="$_r_client"
        [ANTHROPIC_DEFAULT_OPUS_MODEL]="$_r_client"
        [ANTHROPIC_DEFAULT_HAIKU_MODEL]="$_r_client"
        [API_TIMEOUT_MS]="3000000"
        [PI_STREAM_FIRST_EVENT_TIMEOUT_MS]="600000"
        [PI_OPENAI_STREAM_IDLE_TIMEOUT_MS]="600000"
        [OPENAI_BASE_URL]="http://localhost:$port_target/v1"
        [OPENAI_API_KEY]="$token"
        # Claude Code knows no window for a model name outside its catalog and
        # assumes 200K. halogen serves one request up to its full context — the
        # running slot's, else the model's — so auto-compact can use all of it.
        # (A llama-server slot divides its context by --parallel; left unset.)
        [CLAUDE_CODE_MAX_CONTEXT_TOKENS]=""
    )
    if [[ "$_r_backend" == halogen ]]; then
        local ctx_now="" spid=""
        if spid=$(_slot_server_pid "$slot") && _read_argv "$spid" && _is_halogen_argv; then
            ctx_now=$(_argv_env HALOGEN_CTX || _argv_env HALOGEN_SLOT_CTX)
        fi
        val[CLAUDE_CODE_MAX_CONTEXT_TOKENS]="${ctx_now:-${_r_ctx:-$HALOGEN_NATIVE_CTX}}"
    fi
    # gufo's --context is per session: each request may use all of it.
    if [[ "$_r_backend" == gufo ]]; then
        local gctx="" gpid=""
        if gpid=$(_slot_server_pid "$slot") && _read_argv "$gpid" && _is_gufo_argv; then
            gctx=$(_argv_flag --context)
        fi
        val[CLAUDE_CODE_MAX_CONTEXT_TOKENS]="${gctx:-$_r_ctx}"
    fi
    local var
    for var in "${_ENV_VARS[@]}"; do
        if [[ -n "${val[$var]}" ]]; then
            printf 'export %s=%q\n' "$var" "${val[$var]}"
        else
            printf 'unset %s\n' "$var"
        fi
    done

    {
        echo "Claude Code env set for $_r_label ($_r_client) [slot $slot] via $via"
        echo "  CLAUDE_CONFIG_DIR=$config_dir"
        echo "  Token: $token_src"
        echo "  ANTHROPIC_BASE_URL=http://localhost:$port_target"
        echo "  OPENAI_BASE_URL=http://localhost:$port_target/v1"
        echo "  ANTHROPIC_MODEL=$_r_client"
        [[ -n "${val[CLAUDE_CODE_MAX_CONTEXT_TOKENS]}" ]] && echo "  CLAUDE_CODE_MAX_CONTEXT_TOKENS=${val[CLAUDE_CODE_MAX_CONTEXT_TOKENS]}"
    } >&2
    _eval_hint "$args"
}

cmd_clear() {
    echo "unset ${_ENV_VARS[*]}"
    echo "Environment cleared. '$PROG env <name> [slot]' sets up a model again." >&2
    _eval_hint clear
}

# Shell function for ~/.zshrc or ~/.bashrc: `eval "$(llmctl shell-init)"`.
# It lets `llmctl env …` / `llmctl clear` apply their output to the current
# shell directly; every other command is passed through unchanged.
cmd_shell_init() {
    cat <<'EOF'
llmctl() {
    case "${1:-}" in
        env|clear)
            local _llmctl_out
            _llmctl_out="$(command llmctl "$@")" || return
            eval "$_llmctl_out" ;;
        *)  command llmctl "$@" ;;
    esac
}
EOF
}

# ── Benchmark ────────────────────────────────────────────────
#
# ROCm env vars are now configured per-model in models.conf via _model_rocm_env.
# Use benchmark data + formula: score = tg128*5 + pp512*0.1 to determine optimal combo.
# Models using Vulkan (default bin) should have _model_rocm_env="" (empty).
#
# ── ROC env combos (all 8 permutations) ────────────────────

_roc_env_combos() {
    echo "ROC_ENABLE_PREFETCH=0;HSA_ENABLE_COMPRESSION=0;HSA_ENABLE_SDMA=0"
    echo "ROC_ENABLE_PREFETCH=0;HSA_ENABLE_COMPRESSION=0;HSA_ENABLE_SDMA=1"
    echo "ROC_ENABLE_PREFETCH=0;HSA_ENABLE_COMPRESSION=1;HSA_ENABLE_SDMA=0"
    echo "ROC_ENABLE_PREFETCH=0;HSA_ENABLE_COMPRESSION=1;HSA_ENABLE_SDMA=1"
    echo "ROC_ENABLE_PREFETCH=1;HSA_ENABLE_COMPRESSION=0;HSA_ENABLE_SDMA=0"
    echo "ROC_ENABLE_PREFETCH=1;HSA_ENABLE_COMPRESSION=0;HSA_ENABLE_SDMA=1"
    echo "ROC_ENABLE_PREFETCH=1;HSA_ENABLE_COMPRESSION=1;HSA_ENABLE_SDMA=0"
    echo "ROC_ENABLE_PREFETCH=1;HSA_ENABLE_COMPRESSION=1;HSA_ENABLE_SDMA=1"
}

# llama-bench beside the configured llama-server of each kind.
_bench_bin() {
    local server; server=$(command -v "$1" 2>/dev/null) || { echo "llama-bench"; return; }
    echo "$(dirname "$server")/llama-bench"
}
_rocm_bin="$(_bench_bin "${LLAMA_ROCM_BIN:-/opt/llama.cpp-rocm/llama-server}")"
_vulkan_bin="$(_bench_bin "${LLAMA_DEFAULT_BIN:-llama-server}")"
_bench_common_args=(-ngl 999 -t 16 -lm mlock -fa 1)

run_bench() {
    local binary="$1"
    local model="$2"
    local env_combo="$3"
    local backend_type="$4"
    local model_name="$5"
    local result_file="$6"

    local env_display="${env_combo:-<none>}"
    local timestamp_ms
    timestamp_ms=$(date +%s%3N)
    local tmp_out
    tmp_out=$(mktemp)

    printf "%s" "  $env_display ... "

    # env_combo uses ';' as separator; convert to spaces so env receives separate KEY=VAL args
    env ${env_combo//;/ } "$binary" "${_bench_common_args[@]}" -m "$model" > "$tmp_out" 2>&1
    local exit_code=$?

    if [[ "$exit_code" -eq 0 ]]; then
        echo "OK"
    else
        echo "FAILED"
    fi

    local env_json="{}"
    if [[ -n "$env_combo" ]]; then
        local env_parts=()
        IFS=';' read -ra pairs <<< "$env_combo"
        for pair in "${pairs[@]}"; do
            local key="${pair%%=*}"
            local val="${pair#*=}"
            env_parts+=("$key=\"$val\"")
        done
        env_json=$(printf '%s\n' "${env_parts[@]}" | jq -Rs 'split("\n") | map(select(length>0)) | map(split("=") | {key: .[0], value: .[1]}) | from_entries')
    fi

    local stdout_raw
    stdout_raw=$(jq -Rs 'split("\n") | map(select(length>0)) | join("\n")' "$tmp_out")
    rm -f "$tmp_out"

    local status_val exit_code_val
    if [[ "$exit_code" -eq 0 ]]; then
        status_val='"ok"'
        exit_code_val="null"
    else
        status_val='"error"'
        exit_code_val="$exit_code"
    fi

    local entry_json
    entry_json=$(jq -n \
        --arg ts "$timestamp_ms" \
        --arg backend "$backend_type" \
        --arg binary "$binary" \
        --arg model "$model" \
        --arg model_name "$model_name" \
        --argjson env "$env_json" \
        --argjson status "$status_val" \
        --argjson stdout "$stdout_raw" \
        --argjson exit_code "$exit_code_val" \
        '{
            timestamp: $ts,
            backend: $backend,
            binary: $binary,
            model: $model,
            model_name: $model_name,
            env: $env,
            status: $status,
            exit_code: $exit_code,
            stdout: $stdout
        }'
    )
    echo "$entry_json" >> "$result_file"
}

bench_model() {
    local m_name="$1"
    local m_model="$2"
    local m_label="$3"
    local full_mode="${4:-}"
    local result_file="$5"

    local model_path="${m_model//\~/$HOME}"
    if _resolve_model "$m_name" && [[ "$_r_backend" == comfyui || "$_r_backend" == tts || "$_r_backend" == audiocpp ]]; then
        echo "  Skipping $m_label: not an LLM"
        return
    fi
    if [[ "$_r_backend" == llama && "$_r_role" != chat ]]; then
        echo "  Skipping $m_label: not a chat model"
        return
    fi
    if [[ ! -f "$model_path" ]]; then
        echo "  Skipping $m_label: model file not found"
        return
    fi
    if _resolve_model "$m_name" && [[ "$_r_backend" == halogen || "$_r_backend" == gufo ]]; then
        bench_halogen "$m_name" "$model_path" "$m_label" "$full_mode" "$result_file"
        return
    fi
    # llama-bench loads the whole model itself; beside a halogen server, which
    # holds most of the machine, that would stall both or fail.
    local hs
    hs=$(_halogen_slots | head -1)
    if [[ -n "$hs" ]]; then
        echo "  Skipping $m_label: halogen runs on slot $hs, and a measurement beside it measures both — $PROG stop $hs first"
        return
    fi

    echo "  $m_label"
    # A model on a build of its own (a patched llama.cpp, an architecture the
    # ordinary builds cannot load yet) is measured with that build's llama-bench.
    local own_server="${_r_binary//\~/$HOME}" own_bench=""
    if [[ "$own_server" == */* && "$own_server" != "$(command -v "${LLAMA_DEFAULT_BIN:-llama-server}" 2>/dev/null)" ]]; then
        own_bench="$(dirname "$own_server")/llama-bench"
    fi
    if [[ -n "$own_bench" ]]; then
        if [[ -x "$own_bench" ]]; then
            echo "    its own build ($(dirname "$own_server")):"
            run_bench "$own_bench" "$model_path" "" "vulkan" "$m_name" "$result_file"
        else
            echo "    its own build has no llama-bench ($own_bench) — build it beside its llama-server"
        fi
        return
    fi
    if [[ "$full_mode" == "full" ]]; then
        # Full test: all 8 ROCm env combos + Vulkan
        echo "    ROCM:"
        while IFS= read -r combo; do
            [[ -z "$combo" ]] && continue
            run_bench "$_rocm_bin" "$model_path" "$combo" "rocm" "$m_name" "$result_file"
        done < <(_roc_env_combos)

        echo "    Vulkan:"
        run_bench "$_vulkan_bin" "$model_path" "" "vulkan" "$m_name" "$result_file"
    else
        # Default: only test default ROCm env + Vulkan
        local default_rocm_env="ROC_ENABLE_PREFETCH=1;HSA_ENABLE_COMPRESSION=1;HSA_ENABLE_SDMA=0"
        echo "    ROCM (default):"
        run_bench "$_rocm_bin" "$model_path" "$default_rocm_env" "rocm" "$m_name" "$result_file"
        echo "    Vulkan:"
        run_bench "$_vulkan_bin" "$model_path" "" "vulkan" "$m_name" "$result_file"
    fi
}

# bench for a halogen model. llama-bench cannot read a .hgn checkpoint, and the
# engine only exists as a server, so this measures the running slot over HTTP
# (halogen_bench.py): prefill at several prompt lengths, decode on prose and
# code. It records into the same JSONL file as llama-bench runs.
bench_halogen() {
    local m_name="$1" model_path="$2" m_label="$3" full_mode="$4" result_file="$5"
    local slot="" s pid
    for s in $(_container_slots); do
        if pid=$(_slot_server_pid "$s") && _read_argv "$pid" && [[ "$(_argv_halogen_model)" == "$model_path" ]]; then
            slot="$s"; break
        fi
    done
    if [[ -z "$slot" ]]; then
        echo "  Skipping $m_label: halogen is measured on a running server — start it first:"
        echo "    $PROG start $m_name   (or a preset naming it), then $PROG bench $m_name"
        return
    fi
    if ! curl -sf "http://127.0.0.1:$(( PORT_BASE_SERVER + slot ))/health" > /dev/null; then
        echo "  Skipping $m_label: slot $slot does not answer yet (still loading?)"
        return
    fi
    # Prompt lengths in tokens; --full adds the long end, where prefill slows.
    local -a sizes=(1000 8000 32000)
    [[ "$full_mode" == "full" ]] && sizes+=(64000 128000)
    echo "  $m_label — halogen on slot $slot"
    python3 "$HALOGEN_BENCH_SCRIPT" --url "http://127.0.0.1:$(( PORT_BASE_SERVER + slot ))" \
        --record "$result_file" --model-name "$m_name" --model "$model_path" \
        --binary "$_r_binary" "${sizes[@]}" || echo "    FAILED — see $result_file"
}

cmd_benchmark() {
    local target=""
    local full=""

    while [[ "$1" == "--full" ]]; do
        full="full"
        shift
    done
    target="${1:-}"

    if [[ -z "$target" ]]; then
        echo "Usage: $PROG bench [options] <model-name|all>"
        echo ""
        echo "  model-name   run benchmark for a single model"
        echo "  all          run benchmark for all models"
        echo ""
        echo "  Options:"
        echo "    --full      test all 8 ROCm env combos + Vulkan (default: only default ROCm);"
        echo "                halogen: prompts up to 128K instead of 32K"
        echo ""
        echo "  halogen models are measured on their running slot (prefill and decode"
        echo "  over HTTP); llama models are skipped while a halogen server runs."
        echo ""
        echo "  Available models:"
        for entry in "${_MODELS[@]}"; do
            IFS='|' read -r m_name _ _ _ _ m_label _ _ _ _ _ <<< "$entry"
            echo "    $m_name"
        done
        echo ""
        echo "  Result file: $DATA_DIR/benchmarks/benchmark-<model>-<timestamp>.jsonl"
        return
    fi

    _check_deps jq || return 1

    local result_file
    result_file="$DATA_DIR/benchmarks/benchmark-${target}-$(date +%Y%m%d-%H%M%S).jsonl"
    mkdir -p "$(dirname "$result_file")"
    echo "Results → $result_file"
    echo ""

    if [[ "$target" == "all" ]]; then
        for entry in "${_MODELS[@]}"; do
            IFS='|' read -r m_name _ m_model _ _ m_label _ _ _ _ _ _ _ <<< "$entry"
            echo "=== $m_label ==="
            bench_model "$m_name" "$m_model" "$m_label" "$full" "$result_file"
            echo ""
        done
    else
        local found=0
        for entry in "${_MODELS[@]}"; do
            IFS='|' read -r m_name _ m_model _ _ m_label _ _ _ _ _ _ _ <<< "$entry"
            if [[ "$m_name" == "$target" ]]; then
                found=1
                echo "=== $m_label ==="
                bench_model "$m_name" "$m_model" "$m_label" "$full" "$result_file"
                break
            fi
        done
        if [[ "$found" -eq 0 ]]; then
            echo "Unknown model: $target"
            echo "Run '$PROG bench' to see available models."
            return 1
        fi
    fi

    echo ""
    echo "Done. $(wc -l < "$result_file") entries written."
}

